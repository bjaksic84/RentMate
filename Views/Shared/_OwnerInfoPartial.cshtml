@model dynamic

@{
    var fullName = (Model.FirstName ?? "Uporabnik") + " " + (Model.LastName ?? "");
    var profilePic = !string.IsNullOrEmpty(Model.ProfilePictureUrl) 
                     ? Model.ProfilePictureUrl 
                     : "https://via.placeholder.com/100?text=U"; 
}

<div class="modal-header bg-primary text-white border-0">
    <h5 class="modal-title">Lastnik predmeta</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body text-center p-4">
    <img src="@profilePic" 
         class="rounded-circle mb-3 border border-3 border-white shadow" 
         style="width: 90px; height: 90px; object-fit: cover;" 
         alt="@fullName" />
    
    <h4 class="mb-1 fw-bold">@fullName</h4>
    <p class="text-muted mb-4"><i class="bi bi-geo-alt-fill text-danger"></i> @(Model.City ?? "Neznano")</p>

    <div class="row text-start border-top pt-3 bg-light rounded-3 mx-1">
        <div class="col-6 mb-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-shield-check text-success fs-4 me-2"></i>
                <div style="line-height: 1.2;">
                    <small class="d-block text-muted" style="font-size: 0.7rem;">STATUS</small>
                    <span class="fw-bold small">Preverjen</span>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-center gap-3 my-3 bg-light py-2 rounded-3 mx-3">
            <div class="text-center">
                <span class="d-block fw-bold fs-5">@Model.AverageRating.ToString("0.0")</span>
                <small class="text-muted" style="font-size: 0.7rem;">OCENA</small>
            </div>
            <div class="vr opacity-25"></div>
            <div class="text-center">
                <span class="d-block fw-bold fs-5">@Model.ReviewCount</span>
                <small class="text-muted" style="font-size: 0.7rem;">MNENJ</small>
            </div>
        </div>
        <div class="d-grid gap-2 px-3">
            <a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill">
                Poglej polni profil
            </a>
            <a href="mailto:@Model.Email" class="btn btn-outline-secondary rounded-pill">
                Pošlji sporočilo
            </a>
        </div>
    </div>
</div>
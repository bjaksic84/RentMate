@model IEnumerable<RentMate.Models.Item>

@{
    ViewData["Title"] = "Ponudba";
}

<div class="bg-light py-5 mb-5 border-bottom">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <h1 class="fw-bold mb-3">Poišči, kar potrebuješ</h1>
                <p class="lead text-muted mb-4">Sposodi si orodje, elektroniko ali športno opremo od sosedov.</p>
                
                <form asp-action="Index" method="get" class="card card-body shadow-sm border-0 p-2">
                    <div class="row g-2">
                        <div class="col-md-5">
                            <input type="text" name="search" class="form-control form-control-lg border-0" 
                                   placeholder="Kaj iščeš? (npr. Vrtalnik)" value="@ViewBag.Search">
                        </div>
                        <div class="col-md-3">
                            <select name="city" class="form-select form-select-lg border-0 bg-light">
                                <option value="">Vsa mesta</option>
                                @if (ViewBag.Cities != null)
                                {
                                    foreach (var c in ViewBag.Cities)
                                    {
                                        if (ViewBag.City == c)
                                        { <option value="@c" selected>@c</option> }
                                        else
                                        { <option value="@c">@c</option> }
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4 d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-search"></i> Išči
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-emoji-frown display-1 text-muted"></i>
                <h3 class="mt-3">Ni zadetkov.</h3>
                <p class="text-muted">Poskusite spremeniti iskalne pogoje.</p>
                <a asp-action="Index" class="btn btn-outline-primary">Prikaži vse</a>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 product-card">
                        <div class="bg-light text-center py-5 rounded-top position-relative" style="min-height: 200px;">
                             @if (!string.IsNullOrEmpty(item.ImageUrl))
                             {
                                 <img src="@item.ImageUrl" class="card-img-top" style="object-fit:cover; height:200px" alt="@item.Title">
                             }
                             else
                             {
                                 <i class="bi bi-box-seam display-4 text-secondary opacity-25"></i>
                             }
                             <div class="position-absolute top-0 end-0 m-2">
                                 <span class="badge bg-white text-dark shadow-sm">
                                     <i class="bi bi-geo-alt-fill text-danger"></i> @item.User?.City
                                 </span>
                             </div>
                        </div>

                        <div class="card-body">
                            <h5 class="card-title fw-bold text-truncate">@item.Title</h5>
                            <p class="card-text text-muted small text-truncate">
                                @(item.Description?.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)
                            </p>
                            
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="h5 mb-0 text-primary fw-bold">€@item.Price <small class="text-muted fs-6">/ dan</small></span>
                                <small class="text-warning">
                                    <i class="bi bi-star-fill"></i> @(item.AverageRating?.ToString("0.0") ?? "-")
                                    <span class="text-muted">(@item.ReviewCount)</span>
                                </small>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0 pb-3">
                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#rentModal-@item.Id">
                                    <i class="bi bi-cart-plus"></i> Izposodi
                                </button>
                                
                                <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">
                                    Več info
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="rentModal-@item.Id" tabindex="-1" aria-labelledby="rentModalLabel-@item.Id" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title" id="rentModalLabel-@item.Id">Izposoja: @item.Title</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <form asp-controller="Rentals" asp-action="RequestRental" method="post">
                                <div class="modal-body">
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    
                                    <p class="text-muted mb-3">Izberite časovno obdobje izposoje:</p>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Začetek izposoje</label>
                                        <input type="date" name="startDate" class="form-control" required 
                                               min="@DateTime.Now.ToString("yyyy-MM-dd")" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Konec izposoje</label>
                                        <input type="date" name="endDate" class="form-control" required 
                                               min="@DateTime.Now.ToString("yyyy-MM-dd")" value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />
                                    </div>
                                    
                                    <div class="alert alert-info py-2 small">
                                        <i class="bi bi-info-circle"></i> Cena na dan: <strong>€@item.Price</strong>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Prekliči</button>
                                    <button type="submit" class="btn btn-success fw-bold">Potrdi in Rezerviraj</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .product-card { transition: transform 0.2s, box-shadow 0.2s; }
    .product-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
</style>
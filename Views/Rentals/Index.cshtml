@model IEnumerable<RentMate.Models.Item>
@using System.Text.Json;

@{
    ViewData["Title"] = "Tržnica";
    
    // Priprava začetnih vrednosti za ceno (če niso nastavljene, damo privzete)
    decimal currentMin = ViewBag.MinPrice ?? 0;
    decimal currentMax = ViewBag.MaxPrice ?? 500; // Privzet max, če ni izbran
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/plugins/confirmDate/confirmDate.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.7.0/nouislider.min.css">

<style>
    /* Stil za inpute nad sliderjem - da izgledajo kot lebdeče številke, a so editabilni */
    .price-input {
        border: 1px solid #dee2e6;
        background: #fff;
        padding: 2px 5px;
        border-radius: 4px;
        width: 70px;
        text-align: center;
        font-weight: bold;
        font-size: 0.9rem;
        color: #0d6efd;
        transition: border-color 0.2s;
    }
    .price-input:focus {
        border-color: #0d6efd;
        outline: none;
        box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.25);
    }
    /* Slider ročke */
    .noUi-connect {
        background: #0d6efd; /* Primary color */
    }
    .noUi-handle {
        border-radius: 50%;
        cursor: grab;
    }
    .noUi-handle:active {
        cursor: grabbing;
    }
</style>

<div class="bg-white border-bottom shadow-sm sticky-top" style="z-index: 900;">
    <div class="container py-3">
        <form asp-action="Index" method="get" id="filterForm">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Iskanje</label>
                    <input type="text" name="search" class="form-control" placeholder="Kaj iščeš?" value="@ViewBag.Search">
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Lokacija</label>
                    <select name="city" class="form-select">
                        <option value="">Vsa mesta</option>
                        @if (ViewBag.Cities != null)
                        {
                            foreach (var c in ViewBag.Cities)
                            {
                                if (ViewBag.City == c) { <option value="@c" selected>@c</option> }
                                else { <option value="@c">@c</option> }
                            }
                        }
                    </select>
                </div>
                
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Od</label>
                    <input type="date" name="startDate" class="form-control" value="@ViewBag.StartDate">
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Do</label>
                    <input type="date" name="endDate" class="form-control" value="@ViewBag.EndDate">
                </div>
                
                <div class="col-md-3 d-grid">
                    <button type="submit" class="btn btn-primary fw-bold">
                        <i class="bi bi-search"></i> Preveri ponudbo
                    </button>
                </div>
            </div>

            <div class="row g-2 mt-3 align-items-center bg-light p-3 rounded mx-0">
                
                <div class="col-md-6 col-12">
                     <label class="form-label small fw-bold text-muted d-block mb-3">Cenovni razpon (€ / dan)</label>
                     
                     <div class="px-2">
                         <div class="d-flex justify-content-between mb-2">
                             <div class="input-group input-group-sm w-auto">
                                 <input type="number" id="input-min" name="minPrice" class="price-input" value="@currentMin">
                             </div>
                             <div class="input-group input-group-sm w-auto">
                                 <input type="number" id="input-max" name="maxPrice" class="price-input" value="@currentMax">
                             </div>
                         </div>
                         
                         <div id="slider-price"></div>
                     </div>
                </div>

                <div class="col-md-3 ms-auto">
                     <label class="form-label small fw-bold text-muted">Razvrščanje</label>
                     <select name="sort" class="form-select border-primary" onchange="this.form.submit()">
                        <option value="">Privzeto</option>
                        @if(ViewBag.Sort == "priceAsc") { <option value="priceAsc" selected>Cena: Najnižja</option> } else { <option value="priceAsc">Cena: Najnižja</option> }
                        @if(ViewBag.Sort == "priceDesc") { <option value="priceDesc" selected>Cena: Najvišja</option> } else { <option value="priceDesc">Cena: Najvišja</option> }
                        @if(ViewBag.Sort == "titleAsc") { <option value="titleAsc" selected>Ime (A-Z)</option> } else { <option value="titleAsc">Ime (A-Z)</option> }
                    </select>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="container py-5">
    @if (!string.IsNullOrEmpty(ViewBag.StartDate))
    {
        <div class="alert alert-info mb-4">
            <i class="bi bi-calendar-check"></i> Prikazujem rezultate, ki so prosti v terminu: <strong>@ViewBag.StartDate</strong> do <strong>@ViewBag.EndDate</strong>
        </div>
    }

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-search display-1 text-muted opacity-25"></i>
                <h3 class="mt-3">Ni najdenih izdelkov.</h3>
                <a asp-action="Index" class="btn btn-outline-primary">Počisti filtre</a>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                // PRIPRAVA BLOKIRANIH DATUMOV (JSON)
                var blockedDates = item.Rentals
                    .Where(r => r.Status == RentMate.Models.RentalStatus.Active || r.Status == RentMate.Models.RentalStatus.Pending)
                    .Select(r => new { from = r.StartDate.ToString("yyyy-MM-dd"), to = r.EndDate.ToString("yyyy-MM-dd") })
                    .ToList();
                
                string jsonBlocked = JsonSerializer.Serialize(blockedDates);

                <div class="col">
                    <div class="card h-100 shadow-sm border-0 product-card">
                        <div class="bg-light text-center py-5 rounded-top position-relative" style="min-height: 200px;">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                var optimizedUrl = item.ImageUrl.Replace("/upload/", "/upload/c_fill,w_500,h_350,q_auto/f_auto/");
                                <img src="@optimizedUrl" class="w-100 h-100" style="object-fit: cover;" alt="@item.Title">
                            }
                            else
                            {
                            <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                <i class="bi bi-box-seam display-1 opacity-25"></i>
                            </div>
                            }
                            @if(item.AverageRating.HasValue) 
                            {
                                <div class="position-absolute bottom-0 end-0 m-2 px-2 py-1 rounded bg-dark bg-opacity-75 text-white shadow-sm" 
                                    style="backdrop-filter: blur(2px);">
                                    <div class="d-flex align-items-center small">
                                        <span class="text-warning me-1">
                                            @for(int i=0; i < Math.Round(item.AverageRating.Value); i++) { <span>★</span> }
                                        </span>
                                        <span class="fw-bold">@item.AverageRating?.ToString("0.0")</span>
                                    </div>
                                </div>
                            }
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge bg-white text-dark shadow-sm">
                                    <i class="bi bi-geo-alt-fill text-danger"></i> @item.User?.City
                                </span>
                            </div>
                        </div>

                        <div class="card-body">
                            <h5 class="card-title fw-bold text-truncate">@item.Title</h5>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="h5 mb-0 text-primary fw-bold">
                                    @item.Price?.ToString("C2", new System.Globalization.CultureInfo("de-DE")) 
                                    <small class="text-muted fs-6">/ dan</small>
                                </span>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0 pb-3">
                            <div class="d-grid gap-2">
                                @if (User.Identity != null && User.Identity.IsAuthenticated)
                                {
                                    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#rentModal-@item.Id">
                                        <i class="bi bi-calendar-plus"></i> Rezerviraj
                                    </button>
                                }
                                else
                                {
                                    <a href="/Identity/Account/Login" class="btn btn-secondary">
                                        <i class="bi bi-lock"></i> Prijavi se za najem
                                    </a>
                                }
                                <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">
                                    Več info
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="rentModal-@item.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title">Rezervacija: @item.Title</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <form asp-controller="Rentals" asp-action="RequestRental" method="post">
                                <div class="modal-body">
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Izberite termin</label>
                                        <input type="text" class="form-control rent-daterange-picker" 
                                               placeholder="Klikni za izbiro datuma..."
                                               data-blocked='@jsonBlocked' required />
                                        <input type="hidden" name="startDate" class="start-date-input" value="@ViewBag.StartDate" />
                                        <input type="hidden" name="endDate" class="end-date-input" value="@ViewBag.EndDate" />
                                    </div>
                                    <div class="alert alert-light border small text-muted">
                                        <i class="bi bi-info-circle"></i> Sivi datumi so že zasedeni.
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Prekliči</button>
                                    <button type="submit" class="btn btn-success fw-bold">Potrdi</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .product-card { transition: transform 0.2s; }
    .product-card:hover { transform: translateY(-5px); box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
</style>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.7.0/nouislider.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        
        // --- 1. CONFIGURATION FOR PRICE SLIDER ---
        var slider = document.getElementById('slider-price');
        var inputMin = document.getElementById('input-min');
        var inputMax = document.getElementById('input-max');

        // Preberi začetne vrednosti iz inputov (ki so prišli iz serverja)
        var startMin = parseInt(inputMin.value) || 0;
        var startMax = parseInt(inputMax.value) || 500;

        noUiSlider.create(slider, {
            start: [startMin, startMax], // Dve ročki
            connect: true, // Obarvaj sredino
            range: {
                'min': 0,
                'max': 1000 // Nastavi primerno max vrednost za tvojo trgovino
            },
            step: 5, // Korak po 5 eur
            tooltips: false, // Ne rabimo tooltipov, ker imamo inpute zgoraj
            format: {
                to: function (value) { return Math.round(value); },
                from: function (value) { return Number(value); }
            }
        });

        // Ko se premakne slider -> posodobi input polja
        slider.noUiSlider.on('update', function (values, handle) {
            var value = values[handle];
            if (handle === 0) {
                inputMin.value = value;
            } else {
                inputMax.value = value;
            }
        });

        // Ko uporabnik ročno vpiše v input -> posodobi slider
        inputMin.addEventListener('change', function () {
            slider.noUiSlider.set([this.value, null]);
        });
        inputMax.addEventListener('change', function () {
            slider.noUiSlider.set([null, this.value]);
        });


        // --- 2. CONFIGURATION FOR FLATPICKR (DATEPICKER) ---
        var pickers = document.querySelectorAll(".rent-daterange-picker");
        pickers.forEach(function (element) {
            var blockedDatesJson = element.getAttribute("data-blocked");
            var blockedDates = JSON.parse(blockedDatesJson);
            var form = element.closest("form");
            var startDateInput = form.querySelector(".start-date-input");
            var endDateInput = form.querySelector(".end-date-input");
            var defaultDate = [];
            if(startDateInput.value && endDateInput.value) {
                defaultDate = [startDateInput.value, endDateInput.value];
            }

            flatpickr(element, {
                mode: "range",
                dateFormat: "Y-m-d",
                minDate: "today",
                defaultDate: defaultDate,
                disable: blockedDates,
                locale: { firstDayOfWeek: 1 },
                onChange: function(selectedDates, dateStr, instance) {
                    if (selectedDates.length === 2) {
                        startDateInput.value = instance.formatDate(selectedDates[0], "Y-m-d");
                        endDateInput.value = instance.formatDate(selectedDates[1], "Y-m-d");
                    }
                }
            });
        });
    });
</script>
@model string
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@if (!String.IsNullOrEmpty(Model))
{
    var isError = Model.StartsWith("Error");
    <div class="@(isError ? "p-4 bg-red-50 border border-red-200 rounded-xl text-red-700" : "p-4 bg-green-50 border border-green-200 rounded-xl text-green-700") flex items-center gap-3 mb-4" role="alert">
        <i class="bi @(isError ? "bi-x-circle" : "bi-check-circle") text-lg"></i>
        <span>@Model</span>
    </div>
}
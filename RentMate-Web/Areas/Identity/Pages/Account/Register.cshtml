@page
@model RegisterModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Registration"];
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-lg p-8">
            
            <div class="text-center mb-8">
                <h2 class="font-heading text-2xl font-bold text-slate-900">@Localizer["Create account"]</h2>
                <p class="text-slate-500 mt-2 text-sm">@Localizer["The password must be safe and strong."]</p>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="space-y-5">
                <div asp-validation-summary="ModelOnly" class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-700" role="alert"></div>

                <div>
                    <label asp-for="Input.Email" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Email address"]</label>
                    <input asp-for="Input.Email" class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="Input.Password" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Password"]</label>
                    <input asp-for="Input.Password" 
                           id="passwordInput"
                           type="password"
                           class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" 
                           placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-sm text-red-600"></span>
                </div>

                <div class="space-y-2">
                    <div class="flex justify-between items-center">
                        <span id="strength-text" class="text-sm font-medium text-slate-500">@Localizer["Enter password"]</span>
                        <span id="strength-percent" class="text-sm text-slate-500">0%</span>
                    </div>
                    <div class="flex gap-2 h-2">
                        <div class="strength-segment flex-1 rounded-full bg-slate-200 transition-all duration-300"></div>
                        <div class="strength-segment flex-1 rounded-full bg-slate-200 transition-all duration-300"></div>
                        <div class="strength-segment flex-1 rounded-full bg-slate-200 transition-all duration-300"></div>
                        <div class="strength-segment flex-1 rounded-full bg-slate-200 transition-all duration-300"></div>
                        <div class="strength-segment flex-1 rounded-full bg-slate-200 transition-all duration-300"></div>
                    </div>
                </div>

                <div class="p-4 bg-slate-50 rounded-xl border border-slate-200">
                    <ul class="space-y-2 text-sm">
                        <li id="req-length" class="flex items-center gap-2 text-slate-500"><i class="bi bi-circle text-xs"></i>@Localizer["At least 8 characters"]</li>
                        <li id="req-upper" class="flex items-center gap-2 text-slate-500"><i class="bi bi-circle text-xs"></i>@Localizer["At least one uppercase letter"]</li>
                        <li id="req-lower" class="flex items-center gap-2 text-slate-500"><i class="bi bi-circle text-xs"></i>@Localizer["At least one lowercase letter"]</li>
                        <li id="req-number" class="flex items-center gap-2 text-slate-500"><i class="bi bi-circle text-xs"></i>@Localizer["At least one number"]</li>
                        <li id="req-special" class="flex items-center gap-2 text-slate-500"><i class="bi bi-circle text-xs"></i>@Localizer["At least one special character (!?#$)"]</li>
                    </ul>
                </div>

                <div>
                    <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Confirm password"]</label>
                    <input asp-for="Input.ConfirmPassword" class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" placeholder="••••••••" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-sm text-red-600"></span>
                </div>

                <button id="registerSubmit" type="submit" class="w-full px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors">
                    @Localizer["Register"]
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const passwordInput = document.getElementById('passwordInput');
        const segments = document.querySelectorAll('.strength-segment');
        const strengthText = document.getElementById('strength-text');
        const strengthPercent = document.getElementById('strength-percent');

        const translations = {
            enter: "@Localizer["Enter password"]",
            veryWeak: "@Localizer["Very weak"]",
            weak: "@Localizer["Weak"]",
            medium: "@Localizer["Medium strong"]",
            strong: "@Localizer["Strong password"]"
        };

        const reqs = {
            length: document.getElementById('req-length'),
            upper: document.getElementById('req-upper'),
            lower: document.getElementById('req-lower'),
            number: document.getElementById('req-number'),
            special: document.getElementById('req-special')
        };

        passwordInput.addEventListener('input', function () {
            const val = passwordInput.value;
            let score = 0;

            const checks = {
                length: val.length >= 8,
                upper: /[A-Z]/.test(val),
                lower: /[a-z]/.test(val),
                number: /[0-9]/.test(val),
                special: /[^A-Za-z0-9]/.test(val)
            };

            Object.keys(checks).forEach(key => {
                updateRequirement(reqs[key], checks[key]);
                if (checks[key]) score++;
            });

            updateStrengthBar(score);
        });

        function updateRequirement(element, isValid) {
            const icon = element.querySelector('i');
            if (isValid) {
                element.classList.remove('text-slate-500');
                element.classList.add('text-green-600');
                icon.classList.remove('bi-circle');
                icon.classList.add('bi-check-circle-fill');
            } else {
                element.classList.remove('text-green-600');
                element.classList.add('text-slate-500');
                icon.classList.remove('bi-check-circle-fill');
                icon.classList.add('bi-circle');
            }
        }

        function updateStrengthBar(score) {
            segments.forEach(s => s.className = 'strength-segment flex-1 rounded-full bg-slate-200 transition-all duration-300');

            const val = passwordInput.value;
            if (val.length === 0) {
                strengthText.innerText = translations.enter;
                strengthText.className = 'text-sm font-medium text-slate-500';
                strengthPercent.innerText = "0%";
                return;
            }

            const config = {
                0: { bgClass: 'bg-red-500', textClass: 'text-red-600', text: translations.veryWeak, count: 1 },
                1: { bgClass: 'bg-red-500', textClass: 'text-red-600', text: translations.veryWeak, count: 1 },
                2: { bgClass: 'bg-orange-500', textClass: 'text-orange-600', text: translations.weak, count: 2 },
                3: { bgClass: 'bg-yellow-500', textClass: 'text-yellow-600', text: translations.medium, count: 3 },
                4: { bgClass: 'bg-yellow-500', textClass: 'text-yellow-600', text: translations.medium, count: 4 },
                5: { bgClass: 'bg-green-500', textClass: 'text-green-600', text: translations.strong, count: 5 }
            };

            const current = config[score];
            strengthText.innerText = current.text;
            strengthText.className = 'text-sm font-medium ' + current.textClass;
            strengthPercent.innerText = (score * 20) + "%";

            for (let i = 0; i < current.count; i++) {
                segments[i].className = 'strength-segment flex-1 rounded-full transition-all duration-300 ' + current.bgClass;
            }
        }
    </script>
}
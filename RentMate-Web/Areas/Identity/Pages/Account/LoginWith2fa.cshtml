@page
@model LoginWith2faModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Two-factor authentication"];
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-lg p-8">
            
            <div class="text-center mb-8">
                <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="bi bi-shield-lock text-2xl text-blue-600"></i>
                </div>
                <h1 class="font-heading text-2xl font-bold text-slate-900">@ViewData["Title"]</h1>
                <p class="text-slate-500 mt-2 text-sm">@Localizer["Your login is protected with an authenticator app. Enter your authenticator code below."]</p>
            </div>

            <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="space-y-5">
                <input asp-for="RememberMe" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-700" role="alert"></div>
                
                <div>
                    <label asp-for="Input.TwoFactorCode" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Authenticator code"]</label>
                    <input asp-for="Input.TwoFactorCode" class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" autocomplete="off" />
                    <span asp-validation-for="Input.TwoFactorCode" class="text-sm text-red-600"></span>
                </div>
                
                <div class="flex items-center">
                    <input asp-for="Input.RememberMachine" class="w-4 h-4 text-blue-600 border-slate-300 rounded focus:ring-blue-500" />
                    <label asp-for="Input.RememberMachine" class="ml-2 text-sm text-slate-600">
                        @Localizer["Remember this machine"]
                    </label>
                </div>
                
                <button type="submit" class="w-full px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors">
                    @Localizer["Log in"]
                </button>
            </form>
            
            <p class="mt-6 text-center text-sm text-slate-500">
                @Localizer["Don't have access to your authenticator device? You can"]
                <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="text-blue-600 hover:text-blue-700 hover:underline">@Localizer["log in with a recovery code"]</a>.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
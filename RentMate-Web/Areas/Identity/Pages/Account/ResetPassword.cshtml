@page
@model ResetPasswordModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Reset password"];
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-lg p-8">
            
            <div class="text-center mb-8">
                <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="bi bi-key text-2xl text-blue-600"></i>
                </div>
                <h1 class="font-heading text-2xl font-bold text-slate-900">@ViewData["Title"]</h1>
                <p class="text-slate-500 mt-2 text-sm">@Localizer["Reset your password."]</p>
            </div>

            <form method="post" class="space-y-5">
                <div asp-validation-summary="ModelOnly" class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-700" role="alert"></div>
                <input asp-for="Input.Code" type="hidden" />
                
                <div>
                    <label asp-for="Input.Email" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Email"]</label>
                    <input asp-for="Input.Email" class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-sm text-red-600"></span>
                </div>
                
                <div>
                    <label asp-for="Input.Password" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Password"]</label>
                    <input asp-for="Input.Password" class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-sm text-red-600"></span>
                </div>
                
                <div>
                    <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Confirm password"]</label>
                    <input asp-for="Input.ConfirmPassword" class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-sm text-red-600"></span>
                </div>
                
                <button type="submit" class="w-full px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors">
                    @Localizer["Reset"]
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@page
@model LoginModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Log in"];
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-lg p-8">
            
            <div class="text-center mb-8">
                <h2 class="font-heading text-2xl font-bold text-slate-900">@ViewData["Title"]</h2>
                <p class="text-slate-500 mt-2">@Localizer["Use a local account to log in."]</p>
            </div>

            <form id="account" method="post" class="space-y-5">
                <div asp-validation-summary="ModelOnly" class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-700" role="alert"></div>

                <div>
                    <label asp-for="Input.Email" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Email"]</label>
                    <input asp-for="Input.Email" 
                           class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" 
                           autocomplete="username" 
                           aria-required="true" 
                           placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-sm text-red-600"></span>
                </div>

                <div>
                    <label asp-for="Input.Password" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Password"]</label>
                    <input asp-for="Input.Password" 
                           class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" 
                           autocomplete="current-password" 
                           aria-required="true" 
                           placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-sm text-red-600"></span>
                </div>

                <div class="flex items-center">
                    <input asp-for="Input.RememberMe" class="w-4 h-4 text-blue-600 border-slate-300 rounded focus:ring-blue-500" />
                    <label asp-for="Input.RememberMe" class="ml-2 text-sm text-slate-600">
                        @Localizer["Remember me?"]
                    </label>
                </div>

                <button id="login-submit" type="submit" class="w-full px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors">
                    @Localizer["Log in"]
                </button>

                <div class="text-center text-sm space-y-2">
                    <p><a id="forgot-password" asp-page="./ForgotPassword" class="text-blue-600 hover:text-blue-700 hover:underline">@Localizer["Forgot your password?"]</a></p>
                    <p><a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-blue-600 hover:text-blue-700 hover:underline">@Localizer["Register as a new user"]</a></p>
                    <p><a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-blue-600 hover:text-blue-700 hover:underline">@Localizer["Resend email confirmation"]</a></p>
                </div>
            </form>

            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <hr class="my-6 border-slate-200" />
                <div class="text-center">
                    <p class="text-slate-500 text-sm mb-4">@Localizer["Or sign in with"]</p>
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="space-y-2">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="w-full px-4 py-2.5 border border-slate-300 text-slate-700 hover:bg-slate-50 font-medium rounded-xl transition-colors" name="provider" value="@provider.Name" title="@string.Format(Localizer["Log in using your {0} account"].Value, provider.DisplayName)">
                                <i class="bi bi-box-arrow-in-right mr-2"></i> @provider.DisplayName
                            </button>
                        }
                    </form>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .min-vh-100 {
        min-height: 80vh !important;
    }

    .form-floating .form-control::placeholder {
        color: transparent; 
    }
    
    .form-floating .form-control:focus::placeholder {
        color: #a0a0a0;
    }

    .card {
        border-color: #f0f0f0;
    }
</style>
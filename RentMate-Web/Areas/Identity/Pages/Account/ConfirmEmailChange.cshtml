@page
@model ConfirmEmailChangeModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Confirm email change"];
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-lg p-8 text-center">
            <div class="w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <i class="bi bi-envelope-check text-4xl text-blue-600"></i>
            </div>
            <h1 class="font-heading text-2xl font-bold text-slate-900 mb-4">@ViewData["Title"]</h1>
            <partial name="_StatusMessage" model="Model.StatusMessage" />
            <a href="/" class="inline-flex items-center gap-2 mt-6 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors">
                <i class="bi bi-house"></i> @Localizer["Back to Home"]
            </a>
        </div>
    </div>
</div>
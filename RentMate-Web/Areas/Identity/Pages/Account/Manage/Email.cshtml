@page
@using Microsoft.AspNetCore.Mvc.Localization
@model EmailModel
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Email"];
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="space-y-6">
    <!-- Page Header -->
    <div class="border-b border-slate-200 pb-4">
        <h2 class="font-heading text-xl font-bold text-slate-900">@Localizer["Email Settings"]</h2>
        <p class="text-sm text-slate-500 mt-1">@Localizer["Manage your email address and verification status"]</p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="email-form" method="post" class="space-y-6">
        <div asp-validation-summary="All" class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm" role="alert"></div>
        
        <!-- Current Email -->
        <div>
            <label asp-for="Email" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Current Email"]</label>
            <div class="flex items-center gap-3">
                <div class="flex-1 relative">
                    <input asp-for="Email" class="w-full px-4 py-3 bg-slate-100 border border-slate-200 rounded-xl text-slate-500 cursor-not-allowed pr-12" disabled />
                    @if (Model.IsEmailConfirmed)
                    {
                        <div class="absolute right-3 top-1/2 -translate-y-1/2 flex items-center gap-1 text-green-600">
                            <i class="bi bi-check-circle-fill"></i>
                            <span class="text-xs font-medium">@Localizer["Verified"]</span>
                        </div>
                    }
                    else
                    {
                        <div class="absolute right-3 top-1/2 -translate-y-1/2 flex items-center gap-1 text-amber-600">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span class="text-xs font-medium">@Localizer["Unverified"]</span>
                        </div>
                    }
                </div>
            </div>
            @if (!Model.IsEmailConfirmed)
            {
                <div class="mt-3 p-4 bg-amber-50 border border-amber-200 rounded-xl">
                    <div class="flex items-start gap-3">
                        <i class="bi bi-envelope-exclamation text-amber-600 text-xl mt-0.5"></i>
                        <div>
                            <p class="text-sm text-amber-800 font-medium">@Localizer["Your email is not verified"]</p>
                            <p class="text-xs text-amber-600 mt-1">@Localizer["Please verify your email to access all features"]</p>
                            <button type="submit" asp-page-handler="SendVerificationEmail" class="mt-2 text-sm font-medium text-amber-700 hover:text-amber-800 underline">
                                @Localizer["Send verification email"]
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Change Email Section -->
        <div class="pt-4 border-t border-slate-200">
            <h3 class="text-lg font-semibold text-slate-900 mb-4">@Localizer["Change Email Address"]</h3>
            <div>
                <label asp-for="Input.NewEmail" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["New Email"]</label>
                <input asp-for="Input.NewEmail" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all" autocomplete="email" aria-required="true" placeholder="@Localizer["Enter your new email address"]" />
                <span asp-validation-for="Input.NewEmail" class="text-red-500 text-sm"></span>
            </div>
        </div>

        <!-- Submit Button -->
        <div class="flex justify-end pt-4 border-t border-slate-200">
            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-semibold rounded-xl shadow-sm transition-all">
                <i class="bi bi-envelope-check"></i>
                @Localizer["Change Email"]
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@using Microsoft.AspNetCore.Mvc.Localization
@model PersonalDataModel
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Personal Data"];
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="space-y-6">
    <!-- Page Header -->
    <div class="border-b border-slate-200 pb-4">
        <h2 class="font-heading text-xl font-bold text-slate-900">@Localizer["Personal Data"]</h2>
        <p class="text-sm text-slate-500 mt-1">@Localizer["Download or delete your personal data"]</p>
    </div>

    <!-- Info Box -->
    <div class="p-4 bg-blue-50 border border-blue-200 rounded-xl">
        <div class="flex items-start gap-3">
            <i class="bi bi-info-circle-fill text-blue-600 text-xl mt-0.5"></i>
            <div>
                <p class="text-sm text-blue-800">@Localizer["Your account contains personal data that you have provided to us. This page allows you to download or delete that data."]</p>
            </div>
        </div>
    </div>

    <!-- Download Section -->
    <div class="p-6 bg-white border border-slate-200 rounded-xl">
        <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center flex-shrink-0">
                <i class="bi bi-download text-green-600 text-xl"></i>
            </div>
            <div class="flex-1">
                <h3 class="font-semibold text-slate-900">@Localizer["Download Your Data"]</h3>
                <p class="text-sm text-slate-500 mt-1">@Localizer["Download a copy of all your personal data in JSON format."]</p>
                <form id="download-data" asp-page="DownloadPersonalData" method="post" class="mt-4">
                    <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 bg-green-600 hover:bg-green-700 text-white font-medium rounded-xl transition-colors">
                        <i class="bi bi-download"></i>
                        @Localizer["Download Data"]
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Delete Section -->
    <div class="p-6 bg-red-50 border border-red-200 rounded-xl">
        <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center flex-shrink-0">
                <i class="bi bi-trash3 text-red-600 text-xl"></i>
            </div>
            <div class="flex-1">
                <h3 class="font-semibold text-red-800">@Localizer["Delete Your Account"]</h3>
                <p class="text-sm text-red-600 mt-1">@Localizer["Permanently delete your account and all associated data. This action cannot be undone."]</p>
                <div class="mt-4 p-3 bg-red-100 rounded-lg">
                    <p class="text-xs text-red-700 font-medium">
                        <i class="bi bi-exclamation-triangle-fill mr-1"></i>
                        @Localizer["Warning: Deleting your account will permanently remove all your items, rentals, reviews, and personal information."]
                    </p>
                </div>
                <a asp-page="DeletePersonalData" class="mt-4 inline-flex items-center gap-2 px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white font-medium rounded-xl transition-colors">
                    <i class="bi bi-trash3"></i>
                    @Localizer["Delete Account"]
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

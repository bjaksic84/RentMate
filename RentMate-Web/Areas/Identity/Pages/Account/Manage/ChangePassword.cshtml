@page
@using Microsoft.AspNetCore.Mvc.Localization
@model ChangePasswordModel
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Password"];
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="space-y-6">
    <!-- Page Header -->
    <div class="border-b border-slate-200 pb-4">
        <h2 class="font-heading text-xl font-bold text-slate-900">@Localizer["Change Password"]</h2>
        <p class="text-sm text-slate-500 mt-1">@Localizer["Update your password to keep your account secure"]</p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="change-password-form" method="post" class="space-y-6 max-w-md">
        <div asp-validation-summary="ModelOnly" class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm" role="alert"></div>
        
        <!-- Current Password -->
        <div>
            <label asp-for="Input.OldPassword" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Current Password"]</label>
            <div class="relative">
                <input asp-for="Input.OldPassword" type="password" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all pr-12" autocomplete="current-password" aria-required="true" placeholder="@Localizer["Enter your current password"]" />
                <button type="button" onclick="togglePassword(this, 'Input_OldPassword')" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Input.OldPassword" class="text-red-500 text-sm"></span>
        </div>

        <!-- New Password -->
        <div>
            <label asp-for="Input.NewPassword" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["New Password"]</label>
            <div class="relative">
                <input asp-for="Input.NewPassword" type="password" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all pr-12" autocomplete="new-password" aria-required="true" placeholder="@Localizer["Enter your new password"]" />
                <button type="button" onclick="togglePassword(this, 'Input_NewPassword')" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Input.NewPassword" class="text-red-500 text-sm"></span>
        </div>

        <!-- Confirm Password -->
        <div>
            <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Confirm New Password"]</label>
            <div class="relative">
                <input asp-for="Input.ConfirmPassword" type="password" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all pr-12" autocomplete="new-password" aria-required="true" placeholder="@Localizer["Confirm your new password"]" />
                <button type="button" onclick="togglePassword(this, 'Input_ConfirmPassword')" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="text-red-500 text-sm"></span>
        </div>

        <!-- Submit Button -->
        <div class="flex justify-end pt-4 border-t border-slate-200">
            <button type="submit" class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-semibold rounded-xl shadow-sm transition-all">
                <i class="bi bi-key"></i>
                @Localizer["Update Password"]
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(button, inputId) {
            const input = document.getElementById(inputId);
            const icon = button.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
}

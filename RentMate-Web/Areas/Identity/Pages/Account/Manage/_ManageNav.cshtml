@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<nav class="p-2 space-y-1">
    <a asp-page="./Index" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all @(ManageNavPages.IndexNavClass(ViewContext) == "active" ? "bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700/50 hover:text-slate-900 dark:hover:text-slate-100")">
        <i class="bi bi-person text-lg"></i>
        @Localizer["Profile"]
    </a>
    <a asp-page="./Security" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all @(ManageNavPages.SecurityNavClass(ViewContext) == "active" ? "bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700/50 hover:text-slate-900 dark:hover:text-slate-100")">
        <i class="bi bi-shield-lock text-lg"></i>
        @Localizer["Security"]
    </a>
    <a asp-page="./PaymentMethods" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all @(ManageNavPages.PaymentMethodsNavClass(ViewContext) == "active" ? "bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300" : "text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700/50 hover:text-slate-900 dark:hover:text-slate-100")">
        <i class="bi bi-credit-card text-lg"></i>
        @Localizer["Payment Methods"]
    </a>
</nav>

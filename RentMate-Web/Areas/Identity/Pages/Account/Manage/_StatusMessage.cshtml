@model string

@if (!String.IsNullOrEmpty(Model))
{
    var isError = Model.StartsWith("Error");
    <div class="mb-4 p-4 rounded-xl flex items-center gap-3 @(isError ? "bg-red-50 border border-red-200" : "bg-green-50 border border-green-200")" role="alert">
        <i class="bi @(isError ? "bi-exclamation-triangle-fill text-red-600" : "bi-check-circle-fill text-green-600") text-xl"></i>
        <span class="@(isError ? "text-red-800" : "text-green-800") flex-1">@Model</span>
        <button type="button" onclick="this.parentElement.remove()" class="@(isError ? "text-red-600 hover:text-red-800" : "text-green-600 hover:text-green-800")">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
}

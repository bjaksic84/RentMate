@page
@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Mvc.Localization
@model TwoFactorAuthenticationModel
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Two-factor authentication"];
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="space-y-6">
    <!-- Page Header -->
    <div class="border-b border-slate-200 pb-4">
        <h2 class="font-heading text-xl font-bold text-slate-900">@Localizer["Two-Factor Authentication (2FA)"]</h2>
        <p class="text-sm text-slate-500 mt-1">@Localizer["Add an extra layer of security to your account"]</p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    @{
        var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
        if (consentFeature?.CanTrack ?? true)
        {
            <!-- 2FA Status -->
            <div class="p-4 rounded-xl border @(Model.Is2faEnabled ? "bg-green-50 border-green-200" : "bg-slate-50 border-slate-200")">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-xl flex items-center justify-center @(Model.Is2faEnabled ? "bg-green-100" : "bg-slate-200")">
                        <i class="bi @(Model.Is2faEnabled ? "bi-shield-check text-green-600" : "bi-shield text-slate-400") text-xl"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold @(Model.Is2faEnabled ? "text-green-800" : "text-slate-700")">
                            @(Model.Is2faEnabled ? Localizer["2FA is enabled"] : Localizer["2FA is not enabled"])
                        </h3>
                        <p class="text-sm @(Model.Is2faEnabled ? "text-green-600" : "text-slate-500")">
                            @(Model.Is2faEnabled ? Localizer["Your account has an additional layer of security"] : Localizer["Enable 2FA to better protect your account"])
                        </p>
                    </div>
                </div>
            </div>

            if (Model.Is2faEnabled)
            {
                <!-- Recovery Codes Warning -->
                if (Model.RecoveryCodesLeft == 0)
                {
                    <div class="p-4 bg-red-50 border border-red-200 rounded-xl">
                        <div class="flex items-start gap-3">
                            <i class="bi bi-exclamation-triangle-fill text-red-600 text-xl mt-0.5"></i>
                            <div>
                                <p class="font-semibold text-red-800">@Localizer["You have no recovery codes left"]</p>
                                <p class="text-sm text-red-600 mt-1">@Localizer["You must generate a new set of recovery codes before you can log in with a recovery code."]</p>
                                <a asp-page="./GenerateRecoveryCodes" class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-red-700 hover:text-red-800">
                                    @Localizer["Generate new codes"] <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else if (Model.RecoveryCodesLeft == 1)
                {
                    <div class="p-4 bg-red-50 border border-red-200 rounded-xl">
                        <div class="flex items-start gap-3">
                            <i class="bi bi-exclamation-triangle-fill text-red-600 text-xl mt-0.5"></i>
                            <div>
                                <p class="font-semibold text-red-800">@Localizer["You have 1 recovery code left"]</p>
                                <p class="text-sm text-red-600 mt-1">@Localizer["You should generate a new set of recovery codes."]</p>
                                <a asp-page="./GenerateRecoveryCodes" class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-red-700 hover:text-red-800">
                                    @Localizer["Generate new codes"] <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else if (Model.RecoveryCodesLeft <= 3)
                {
                    <div class="p-4 bg-amber-50 border border-amber-200 rounded-xl">
                        <div class="flex items-start gap-3">
                            <i class="bi bi-exclamation-circle-fill text-amber-600 text-xl mt-0.5"></i>
                            <div>
                                <p class="font-semibold text-amber-800">@Localizer["You have {0} recovery codes left", Model.RecoveryCodesLeft]</p>
                                <p class="text-sm text-amber-600 mt-1">@Localizer["Consider generating a new set of recovery codes."]</p>
                                <a asp-page="./GenerateRecoveryCodes" class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-amber-700 hover:text-amber-800">
                                    @Localizer["Generate new codes"] <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }

                <!-- Actions for enabled 2FA -->
                <div class="flex flex-wrap gap-3">
                    @if (Model.IsMachineRemembered)
                    {
                        <form method="post">
                            <button type="submit" class="inline-flex items-center gap-2 px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-xl transition-colors">
                                <i class="bi bi-laptop"></i>
                                @Localizer["Forget this browser"]
                            </button>
                        </form>
                    }
                    <a asp-page="./Disable2fa" class="inline-flex items-center gap-2 px-4 py-2.5 bg-red-100 hover:bg-red-200 text-red-700 font-medium rounded-xl transition-colors">
                        <i class="bi bi-shield-x"></i>
                        @Localizer["Disable 2FA"]
                    </a>
                    <a asp-page="./GenerateRecoveryCodes" class="inline-flex items-center gap-2 px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-xl transition-colors">
                        <i class="bi bi-key"></i>
                        @Localizer["Reset recovery codes"]
                    </a>
                </div>
            }

            <!-- Authenticator App Section -->
            <div class="pt-4 border-t border-slate-200">
                <h3 class="text-lg font-semibold text-slate-900 mb-4">@Localizer["Authenticator App"]</h3>
                <p class="text-sm text-slate-500 mb-4">@Localizer["Use an authenticator app like Google Authenticator or Microsoft Authenticator to generate verification codes."]</p>
                <div class="flex flex-wrap gap-3">
                    @if (!Model.HasAuthenticator)
                    {
                        <a asp-page="./EnableAuthenticator" class="inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-semibold rounded-xl shadow-sm transition-all">
                            <i class="bi bi-plus-lg"></i>
                            @Localizer["Add authenticator app"]
                        </a>
                    }
                    else
                    {
                        <a asp-page="./EnableAuthenticator" class="inline-flex items-center gap-2 px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-xl transition-colors">
                            <i class="bi bi-gear"></i>
                            @Localizer["Configure authenticator app"]
                        </a>
                        <a asp-page="./ResetAuthenticator" class="inline-flex items-center gap-2 px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-xl transition-colors">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            @Localizer["Reset authenticator app"]
                        </a>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="p-4 bg-red-50 border border-red-200 rounded-xl">
                <div class="flex items-start gap-3">
                    <i class="bi bi-shield-exclamation text-red-600 text-xl mt-0.5"></i>
                    <div>
                        <p class="font-semibold text-red-800">@Localizer["Privacy and cookie policy have not been accepted"]</p>
                        <p class="text-sm text-red-600 mt-1">@Localizer["You must accept the policy before you can enable two factor authentication."]</p>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

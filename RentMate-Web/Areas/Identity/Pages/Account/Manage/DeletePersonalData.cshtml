@page
@using Microsoft.AspNetCore.Mvc.Localization
@model DeletePersonalDataModel
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Delete Account"];
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="space-y-6">
    <!-- Page Header -->
    <div class="border-b border-slate-200 pb-4">
        <h2 class="font-heading text-xl font-bold text-slate-900">@Localizer["Delete Account"]</h2>
        <p class="text-sm text-slate-500 mt-1">@Localizer["Permanently delete your account and all data"]</p>
    </div>

    <!-- Warning Box -->
    <div class="p-4 bg-red-50 border border-red-200 rounded-xl" role="alert">
        <div class="flex items-start gap-3">
            <i class="bi bi-exclamation-triangle-fill text-red-600 text-2xl mt-0.5"></i>
            <div>
                <p class="font-semibold text-red-800">@Localizer["This action is permanent and cannot be undone"]</p>
                <p class="text-sm text-red-600 mt-1">@Localizer["Deleting your account will permanently remove all your personal data, items, rentals, and reviews. You will not be able to recover this information."]</p>
            </div>
        </div>
    </div>

    <form id="delete-user" method="post" class="space-y-6 max-w-md">
        <div asp-validation-summary="ModelOnly" class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm" role="alert"></div>
        
        @if (Model.RequirePassword)
        {
            <div>
                <label asp-for="Input.Password" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Confirm your password"]</label>
                <div class="relative">
                    <input asp-for="Input.Password" type="password" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all" autocomplete="current-password" aria-required="true" placeholder="@Localizer["Enter your password to confirm"]" />
                </div>
                <span asp-validation-for="Input.Password" class="text-red-500 text-sm"></span>
            </div>
        }

        <div class="flex items-center gap-4 pt-4 border-t border-slate-200">
            <a asp-page="./PersonalData" class="px-5 py-3 text-slate-600 hover:text-slate-800 font-medium">
                @Localizer["Cancel"]
            </a>
            <button type="submit" class="inline-flex items-center gap-2 px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-xl shadow-sm transition-all">
                <i class="bi bi-trash3"></i>
                @Localizer["Delete My Account"]
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@using Microsoft.AspNetCore.Mvc.Localization
@model EnableAuthenticatorModel
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Configure Authenticator"];
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="space-y-6">
    <!-- Page Header -->
    <div class="border-b border-slate-200 pb-4">
        <h2 class="font-heading text-xl font-bold text-slate-900">@Localizer["Configure Authenticator App"]</h2>
        <p class="text-sm text-slate-500 mt-1">@Localizer["Set up two-factor authentication using an authenticator app"]</p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <!-- Step 1 -->
    <div class="p-5 bg-slate-50 border border-slate-200 rounded-xl">
        <div class="flex items-start gap-4">
            <div class="w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">1</div>
            <div>
                <h3 class="font-semibold text-slate-900">@Localizer["Download an Authenticator App"]</h3>
                <p class="text-sm text-slate-600 mt-1">@Localizer["Download a two-factor authenticator app like:"]</p>
                <div class="flex flex-wrap gap-4 mt-3">
                    <div class="flex items-center gap-2 text-sm">
                        <i class="bi bi-microsoft text-blue-600"></i>
                        <span class="font-medium">Microsoft Authenticator:</span>
                        <a href="https://go.microsoft.com/fwlink/?Linkid=825072" class="text-blue-600 hover:underline">Android</a> |
                        <a href="https://go.microsoft.com/fwlink/?Linkid=825073" class="text-blue-600 hover:underline">iOS</a>
                    </div>
                    <div class="flex items-center gap-2 text-sm">
                        <i class="bi bi-google text-red-500"></i>
                        <span class="font-medium">Google Authenticator:</span>
                        <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en" class="text-blue-600 hover:underline">Android</a> |
                        <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8" class="text-blue-600 hover:underline">iOS</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Step 2 -->
    <div class="p-5 bg-slate-50 border border-slate-200 rounded-xl">
        <div class="flex items-start gap-4">
            <div class="w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">2</div>
            <div class="flex-1">
                <h3 class="font-semibold text-slate-900">@Localizer["Scan QR Code or Enter Key"]</h3>
                <p class="text-sm text-slate-600 mt-1">@Localizer["Scan the QR Code below or enter this key into your authenticator app:"]</p>
                <div class="mt-3 p-3 bg-white border border-slate-200 rounded-lg inline-block">
                    <code class="text-sm font-mono text-slate-800">@Model.SharedKey</code>
                </div>
                <p class="text-xs text-slate-500 mt-2">@Localizer["Spaces and casing do not matter."]</p>
                <div class="mt-4 p-4 bg-white border border-slate-200 rounded-xl inline-block">
                    <div id="qrCode"></div>
                    <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Step 3 -->
    <div class="p-5 bg-slate-50 border border-slate-200 rounded-xl">
        <div class="flex items-start gap-4">
            <div class="w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold flex-shrink-0">3</div>
            <div class="flex-1">
                <h3 class="font-semibold text-slate-900">@Localizer["Verify Your Code"]</h3>
                <p class="text-sm text-slate-600 mt-1">@Localizer["Enter the 6-digit code from your authenticator app to verify setup."]</p>
                <form id="send-code" method="post" class="mt-4 max-w-xs">
                    <div asp-validation-summary="ModelOnly" class="p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm mb-4" role="alert"></div>
                    <div>
                        <label asp-for="Input.Code" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Verification Code"]</label>
                        <input asp-for="Input.Code" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all text-center text-lg font-mono tracking-widest" autocomplete="off" placeholder="000000" maxlength="6" />
                        <span asp-validation-for="Input.Code" class="text-red-500 text-sm"></span>
                    </div>
                    <button type="submit" class="mt-4 w-full inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-semibold rounded-xl shadow-sm transition-all">
                        <i class="bi bi-check-lg"></i>
                        @Localizer["Verify"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

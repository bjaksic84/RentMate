@page
@model ExternalLoginModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Register"];
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-lg p-8">
            
            <div class="text-center mb-8">
                <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="bi bi-person-plus text-2xl text-blue-600"></i>
                </div>
                <h1 class="font-heading text-2xl font-bold text-slate-900">@ViewData["Title"]</h1>
                <h2 id="external-login-title" class="text-slate-700 mt-2">@Localizer["Associate your {0} account.", Model.ProviderDisplayName]</h2>
            </div>

            <p id="external-login-description" class="p-4 bg-blue-50 border border-blue-200 rounded-xl text-blue-700 text-sm mb-6">
                @Localizer["You've successfully authenticated with"] <strong>@Model.ProviderDisplayName</strong>.
                @Localizer["Please enter an email address for this site below and click the Register button to finish logging in."]
            </p>

            <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="space-y-5">
                <div asp-validation-summary="ModelOnly" class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-700" role="alert"></div>
                
                <div>
                    <label asp-for="Input.Email" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Email"]</label>
                    <input asp-for="Input.Email" class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" autocomplete="email" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-sm text-red-600"></span>
                </div>
                
                <button type="submit" class="w-full px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors">
                    @Localizer["Register"]
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
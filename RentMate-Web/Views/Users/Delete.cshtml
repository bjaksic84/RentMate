@model RentMate.Models.ApplicationUser
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Delete"];
}

<h1>@Localizer["Delete"]</h1>

<h3>@Localizer["Are you sure you want to delete this?"]</h3>
<div>
    <h4>@Localizer["User"]</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">@Localizer["Username"]</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.UserName)</dd>
        
        <dt class = "col-sm-2">@Localizer["Email"]</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Email)</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="@Localizer["Delete"]" class="btn btn-danger" /> |
        <a asp-action="Index">@Localizer["Back to List"]</a>
    </form>
</div>

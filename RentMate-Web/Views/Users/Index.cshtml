@model IEnumerable<RentMate.Models.ApplicationUser>
@{
    ViewData["Title"] = "Upravljanje uporabnikov";
}

<div class="container-fluid px-4 mt-4">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center bg-dark text-white">
            <h6 class="m-0 font-weight-bold">Seznam vseh uporabnikov</h6>
            <div class="input-group w-25">
                <input type="text" id="userSearch" class="form-control form-control-sm" placeholder="Išči uporabnika...">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Uporabniško ime</th>
                            <th>Email</th>
                            <th>Vloge</th>
                            <th class="text-end">Akcije</th>
                        </tr>
                    </thead>
                    <tbody id="usersTable">
                        @foreach (var user in Model)
                        {
                            <tr data-user-id="@user.Id">
                                <td><span class="fw-bold">@user.UserName</span></td>
                                <td>@user.Email</td>
                                <td class="user-roles"><span class="badge bg-light text-dark">Nalaganje...</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-primary" onclick="openRoleModal('@user.Id', '@user.UserName')">
                                        <i class="fas fa-shield-alt"></i> Vloge
                                    </button>
                                    <button class="btn btn-sm btn-danger" onclick="confirmDelete('@user.Id', '@user.UserName')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Modal -->
<div class="modal fade" id="roleModal" tabindex="-1" aria-labelledby="roleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content shadow-lg">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title" id="roleModalLabel">Manage Roles</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <div id="rolesCheckboxList" class="mb-3"></div>

        <div class="d-flex justify-content-end">
            <button class="btn btn-primary" type="button" onclick="saveRoles()">Save Changes</button>
        </div>

      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
let currentUserId = null;
let modalInstance = null;

document.addEventListener("DOMContentLoaded", async () => {
    await loadRolesForAllUsers();
    modalInstance = new bootstrap.Modal(document.getElementById('roleModal'));
});

// Dodaj k obstoječim skriptam [cite: 12-22]
async function confirmDelete(userId, userName) {
    if (confirm(`Ali ste prepričani, da želite izbrisati uporabnika ${userName}? To dejanje je nepovratno.`)) {
        const res = await fetch(`/api/UsersApi/${userId}`, {
            method: "DELETE"
        });

        if (res.ok) {
            // Odstrani vrstico iz tabele brez ponovnega nalaganja strani
            document.querySelector(`tr[data-user-id="${userId}"]`).remove();
        } else {
            const error = await res.text();
            alert("Napaka pri brisanju: " + error);
        }
    }
}

// Enostavno iskanje po tabeli
document.getElementById("userSearch").addEventListener("keyup", function() {
    let value = this.value.toLowerCase();
    document.querySelectorAll("#usersTable tr").forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(value) ? "" : "none";
    });
});

async function loadRolesForAllUsers() {
    document.querySelectorAll("#usersTable tr").forEach(async row => {
        const userId = row.getAttribute("data-user-id");
        const rolesCell = row.querySelector(".user-roles");

        try {
            const res = await fetch(`/api/UsersApi/${userId}/roles`);
            const roles = await res.json();
            rolesCell.innerHTML = roles.length ? roles.join(", ") : "<i>No roles</i>";
        } catch {
            rolesCell.innerText = "Error loading roles";
        }
    });
}

async function openRoleModal(userId, userName) {
    currentUserId = userId;
    document.getElementById("roleModalLabel").innerText = `Manage Roles for ${userName}`;
    await loadCheckboxRoles();
    modalInstance.show();
}

// ✅ Load all available roles and mark user's current ones
async function loadCheckboxRoles() {
    const [allRolesRes, userRolesRes] = await Promise.all([
        fetch('/api/UsersApi/roles'),
        fetch(`/api/UsersApi/${currentUserId}/roles`)
    ]);

    const allRoles = await allRolesRes.json();
    const userRoles = await userRolesRes.json();

    const container = document.getElementById("rolesCheckboxList");
    container.innerHTML = allRoles.map(role => `
        <div class="form-check">
            <input class="form-check-input" type="checkbox" value="${role}" id="role-${role}" ${userRoles.includes(role) ? "checked" : ""}>
            <label class="form-check-label" for="role-${role}">
                ${role}
            </label>
        </div>
    `).join("");
}

// ✅ Save roles: sends all checked roles to backend
async function saveRoles() {
    const selectedRoles = Array.from(document.querySelectorAll("#rolesCheckboxList input:checked"))
        .map(cb => cb.value);

    const res = await fetch(`/api/UsersApi/${currentUserId}/roles/manage`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(selectedRoles)
    });

    if (res.ok) {
        modalInstance.hide();
        await loadRolesForAllUsers();
    } else {
        alert("Error saving roles");
    }
}
</script>
}


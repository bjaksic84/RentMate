@model IEnumerable<RentMate.Models.Domain.ApplicationUser>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["User Management"];
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    @await Html.PartialAsync("_PageHeader", new { 
        Title = "User Management", 
        Subtitle = "List of all users"
    })
    
    <div class="mb-6">
        <div class="relative max-w-xs">
            <i class="bi bi-search absolute left-4 top-1/2 -translate-y-1/2 text-stone-400"></i>
            <input type="text" id="userSearch" class="pl-10 pr-4 py-2.5 border border-stone-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors w-full" placeholder="@Localizer["Search users..."]">
        </div>
    </div>

    <!-- Users Table -->
    <div class="bg-white rounded-lg border border-stone-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-stone-50 border-b border-stone-200">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-stone-500 uppercase tracking-wider">@Localizer["Username"]</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-stone-500 uppercase tracking-wider">@Localizer["Email"]</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-stone-500 uppercase tracking-wider">@Localizer["Roles"]</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-stone-500 uppercase tracking-wider">@Localizer["Status"]</th>
                        <th class="px-6 py-4 text-right text-xs font-semibold text-stone-500 uppercase tracking-wider">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody id="usersTable" class="divide-y divide-stone-200">
                    @foreach (var user in Model)
                    {
                        var isBanned = user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.Now;
                        <tr data-user-id="@user.Id" class="hover:bg-stone-50 transition-colors duration-150">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <img src="@(user.ProfilePictureUrl ?? "https://via.placeholder.com/40")" class="w-10 h-10 rounded-full object-cover" />
                                    <span class="font-semibold text-stone-900">@user.UserName</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-stone-500">@user.Email</td>
                            <td class="px-6 py-4 user-roles">
                                @await Html.PartialAsync("_StatusBadge", new { Type = "normal", Text = "Loading..." })
                            </td>
                            <td class="px-6 py-4">
                                @await Html.PartialAsync("_StatusBadge", new { Type = isBanned ? "banned" : "completed", Text = isBanned ? "Banned" : "Active" })
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center justify-end gap-1">
                                    <button class="p-2 text-stone-400 hover:text-primary-600 hover:bg-primary-50 rounded-lg transition-colors duration-150" onclick="openRoleModal('@user.Id', '@user.UserName')" title="@Localizer["Roles"]">
                                        <i class="bi bi-shield"></i>
                                    </button>

                                    @if (isBanned)
                                    {
                                        <form asp-action="UnbanUser" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="p-2 text-stone-400 hover:text-green-600 hover:bg-green-50 rounded-lg transition-colors duration-150" title="@Localizer["Unban"]">
                                                <i class="bi bi-person-check"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="BanUser" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="p-2 text-stone-400 hover:text-amber-600 hover:bg-amber-50 rounded-lg transition-colors duration-150" title="@Localizer["Ban"]" onclick="return confirm('@Localizer["Are you sure you want to ban this user?"]');">
                                                <i class="bi bi-person-slash"></i>
                                            </button>
                                        </form>
                                    }

                                    <button class="p-2 text-stone-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors duration-150" onclick="confirmDelete('@user.Id', '@user.UserName')" title="@Localizer["Delete"]">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        @if(!Model.Any())
        {
            @await Html.PartialAsync("_EmptyState", new { Icon = "bi-people", Message = "No users found" })
        }
    </div>
</div>

<!-- Role Management Modal -->
<div id="roleModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50" onclick="closeRoleModal()"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md">
        <div class="bg-white rounded-lg shadow-xl m-4">
            <div class="flex items-center justify-between p-6 border-b border-stone-200">
                <h3 class="text-xl font-bold text-stone-900" id="roleModalLabel">@Localizer["Manage Roles"]</h3>
                <button type="button" onclick="closeRoleModal()" class="p-2 text-stone-400 hover:text-stone-600 rounded-lg">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="p-6">
                <div id="rolesCheckboxList" class="space-y-3"></div>
            </div>
            <div class="flex gap-3 p-6 border-t border-stone-200">
                <button onclick="closeRoleModal()" class="flex-1 px-4 py-3 border border-stone-200 rounded-lg text-stone-600 hover:bg-stone-50 transition-colors duration-150 font-medium">
                    @Localizer["Close"]
                </button>
                <button onclick="saveRoles()" class="flex-1 px-4 py-3 bg-primary-600 text-white rounded-lg font-semibold hover:bg-primary-700 transition-colors duration-150">
                    @Localizer["Save Changes"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let currentUserId = null;

// Localized strings for JavaScript
const locConfirmDelete = "@Localizer["Are you sure you want to delete user"]";
const locIrreversible = "@Localizer["This action is irreversible."] ";
const locErrorDelete = "@Localizer["Error deleting:"] ";
const locNoRoles = "@Localizer["No roles"]";
const locErrorRoles = "@Localizer["Error loading roles"]";
const locManageRolesFor = "@Localizer["Manage Roles for"]";
const locErrorSaving = "@Localizer["Error saving roles"]";

document.addEventListener("DOMContentLoaded", async () => {
    await loadRolesForAllUsers();
});

async function confirmDelete(userId, userName) {
    if (confirm(`${locConfirmDelete} ${userName}? ${locIrreversible}`)) {
        const res = await fetch(`/api/UsersApi/${userId}`, {
            method: "DELETE"
        });

        if (res.ok) {
            document.querySelector(`tr[data-user-id="${userId}"]`).remove();
        } else {
            const error = await res.text();
            alert(locErrorDelete + error);
        }
    }
}

document.getElementById("userSearch").addEventListener("keyup", function() {
    let value = this.value.toLowerCase();
    document.querySelectorAll("#usersTable tr").forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(value) ? "" : "none";
    });
});

async function loadRolesForAllUsers() {
    document.querySelectorAll("#usersTable tr").forEach(async row => {
        const userId = row.getAttribute("data-user-id");
        const rolesCell = row.querySelector(".user-roles");

        try {
            const res = await fetch(`/api/UsersApi/${userId}/roles`);
            const roles = await res.json();
            if (roles.length) {
                rolesCell.innerHTML = roles.map(r => `<span class="inline-block px-2 py-1 bg-primary-100 text-primary-700 text-xs font-medium rounded-full mr-1">${r}</span>`).join("");
            } else {
                rolesCell.innerHTML = `<span class="text-stone-400 text-sm italic">${locNoRoles}</span>`;
            }
        } catch {
            rolesCell.innerText = locErrorRoles;
        }
    });
}

function openRoleModal(userId, userName) {
    currentUserId = userId;
    document.getElementById("roleModalLabel").innerText = `${locManageRolesFor} ${userName}`;
    loadCheckboxRoles();
    document.getElementById("roleModal").classList.remove("hidden");
}

function closeRoleModal() {
    document.getElementById("roleModal").classList.add("hidden");
}

async function loadCheckboxRoles() {
    const [allRolesRes, userRolesRes] = await Promise.all([
        fetch('/api/UsersApi/roles'),
        fetch(`/api/UsersApi/${currentUserId}/roles`)
    ]);

    const allRoles = await allRolesRes.json();
    const userRoles = await userRolesRes.json();

    const container = document.getElementById("rolesCheckboxList");
    container.innerHTML = allRoles.map(role => `
        <label class="flex items-center gap-3 p-3 border border-stone-200 rounded-lg hover:bg-stone-50 cursor-pointer transition-colors duration-150">
            <input type="checkbox" value="${role}" class="w-5 h-5 text-primary-600 border-stone-300 rounded focus:ring-primary-500" ${userRoles.includes(role) ? "checked" : ""}>
            <span class="font-medium text-stone-700">${role}</span>
        </label>
    `).join("");
}

async function saveRoles() {
    const selectedRoles = Array.from(document.querySelectorAll("#rolesCheckboxList input:checked"))
        .map(cb => cb.value);

    const res = await fetch(`/api/UsersApi/${currentUserId}/roles/manage`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(selectedRoles)
    });

    if (res.ok) {
        closeRoleModal();
        await loadRolesForAllUsers();
    } else {
        alert(locErrorSaving);
    }
}
</script>
}

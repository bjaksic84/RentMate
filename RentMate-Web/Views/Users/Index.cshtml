@model IEnumerable<RentMate.Models.ApplicationUser>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["User Management"];
}

<div class="container-fluid px-4 mt-4">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center bg-dark text-white">
            <h6 class="m-0 font-weight-bold">@Localizer["List of all users"]</h6>
            <div class="input-group w-25">
                <input type="text" id="userSearch" class="form-control form-control-sm" placeholder="@Localizer["Search users..."]">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["Username"]</th>
                            <th>@Localizer["Email"]</th>
                            <th>@Localizer["Roles"]</th>
                            <th class="text-end">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="usersTable">
                        @foreach (var user in Model)
                        {
                            <tr data-user-id="@user.Id">
                                <td><span class="fw-bold">@user.UserName</span></td>
                                <td>@user.Email</td>
                                <td class="user-roles"><span class="badge bg-light text-dark">@Localizer["Loading..."]</span></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-primary" onclick="openRoleModal('@user.Id', '@user.UserName')">
                                        <i class="fas fa-shield-alt"></i> @Localizer["Roles"]
                                    </button>
                                    <button class="btn btn-sm btn-danger" onclick="confirmDelete('@user.Id', '@user.UserName')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="roleModal" tabindex="-1" aria-labelledby="roleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content shadow-lg">
      <div class="modal-header bg-dark text-white">
        <h5 class="modal-title" id="roleModalLabel">@Localizer["Manage Roles"]</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <div id="rolesCheckboxList" class="mb-3"></div>

        <div class="d-flex justify-content-end">
            <button class="btn btn-primary" type="button" onclick="saveRoles()">@Localizer["Save Changes"]</button>
        </div>

      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Close"]</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
let currentUserId = null;
let modalInstance = null;

// Localized strings for JavaScript
const locConfirmDelete = "@Localizer["Are you sure you want to delete user"]";
const locIrreversible = "@Localizer["This action is irreversible."] ";
const locErrorDelete = "@Localizer["Error deleting:"] ";
const locNoRoles = "@Localizer["No roles"]";
const locErrorRoles = "@Localizer["Error loading roles"]";
const locManageRolesFor = "@Localizer["Manage Roles for"]";
const locErrorSaving = "@Localizer["Error saving roles"]";

document.addEventListener("DOMContentLoaded", async () => {
    await loadRolesForAllUsers();
    modalInstance = new bootstrap.Modal(document.getElementById('roleModal'));
});

async function confirmDelete(userId, userName) {
    if (confirm(`${locConfirmDelete} ${userName}? ${locIrreversible}`)) {
        const res = await fetch(`/api/UsersApi/${userId}`, {
            method: "DELETE"
        });

        if (res.ok) {
            document.querySelector(`tr[data-user-id="${userId}"]`).remove();
        } else {
            const error = await res.text();
            alert(locErrorDelete + error);
        }
    }
}

document.getElementById("userSearch").addEventListener("keyup", function() {
    let value = this.value.toLowerCase();
    document.querySelectorAll("#usersTable tr").forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(value) ? "" : "none";
    });
});

async function loadRolesForAllUsers() {
    document.querySelectorAll("#usersTable tr").forEach(async row => {
        const userId = row.getAttribute("data-user-id");
        const rolesCell = row.querySelector(".user-roles");

        try {
            const res = await fetch(`/api/UsersApi/${userId}/roles`);
            const roles = await res.json();
            rolesCell.innerHTML = roles.length ? roles.join(", ") : `<i>${locNoRoles}</i>`;
        } catch {
            rolesCell.innerText = locErrorRoles;
        }
    });
}

async function openRoleModal(userId, userName) {
    currentUserId = userId;
    document.getElementById("roleModalLabel").innerText = `${locManageRolesFor} ${userName}`;
    await loadCheckboxRoles();
    modalInstance.show();
}

async function loadCheckboxRoles() {
    const [allRolesRes, userRolesRes] = await Promise.all([
        fetch('/api/UsersApi/roles'),
        fetch(`/api/UsersApi/${currentUserId}/roles`)
    ]);

    const allRoles = await allRolesRes.json();
    const userRoles = await userRolesRes.json();

    const container = document.getElementById("rolesCheckboxList");
    container.innerHTML = allRoles.map(role => `
        <div class="form-check">
            <input class="form-check-input" type="checkbox" value="${role}" id="role-${role}" ${userRoles.includes(role) ? "checked" : ""}>
            <label class="form-check-label" for="role-${role}">
                ${role}
            </label>
        </div>
    `).join("");
}

async function saveRoles() {
    const selectedRoles = Array.from(document.querySelectorAll("#rolesCheckboxList input:checked"))
        .map(cb => cb.value);

    const res = await fetch(`/api/UsersApi/${currentUserId}/roles/manage`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(selectedRoles)
    });

    if (res.ok) {
        modalInstance.hide();
        await loadRolesForAllUsers();
    } else {
        alert(locErrorSaving);
    }
}
</script>
}
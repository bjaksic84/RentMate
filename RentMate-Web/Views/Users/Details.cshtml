@model RentMate.Models.Domain.ApplicationUser
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Details"];
}

<h1>@Localizer["Details"]</h1>

<div>
    <h4>@Localizer["User"]</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">@Localizer["Username"]</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.UserName)</dd>
        
        <dt class = "col-sm-2">@Localizer["Email"]</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Email)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">@Localizer["Edit"]</a> |
    <a asp-action="Index">@Localizer["Back to List"]</a>
</div>

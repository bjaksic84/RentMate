@model RentMate.Models.ManageRolesViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Manage Roles"];
}

<h2>@Localizer["Edit Roles for"] @Model.UserEmail</h2>

<form asp-action="ManageRoles" method="post">
    <input type="hidden" asp-for="UserId" />

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>@Localizer["Role"]</th>
                <th>@Localizer["Assigned"]</th>
            </tr>
        </thead>
        <tbody>
        @for (int i = 0; i < Model.Roles.Count; i++)
        {
            <tr>
                <td>@Model.Roles[i].RoleName</td>
                <td>
                    <input asp-for="Roles[i].IsSelected" type="checkbox" class="form-check-input" />
                    <input asp-for="Roles[i].RoleName" type="hidden" />
                </td>
            </tr>
        }
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
    <a asp-action="Index" class="btn btn-secondary">@Localizer["Back"]</a>
</form>
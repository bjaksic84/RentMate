@model RentMate.Models.Domain.Rental
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService
@{
    ViewData["Title"] = "Checkout";
    var clientSecret = ViewBag.ClientSecret as string;
    var publishableKey = ViewBag.PublishableKey as string;
    var isExtension = ViewBag.IsExtension as bool? ?? false;
    var extensionId = ViewBag.ExtensionId as int? ?? 0;
    var extensionCost = ViewBag.ExtensionCost as decimal? ?? 0;
    var extensionNewEndDate = ViewBag.ExtensionNewEndDate as DateTime?;
    var displayAmount = isExtension ? extensionCost : Model.TotalPrice;
}

<div class="max-w-3xl mx-auto px-4 py-12">
    <script src="https://js.stripe.com/v3/"></script>
    <div class="bg-white rounded-lg shadow-xl overflow-hidden">
        <div class="p-8 bg-stone-50 border-b border-stone-200">
            <h1 class="text-2xl font-bold text-stone-900">Checkout</h1>
            <p class="text-stone-500 mt-1">
                @if (isExtension)
                {
                    @:Complete your extension payment for <span class="font-semibold text-stone-700">@Model.Item?.Title</span>
                }
                else
                {
                    @:Complete your rental payment for <span class="font-semibold text-stone-700">@Model.Item?.Title</span>
                }
            </p>
        </div>

        <div class="p-8">
            <div class="flex items-center justify-between mb-8 p-4 bg-primary-50 rounded-lg">
                <div>
                    <p class="text-sm text-primary-600 font-medium uppercase tracking-wide">Total Amount</p>
                    <p class="text-3xl font-bold text-stone-900">@CurrencyService.Format(displayAmount)</p>
                </div>
                <div class="text-right">
                    @if (isExtension && extensionNewEndDate.HasValue)
                    {
                        <p class="text-sm text-stone-500">Extension Period</p>
                        <p class="font-medium text-stone-900">@Model.EndDate.ToString("MMM dd") - @extensionNewEndDate.Value.ToString("MMM dd")</p>
                    }
                    else
                    {
                        <p class="text-sm text-stone-500">Rental Period</p>
                        <p class="font-medium text-stone-900">@Model.StartDate.ToString("MMM dd") - @Model.EndDate.ToString("MMM dd")</p>
                    }
                </div>
            </div>

            <form id="payment-form">
                <div id="payment-element">
                    <!-- Stripe Elements will create form elements here -->
                </div>
                
                <div id="error-message" class="hidden mt-4 p-3 bg-red-50 text-red-600 rounded-lg text-sm"></div>

                <button id="submit" class="w-full mt-8 bg-primary-600 hover:bg-primary-700 text-white font-bold py-4 px-6 rounded-lg transition-colors duration-150 flex items-center justify-center">
                    <div class="spinner hidden mr-3" id="spinner"></div>
                    <span id="button-text">Pay now</span>
                </button>
            </form>
        </div>
    </div>
</div>


<script>
    const stripe = Stripe('@publishableKey');
    const options = {
        clientSecret: '@clientSecret',
        appearance: {
            theme: 'stripe',
            variables: {
                colorPrimary: '#2563eb',
            },
        },
    };

    const elements = stripe.elements(options);
    const paymentElement = elements.create('payment');
    paymentElement.mount('#payment-element');

    const form = document.getElementById('payment-form');
    const submitBtn = document.getElementById('submit');
    const errorMessage = document.getElementById('error-message');

    form.addEventListener('submit', async (event) => {
        event.preventDefault();

        setLoading(true);

        const { error } = await stripe.confirmPayment({
            elements,
            confirmParams: {
                return_url: '@(isExtension
                    ? Url.Action("ExtensionSuccess", "Payment", new { extensionId = extensionId }, Context.Request.Scheme)
                    : Url.Action("Success", "Payment", new { rentalId = Model.Id }, Context.Request.Scheme))',
            },
        });

        if (error) {
            showMessage(error.message);
            setLoading(false);
        } else {
            // Your customer will be redirected to your `return_url`.
        }
    });

    function showMessage(messageText) {
        errorMessage.classList.remove('hidden');
        errorMessage.textContent = messageText;
    }

    function setLoading(isLoading) {
        if (isLoading) {
            submitBtn.disabled = true;
            document.querySelector("#spinner").classList.remove("hidden");
            document.querySelector("#button-text").classList.add("hidden");
        } else {
            submitBtn.disabled = false;
            document.querySelector("#spinner").classList.add("hidden");
            document.querySelector("#button-text").classList.remove("hidden");
        }
    }
</script>

<style>
    .spinner {
        border: 4px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        border-top: 4px solid #ffffff;
        width: 24px;
        height: 24px;
        -webkit-animation: spin 1s linear infinite; /* Safari */
        animation: spin 1s linear infinite;
    }
    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

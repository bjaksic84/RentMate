@model RentMate.Models.Item
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject RentMate.Services.CurrencyService CurrencyService

@{
    ViewData["Title"] = Localizer["New Item"];
    var currency = CurrencyService.GetCurrentCurrency();
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        <a asp-controller="Dashboard" asp-action="UserDashboard" class="inline-flex items-center gap-2 text-slate-500 hover:text-blue-600 transition-colors mb-4">
            <i class="bi bi-arrow-left"></i>
            @Localizer["Back to Dashboard"]
        </a>
        <h1 class="font-heading text-3xl font-bold text-slate-900">@Localizer["List a New Item"]</h1>
        <p class="text-slate-500 mt-2">@Localizer["Share your item with the community and start earning"]</p>
    </div>

    <form asp-action="Create" enctype="multipart/form-data" class="space-y-6">
        <div asp-validation-summary="ModelOnly" class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-700"></div>

        <!-- Image Upload Section -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6">
            <h2 class="font-heading text-lg font-semibold text-slate-900 mb-4">@Localizer["Item Photo"]</h2>
            
            <div class="flex flex-col md:flex-row gap-6">
                <!-- Preview -->
                <div class="shrink-0">
                    <img id="imgPreview" src="https://via.placeholder.com/200x200?text=No+Image" 
                         class="w-48 h-48 rounded-xl object-cover border-2 border-dashed border-slate-300" />
                </div>
                
                <!-- Upload Buttons -->
                <div class="flex-1 space-y-4">
                    <p class="text-sm text-slate-500">@Localizer["Upload a clear photo of your item. Good photos help renters trust your listing."]</p>
                    
                    <div class="flex flex-wrap gap-3">
                        <label class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-xl cursor-pointer transition-colors">
                            <i class="bi bi-camera"></i>
                            @Localizer["Take Photo"]
                            <input type="file" name="image" id="cameraInput" class="hidden" accept="image/*" capture="environment" onchange="previewImage(this)" />
                        </label>
                        <label class="inline-flex items-center gap-2 px-4 py-2.5 border border-slate-300 text-slate-700 hover:bg-slate-50 font-medium rounded-xl cursor-pointer transition-colors">
                            <i class="bi bi-image"></i>
                            @Localizer["Choose File"]
                            <input type="file" name="image" id="fileInput" class="hidden" accept="image/*" onchange="previewImage(this)" />
                        </label>
                    </div>
                    
                    <p class="text-xs text-slate-400">@Localizer["Supported formats: JPG, PNG, WebP. Max 10MB."]</p>
                </div>
            </div>
        </div>

        <!-- Item Details -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6">
            <h2 class="font-heading text-lg font-semibold text-slate-900 mb-4">@Localizer["Item Details"]</h2>
            
            <div class="space-y-4">
                <!-- Title -->
                <div>
                    <label asp-for="Title" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Title"]</label>
                    <input asp-for="Title" class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" 
                           placeholder="@Localizer["e.g. Professional Camera Canon EOS R5"]" />
                    <span asp-validation-for="Title" class="text-sm text-red-600"></span>
                </div>

                <div class="grid md:grid-cols-2 gap-4">
                    <!-- Category -->
                    <div>
                        <label asp-for="Category" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Category"]</label>
                        <select asp-for="Category" class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors bg-white">
                            <option value="" disabled selected>@Localizer["Select category..."]</option>
                            <option value="Tools">??? @Localizer["Tools"]</option>
                            <option value="Electronics">?? @Localizer["Electronics"]</option>
                            <option value="Sport">? @Localizer["Sports"]</option>
                            <option value="Home">?? @Localizer["Home & Garden"]</option>
                            <option value="Events">?? @Localizer["Fun"]</option>
                            <option value="Other">?? @Localizer["Other"]</option>
                        </select>
                        <span asp-validation-for="Category" class="text-sm text-red-600"></span>
                    </div>

                    <!-- Price -->
                    <div>
                        <label asp-for="Price" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Price per day"] (@currency.Code)</label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">@currency.Symbol</span>
                            <input asp-for="Price" type="number" step="0.01" min="0" 
                                   class="w-full pl-10 pr-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" 
                                   placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Price" class="text-sm text-red-600"></span>
                    </div>
                </div>

                <!-- Description -->
                <div>
                    <label asp-for="Description" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Description"]</label>
                    <textarea asp-for="Description" rows="4" 
                              class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors resize-none"
                              placeholder="@Localizer["Describe your item, its condition, what's included, and any rental requirements..."]"></textarea>
                    <span asp-validation-for="Description" class="text-sm text-red-600"></span>
                </div>
            </div>
        </div>

        <!-- Pickup Location -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6">
            <h2 class="font-heading text-lg font-semibold text-slate-900 mb-4">@Localizer["Pickup Location"]</h2>
            
            <div>
                <label asp-for="Location" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Address or Area"]</label>
                <div class="flex gap-2">
                    <input asp-for="Location" id="locationInput" 
                           class="flex-1 px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" 
                           placeholder="@Localizer["e.g. Ljubljana, Slovenia"]" />
                    <button type="button" id="getLocationBtn" onclick="getCurrentLocation()"
                            class="px-4 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl transition-colors flex items-center gap-2">
                        <i class="bi bi-geo-alt"></i>
                        <span class="hidden sm:inline">@Localizer["Use My Location"]</span>
                    </button>
                </div>
                <p class="mt-1 text-sm text-slate-500">@Localizer["This helps renters find items near them. Exact address is shared only after booking."]</p>
                <span asp-validation-for="Location" class="text-sm text-red-600"></span>
                <div id="locationStatus" class="text-sm mt-2"></div>
            </div>
        </div>

        <!-- Submit -->
        <div class="flex flex-col sm:flex-row gap-3 justify-end">
            <a asp-controller="Dashboard" asp-action="UserDashboard" 
               class="px-6 py-3 border border-slate-300 text-slate-700 hover:bg-slate-50 font-medium rounded-xl transition-colors text-center">
                @Localizer["Cancel"]
            </a>
            <button type="submit" 
                    class="px-8 py-3 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-semibold rounded-xl shadow-sm  transition-all">
                @Localizer["Publish Item"]
            </button>
        </div>
    </form>
</div>

<!-- GDPR Consent Modal -->
<div id="locationConsentModal" class="fixed inset-0 z-50 hidden">
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" onclick="closeConsentModal()"></div>
    <div class="fixed inset-0 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 relative">
            <button onclick="closeConsentModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600">
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="text-center mb-6">
                <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="bi bi-geo-alt text-blue-600 text-2xl"></i>
                </div>
                <h3 class="font-heading text-xl font-bold text-slate-900">@Localizer["Location Access"]</h3>
            </div>
            <p class="text-slate-600 mb-4">@Localizer["We would like to access your location to set the default pickup location for your item."]</p>
            <p class="text-sm text-slate-500 mb-6">@Localizer["Your location data will only be used to display the pickup location to potential renters. You can always enter a custom address instead."]</p>
            <div class="flex gap-3">
                <button onclick="closeConsentModal()" class="flex-1 px-4 py-3 border border-slate-300 text-slate-700 hover:bg-slate-50 font-medium rounded-xl transition-colors">
                    @Localizer["No thanks"]
                </button>
                <button onclick="confirmLocationAccess()" class="flex-1 px-4 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-xl transition-colors">
                    @Localizer["Allow Access"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imgPreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        let locationConsented = false;

        function getCurrentLocation() {
            if (!locationConsented) {
                document.getElementById('locationConsentModal').classList.remove('hidden');
                return;
            }
            requestLocation();
        }

        function closeConsentModal() {
            document.getElementById('locationConsentModal').classList.add('hidden');
        }

        function confirmLocationAccess() {
            locationConsented = true;
            closeConsentModal();
            requestLocation();
        }

        function requestLocation() {
            const statusEl = document.getElementById('locationStatus');
            const btn = document.getElementById('getLocationBtn');
            
            statusEl.innerHTML = '<span class="text-blue-600"><i class="bi bi-arrow-repeat animate-spin"></i> @Localizer["Getting location..."]</span>';
            btn.disabled = true;

            if (!navigator.geolocation) {
                statusEl.innerHTML = '<span class="text-red-600">@Localizer["Geolocation is not supported by your browser"]</span>';
                btn.disabled = false;
                return;
            }

            navigator.geolocation.getCurrentPosition(
                async (position) => {
                    try {
                        const response = await fetch(
                            `https://nominatim.openstreetmap.org/reverse?lat=${position.coords.latitude}&lon=${position.coords.longitude}&format=json`
                        );
                        const data = await response.json();
                        
                        let location = '';
                        if (data.address) {
                            const parts = [];
                            if (data.address.city || data.address.town || data.address.village) {
                                parts.push(data.address.city || data.address.town || data.address.village);
                            }
                            if (data.address.country) {
                                parts.push(data.address.country);
                            }
                            location = parts.join(', ');
                        }
                        
                        document.getElementById('locationInput').value = location || data.display_name;
                        statusEl.innerHTML = '<span class="text-green-600"><i class="bi bi-check-circle"></i> @Localizer["Location set successfully"]</span>';
                    } catch (error) {
                        statusEl.innerHTML = '<span class="text-red-600">@Localizer["Could not get address from coordinates"]</span>';
                    }
                    btn.disabled = false;
                },
                (error) => {
                    let message = '@Localizer["Could not get your location"]';
                    if (error.code === error.PERMISSION_DENIED) {
                        message = '@Localizer["Location access was denied. Please enter your location manually."]';
                    }
                    statusEl.innerHTML = `<span class="text-red-600">${message}</span>`;
                    btn.disabled = false;
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 300000 }
            );
        }
    </script>
}


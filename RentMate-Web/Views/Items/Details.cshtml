@model RentMate.Models.ViewModels.ItemDetailsViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService

@{
    ViewData["Title"] = Model.Title;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" crossorigin="anonymous" />

<div class="max-w-7xl mx-auto px-4 py-6 pb-24 lg:pb-6">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-6">
        <a asp-controller="Home" asp-action="Marketplace" class="hover:text-blue-600 transition-colors">@Localizer["Marketplace"]</a>
        <i class="bi bi-chevron-right text-xs"></i>
        <a asp-controller="Home" asp-action="Marketplace" asp-route-category="@Model.Category" class="hover:text-blue-600 transition-colors">@Localizer[Model.Category ?? ""]</a>
        <i class="bi bi-chevron-right text-xs"></i>
        <span class="text-slate-700 dark:text-slate-300 font-medium truncate max-w-[200px]">@Model.Title</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-8">
            <partial name="Partials/_ItemHero" model="Model" />
            <partial name="Partials/_ItemGallery" model="Model" />
            <partial name="Partials/_ItemOwnerCard" model="Model" />

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6">
                    <h2 class="font-heading text-xl font-bold text-slate-900 dark:text-white mb-4">@Localizer["About this item"]</h2>
                    <p class="text-slate-600 dark:text-slate-300 whitespace-pre-line leading-relaxed">@Model.Description</p>
                </div>
            }

            <partial name="Partials/_ItemAccessories" model="Model" />
            <partial name="Partials/_ItemPolicies" model="Model" />
            <partial name="Partials/_ItemAvailability" model="Model" />
            <partial name="Partials/_ItemReviews" model="Model" />
            <partial name="Partials/_ItemLocation" model="Model" />
            <partial name="Partials/_ItemFaq" model="Model" />
            <partial name="Partials/_ItemSimilar" model="Model" />
        </div>

        <!-- Sidebar -->
        <div class="hidden lg:block">
            <partial name="Partials/_ItemBookingCard" model="Model" />
        </div>
    </div>
</div>

<!-- Mobile booking bar -->
<partial name="Partials/_ItemMobileBookingBar" model="Model" />

<!-- Modals -->
@if (!Model.IsOwner)
{
    <partial name="_RentModal" model="Model.Item" />
}
<partial name="Partials/_ItemReviewEditModal" model="Model" />

@section Scripts {
    <script>
        window.ItemDetailsConfig = {
            itemId: @Model.ItemId,
            images: @Html.Raw(Json.Serialize(Model.Images.Select(i => new { url = i.ImageUrl, order = i.DisplayOrder }))),
            map: {
                lat: @((Model.MapLat ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture)),
                lng: @((Model.MapLng ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture)),
                city: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.MapCityName ?? ""))'
            },
            urls: {
                deleteReview: '/api/Reviews/',
                updateReview: '/api/Reviews/',
                loadReviews: '/api/Reviews/item/@Model.ItemId'
            },
            strings: {
                linkCopied: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Link copied!"].Value))',
                confirmDelete: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Are you sure you want to delete your review?"].Value))',
                anonymous: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["Anonymous"].Value))',
                user: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Localizer["User"].Value))'
            },
            currentUserId: '@Model.CurrentUserId',
            isOwner: @Json.Serialize(Model.IsOwner),
            blockedRanges: @Html.Raw(Json.Serialize(Model.BlockedDateRanges.Select(r => new { from = r.StartDate.ToString("yyyy-MM-dd"), to = r.EndDate.ToString("yyyy-MM-dd") })))
        };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" crossorigin="anonymous"></script>
    <script src="~/js/item-details.js?v=2"></script>
}

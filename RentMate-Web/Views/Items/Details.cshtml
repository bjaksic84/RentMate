@using Microsoft.AspNetCore.Mvc.Localization
@using System.Text.Json
@model RentMate.Models.Item
@inject IViewLocalizer Localizer
@inject RentMate.Services.CurrencyService CurrencyService

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

@{
    ViewData["Title"] = Model.Title;
    var avgRating = Model.AverageRating ?? 0;
    
    var blockedDates = Model.Rentals?
        .Where(r => r.Status == RentMate.Shared.RentalStatus.Active || r.Status == RentMate.Shared.RentalStatus.Pending)
        .Select(r => new { from = r.StartDate.ToString("yyyy-MM-dd"), to = r.EndDate.ToString("yyyy-MM-dd") })
        .ToList();
    string jsonBlocked = blockedDates != null ? JsonSerializer.Serialize(blockedDates) : "[]";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-slate-500 mb-6">
        <a asp-controller="Rentals" asp-action="Index" class="hover:text-blue-600 transition-colors">@Localizer["Marketplace"]</a>
        <i class="bi bi-chevron-right text-xs"></i>
        <a asp-controller="Rentals" asp-action="Index" asp-route-category="@Model.Category" class="hover:text-blue-600 transition-colors">@Localizer[Model.Category]</a>
        <i class="bi bi-chevron-right text-xs"></i>
        <span class="text-slate-900 font-medium truncate max-w-[200px]">@Model.Title</span>
    </nav>

    <!-- Title & Meta -->
    <div class="mb-6">
        <h1 class="font-heading text-3xl md:text-4xl font-bold text-slate-900 mb-3">@Model.Title</h1>
        <div class="flex flex-wrap items-center gap-4 text-slate-600">
            <div class="flex items-center gap-1">
                <i class="bi bi-star-fill text-amber-400"></i>
                <span class="font-semibold text-slate-900">@avgRating.ToString("0.0")</span>
                <span class="text-slate-500">(@Model.ReviewCount @Localizer["reviews"])</span>
            </div>
            <span class="text-slate-300">�</span>
            <div class="flex items-center gap-1">
                <i class="bi bi-geo-alt"></i>
                <span>@Model.User?.City</span>
            </div>
            <span class="text-slate-300">�</span>
            <div class="flex items-center gap-1">
                <i class="bi bi-tag"></i>
                <span>@Localizer[Model.Category]</span>
            </div>
        </div>
    </div>

    <div class="grid lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-8">
            <!-- Image -->
            <div class="relative rounded-2xl overflow-hidden shadow-lg">
                @if(!string.IsNullOrEmpty(Model.ImageUrl)) {
                    var urlLarge = Model.ImageUrl.Replace("/upload/", "/upload/c_fill,w_1200,h_800,q_auto,f_auto/");
                    <img src="@urlLarge" class="w-full h-[400px] md:h-[500px] object-cover" alt="@Model.Title">
                } else {
                    <div class="w-full h-[400px] bg-slate-100 flex items-center justify-center">
                        <div class="text-center text-slate-400">
                            <i class="bi bi-image text-6xl"></i>
                            <p class="mt-2">@Localizer["No image"]</p>
                        </div>
                    </div>
                }
                <!-- Favorite button -->
                <button class="absolute top-4 right-4 w-10 h-10 bg-white/90 backdrop-blur rounded-full flex items-center justify-center shadow-lg hover:scale-110 transition-transform">
                    <i class="bi bi-heart text-slate-600 hover:text-red-500"></i>
                </button>
            </div>

            <!-- Owner Info -->
            <div class="flex items-center justify-between p-6 bg-white rounded-2xl border border-slate-200">
                <div class="flex items-center gap-4">
                    <a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.UserId" class="shrink-0">
                        <img src="@(Model.User?.ProfilePictureUrl ?? "https://via.placeholder.com/60")" 
                             class="w-14 h-14 rounded-full object-cover ring-2 ring-slate-100">
                    </a>
                    <div>
                        <p class="text-sm text-slate-500">@Localizer["Hosted by"]</p>
                        <a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.UserId" class="font-semibold text-slate-900 hover:text-blue-600 transition-colors">
                            @Model.User?.FirstName @Model.User?.LastName
                        </a>
                    </div>
                </div>
                <a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.UserId" 
                   class="px-4 py-2 text-sm font-medium text-blue-600 hover:bg-blue-50 rounded-lg transition-colors">
                    @Localizer["View Profile"]
                </a>
            </div>

            <!-- Description -->
            <div class="bg-white rounded-2xl border border-slate-200 p-6">
                <h2 class="font-heading text-xl font-bold text-slate-900 mb-4">@Localizer["About this item"]</h2>
                <p class="text-slate-600 leading-relaxed whitespace-pre-line">@Model.Description</p>
            </div>

            <!-- Reviews Section -->
            <div class="bg-white rounded-2xl border border-slate-200 p-6">
                <div class="flex items-center gap-3 mb-6">
                    <i class="bi bi-star-fill text-amber-400 text-xl"></i>
                    <h2 class="font-heading text-xl font-bold text-slate-900">
                        @avgRating.ToString("0.0") � @Model.ReviewCount @Localizer["reviews"]
                    </h2>
                </div>
                
                @if(Model.Reviews?.Any() == true) {
                    <div class="grid md:grid-cols-2 gap-6">
                        @foreach(var review in Model.Reviews.OrderByDescending(r => r.CreatedAt).Take(4))
                        {
                            <div class="p-4 bg-slate-50 rounded-xl">
                                <div class="flex items-center gap-3 mb-3">
                                    <img src="@(review.Reviewer?.ProfilePictureUrl ?? "https://via.placeholder.com/40")" 
                                         class="w-10 h-10 rounded-full object-cover">
                                    <div>
                                        <p class="font-semibold text-slate-900">@(review.IsAnonymous ? Localizer["Anonymous"] : review.Reviewer?.FirstName)</p>
                                        <p class="text-xs text-slate-500">@review.CreatedAt.ToString("MMMM yyyy")</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-0.5 mb-2">
                                    @for(int i = 0; i < 5; i++) {
                                        <i class="bi bi-star-fill text-sm @(i < review.Rating ? "text-amber-400" : "text-slate-200")"></i>
                                    }
                                </div>
                                <p class="text-slate-600 text-sm line-clamp-3">@review.Body</p>
                            </div>
                        }
                    </div>
                    @if(Model.ReviewCount > 4) {
                        <button class="mt-6 px-6 py-3 border border-slate-300 text-slate-700 font-semibold rounded-xl hover:bg-slate-50 transition-colors">
                            @Localizer["Show all {0} reviews", Model.ReviewCount]
                        </button>
                    }
                } else {
                    <div class="text-center py-8 text-slate-500">
                        <i class="bi bi-chat-square-text text-4xl mb-2"></i>
                        <p>@Localizer["No reviews yet"]</p>
                    </div>
                }
            </div>

            <!-- Location Section -->
            <div class="bg-white rounded-2xl border border-slate-200 p-6">
                <h2 class="font-heading text-xl font-bold text-slate-900 mb-4">@Localizer["Pickup Location"]</h2>
                <div class="flex items-center gap-2 text-slate-600 mb-4">
                    <i class="bi bi-geo-alt-fill text-red-500"></i>
                    <span>@ViewBag.MapCityName</span>
                    <span class="px-2 py-0.5 bg-slate-100 text-slate-600 text-xs rounded-full">@Localizer["Approximate location"]</span>
                </div>
                
                <div id="map" class="h-[300px] rounded-xl overflow-hidden shadow-inner"></div>
                
                <div class="flex items-start gap-3 mt-4 p-4 bg-blue-50 rounded-xl">
                    <i class="bi bi-shield-check text-blue-600 text-xl"></i>
                    <p class="text-sm text-blue-800">
                        @Localizer["For safety and privacy, we only show the approximate area where the item is located. You will receive the exact pickup address after booking confirmation."]
                    </p>
                </div>
            </div>
        </div>

        <!-- Sidebar - Booking Card -->
        <div class="lg:col-span-1">
            <div class="sticky top-24">
                <div class="bg-white rounded-2xl border border-slate-200 shadow-md p-6">
                    <!-- Price -->
                    <div class="flex items-end justify-between mb-6">
                        <div>
                            <span class="text-3xl font-bold text-slate-900">@CurrencyService.Format(Model.Price)</span>
                            <span class="text-slate-500"> / @Localizer["day"]</span>
                        </div>
                        <div class="flex items-center gap-1 text-sm">
                            <i class="bi bi-star-fill text-amber-400"></i>
                            <span class="font-semibold">@avgRating.ToString("0.0")</span>
                        </div>
                    </div>

                    <!-- Rent Button -->
                    <button type="button" 
                            class="w-full py-4 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-bold rounded-xl shadow-sm  transition-all duration-300"
                            data-bs-toggle="modal" data-bs-target="#rentModal-@Model.Id">
                        @Localizer["Rent Now"]
                    </button>
                    
                    <p class="text-center text-sm text-slate-500 mt-4">
                        <i class="bi bi-shield-lock me-1"></i>
                        @Localizer["Secure payment and rental"]
                    </p>
                    
                    <!-- Quick Stats -->
                    <div class="grid grid-cols-2 gap-4 mt-6 pt-6 border-t border-slate-200">
                        <div class="text-center">
                            <p class="text-2xl font-bold text-slate-900">@Model.ReviewCount</p>
                            <p class="text-sm text-slate-500">@Localizer["Reviews"]</p>
                        </div>
                        <div class="text-center">
                            <p class="text-2xl font-bold text-slate-900">@(Model.Rentals?.Count ?? 0)</p>
                            <p class="text-sm text-slate-500">@Localizer["Rentals"]</p>
                        </div>
                    </div>
                </div>

                <!-- Safety Tips -->
                <div class="mt-6 p-4 bg-slate-50 rounded-xl">
                    <h3 class="font-semibold text-slate-900 mb-3 flex items-center gap-2">
                        <i class="bi bi-lightbulb text-amber-500"></i>
                        @Localizer["Safety Tips"]
                    </h3>
                    <ul class="space-y-2 text-sm text-slate-600">
                        <li class="flex items-start gap-2">
                            <i class="bi bi-check-circle text-green-500 mt-0.5"></i>
                            <span>@Localizer["Always meet in a public place"]</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="bi bi-check-circle text-green-500 mt-0.5"></i>
                            <span>@Localizer["Inspect the item before renting"]</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="bi bi-check-circle text-green-500 mt-0.5"></i>
                            <span>@Localizer["Use in-app payments only"]</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var lat = @(((double)ViewBag.MapLat).ToString(System.Globalization.CultureInfo.InvariantCulture));
            var lng = @(((double)ViewBag.MapLng).ToString(System.Globalization.CultureInfo.InvariantCulture));
            var cityName = "@ViewBag.MapCityName";

            var map = L.map('map', { scrollWheelZoom: false }).setView([lat, lng], 11);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            var circle = L.circle([lat, lng], {
                color: '#2563eb',
                fillColor: '#2563eb',
                fillOpacity: 0.15,
                radius: 1200
            }).addTo(map);

            circle.bindPopup(`<b>${cityName}</b><br>@Localizer["Approximate pickup location."]`);
        });
    </script>

    <partial name="_RentModal" model="Model" />
}


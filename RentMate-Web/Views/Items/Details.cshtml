@using Microsoft.AspNetCore.Mvc.Localization
@using System.Text.Json
@model RentMate.Models.Item
@inject IViewLocalizer Localizer

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

@{
    ViewData["Title"] = Model.Title;
    var avgRating = Model.AverageRating ?? 0;
    
    // For calendar
    var blockedDates = Model.Rentals?
        .Where(r => r.Status == RentMate.Shared.RentalStatus.Active || r.Status == RentMate.Shared.RentalStatus.Pending)
        .Select(r => new { from = r.StartDate.ToString("yyyy-MM-dd"), to = r.EndDate.ToString("yyyy-MM-dd") })
        .ToList();
    // Serialize blocked dates as JSON array; if null, use an empty array string
    string jsonBlocked = blockedDates != null ? JsonSerializer.Serialize(blockedDates) : "[]";
}

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Rentals" asp-action="Index">@Localizer["Marketplace"]</a></li>
            <li class="breadcrumb-item"><a href="#">@Model.Category</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row mb-4">
        <div class="col-12">
            <h1 class="fw-bold display-5">@Model.Title</h1>
            <div class="d-flex align-items-center gap-3 text-muted">
                <span><i class="bi bi-star-fill text-warning"></i> <strong>@avgRating.ToString("0.0")</strong> (@Model.ReviewCount @Localizer["reviews"])</span>
                <span>•</span>
                <span><i class="bi bi-geo-alt"></i> @Model.User?.City</span>
            </div>
        </div>
    </div>

    <div class="row g-5">
        <div class="col-lg-8">
                <div class="mb-5">
                @if(!string.IsNullOrEmpty(Model.ImageUrl)) {
                    var urlLarge = Model.ImageUrl.Replace("/upload/", "/upload/c_fill,w_1200,h_800,q_auto,f_auto/");
                    var urlMed = Model.ImageUrl.Replace("/upload/", "/upload/c_fill,w_800,h_533,q_auto,f_auto/");
                    <img src="@urlLarge" srcset="@urlMed 800w, @urlLarge 1200w" sizes="(max-width: 992px) 800px, 1200px" loading="lazy" class="img-fluid rounded-4 shadow-sm w-100" style="max-height: 500px; object-fit: cover;" alt="@Model.Title">
                } else {
                    <div class="bg-light rounded-4 d-flex align-items-center justify-content-center" style="height: 400px;">
                        <span class="text-muted"><i class="bi bi-image fs-1"></i> @Localizer["No image"]</span>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-between align-items-center border-bottom pb-4 mb-4">
                <div>
                    <h3 class="fw-bold">@Localizer["Item Description"]</h3>
                    <p class="text-muted">@Localizer["Category"]: @Model.Category</p>
                </div>
                <a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.UserId" class="text-decoration-none text-dark text-center">
                    <img src="@(Model.User?.ProfilePictureUrl ?? "https://via.placeholder.com/60")" 
                         class="rounded-circle object-fit-cover shadow-sm mb-1" style="width: 60px; height: 60px;">
                    <div class="small fw-bold">@Model.User?.FirstName</div>
                </a>
            </div>

            <div class="mb-5">
                <p class="lead fs-6" style="white-space: pre-line;">@Model.Description</p>
            </div>

            <div class="border-top pt-5">
                <h3 class="fw-bold mb-4"><i class="bi bi-star-fill text-warning me-2"></i> @avgRating.ToString("0.0") · @Model.ReviewCount @Localizer["reviews"]</h3>
                
                <div class="row row-cols-1 row-cols-md-2 g-4">
                    @foreach(var review in Model.Reviews.OrderByDescending(r => r.CreatedAt).Take(4))
                    {
                        <div class="col">
                            <div class="card border-0 h-100">
                                <div class="card-body px-0">
                                    <div class="d-flex align-items-center mb-2">
                                        <img src="@(review.Reviewer?.ProfilePictureUrl ?? "https://via.placeholder.com/40")" 
                                             class="rounded-circle me-2 object-fit-cover" style="width: 40px; height: 40px;">
                                        <div>
                                            <div class="fw-bold">@(review.IsAnonymous ? Localizer["Anonymous"] : review.Reviewer?.FirstName)</div>
                                            <div class="text-muted small">@review.CreatedAt.ToString("MMMM yyyy")</div>
                                        </div>
                                    </div>
                                    <div class="mb-1">
                                        @for(int i=0; i<review.Rating; i++){ <i class="bi bi-star-fill text-warning small"></i> }
                                    </div>
                                    <p class="text-muted small">@review.Body</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @if(Model.ReviewCount > 4) {
                    <button class="btn btn-outline-dark mt-3">@Localizer["Show all {0} reviews", Model.ReviewCount]</button>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="sticky-top" style="top: 100px; z-index: 10;">
                <div class="card shadow-lg border-0 rounded-4 p-4">
                    <div class="d-flex justify-content-between align-items-end mb-4">
                        <div>
                                <span class="fs-3 fw-bold">@Model.Price?.ToString("C")</span>
                            <span class="text-muted"> @Localizer["/ day"]</span>
                        </div>
                        <div class="small">
                            <i class="bi bi-star-fill text-warning"></i> @avgRating.ToString("0.0")
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="button" class="btn btn-primary btn-lg rounded-3 fw-bold" data-bs-toggle="modal" data-bs-target="#rentModal-@Model.Id">
                            @Localizer["Rent"]
                        </button>
                    </div>
                    
                    <div class="text-center mt-3 small text-muted">
                        <i class="bi bi-shield-lock"></i> @Localizer["Secure payment and rental"]
                    </div>
                </div>
                <div class="border-top pt-4 mb-5">
                    <h3 class="fw-bold mb-3">@Localizer["Location"]</h3>
                    <p class="text-muted mb-3">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> 
                        @ViewBag.MapCityName 
                        <span class="badge bg-light text-dark border ms-2">@Localizer["Approximate location"]</span>
                    </p>
                    
                    <div id="map" class="shadow-sm rounded-4" style="height: 320px; width: 100%; z-index: 1;"></div>
                    
                    <div class="d-flex align-items-start mt-3 gap-2 text-muted small">
                        <i class="bi bi-shield-check fs-5 text-primary"></i>
                        <p class="mb-0">
                            @Localizer["For safety and privacy, we only show the <strong>approximate area (circle)</strong> where the item is located. You will receive the exact pickup address after booking confirmation."]
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Get coordinates
            var lat = @(((double)ViewBag.MapLat).ToString(System.Globalization.CultureInfo.InvariantCulture));
            var lng = @(((double)ViewBag.MapLng).ToString(System.Globalization.CultureInfo.InvariantCulture));
            var cityName = "@ViewBag.MapCityName";

            // 1. FIX: Zoom level changed from 13 to 11 (more zoomed out to show region)
            var map = L.map('map', { scrollWheelZoom: false }).setView([lat, lng], 11);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            // Adding CIRCLE (Safety zone) - not pin
            var circle = L.circle([lat, lng], {
                color: '#0d6efd',       // Border (RentMate blue)
                fillColor: '#0d6efd',   // Fill
                fillOpacity: 0.15,      // Opacity
                radius: 1200            // 1.2 km radius
            }).addTo(map);

            // Popup remains the same
            circle.bindPopup(`<b>${cityName}</b><br>@Localizer["Approximate pickup location."]`);
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    @* Use shared rent modal partial *@
    <partial name="_RentModal" model="Model" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const pricePerDay = @(Model.Price ?? 0);

            document.querySelectorAll(".rent-daterange-picker").forEach(function (element) {
                const blocked = JSON.parse(element.getAttribute('data-blocked')) || [];
                const form = element.closest('form');
                const startInput = form.querySelector('.start-date-input');
                const endInput = form.querySelector('.end-date-input');
                const calcWrapper = document.getElementById('modalPriceCalculation');
                const calcDays = document.getElementById('modalCalcDays');
                const calcTotalBase = document.getElementById('modalCalcTotalBase');
                const calcFinalTotal = document.getElementById('modalCalcFinalTotal');

                flatpickr(element, {
                    mode: 'range', dateFormat: 'Y-m-d', minDate: 'today', disable: blocked, locale: { firstDayOfWeek: 1 },
                    onChange: function(selectedDates, dateStr, instance) {
                        if (selectedDates.length === 2) {
                            const start = selectedDates[0];
                            const end = selectedDates[1];

                            startInput.value = instance.formatDate(start, 'Y-m-d');
                            endInput.value = instance.formatDate(end, 'Y-m-d');

                            const diffTime = Math.abs(end - start);
                            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
                            const total = diffDays * pricePerDay;

                            if (calcWrapper) {
                                calcDays.innerText = `${diffDays} @Localizer["days x"] ${pricePerDay}€`;
                                calcTotalBase.innerText = `${total.toFixed(2)}€`;
                                calcFinalTotal.innerText = `${total.toFixed(2)}€`;
                                calcWrapper.classList.remove('d-none');
                            }
                        }
                    }
                });
            });
        });
    </script>
}
@model IEnumerable<RentMate.Models.Item>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject RentMate.Services.CurrencyService CurrencyService

@{
    ViewData["Title"] = Localizer["Items List"];
}

<h1>@Localizer["Items"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">@Localizer["Create New Item"]</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Localizer["Title"]
            </th>
            <th>
                @Localizer["Description"]
            </th>
            <th>
                @Localizer["Price"]
            </th>
            <th>
                @Localizer["Owner"]
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @CurrencyService.Format(item.Price)
            </td>
            <td>
                @(item.User?.Email ?? Localizer["No user assigned"].Value)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">@Localizer["Edit"]</a> |
                <a asp-action="Details" asp-route-id="@item.Id">@Localizer["Details"]</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">@Localizer["Delete"]</a>
            </td>
        </tr>
}
    </tbody>
</table>
@model RentMate.Models.ViewModels.ItemDetailsViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<!-- Edit Review Modal -->
<div id="editReviewModal" class="hidden fixed inset-0" style="z-index: var(--z-modal);">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeEditReviewModal()"></div>

    <!-- Modal Content -->
    <div class="relative bg-white dark:bg-slate-800 rounded-2xl shadow-2xl max-w-lg mx-auto mt-20 p-6">
        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
            <h3 class="font-heading text-xl font-bold text-slate-900 dark:text-white">
                @Localizer["Edit Review"]
            </h3>
            <button type="button" onclick="closeEditReviewModal()"
                    class="p-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <!-- Form -->
        <form id="editReviewForm" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editReviewId" name="ReviewId" />

            <!-- Star Picker -->
            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                    @Localizer["Your Rating:"]
                </label>
                <div id="editStarPicker" class="flex gap-1 text-2xl cursor-pointer">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="bi bi-star text-slate-300 dark:text-slate-500 transition-colors hover:text-amber-400"
                           data-value="@i"></i>
                    }
                </div>
                <input type="hidden" id="editRatingInput" name="Rating" value="0" />
            </div>

            <!-- Title -->
            <div>
                <input type="text" id="editReviewTitle" name="Title" maxlength="200"
                       placeholder="@Localizer["Title (optional)"]"
                       class="w-full px-4 py-3 bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
            </div>

            <!-- Body -->
            <div>
                <textarea id="editReviewBody" name="Body" maxlength="2000"
                          placeholder="@Localizer["Write your review..."]"
                          rows="4"
                          class="w-full px-4 py-3 bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors resize-none"></textarea>
            </div>

            <!-- Anonymous Checkbox -->
            <label class="inline-flex items-center gap-2 text-slate-600 dark:text-slate-400 cursor-pointer">
                <input type="checkbox" id="editReviewAnonymous" name="IsAnonymous"
                       class="w-5 h-5 text-blue-600 border-slate-300 dark:border-slate-600 rounded focus:ring-blue-500" />
                <span class="text-sm">@Localizer["Post anonymously"]</span>
            </label>

            <!-- Buttons -->
            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" onclick="closeEditReviewModal()"
                        class="px-5 py-2.5 text-slate-600 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 font-medium rounded-xl hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                    @Localizer["Cancel"]
                </button>
                <button type="submit"
                        class="px-6 py-2.5 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-semibold rounded-xl hover:shadow-md transition-all">
                    @Localizer["Save"]
                </button>
            </div>
        </form>
    </div>
</div>

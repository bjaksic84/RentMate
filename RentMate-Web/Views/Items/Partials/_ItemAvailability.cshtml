@model RentMate.Models.ViewModels.ItemDetailsViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6">
    <h2 class="font-heading text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
        <i class="bi bi-calendar3 text-blue-500"></i>
        @Localizer["Availability"]
    </h2>

    <div id="availabilityCalendar" class="select-none"></div>

    <div class="flex items-center gap-4 mt-4 text-sm text-slate-500 dark:text-slate-400">
        <div class="flex items-center gap-2">
            <div class="w-4 h-4 rounded bg-white dark:bg-slate-700 border border-slate-300 dark:border-slate-500"></div>
            <span>@Localizer["Available"]</span>
        </div>
        <div class="flex items-center gap-2">
            <div class="w-4 h-4 rounded bg-red-100 dark:bg-red-900/30 border border-red-300 dark:border-red-700"></div>
            <span>@Localizer["Booked"]</span>
        </div>
        <div class="flex items-center gap-2">
            <div class="w-4 h-4 rounded ring-2 ring-blue-500 bg-white dark:bg-slate-700"></div>
            <span>@Localizer["Today"]</span>
        </div>
    </div>
</div>

@model RentMate.Models.ViewModels.ItemDetailsViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@if (Model.MapLat.HasValue && Model.MapLng.HasValue && Model.MapLat != 0 && Model.MapLng != 0)
{
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6">
        <h2 class="font-heading text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
            <i class="bi bi-geo-alt-fill text-red-500"></i>
            @Localizer["Pickup Location"]
        </h2>

        <div class="flex items-center gap-2 text-slate-600 dark:text-slate-400 mb-4">
            <i class="bi bi-geo-alt text-slate-400"></i>
            <span>@Model.MapCityName</span>
            <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400 text-xs rounded-full">@Localizer["Approximate location"]</span>
        </div>

        <div id="detailMap" class="h-[300px] rounded-xl overflow-hidden shadow-inner border border-slate-200 dark:border-slate-700"></div>

        <div class="flex items-start gap-3 mt-4 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-xl">
            <i class="bi bi-shield-check text-blue-600 dark:text-blue-400 text-xl flex-shrink-0"></i>
            <p class="text-sm text-blue-800 dark:text-blue-300">
                @Localizer["For safety and privacy, we only show the approximate area where the item is located. You will receive the exact pickup address after booking confirmation."]
            </p>
        </div>
    </div>
}

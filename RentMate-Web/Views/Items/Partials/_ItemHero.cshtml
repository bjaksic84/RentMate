@model RentMate.Models.ViewModels.ItemDetailsViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    var avgRating = Model.AverageRating ?? 0;
    var fullStars = (int)Math.Floor(avgRating);
    var hasHalf = (avgRating - fullStars) >= 0.5;
    var emptyStars = 5 - fullStars - (hasHalf ? 1 : 0);
}

<div class="relative">
    <div class="flex items-start justify-between gap-4">
        <div class="min-w-0">
            <h1 class="font-heading text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-3">@Model.Title</h1>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-slate-600 dark:text-slate-400">
                <!-- Star Rating -->
                <div class="flex items-center gap-1.5">
                    <div class="flex items-center gap-0.5">
                        @for (int i = 0; i < fullStars; i++)
                        {
                            <i class="bi bi-star-fill text-amber-400"></i>
                        }
                        @if (hasHalf)
                        {
                            <i class="bi bi-star-half text-amber-400"></i>
                        }
                        @for (int i = 0; i < emptyStars; i++)
                        {
                            <i class="bi bi-star text-slate-300 dark:text-slate-500"></i>
                        }
                    </div>
                    <span class="font-semibold text-slate-900 dark:text-white">@avgRating.ToString("0.0")</span>
                    <span class="text-slate-500 dark:text-slate-400">(@Model.ReviewCount @Localizer["reviews"])</span>
                </div>

                <span class="text-slate-300 dark:text-slate-600 hidden sm:inline">&middot;</span>

                <!-- Location -->
                <div class="flex items-center gap-1">
                    <i class="bi bi-geo-alt-fill text-blue-500" aria-hidden="true"></i>
                    <span>@(Model.OwnerCity ?? Localizer["Location not specified"].Value)</span>
                </div>

                <span class="text-slate-300 dark:text-slate-600 hidden sm:inline">&middot;</span>

                <!-- Category Badge -->
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300">
                    <i class="bi bi-tag-fill text-[10px]" aria-hidden="true"></i>
                    @Localizer[Model.Category ?? ""]
                </span>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2 flex-shrink-0 pt-1">
            <button type="button"
                    id="shareBtn"
                    title="@Localizer["Share"]"
                    class="h-10 flex items-center justify-center gap-2 px-3 lg:px-4 rounded-full border border-slate-200 dark:border-slate-600 text-slate-500 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 hover:border-blue-300 dark:hover:border-blue-500 transition-all">
                <i class="bi bi-share text-lg"></i>
                <span class="hidden lg:inline text-sm font-medium">@Localizer["Share"]</span>
            </button>
            <!-- TODO: Report button -->
        </div>
    </div>
</div>

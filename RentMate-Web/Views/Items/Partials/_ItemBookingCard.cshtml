@model RentMate.Models.ViewModels.ItemDetailsViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService

<div class="sticky top-24">
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-md p-6">
        <!-- Price -->
        <div class="flex items-end justify-between mb-6">
            <div>
                <span class="text-3xl font-bold text-slate-900 dark:text-white">@CurrencyService.Format(Model.Price)</span>
                <span class="text-slate-500 dark:text-slate-400"> / @Localizer["day"]</span>
            </div>
            @if (Model.AverageRating.HasValue && Model.AverageRating > 0)
            {
                <div class="flex items-center gap-1 text-sm">
                    <i class="bi bi-star-fill text-amber-400"></i>
                    <span class="font-semibold text-slate-900 dark:text-white">@Model.AverageRating.Value.ToString("0.0")</span>
                </div>
            }
        </div>

        <!-- Deposit info -->
        @if (Model.DepositAmount.HasValue && Model.DepositAmount.Value > 0)
        {
            <div class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-4 p-3 bg-slate-50 dark:bg-slate-700/50 rounded-xl">
                <i class="bi bi-shield-check text-blue-500"></i>
                <span>+ @CurrencyService.Format(Model.DepositAmount.Value) @Localizer["Deposit"] (@Localizer["refundable"])</span>
            </div>
        }

        <!-- Trust signals -->
        <div class="space-y-2 mb-6">
            <div class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400">
                <i class="bi bi-lock-fill text-green-500"></i>
                <span>@Localizer["Secure payment via Stripe"]</span>
            </div>
            @if (Model.OwnerTrustScore >= 70)
            {
                <div class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400">
                    <i class="bi bi-patch-check-fill text-blue-500"></i>
                    <span>@Localizer["Trusted Host"]</span>
                </div>
            }
        </div>

        <!-- Rent Now button (only for non-owners) -->
        @if (!Model.IsOwner)
        {
            <button type="button"
                    class="w-full py-4 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-bold rounded-xl shadow-sm transition-all duration-300"
                    onclick="document.getElementById('rentModal-@Model.ItemId').classList.remove('hidden')">
                @Localizer["Rent Now"]
            </button>
        }

        <p class="text-center text-sm text-slate-500 dark:text-slate-400 mt-4">
            <i class="bi bi-shield-lock me-1"></i>
            @Localizer["Secure payment and rental"]
        </p>

        <!-- Quick Stats -->
        <div class="grid grid-cols-2 gap-4 mt-6 pt-6 border-t border-slate-200 dark:border-slate-700">
            <div class="text-center">
                <p class="text-2xl font-bold text-slate-900 dark:text-white">@Model.ReviewCount</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">@Localizer["Reviews"]</p>
            </div>
            <div class="text-center">
                <p class="text-2xl font-bold text-slate-900 dark:text-white">@Model.ItemRentalCount</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">@Localizer["Rentals"]</p>
            </div>
        </div>
    </div>

    <!-- Safety Tips -->
    <div class="mt-6 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-xl border border-slate-200 dark:border-slate-700">
        <h3 class="font-semibold text-slate-900 dark:text-white mb-3 flex items-center gap-2">
            <i class="bi bi-lightbulb text-amber-500"></i>
            @Localizer["Safety Tips"]
        </h3>
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
            <li class="flex items-start gap-2">
                <i class="bi bi-check-circle text-green-500 mt-0.5"></i>
                <span>@Localizer["Always meet in a public place"]</span>
            </li>
            <li class="flex items-start gap-2">
                <i class="bi bi-check-circle text-green-500 mt-0.5"></i>
                <span>@Localizer["Inspect the item before renting"]</span>
            </li>
            <li class="flex items-start gap-2">
                <i class="bi bi-check-circle text-green-500 mt-0.5"></i>
                <span>@Localizer["Use in-app payments only"]</span>
            </li>
        </ul>
    </div>
</div>

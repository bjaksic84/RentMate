@using Microsoft.AspNetCore.Mvc.Localization
@model RentMate.Models.ViewModels.ItemDetailsViewModel
@inject IViewLocalizer Localizer

@{
    var isVerified = Model.OwnerIsPhoneVerified || Model.OwnerIsGovernmentIdVerified;
    var firstInitial = !string.IsNullOrEmpty(Model.OwnerName) ? Model.OwnerName[0].ToString().ToUpper() : "?";

    string FormatResponseTime(double hours)
    {
        if (hours < 1) return Localizer["Less than 1 hour"].Value;
        if (hours < 24) return Localizer["Less than {0} hours", (int)Math.Ceiling(hours)].Value;
        return Localizer["{0} days", (int)Math.Ceiling(hours / 24)].Value;
    }
}

<div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6 shadow-sm">

    @* --- Avatar + Name --- *@
    <div class="flex items-start gap-4 mb-5">
        <div class="relative flex-shrink-0">
            @if (!string.IsNullOrEmpty(Model.OwnerProfilePictureUrl))
            {
                <img src="@Model.OwnerProfilePictureUrl"
                     alt="@Model.OwnerName"
                     class="w-16 h-16 rounded-full object-cover" />
            }
            else
            {
                <div class="w-16 h-16 rounded-full bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center">
                    <span class="text-white text-xl font-semibold font-heading">@firstInitial</span>
                </div>
            }
            @if (isVerified)
            {
                <span class="absolute bottom-0 right-0 w-5 h-5 bg-green-500 rounded-full flex items-center justify-center border-2 border-white dark:border-slate-800">
                    <i class="bi bi-check text-white" style="font-size: 0.65rem; line-height: 1;"></i>
                </span>
            }
        </div>

        <div class="flex-1 min-w-0">
            <a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.OwnerId"
               class="font-semibold text-slate-900 dark:text-slate-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors truncate block font-heading text-base">
                @Model.OwnerName
            </a>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">
                @if (Model.OwnerMemberSince.Year >= 2000)
                {
                    @Localizer["Member since"] @Model.OwnerMemberSince.ToString("MMMM yyyy")
                }
                else
                {
                    @Localizer["Member since"] @DateTime.UtcNow.Year
                }
            </p>

            @* Owner rating *@
            @if (Model.OwnerAverageRating > 0)
            {
                <div class="flex items-center gap-1 mt-1">
                    @{
                        int fullStars = (int)Math.Floor(Model.OwnerAverageRating);
                        bool hasHalfStar = (Model.OwnerAverageRating - fullStars) >= 0.5;
                    }
                    @for (int i = 0; i < 5; i++)
                    {
                        if (i < fullStars)
                        {
                            <i class="bi bi-star-fill text-amber-400" style="font-size: 0.75rem;"></i>
                        }
                        else if (i == fullStars && hasHalfStar)
                        {
                            <i class="bi bi-star-half text-amber-400" style="font-size: 0.75rem;"></i>
                        }
                        else
                        {
                            <i class="bi bi-star text-slate-300 dark:text-slate-500" style="font-size: 0.75rem;"></i>
                        }
                    }
                    <span class="text-xs font-medium text-slate-600 dark:text-slate-400 ml-0.5">
                        @Model.OwnerAverageRating.ToString("F1")
                    </span>
                </div>
            }
        </div>
    </div>

    @* --- Stats Row --- *@
    @{
        var hasResponseData = Model.OwnerCompletedRentals > 0 && (Model.OwnerResponseRate > 0 || Model.OwnerAvgResponseTimeHours > 0);
    }
    <div class="flex items-center divide-x divide-slate-200 dark:divide-slate-700 mb-5 @(!hasResponseData ? "justify-center" : "")">
        @if (hasResponseData)
        {
            <div class="flex-1 flex flex-col items-center px-3 first:pl-0 last:pr-0 gap-0.5">
                <div class="flex items-center gap-1 text-slate-700 dark:text-slate-300">
                    <i class="bi bi-chat-dots text-blue-500" style="font-size: 0.85rem;"></i>
                    <span class="font-semibold text-sm">@Model.OwnerResponseRate%</span>
                </div>
                <span class="text-xs text-slate-500 dark:text-slate-400 text-center leading-tight">@Localizer["Response Rate"]</span>
            </div>
            <div class="flex-1 flex flex-col items-center px-3 gap-0.5">
                <div class="flex items-center gap-1 text-slate-700 dark:text-slate-300">
                    <i class="bi bi-clock text-blue-500" style="font-size: 0.85rem;"></i>
                    <span class="font-semibold text-sm">@FormatResponseTime(Model.OwnerAvgResponseTimeHours)</span>
                </div>
                <span class="text-xs text-slate-500 dark:text-slate-400 text-center leading-tight">@Localizer["Response Time"]</span>
            </div>
        }
        <div class="flex-1 flex flex-col items-center px-3 first:pl-0 last:pr-0 gap-0.5">
            <div class="flex items-center gap-1 text-slate-700 dark:text-slate-300">
                <i class="bi bi-box-seam text-blue-500" style="font-size: 0.85rem;"></i>
                <span class="font-semibold text-sm">@Model.OwnerCompletedRentals</span>
            </div>
            <span class="text-xs text-slate-500 dark:text-slate-400 text-center leading-tight">@Localizer["Completed Rentals"]</span>
        </div>
    </div>

    @* --- Verification Badges --- *@
    @{
        bool hasAnyBadge = Model.OwnerIsPhoneVerified || Model.OwnerIsGovernmentIdVerified || Model.OwnerTrustScore >= 70;
    }
    @if (hasAnyBadge)
    {
        <div class="flex flex-wrap gap-2 mb-5">
            @if (Model.OwnerIsPhoneVerified)
            {
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-400 border border-green-200 dark:border-green-800">
                    <i class="bi bi-phone" style="font-size: 0.75rem;"></i>
                    @Localizer["Phone Verified"]
                </span>
            }
            @if (Model.OwnerIsGovernmentIdVerified)
            {
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-400 border border-green-200 dark:border-green-800">
                    <i class="bi bi-person-badge" style="font-size: 0.75rem;"></i>
                    @Localizer["ID Verified"]
                </span>
            }
            @if (Model.OwnerTrustScore >= 70)
            {
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-400 border border-blue-200 dark:border-blue-800">
                    <i class="bi bi-shield-check" style="font-size: 0.75rem;"></i>
                    @Localizer["Trusted Host"]
                </span>
            }
        </div>
    }

    @* --- View Profile Button --- *@
    <a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.OwnerId"
       class="flex items-center justify-center gap-2 w-full px-4 py-2.5 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 rounded-xl text-sm font-medium hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors">
        <i class="bi bi-person"></i>
        @Localizer["View Profile"]
    </a>

</div>

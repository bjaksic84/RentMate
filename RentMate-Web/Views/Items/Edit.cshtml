@model RentMate.Models.Domain.Item
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService

@{
    ViewData["Title"] = Localizer["Edit item"];
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        @await Html.PartialAsync("_BackLink", new { Controller = "Dashboard", Action = "UserDashboard", Text = Localizer["Back to Dashboard"].Value })
        <h1 class="font-heading text-3xl font-bold text-slate-900">@Localizer["Edit Item"]</h1>
        <p class="text-slate-500 mt-1">@Localizer["Update your listing details"]</p>
    </div>

    <form asp-action="Edit" enctype="multipart/form-data" class="space-y-8">
        <div asp-validation-summary="ModelOnly" class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-600 text-sm"></div>
        <input type="hidden" asp-for="Id" />

        <!-- Image Section -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6">
            <h2 class="font-heading text-lg font-semibold text-slate-900 dark:text-white mb-1">@Localizer["Item Photos"]</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">@Localizer["Manage your item photos. Drag to reorder. The first image is the main photo."]</p>

            <!-- Existing Images -->
            <div id="existingImagesContainer" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 mb-4">
                @if (Model.Images != null && Model.Images.Any())
                {
                    foreach (var image in Model.Images.OrderBy(i => i.DisplayOrder))
                    {
                        var thumbUrl = image.ImageUrl.Replace("/upload/", "/upload/c_fill,w_200,h_200,q_auto/");
                        <div class="relative group aspect-square existing-image" data-id="@image.Id" data-order="@image.DisplayOrder">
                            <img src="@thumbUrl" class="w-full h-full object-cover rounded-xl border-2 @(image.DisplayOrder == 0 ? "border-blue-500" : "border-slate-200 dark:border-slate-600")" draggable="false" />
                            @if (image.DisplayOrder == 0)
                            {
                                <span class="absolute top-2 left-2 px-2 py-0.5 bg-blue-600 text-white text-xs font-medium rounded-full">@Localizer["Main"]</span>
                            }
                            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity rounded-xl flex items-center justify-center gap-2">
                                <button type="button" onclick="setAsPrimary(@image.Id)" class="w-8 h-8 bg-white hover:bg-blue-50 text-blue-600 rounded-full flex items-center justify-center" title="@Localizer["Set as main"]">
                                    <i class="bi bi-star-fill text-sm"></i>
                                </button>
                                <button type="button" onclick="deleteExistingImage(@image.Id)" class="w-8 h-8 bg-white hover:bg-red-50 text-red-600 rounded-full flex items-center justify-center" title="@Localizer["Delete"]">
                                    <i class="bi bi-trash text-sm"></i>
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Add More Images -->
            <div id="dropZone" class="border-2 border-dashed border-slate-300 dark:border-slate-600 rounded-xl p-6 text-center hover:border-blue-400 hover:bg-blue-50/50 dark:hover:bg-blue-900/20 transition-colors cursor-pointer">
                <div class="space-y-2">
                    <i class="bi bi-cloud-arrow-up text-2xl text-slate-400"></i>
                    <p class="text-sm font-medium text-slate-700 dark:text-slate-300">@Localizer["Add more photos"]</p>
                    <div class="flex flex-wrap justify-center gap-2">
                        <label class="inline-flex items-center gap-1 px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg cursor-pointer transition-colors">
                            <i class="bi bi-camera"></i>
                            @Localizer["Camera"]
                            <input type="file" name="images" id="cameraInput" class="hidden" accept="image/*" capture="environment" onchange="handleNewFiles(this.files)" />
                        </label>
                        <label class="inline-flex items-center gap-1 px-3 py-2 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 text-sm font-medium rounded-lg cursor-pointer transition-colors">
                            <i class="bi bi-images"></i>
                            @Localizer["Browse"]
                            <input type="file" name="images" id="fileInput" class="hidden" accept="image/*" multiple onchange="handleNewFiles(this.files)" />
                        </label>
                    </div>
                </div>
            </div>

            <!-- New Image Previews (for images to be uploaded) -->
            <div id="newImagePreviews" class="mt-4 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 hidden"></div>
            <p id="imageStatus" class="text-sm text-slate-500 dark:text-slate-400 mt-2"></p>
        </div>

        <!-- Basic Info -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6">
            <h2 class="font-heading text-lg font-semibold text-slate-900 mb-4">@Localizer["Basic Information"]</h2>
            
            <div class="space-y-4">
                <div>
                    <label asp-for="Title" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Title"]</label>
                    <input asp-for="Title" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
                    <span asp-validation-for="Title" class="text-red-500 text-sm mt-1"></span>
                </div>
                
                <div class="grid sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Category" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Category"]</label>
                        @await Html.PartialAsync("_CategorySelect", new { Name = "Category", SelectedValue = Model?.Category })
                        <span asp-validation-for="Category" class="text-red-500 text-sm mt-1"></span>
                    </div>
                    <div>
                        <label asp-for="Price" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Price per day"]</label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">@CurrencyService.GetSymbol()</span>
                            <input asp-for="Price" type="number" step="0.01" min="0" class="w-full pl-10 pr-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
                        </div>
                        <span asp-validation-for="Price" class="text-red-500 text-sm mt-1"></span>
                    </div>
                </div>
                
                <div>
                    <label asp-for="Description" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Description"]</label>
                    <textarea asp-for="Description" rows="4" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors resize-none"></textarea>
                    <span asp-validation-for="Description" class="text-red-500 text-sm mt-1"></span>
                </div>
            </div>
        </div>

        <!-- Rental Settings -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6">
            <h2 class="font-heading text-lg font-semibold text-slate-900 dark:text-white mb-1">@Localizer["Rental Settings"]</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">@Localizer["Configure deposit, extensions, and rental limits"]</p>

            <div class="space-y-4">
                <div class="grid sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="DepositAmount" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">@Localizer["Deposit Amount"]</label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">@CurrencyService.GetSymbol()</span>
                            <input asp-for="DepositAmount" type="number" step="0.01" min="0" class="w-full pl-10 pr-4 py-3 border border-slate-200 dark:border-slate-600 dark:bg-slate-700 dark:text-white rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" placeholder="0.00" />
                        </div>
                        <p class="text-xs text-slate-400 mt-1">@Localizer["Leave empty for no deposit requirement"]</p>
                    </div>
                    <div>
                        <label asp-for="MaxRentalDays" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">@Localizer["Max Rental Days"]</label>
                        <input asp-for="MaxRentalDays" type="number" min="1" class="w-full px-4 py-3 border border-slate-200 dark:border-slate-600 dark:bg-slate-700 dark:text-white rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" placeholder="@Localizer["No limit"]" />
                        <p class="text-xs text-slate-400 mt-1">@Localizer["Leave empty for no limit"]</p>
                    </div>
                </div>

                <div class="flex items-center gap-3 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl">
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input asp-for="AutoApproveExtensions" type="checkbox" class="sr-only peer" />
                        <div class="w-11 h-6 bg-slate-200 peer-focus:ring-2 peer-focus:ring-blue-500 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                    </label>
                    <div>
                        <p class="text-sm font-medium text-slate-700 dark:text-slate-300">@Localizer["Auto-approve Extensions"]</p>
                        <p class="text-xs text-slate-400">@Localizer["Automatically approve extension requests when no scheduling conflict exists"]</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Accessories -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h2 class="font-heading text-lg font-semibold text-slate-900 dark:text-white">@Localizer["Accessories"]</h2>
                    <p class="text-sm text-slate-500 dark:text-slate-400">@Localizer["Add optional extras renters can include"]</p>
                </div>
                <button type="button" id="addAccessoryBtn" class="px-4 py-2 text-sm font-medium text-blue-600 border border-blue-200 rounded-xl hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors">
                    <i class="bi bi-plus-lg mr-1"></i>@Localizer["Add"]
                </button>
            </div>

            <div id="accessoriesList" class="space-y-3">
                <!-- Populated by JS -->
            </div>
            <div id="noAccessories" class="text-center py-8 text-slate-400 hidden">
                <i class="bi bi-puzzle text-3xl mb-2 block"></i>
                <p class="text-sm">@Localizer["No accessories yet. Add extras like chargers, cases, or bags."]</p>
            </div>

            <!-- Add/Edit Form (hidden by default) -->
            <div id="accessoryForm" class="hidden mt-4 p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border border-slate-200 dark:border-slate-600">
                <input type="hidden" id="accEditId" value="" />
                <div class="grid sm:grid-cols-2 gap-3 mb-3">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">@Localizer["Accessory Name"]</label>
                        <input id="accName" type="text" maxlength="100" class="w-full px-3 py-2 border border-slate-200 dark:border-slate-600 dark:bg-slate-700 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-blue-500" placeholder="@Localizer["e.g. Charger, Case, Tripod"]" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">@Localizer["Daily Price"]</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm">@CurrencyService.GetSymbol()</span>
                            <input id="accPrice" type="number" step="0.01" min="0" class="w-full pl-8 pr-3 py-2 border border-slate-200 dark:border-slate-600 dark:bg-slate-700 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-blue-500" placeholder="0.00" />
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">@Localizer["Description"] <span class="text-slate-400 font-normal">(@Localizer["Optional"])</span></label>
                    <input id="accDesc" type="text" maxlength="500" class="w-full px-3 py-2 border border-slate-200 dark:border-slate-600 dark:bg-slate-700 dark:text-white rounded-lg text-sm focus:ring-2 focus:ring-blue-500" />
                </div>
                <div class="flex gap-2 justify-end">
                    <button type="button" id="accCancelBtn" class="px-4 py-2 text-sm text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-600 rounded-lg transition-colors">@Localizer["Cancel"]</button>
                    <button type="button" id="accSaveBtn" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition-colors">@Localizer["Save"]</button>
                </div>
            </div>
        </div>

        <!-- Location -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6">
            <h2 class="font-heading text-lg font-semibold text-slate-900 dark:text-white mb-4">@Localizer["Pickup Location"]</h2>
            
            <div>
                <label asp-for="Location" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Address"]</label>
                <div class="flex gap-2">
                    <input asp-for="Location" id="locationInput" class="flex-1 px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" placeholder="@Localizer["e.g. Ljubljana, Slovenia"]" />
                    <button type="button" id="getLocationBtn" onclick="getCurrentLocation()" class="px-4 py-3 border border-slate-200 rounded-xl text-slate-600 hover:bg-slate-50 transition-colors flex items-center gap-2">
                        <i class="bi bi-geo-alt"></i>
                        <span class="hidden sm:inline">@Localizer["Use My Location"]</span>
                    </button>
                </div>
                <p class="text-sm text-slate-400 mt-2">@Localizer["Enter a pickup address or use your current location"]</p>
                <span asp-validation-for="Location" class="text-red-500 text-sm"></span>
                <div id="locationStatus" class="text-sm mt-1"></div>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-3 justify-between pt-4">
            <a asp-controller="Items" asp-action="Delete" asp-route-id="@Model.Id"
               class="px-5 py-3 border border-red-200 dark:border-red-800 rounded-xl text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors text-center font-medium flex items-center gap-2">
                <i class="bi bi-trash"></i>
                @Localizer["Delete Item"]
            </a>
            <div class="flex flex-col sm:flex-row gap-3">
                <a asp-controller="Dashboard" asp-action="UserDashboard" class="px-6 py-3 border border-slate-200 rounded-xl text-slate-600 hover:bg-slate-50 transition-colors text-center font-medium">
                    @Localizer["Cancel"]
                </a>
                <button type="submit" class="px-8 py-3 bg-gradient-to-r from-blue-600 to-blue-500 text-white rounded-xl font-semibold hover:shadow-md transition-all">
                    @Localizer["Save changes"]
                </button>
            </div>
        </div>
    </form>
</div>

<!-- GDPR Location Consent Modal -->
<div id="locationConsentModal" class="fixed inset-0 hidden" style="z-index: var(--z-modal, 1200);">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" style="z-index: var(--z-modal-backdrop, 1100);" onclick="closeLocationModal()"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md" style="z-index: var(--z-modal, 1200);">
        <div class="bg-white rounded-2xl shadow-2xl p-6 m-4">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                    <i class="bi bi-geo-alt text-blue-600 text-xl"></i>
                </div>
                <h3 class="font-heading text-xl font-bold text-slate-900">@Localizer["Location Access"]</h3>
            </div>
            <p class="text-slate-600 mb-2">@Localizer["We would like to access your location to set the default pickup location for your item."]</p>
            <p class="text-sm text-slate-400 mb-6">@Localizer["Your location data will only be used to display the pickup location to potential renters. You can always enter a custom address instead."]</p>
            <div class="flex gap-3">
                <button type="button" onclick="closeLocationModal()" class="flex-1 px-4 py-3 border border-slate-200 rounded-xl text-slate-600 hover:bg-slate-50 transition-colors font-medium">
                    @Localizer["No, thanks"]
                </button>
                <button type="button" onclick="requestGeolocation()" class="flex-1 px-4 py-3 bg-gradient-to-r from-blue-600 to-blue-500 text-white rounded-xl font-semibold hover:shadow-lg transition-all">
                    @Localizer["Allow"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Multi-image handling
        var itemId = @Model.Id;
        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        var newFiles = [];
        var dropZone = document.getElementById('dropZone');
        var newPreviewContainer = document.getElementById('newImagePreviews');
        var statusEl = document.getElementById('imageStatus');

        // Drag and drop handlers
        dropZone.addEventListener('dragover', function(e) {
            e.preventDefault();
            dropZone.classList.add('border-blue-400', 'bg-blue-50');
        });

        dropZone.addEventListener('dragleave', function(e) {
            e.preventDefault();
            dropZone.classList.remove('border-blue-400', 'bg-blue-50');
        });

        dropZone.addEventListener('drop', function(e) {
            e.preventDefault();
            dropZone.classList.remove('border-blue-400', 'bg-blue-50');
            handleNewFiles(e.dataTransfer.files);
        });

        dropZone.addEventListener('click', function(e) {
            if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'LABEL' && !e.target.closest('label')) {
                document.getElementById('fileInput').click();
            }
        });

        function handleNewFiles(files) {
            var validTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
            var maxSize = 20 * 1024 * 1024; // 20MB (matches server limit)

            var allFiles = Array.from(files);
            var validFiles = allFiles.filter(function(file) {
                return validTypes.includes(file.type) && file.size <= maxSize;
            });
            var rejectedCount = allFiles.length - validFiles.length;

            if (rejectedCount > 0) {
                alert('@Localizer["Some files were rejected (wrong type or too large)."]');
            }

            var existingCount = document.querySelectorAll('.existing-image').length;
            var maxImages = 10;
            if (existingCount + newFiles.length + validFiles.length > maxImages) {
                alert('@Localizer["Maximum {0} images allowed", 10]');
                validFiles = validFiles.slice(0, maxImages - existingCount - newFiles.length);
            }

            newFiles = newFiles.concat(validFiles);
            updateNewFilePreviews();
            updateFileInput();
        }

        function updateNewFilePreviews() {
            newPreviewContainer.innerHTML = '';
            if (newFiles.length === 0) {
                newPreviewContainer.classList.add('hidden');
                return;
            }

            newPreviewContainer.classList.remove('hidden');
            statusEl.textContent = newFiles.length + ' @Localizer["new image(s) to upload"]';

            newFiles.forEach(function(file, index) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var div = document.createElement('div');
                    div.className = 'relative group aspect-square';
                    div.innerHTML = '<img src="' + e.target.result + '" class="w-full h-full object-cover rounded-xl border-2 border-dashed border-green-400" />' +
                        '<span class="absolute top-2 left-2 px-2 py-0.5 bg-green-500 text-white text-xs font-medium rounded-full">@Localizer["New"]</span>' +
                        '<button type="button" onclick="removeNewFile(' + index + ')" class="absolute top-2 right-2 w-7 h-7 bg-red-500 hover:bg-red-600 text-white rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity"><i class="bi bi-x"></i></button>';
                    newPreviewContainer.appendChild(div);
                };
                reader.readAsDataURL(file);
            });
        }

        function removeNewFile(index) {
            newFiles.splice(index, 1);
            updateNewFilePreviews();
            updateFileInput();
        }

        function updateFileInput() {
            var dt = new DataTransfer();
            newFiles.forEach(function(file) { dt.items.add(file); });
            document.getElementById('fileInput').files = dt.files;
        }

        function deleteExistingImage(imageId) {
            if (!confirm('@Localizer["Delete this image?"]')) return;

            fetch('/Items/DeleteImage?imageId=' + imageId, {
                method: 'POST',
                headers: { 'X-CSRF-TOKEN': token, 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    var el = document.querySelector('.existing-image[data-id="' + imageId + '"]');
                    if (el) el.remove();
                    refreshExistingImages();
                } else {
                    alert(data.message || '@Localizer["Failed to delete image"]');
                }
            });
        }

        function setAsPrimary(imageId) {
            fetch('/Items/SetPrimaryImage?imageId=' + imageId, {
                method: 'POST',
                headers: { 'X-CSRF-TOKEN': token, 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    refreshExistingImages();
                } else {
                    alert(data.message || '@Localizer["Failed to set primary image"]');
                }
            });
        }

        function refreshExistingImages() {
            fetch('/Items/GetImages?itemId=' + itemId)
                .then(function(r) { return r.json(); })
                .then(function(images) {
                    var container = document.getElementById('existingImagesContainer');
                    container.innerHTML = '';
                    images.forEach(function(img) {
                        var thumbUrl = img.imageUrl.replace('/upload/', '/upload/c_fill,w_200,h_200,q_auto/');
                        var isPrimary = img.displayOrder === 0;
                        var div = document.createElement('div');
                        div.className = 'relative group aspect-square existing-image';
                        div.setAttribute('data-id', img.id);
                        div.setAttribute('data-order', img.displayOrder);
                        div.innerHTML = '<img src="' + thumbUrl + '" class="w-full h-full object-cover rounded-xl border-2 ' + (isPrimary ? 'border-blue-500' : 'border-slate-200 dark:border-slate-600') + '" draggable="false" />' +
                            (isPrimary ? '<span class="absolute top-2 left-2 px-2 py-0.5 bg-blue-600 text-white text-xs font-medium rounded-full">@Localizer["Main"]</span>' : '') +
                            '<div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity rounded-xl flex items-center justify-center gap-2">' +
                            '<button type="button" onclick="setAsPrimary(' + img.id + ')" class="w-8 h-8 bg-white hover:bg-blue-50 text-blue-600 rounded-full flex items-center justify-center" title="@Localizer["Set as main"]"><i class="bi bi-star-fill text-sm"></i></button>' +
                            '<button type="button" onclick="deleteExistingImage(' + img.id + ')" class="w-8 h-8 bg-white hover:bg-red-50 text-red-600 rounded-full flex items-center justify-center" title="@Localizer["Delete"]"><i class="bi bi-trash text-sm"></i></button>' +
                            '</div>';
                        container.appendChild(div);
                    });
                });
        }

        // Location modal
        function getCurrentLocation() {
            if (!navigator.geolocation) {
                showLocationStatus('@Localizer["Geolocation is not supported by your browser"]', 'text-red-500');
                return;
            }
            document.getElementById('locationConsentModal').classList.remove('hidden');
        }

        function closeLocationModal() {
            document.getElementById('locationConsentModal').classList.add('hidden');
        }

        function requestGeolocation() {
            closeLocationModal();
            showLocationStatus('@Localizer["Getting your location..."]', 'text-blue-500');
            document.getElementById('getLocationBtn').disabled = true;
            
            navigator.geolocation.getCurrentPosition(
                function(position) {
                    reverseGeocode(position.coords.latitude, position.coords.longitude);
                },
                function(error) {
                    document.getElementById('getLocationBtn').disabled = false;
                    switch(error.code) {
                        case error.PERMISSION_DENIED:
                            showLocationStatus('@Localizer["Location access denied. Please enter your address manually."]', 'text-amber-500');
                            break;
                        case error.POSITION_UNAVAILABLE:
                            showLocationStatus('@Localizer["Location unavailable. Please enter your address manually."]', 'text-amber-500');
                            break;
                        default:
                            showLocationStatus('@Localizer["Unable to get location. Please enter your address manually."]', 'text-amber-500');
                    }
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 300000 }
            );
        }

        function reverseGeocode(lat, lng) {
            fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=16&addressdetails=1`, {
                headers: { 'Accept-Language': document.documentElement.lang || 'en' }
            })
            .then(response => response.json())
            .then(data => {
                document.getElementById('getLocationBtn').disabled = false;
                if (data && data.address) {
                    const addr = data.address;
                    let location = '';
                    if (addr.road) location += addr.road;
                    if (addr.house_number) location += ' ' + addr.house_number;
                    if (addr.city || addr.town || addr.village) {
                        if (location) location += ', ';
                        location += addr.city || addr.town || addr.village;
                    }
                    if (addr.country) {
                        if (location) location += ', ';
                        location += addr.country;
                    }
                    document.getElementById('locationInput').value = location || data.display_name;
                    showLocationStatus('@Localizer["Location set successfully!"]', 'text-green-500');
                } else {
                    document.getElementById('locationInput').value = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                    showLocationStatus('@Localizer["Location set (coordinates)"]', 'text-green-500');
                }
            })
            .catch(error => {
                document.getElementById('getLocationBtn').disabled = false;
                document.getElementById('locationInput').value = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                showLocationStatus('@Localizer["Location set (coordinates)"]', 'text-green-500');
            });
        }

        function showLocationStatus(message, className) {
            const statusEl = document.getElementById('locationStatus');
            statusEl.textContent = message;
            statusEl.className = 'text-sm mt-1 ' + className;
        }

        // Accessory Management
        (function() {
            var itemId = @Model.Id;
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var list = document.getElementById('accessoriesList');
            var noMsg = document.getElementById('noAccessories');
            var form = document.getElementById('accessoryForm');
            var editId = document.getElementById('accEditId');
            var nameInput = document.getElementById('accName');
            var priceInput = document.getElementById('accPrice');
            var descInput = document.getElementById('accDesc');
            var currencySymbol = '@CurrencyService.GetSymbol()';

            function renderAccessories(accessories) {
                list.innerHTML = '';
                if (!accessories || accessories.length === 0) {
                    noMsg.classList.remove('hidden');
                    return;
                }
                noMsg.classList.add('hidden');
                accessories.forEach(function(a) {
                    var row = document.createElement('div');
                    row.className = 'flex items-center gap-3 p-3 bg-slate-50 dark:bg-slate-700/50 rounded-xl group';
                    row.setAttribute('data-id', a.id);
                    var availBadge = a.isAvailable
                        ? '<span class="px-2 py-0.5 text-xs font-medium rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-400">@Localizer["Available"]</span>'
                        : '<span class="px-2 py-0.5 text-xs font-medium rounded-full bg-slate-200 text-slate-500">@Localizer["Unavailable"]</span>';
                    row.innerHTML = '<div class="flex-1 min-w-0">' +
                        '<div class="flex items-center gap-2">' +
                        '<p class="text-sm font-medium text-slate-900 dark:text-white truncate">' + escapeHtml(a.name) + '</p>' +
                        availBadge +
                        '</div>' +
                        (a.description ? '<p class="text-xs text-slate-400 truncate mt-0.5">' + escapeHtml(a.description) + '</p>' : '') +
                        '</div>' +
                        '<p class="text-sm font-semibold text-slate-900 dark:text-white whitespace-nowrap">' + currencySymbol + parseFloat(a.dailyPrice).toFixed(2) + '<span class="text-xs font-normal text-slate-400">/@Localizer["day"]</span></p>' +
                        '<div class="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">' +
                        '<button type="button" class="acc-edit p-1.5 text-slate-400 hover:text-blue-600 rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/20" data-id="' + a.id + '"><i class="bi bi-pencil text-sm"></i></button>' +
                        '<button type="button" class="acc-delete p-1.5 text-slate-400 hover:text-red-600 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20" data-id="' + a.id + '"><i class="bi bi-trash text-sm"></i></button>' +
                        '</div>';
                    list.appendChild(row);
                });
                bindRowActions();
            }

            function bindRowActions() {
                list.querySelectorAll('.acc-edit').forEach(function(btn) {
                    btn.onclick = function() { startEdit(parseInt(this.getAttribute('data-id'))); };
                });
                list.querySelectorAll('.acc-delete').forEach(function(btn) {
                    btn.onclick = function() { deleteAccessory(parseInt(this.getAttribute('data-id'))); };
                });
            }

            function escapeHtml(str) {
                var div = document.createElement('div');
                div.textContent = str || '';
                return div.innerHTML;
            }

            function showForm(acc) {
                editId.value = acc ? acc.id : '';
                nameInput.value = acc ? acc.name : '';
                priceInput.value = acc ? acc.dailyPrice : '';
                descInput.value = acc ? (acc.description || '') : '';
                form.classList.remove('hidden');
                nameInput.focus();
            }

            function hideForm() {
                form.classList.add('hidden');
                editId.value = '';
                nameInput.value = '';
                priceInput.value = '';
                descInput.value = '';
            }

            function startEdit(id) {
                var row = list.querySelector('[data-id="' + id + '"]');
                if (!row) return;
                // Fetch fresh data
                fetch('/Items/GetAccessories?itemId=' + itemId)
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        var acc = data.find(function(a) { return a.id === id; });
                        if (acc) showForm(acc);
                    });
            }

            function deleteAccessory(id) {
                if (!confirm('@Localizer["Delete this accessory?"]')) return;
                fetch('/Items/DeleteAccessory?accessoryId=' + id, {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': token, 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.success) loadAccessories();
                    else alert(data.message || '@Localizer["Failed to delete accessory"]');
                });
            }

            function loadAccessories() {
                fetch('/Items/GetAccessories?itemId=' + itemId)
                    .then(function(r) { return r.json(); })
                    .then(renderAccessories);
            }

            document.getElementById('addAccessoryBtn').onclick = function() { showForm(null); };
            document.getElementById('accCancelBtn').onclick = hideForm;
            document.getElementById('accSaveBtn').onclick = function() {
                var name = nameInput.value.trim();
                var price = parseFloat(priceInput.value);
                if (!name) { nameInput.focus(); return; }
                if (isNaN(price) || price < 0) { priceInput.focus(); return; }

                var id = editId.value;
                var url, params;
                if (id) {
                    url = '/Items/UpdateAccessory';
                    params = 'accessoryId=' + id + '&name=' + encodeURIComponent(name) + '&dailyPrice=' + price + '&isAvailable=true&description=' + encodeURIComponent(descInput.value);
                } else {
                    url = '/Items/AddAccessory';
                    params = 'itemId=' + itemId + '&name=' + encodeURIComponent(name) + '&dailyPrice=' + price + '&description=' + encodeURIComponent(descInput.value);
                }

                fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-TOKEN': token, 'X-Requested-With': 'XMLHttpRequest' },
                    body: params
                })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.success) { hideForm(); loadAccessories(); }
                });
            };

            // Initial load
            loadAccessories();
        })();
    </script>
}

@model RentMate.Models.Item
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject RentMate.Services.CurrencyService CurrencyService

@{
    ViewData["Title"] = Localizer["Edit item"];
    var categories = new[] { "Uncategorized", "Electronics", "Sports", "Tools", "Vehicles", "Home", "Garden", "Events", "Other" };
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        <a asp-controller="Dashboard" asp-action="UserDashboard" class="inline-flex items-center gap-2 text-slate-500 hover:text-blue-600 transition-colors mb-4">
            <i class="bi bi-arrow-left"></i>
            @Localizer["Back to Dashboard"]
        </a>
        <h1 class="font-heading text-3xl font-bold text-slate-900">@Localizer["Edit Item"]</h1>
        <p class="text-slate-500 mt-1">@Localizer["Update your listing details"]</p>
    </div>

    <form asp-action="Edit" enctype="multipart/form-data" class="space-y-8">
        <div asp-validation-summary="ModelOnly" class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-600 text-sm"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageUrl" />

        <!-- Image Section -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6">
            <h2 class="font-heading text-lg font-semibold text-slate-900 mb-4">@Localizer["Item Photo"]</h2>
            
            <div class="flex flex-col sm:flex-row gap-6 items-start">
                <!-- Image Preview -->
                <div class="shrink-0">
                    <img id="imgPreview" 
                         src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/200x200?text=No+Image" : Model.ImageUrl)" 
                         class="w-48 h-48 rounded-xl object-cover border-2 border-slate-200" />
                </div>
                
                <!-- Upload Buttons -->
                <div class="flex-1 space-y-3">
                    <p class="text-sm text-slate-500 mb-3">@Localizer["Replace image"]:</p>
                    <label class="flex items-center justify-center gap-2 w-full px-4 py-3 border-2 border-dashed border-blue-300 rounded-xl text-blue-600 hover:bg-blue-50 cursor-pointer transition-colors">
                        <i class="bi bi-camera text-xl"></i>
                        <span class="font-medium">@Localizer["Take Photo"]</span>
                        <input type="file" name="image" id="cameraInput" class="hidden" accept="image/*" capture="environment" onchange="previewImage(this)" />
                    </label>
                    <label class="flex items-center justify-center gap-2 w-full px-4 py-3 border border-slate-200 rounded-xl text-slate-600 hover:bg-slate-50 cursor-pointer transition-colors">
                        <i class="bi bi-image text-xl"></i>
                        <span class="font-medium">@Localizer["Choose File"]</span>
                        <input type="file" name="image" id="fileInput" class="hidden" accept="image/*" onchange="previewImage(this)" />
                    </label>
                </div>
            </div>
        </div>

        <!-- Basic Info -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6">
            <h2 class="font-heading text-lg font-semibold text-slate-900 mb-4">@Localizer["Basic Information"]</h2>
            
            <div class="space-y-4">
                <div>
                    <label asp-for="Title" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Title"]</label>
                    <input asp-for="Title" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
                    <span asp-validation-for="Title" class="text-red-500 text-sm mt-1"></span>
                </div>
                
                <div class="grid sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Category" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Category"]</label>
                        <select asp-for="Category" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors bg-white">
                            @foreach (var cat in categories)
                            {
                                var isSelected = Model.Category == cat;
                                <option value="@cat" selected="@isSelected">@Localizer[cat]</option>
                            }
                        </select>
                        <span asp-validation-for="Category" class="text-red-500 text-sm mt-1"></span>
                    </div>
                    <div>
                        <label asp-for="Price" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Price per day"]</label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">@CurrencyService.GetSymbol()</span>
                            <input asp-for="Price" type="number" step="0.01" min="0" class="w-full pl-10 pr-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
                        </div>
                        <span asp-validation-for="Price" class="text-red-500 text-sm mt-1"></span>
                    </div>
                </div>
                
                <div>
                    <label asp-for="Description" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Description"]</label>
                    <textarea asp-for="Description" rows="4" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors resize-none"></textarea>
                    <span asp-validation-for="Description" class="text-red-500 text-sm mt-1"></span>
                </div>
            </div>
        </div>

        <!-- Location -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6">
            <h2 class="font-heading text-lg font-semibold text-slate-900 mb-4">@Localizer["Pickup Location"]</h2>
            
            <div>
                <label asp-for="Location" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Address"]</label>
                <div class="flex gap-2">
                    <input asp-for="Location" id="locationInput" class="flex-1 px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" placeholder="@Localizer["e.g. Ljubljana, Slovenia"]" />
                    <button type="button" id="getLocationBtn" onclick="getCurrentLocation()" class="px-4 py-3 border border-slate-200 rounded-xl text-slate-600 hover:bg-slate-50 transition-colors flex items-center gap-2">
                        <i class="bi bi-geo-alt"></i>
                        <span class="hidden sm:inline">@Localizer["Use My Location"]</span>
                    </button>
                </div>
                <p class="text-sm text-slate-400 mt-2">@Localizer["Enter a pickup address or use your current location"]</p>
                <span asp-validation-for="Location" class="text-red-500 text-sm"></span>
                <div id="locationStatus" class="text-sm mt-1"></div>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-3 justify-end pt-4">
            <a asp-controller="Dashboard" asp-action="UserDashboard" class="px-6 py-3 border border-slate-200 rounded-xl text-slate-600 hover:bg-slate-50 transition-colors text-center font-medium">
                @Localizer["Cancel"]
            </a>
            <button type="submit" class="px-8 py-3 bg-gradient-to-r from-blue-600 to-blue-500 text-white rounded-xl font-semibold hover:shadow-md transition-all">
                @Localizer["Save changes"]
            </button>
        </div>
    </form>
</div>

<!-- GDPR Location Consent Modal -->
<div id="locationConsentModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeLocationModal()"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md">
        <div class="bg-white rounded-2xl shadow-2xl p-6 m-4">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                    <i class="bi bi-geo-alt text-blue-600 text-xl"></i>
                </div>
                <h3 class="font-heading text-xl font-bold text-slate-900">@Localizer["Location Access"]</h3>
            </div>
            <p class="text-slate-600 mb-2">@Localizer["We would like to access your location to set the default pickup location for your item."]</p>
            <p class="text-sm text-slate-400 mb-6">@Localizer["Your location data will only be used to display the pickup location to potential renters. You can always enter a custom address instead."]</p>
            <div class="flex gap-3">
                <button type="button" onclick="closeLocationModal()" class="flex-1 px-4 py-3 border border-slate-200 rounded-xl text-slate-600 hover:bg-slate-50 transition-colors font-medium">
                    @Localizer["No, thanks"]
                </button>
                <button type="button" onclick="requestGeolocation()" class="flex-1 px-4 py-3 bg-gradient-to-r from-blue-600 to-blue-500 text-white rounded-xl font-semibold hover:shadow-lg transition-all">
                    @Localizer["Allow"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Image preview
        function previewImage(input) {
            if (input.files && input.files[0]) {
                if (input.id === 'cameraInput') {
                    document.getElementById('fileInput').value = '';
                } else {
                    document.getElementById('cameraInput').value = '';
                }
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('imgPreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Location modal
        function getCurrentLocation() {
            if (!navigator.geolocation) {
                showLocationStatus('@Localizer["Geolocation is not supported by your browser"]', 'text-red-500');
                return;
            }
            document.getElementById('locationConsentModal').classList.remove('hidden');
        }

        function closeLocationModal() {
            document.getElementById('locationConsentModal').classList.add('hidden');
        }

        function requestGeolocation() {
            closeLocationModal();
            showLocationStatus('@Localizer["Getting your location..."]', 'text-blue-500');
            document.getElementById('getLocationBtn').disabled = true;
            
            navigator.geolocation.getCurrentPosition(
                function(position) {
                    reverseGeocode(position.coords.latitude, position.coords.longitude);
                },
                function(error) {
                    document.getElementById('getLocationBtn').disabled = false;
                    switch(error.code) {
                        case error.PERMISSION_DENIED:
                            showLocationStatus('@Localizer["Location access denied. Please enter your address manually."]', 'text-amber-500');
                            break;
                        case error.POSITION_UNAVAILABLE:
                            showLocationStatus('@Localizer["Location unavailable. Please enter your address manually."]', 'text-amber-500');
                            break;
                        default:
                            showLocationStatus('@Localizer["Unable to get location. Please enter your address manually."]', 'text-amber-500');
                    }
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 300000 }
            );
        }

        function reverseGeocode(lat, lng) {
            fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=16&addressdetails=1`, {
                headers: { 'Accept-Language': document.documentElement.lang || 'en' }
            })
            .then(response => response.json())
            .then(data => {
                document.getElementById('getLocationBtn').disabled = false;
                if (data && data.address) {
                    const addr = data.address;
                    let location = '';
                    if (addr.road) location += addr.road;
                    if (addr.house_number) location += ' ' + addr.house_number;
                    if (addr.city || addr.town || addr.village) {
                        if (location) location += ', ';
                        location += addr.city || addr.town || addr.village;
                    }
                    if (addr.country) {
                        if (location) location += ', ';
                        location += addr.country;
                    }
                    document.getElementById('locationInput').value = location || data.display_name;
                    showLocationStatus('@Localizer["Location set successfully!"]', 'text-green-500');
                } else {
                    document.getElementById('locationInput').value = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                    showLocationStatus('@Localizer["Location set (coordinates)"]', 'text-green-500');
                }
            })
            .catch(error => {
                document.getElementById('getLocationBtn').disabled = false;
                document.getElementById('locationInput').value = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                showLocationStatus('@Localizer["Location set (coordinates)"]', 'text-green-500');
            });
        }

        function showLocationStatus(message, className) {
            const statusEl = document.getElementById('locationStatus');
            statusEl.textContent = message;
            statusEl.className = 'text-sm mt-1 ' + className;
        }
    </script>
}

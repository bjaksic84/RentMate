@inject IViewLocalizer Localizer
@inject RentMate.Services.CurrencyService CurrencyService
@{
    ViewData["Title"] = Localizer["Home"];
}

@* 1. HERO SECTION *@
<section class="py-5 bg-white border-bottom">
    <div class="container text-center py-5">
        <h1 class="display-4 fw-bold mb-3 text-dark">@Localizer["Rent anything, anywhere."]</h1>
        <p class="lead text-muted mb-5">@Localizer["Forget about buying things you only need occasionally."]</p>

        <div class="search-container mx-auto shadow-lg rounded-pill p-2 bg-white border" style="max-width: 800px;">
            <form class="row g-0 align-items-center" asp-controller="Rentals" asp-action="Index" method="get">
                <div class="col-md-5 border-end">
                    <div class="d-flex align-items-center px-3">
                        <i class="bi bi-search text-muted me-2"></i>
                        <input name="search" class="form-control border-0 shadow-none" placeholder="@Localizer["What are you looking for?"]" />
                    </div>
                </div>
                <div class="col-md-4 border-end">
                    <div class="d-flex align-items-center px-3">
                        <i class="bi bi-geo-alt text-muted me-2"></i>
                        <input name="city" class="form-control border-0 shadow-none" placeholder="@Localizer["City"]" />
                    </div>
                </div>
                <div class="col-md-3 ps-2 pe-1">
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-bold">@Localizer["Search"]</button>
                </div>
            </form>
        </div>
    </div>
</section>

@* 2. FIXED CATEGORIES SECTION *@
<section class="py-4 bg-light shadow-sm">
    <div class="container">
        <div class="d-flex justify-content-center gap-4 gap-md-5 overflow-auto pb-2 category-scroll">
            <a href="/Rentals?category=Tools" class="category-link text-center text-decoration-none">
                <div class="icon-circle mb-2"><i class="bi bi-tools"></i></div>
                <span class="small fw-bold">@Localizer["Tools"]</span>
            </a>
            <a href="/Rentals?category=Electronics" class="category-link text-center text-decoration-none">
                <div class="icon-circle mb-2"><i class="bi bi-laptop"></i></div>
                <span class="small fw-bold">@Localizer["Electronics"]</span>
            </a>
            <a href="/Rentals?category=Sport" class="category-link text-center text-decoration-none">
                <div class="icon-circle mb-2"><i class="bi bi-bicycle"></i></div>
                <span class="small fw-bold">@Localizer["Sports"]</span>
            </a>
            <a href="/Rentals?category=Home" class="category-link text-center text-decoration-none">
                <div class="icon-circle mb-2"><i class="bi bi-house-door"></i></div>
                <span class="small fw-bold">@Localizer["Home & Garden"]</span>
            </a>
            <a href="/Rentals?category=Events" class="category-link text-center text-decoration-none">
                <div class="icon-circle mb-2"><i class="bi bi-balloon-heart"></i></div>
                <span class="small fw-bold">@Localizer["Fun"]</span>
            </a>
            <a href="/Rentals?category=Other" class="category-link text-center text-decoration-none">
                <div class="icon-circle mb-2"><i class="bi bi-box-seam"></i></div>
                <span class="small fw-bold">@Localizer["Other"]</span>
            </a>
        </div>
    </div>
</section>

@* 3. FEATURED ITEMS (Placeholder Carousel) *@
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold m-0">@Localizer["Popular near you"]</h3>
            <a href="/Rentals" class="text-primary text-decoration-none fw-bold">@Localizer["All"] <i class="bi bi-chevron-right"></i></a>
        </div>

        <div id="featuredCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner rounded-4 shadow">
                <div class="carousel-item active">
                    <div class="row g-0 bg-dark text-white p-5 align-items-center">
                        <div class="col-md-6">
                            <span class="badge bg-warning text-dark mb-2">@Localizer["Top rated"]</span>
                            <h2 class="display-6 fw-bold">Profesionalni DJI dron</h2>
                            <p>@Localizer["Owner"]: Marko (⭐ 4.9) • @Localizer["Location"]: Maribor</p>
                            <h4 class="text-primary">@CurrencyService.Format(25) / @Localizer["day"]</h4>
                        </div>
                        <div class="col-md-6 text-center">
                            <i class="bi bi-camera-reels display-1 opacity-25"></i>
                        </div>
                    </div>
                </div>
                @* Tukaj bi dodal še 2-3 carousel-item-e *@
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#featuredCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#featuredCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    </div>
</section>
@* 3. CALL TO ACTION (Če uporabnik ni vpisan) *@
@if (!(User.Identity?.IsAuthenticated ?? false))
{
    <section class="py-5">
        <div class="container">
            <div class="card cta-join p-0 rounded-4 shadow-lg text-center">
                <div class="card-body p-5">
                    <h2 class="fw-bold mb-3">@Localizer["Become part of the RentMate community"]</h2>
                    <p class="mb-4 text-muted">@Localizer["Earn by renting out your equipment or save by renting."]</p>
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg px-5 rounded-pill fw-bold">@Localizer["Register"]</a>
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary btn-lg px-4 rounded-pill">@Localizer["Login"]</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
@* 4. HOW IT WORKS *@
<section class="py-5 bg-white border-top">
    <div class="container">
        <h3 class="fw-bold text-center mb-5">@Localizer["How does RentMate work?"]</h3>
        <div class="row text-center g-4">
            <div class="col-md-4">
                <div class="p-4 rounded-4 bg-light h-100">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-search h4 m-0"></i>
                    </div>
                    <h5 class="fw-bold">@Localizer["Find"]</h5>
                    <p class="text-muted small">@Localizer["Browse thousands of items in your immediate vicinity."]</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-4 bg-light h-100">
                    <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-calendar-check h4 m-0"></i>
                    </div>
                    <h5 class="fw-bold">@Localizer["Book"]</h5>
                    <p class="text-muted small">@Localizer["Select dates, contact the owner and confirm the rental."]</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 rounded-4 bg-light h-100">
                    <div class="bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-stars h4 m-0"></i>
                    </div>
                    <h5 class="fw-bold">@Localizer["Use & Save"]</h5>
                    <p class="text-muted small">@Localizer["Pick up the item, use it and return it. Simple!"]</p>
                </div>
            </div>
        </div>
    </div>
</section>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject RentMate.Services.CurrencyService CurrencyService
@{
    ViewData["Title"] = Localizer["Home"];
    var popularItems = ViewBag.PopularItems as IEnumerable<RentMate.Models.Item> ?? Enumerable.Empty<RentMate.Models.Item>();
    var newItems = ViewBag.NewItems as IEnumerable<RentMate.Models.Item> ?? Enumerable.Empty<RentMate.Models.Item>();
    var cities = ViewBag.Cities as IEnumerable<string> ?? Enumerable.Empty<string>();
    var currency = CurrencyService.GetCurrentCurrency();
}

<!-- Hero Section - Full viewport height -->
<section class="relative min-h-[calc(100vh-5rem)] flex items-center justify-center overflow-hidden">
    <!-- Animated gradient background -->
    <div class="absolute inset-0 bg-gradient-to-br from-blue-600 via-blue-700 to-slate-900">
        <!-- Decorative elements -->
        <div class="absolute inset-0 opacity-30">
            <div class="absolute top-20 left-10 w-72 h-72 bg-sky-400 rounded-full mix-blend-multiply filter blur-3xl animate-pulse"></div>
            <div class="absolute top-40 right-10 w-72 h-72 bg-blue-400 rounded-full mix-blend-multiply filter blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
            <div class="absolute bottom-20 left-1/2 w-72 h-72 bg-indigo-400 rounded-full mix-blend-multiply filter blur-3xl animate-pulse" style="animation-delay: 4s;"></div>
        </div>
        <!-- Grid pattern overlay -->
        <div class="absolute inset-0" style="background-image: radial-gradient(rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 40px 40px;"></div>
    </div>
    
    <!-- Hero Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-md rounded-full border border-white/20 text-white/90 text-sm font-medium mb-8">
            <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
            @ViewBag.TotalItems+ @Localizer["items available near you"]
        </div>
        
        <!-- Main heading -->
        <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight">
            @Localizer["Rent anything,"]<br>
            <span class="bg-gradient-to-r from-sky-300 to-blue-300 bg-clip-text text-transparent">@Localizer["anywhere."]</span>
        </h1>
        
        <p class="text-lg sm:text-xl text-blue-100 max-w-2xl mx-auto mb-12">
            @Localizer["Forget about buying things you only need occasionally."] @Localizer["Save money, save space, save the planet."]
        </p>
        
        <!-- Search Widget - Glassmorphic pill-shaped -->
        <div class="max-w-4xl mx-auto">
            <form asp-controller="Rentals" asp-action="Index" method="get" class="glass rounded-2xl sm:rounded-full p-2 shadow-lg border border-white/30">
                <div class="flex flex-col sm:flex-row items-stretch gap-2">
                    <!-- Location -->
                    <div class="flex-1 group">
                        <div class="flex items-center gap-3 px-5 py-3 sm:py-4 rounded-xl sm:rounded-full bg-white/50 hover:bg-white/80 focus-within:bg-white focus-within:ring-2 focus-within:ring-blue-500 transition-all duration-200">
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-600 to-sky-500 flex items-center justify-center flex-shrink-0">
                                <i class="bi bi-geo-alt-fill text-white"></i>
                            </div>
                            <div class="flex-1 text-left">
                                <label class="block text-xs font-semibold text-blue-600 uppercase tracking-wide">@Localizer["Where"]</label>
                                <select name="city" class="w-full bg-transparent border-none text-slate-900 font-medium focus:outline-none text-sm cursor-pointer">
                                    <option value="">@Localizer["All cities"]</option>
                                    @foreach (var city in cities)
                                    {
                                        <option value="@city">@city</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Divider -->
                    <div class="hidden sm:block w-px bg-slate-200 my-2"></div>
                    
                    <!-- What -->
                    <div class="flex-1 group">
                        <div class="flex items-center gap-3 px-5 py-3 sm:py-4 rounded-xl sm:rounded-full bg-white/50 hover:bg-white/80 focus-within:bg-white focus-within:ring-2 focus-within:ring-blue-500 transition-all duration-200">
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-600 to-sky-500 flex items-center justify-center flex-shrink-0">
                                <i class="bi bi-search text-white"></i>
                            </div>
                            <div class="flex-1 text-left">
                                <label class="block text-xs font-semibold text-blue-600 uppercase tracking-wide">@Localizer["What"]</label>
                                <input type="text" name="search" placeholder="@Localizer["e.g. Drill, Camera, Bike..."]" 
                                       class="w-full bg-transparent border-none text-slate-900 font-medium placeholder-slate-400 focus:outline-none text-sm">
                            </div>
                        </div>
                    </div>
                    
                    <!-- Divider -->
                    <div class="hidden sm:block w-px bg-slate-200 my-2"></div>
                    
                    <!-- Date Range -->
                    <div class="flex-1 group">
                        <div class="flex items-center gap-3 px-5 py-3 sm:py-4 rounded-xl sm:rounded-full bg-white/50 hover:bg-white/80 focus-within:bg-white focus-within:ring-2 focus-within:ring-blue-500 transition-all duration-200">
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-600 to-sky-500 flex items-center justify-center flex-shrink-0">
                                <i class="bi bi-calendar-event text-white"></i>
                            </div>
                            <div class="flex-1 text-left">
                                <label class="block text-xs font-semibold text-blue-600 uppercase tracking-wide">@Localizer["When"]</label>
                                <input type="text" id="dateRange" name="dates" placeholder="@Localizer["Pick a date range"]" readonly
                                       class="w-full bg-transparent border-none text-slate-900 font-medium placeholder-slate-400 focus:outline-none text-sm cursor-pointer">
                            </div>
                        </div>
                    </div>
                    
                    <!-- Search Button -->
                    <button type="submit" class="px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-semibold rounded-xl sm:rounded-full shadow-sm  transition-all duration-300 flex items-center justify-center gap-2 group">
                        <i class="bi bi-search text-lg group-hover:scale-110 transition-transform"></i>
                        <span class="sm:hidden lg:inline">@Localizer["Search"]</span>
                    </button>
                </div>
            </form>
        </div>
        
        <!-- Quick categories -->
        <div class="flex flex-wrap justify-center gap-3 mt-8">
            @{
                var categories = new[] { ("Tools", "bi-tools", "Orodje"), ("Electronics", "bi-laptop", "Elektronika"), ("Sports", "bi-bicycle", "Šport"), ("Home & Garden", "bi-house", "Dom & Vrt"), ("Fun", "bi-controller", "Zabava") };
            }
            @foreach (var (cat, icon, slCat) in categories)
            {
                <a asp-controller="Rentals" asp-action="Index" asp-route-category="@cat" 
                   class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 hover:bg-white/20 backdrop-blur-sm rounded-full text-white/90 text-sm font-medium border border-white/10 hover:border-white/30 transition-all duration-200">
                    <i class="bi @icon"></i>
                    @Localizer[cat]
                </a>
            }
        </div>
    </div>
    
    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/60 animate-bounce">
        <i class="bi bi-chevron-double-down text-2xl"></i>
    </div>
</section>

<!-- How it works section -->
<section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="font-heading text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
                @Localizer["How does RentMate work?"]
            </h2>
            <p class="text-lg text-slate-600 max-w-2xl mx-auto">
                @Localizer["Simple steps to rent what you need"]
            </p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
            @{
                var steps = new[] {
                    ("bi-search", "Find", "Browse thousands of items in your immediate vicinity.", "blue"),
                    ("bi-calendar-check", "Book", "Select dates, contact the owner and confirm the rental.", "sky"),
                    ("bi-emoji-smile", "Use & Save", "Pick up the item, use it and return it. Simple!", "green")
                };
                var stepNum = 1;
            }
            @foreach (var (icon, title, desc, color) in steps)
            {
                <div class="relative group">
                    <div class="bg-slate-50 rounded-2xl p-8 hover-lift border border-slate-100 h-full">
                        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-@(color)-500 to-@(color)-600 flex items-center justify-center mb-6 shadow-lg shadow-@(color)-500/30 group-hover:scale-110 transition-transform duration-300">
                            <i class="bi @icon text-white text-2xl"></i>
                        </div>
                        <div class="absolute top-6 right-6 w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center text-sm font-bold text-slate-500">
                            @stepNum
                        </div>
                        <h3 class="font-heading text-xl font-bold text-slate-900 mb-3">@Localizer[title]</h3>
                        <p class="text-slate-600">@Localizer[desc]</p>
                    </div>
                </div>
                stepNum++;
            }
        </div>
    </div>
</section>

<!-- Popular Items Section -->
@if (popularItems.Any())
{
<section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-10">
            <div>
                <h2 class="font-heading text-3xl sm:text-4xl font-bold text-slate-900 mb-2">
                    @Localizer["Popular near you"]
                </h2>
                <p class="text-slate-600">@Localizer["Top rated items loved by renters"]</p>
            </div>
            <a asp-controller="Rentals" asp-action="Index" asp-route-sort="rating" 
               class="hidden sm:inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 font-semibold transition-colors">
                @Localizer["View all"] <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            @foreach (var item in popularItems.Take(4))
            {
                <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="group">
                    <div class="bg-white rounded-2xl overflow-hidden hover-lift border border-slate-100">
                        <!-- Image -->
                        <div class="aspect-[4/3] relative overflow-hidden">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            }
                            else
                            {
                                <div class="w-full h-full bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center">
                                    <i class="bi bi-image text-4xl text-slate-300"></i>
                                </div>
                            }
                            <!-- Favorite button -->
                            <button onclick="event.preventDefault();" class="absolute top-3 right-3 w-9 h-9 rounded-full bg-white/80 backdrop-blur-sm hover:bg-white flex items-center justify-center shadow-md transition-all duration-200 hover:scale-110">
                                <i class="bi bi-heart text-slate-600 hover:text-red-500"></i>
                            </button>
                            <!-- Rating badge -->
                            @if (item.AverageRating.HasValue)
                            {
                                <div class="absolute bottom-3 left-3 flex items-center gap-1 px-2 py-1 bg-white/90 backdrop-blur-sm rounded-lg text-sm font-semibold">
                                    <i class="bi bi-star-fill text-amber-400"></i>
                                    <span>@item.AverageRating.Value.ToString("0.0")</span>
                                </div>
                            }
                        </div>
                        <!-- Content -->
                        <div class="p-4">
                            <div class="flex items-start justify-between gap-2 mb-2">
                                <h3 class="font-heading font-semibold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-1">
                                    @item.Title
                                </h3>
                            </div>
                            @if (!string.IsNullOrEmpty(item.Location))
                            {
                                <p class="text-sm text-slate-500 flex items-center gap-1 mb-3">
                                    <i class="bi bi-geo-alt"></i> @item.Location
                                </p>
                            }
                            <div class="flex items-baseline gap-1">
                                <span class="text-xl font-bold text-slate-900">@currency.Symbol@item.Price</span>
                                <span class="text-sm text-slate-500">/ @Localizer["day"]</span>
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>
        
        <div class="mt-8 text-center sm:hidden">
            <a asp-controller="Rentals" asp-action="Index" asp-route-sort="rating" 
               class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-full transition-colors">
                @Localizer["View all"] <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</section>
}

<!-- New Additions Section -->
@if (newItems.Any())
{
<section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-10">
            <div>
                <h2 class="font-heading text-3xl sm:text-4xl font-bold text-slate-900 mb-2">
                    @Localizer["New Additions"]
                </h2>
                <p class="text-slate-600">@Localizer["Fresh items just listed"]</p>
            </div>
            <a asp-controller="Rentals" asp-action="Index" asp-route-sort="newest" 
               class="hidden sm:inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 font-semibold transition-colors">
                @Localizer["View all"] <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            @foreach (var item in newItems.Take(4))
            {
                <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="group">
                    <div class="bg-white rounded-2xl overflow-hidden hover-lift border border-slate-200">
                        <!-- Image -->
                        <div class="aspect-[4/3] relative overflow-hidden">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            }
                            else
                            {
                                <div class="w-full h-full bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center">
                                    <i class="bi bi-image text-4xl text-slate-300"></i>
                                </div>
                            }
                            <!-- New badge -->
                            <div class="absolute top-3 left-3 px-3 py-1 bg-green-500 text-white text-xs font-bold rounded-full">
                                @Localizer["New"]
                            </div>
                            <!-- Favorite button -->
                            <button onclick="event.preventDefault();" class="absolute top-3 right-3 w-9 h-9 rounded-full bg-white/80 backdrop-blur-sm hover:bg-white flex items-center justify-center shadow-md transition-all duration-200 hover:scale-110">
                                <i class="bi bi-heart text-slate-600 hover:text-red-500"></i>
                            </button>
                        </div>
                        <!-- Content -->
                        <div class="p-4">
                            <h3 class="font-heading font-semibold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-1 mb-2">
                                @item.Title
                            </h3>
                            @if (!string.IsNullOrEmpty(item.Location))
                            {
                                <p class="text-sm text-slate-500 flex items-center gap-1 mb-3">
                                    <i class="bi bi-geo-alt"></i> @item.Location
                                </p>
                            }
                            <div class="flex items-baseline gap-1">
                                <span class="text-xl font-bold text-slate-900">@currency.Symbol@item.Price</span>
                                <span class="text-sm text-slate-500">/ @Localizer["day"]</span>
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
</section>
}

<!-- Testimonials Section -->
<section class="py-20 bg-gradient-to-br from-blue-600 to-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="font-heading text-3xl sm:text-4xl font-bold mb-4">
                @Localizer["What our users say"]
            </h2>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
            @{
                var testimonials = new[] {
                    ("RentMate saved me so much money! I needed a power drill for one project and found one nearby for just a few euros.", "Sarah M.", "Ljubljana"),
                    ("I've been renting out my camping gear and it basically pays for itself now. Great way to earn passive income!", "Mark T.", "Maribor"),
                    ("The booking process is so smooth. Found a projector for my party in minutes!", "Ana K.", "Celje")
                };
            }
            @foreach (var (quote, name, loc) in testimonials)
            {
                <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/10">
                    <div class="flex gap-1 mb-4">
                        @for (int i = 0; i < 5; i++)
                        {
                            <i class="bi bi-star-fill text-amber-400"></i>
                        }
                    </div>
                    <p class="text-blue-100 mb-6 leading-relaxed">"@Localizer[quote]"</p>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-sky-400 to-blue-500 flex items-center justify-center font-bold text-white">
                            @name[0]
                        </div>
                        <div>
                            <p class="font-semibold">@name</p>
                            <p class="text-sm text-blue-200">@loc</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-20 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="font-heading text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
            @Localizer["Become part of the RentMate community"]
        </h2>
        <p class="text-lg text-slate-600 mb-8 max-w-2xl mx-auto">
            @Localizer["Earn by renting out your equipment or save by renting."]
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a asp-controller="Items" asp-action="Create" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-semibold rounded-full shadow-sm  transition-all duration-300">
                <i class="bi bi-plus-circle"></i>
                @Localizer["List your first item"]
            </a>
            <a asp-controller="Rentals" asp-action="Index" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white hover:bg-slate-50 text-slate-900 font-semibold rounded-full border-2 border-slate-200 hover:border-blue-300 transition-all duration-300">
                <i class="bi bi-search"></i>
                @Localizer["Browse marketplace"]
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Initialize Flatpickr date range picker
        flatpickr("#dateRange", {
            mode: "range",
            minDate: "today",
            dateFormat: "M d",
            locale: {
                rangeSeparator: " - "
            },
            disableMobile: true
        });
    </script>
}


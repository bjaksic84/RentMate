@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService
@{
    ViewData["Title"] = Localizer["Home"];
    var popularItems = ViewBag.PopularItems as IEnumerable<RentMate.Models.Domain.Item> ?? Enumerable.Empty<RentMate.Models.Domain.Item>();
    var newItems = ViewBag.NewItems as IEnumerable<RentMate.Models.Domain.Item> ?? Enumerable.Empty<RentMate.Models.Domain.Item>();
    var cities = ViewBag.Cities as IEnumerable<string> ?? Enumerable.Empty<string>();
    var currency = CurrencyService.GetCurrentCurrency();
}

<!-- Hero Section - Content-forward, light design -->
<section class="relative bg-stone-50 py-16 md:py-24 z-10">
    <!-- Hero Content -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center overflow-visible" style="z-index: var(--z-base, 1);">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-primary-50 rounded-full border border-primary-200 text-primary-700 text-sm font-medium mb-8">
            <span class="w-2 h-2 bg-green-500 rounded-full"></span>
            @ViewBag.TotalItems+ @Localizer["items available near you"]
        </div>

        <!-- Main heading -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-stone-900 mb-6 leading-tight">
            @Localizer["Rent anything,"]<br>
            <span class="text-primary-600">@Localizer["anywhere."]</span>
        </h1>

        <p class="text-lg sm:text-xl text-stone-600 max-w-2xl mx-auto mb-12">
            @Localizer["Forget about buying things you only need occasionally."] @Localizer["Save money, save space, save the planet."]
        </p>

        <!-- Search Widget - Solid white card -->
        <!--
            ARCHITECTURAL DECISIONS:
            1. role="search" - Semantic landmark for screen readers (WCAG 2.1)
            2. method="get" - Search actions must use GET for URL shareability/bookmarking
            3. value="" binding - Preserves search term after page refresh via ViewBag
            4. Clear button - Conditionally visible via oninput JavaScript
            5. Loading spinner - Shows on form submit for perceived performance
            6. ring-offset-2 - Creates visual gap between focus ring and element
        -->
        <div class="max-w-4xl mx-auto overflow-visible">
            <form asp-controller="Rentals" asp-action="Index" method="get"
                  role="search"
                  aria-label="@Localizer["Search marketplace"]"
                  id="heroSearchForm"
                  onsubmit="showSearchLoading()"
                  class="bg-white rounded-lg shadow-md border border-stone-200 p-2 relative z-50 overflow-visible">
                <div class="flex flex-col md:flex-row items-stretch gap-2">
                    <!-- What (Search Input) -->
                    <div class="flex-1 min-w-0 group">
                        <div onclick="document.getElementById('heroSearch').focus()"
                             class="flex items-center gap-3 px-4 py-3 rounded-lg
                                    hover:bg-stone-50
                                    focus-within:bg-stone-50 focus-within:ring-2 focus-within:ring-primary-500 focus-within:ring-offset-2
                                    transition-colors duration-150 cursor-text h-full">
                            <!-- Search Icon (left-positioned) -->
                            <div class="w-9 h-9 rounded-full bg-primary-50 text-primary-600 flex items-center justify-center flex-shrink-0" aria-hidden="true">
                                <i class="bi bi-search text-sm"></i>
                            </div>
                            <!-- Input Container with relative positioning for clear button -->
                            <div class="flex-1 min-w-0 relative">
                                <input type="text"
                                       id="heroSearch"
                                       name="search"
                                       value="@(ViewBag.CurrentSearch ?? "")"
                                       placeholder="@Localizer["What are you looking for?"]"
                                       aria-label="@Localizer["Search for items"]"
                                       autocomplete="off"
                                       oninput="toggleClearButton(this)"
                                       class="w-full bg-transparent border-none text-stone-900 font-medium placeholder-stone-500 focus:outline-none text-sm pr-8">
                                <!-- Clear Button (×) - Hidden by default, shown when input has value -->
                                <button type="button"
                                        id="heroSearchClear"
                                        onclick="clearSearchInput()"
                                        aria-label="@Localizer["Clear search"]"
                                        class="absolute right-0 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full
                                               bg-stone-200 hover:bg-stone-300
                                               flex items-center justify-center
                                               text-stone-500 hover:text-stone-700
                                               transition-colors duration-150
                                               opacity-0 invisible
                                               focus:opacity-100 focus:visible focus:outline-none focus:ring-2 focus:ring-primary-500">
                                    <i class="bi bi-x text-sm" aria-hidden="true"></i>
                                </button>
                            </div>
                            <!-- Loading Spinner - Hidden by default, shown on form submit -->
                            <div id="heroSearchSpinner" class="hidden flex-shrink-0" aria-hidden="true">
                                <div class="w-5 h-5 border-2 border-primary-500 border-t-transparent rounded-full animate-spin"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Divider -->
                    <div class="hidden md:block w-px bg-stone-300/50 my-2"></div>

                    <!-- Date Range - SmartCalendar Component (CENTER position) -->
                    <div class="flex-1 min-w-0">
                        @await Html.PartialAsync("_SmartCalendar", new RentMate.Models.ViewModels.SmartCalendarModel {
                            Id = "heroDateRange",
                            StartDateField = "startDate",
                            EndDateField = "endDate",
                            Mode = RentMate.Models.ViewModels.CalendarMode.Range,
                            MinDate = DateOnly.FromDateTime(DateTime.Today),
                            Placeholder = Localizer["When? (Pick dates)"].Value,
                            CssClass = "sc-open-up"
                        })
                    </div>

                    <!-- Divider -->
                    <div class="hidden md:block w-px bg-stone-300/50 my-2"></div>

                    <!-- Location -->
                    <div class="flex-1 min-w-0 group">
                        <div onclick="document.querySelector('[name=city]').focus()" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-stone-50 focus-within:bg-stone-50 focus-within:ring-2 focus-within:ring-primary-500 focus-within:ring-offset-2 transition-colors duration-150 cursor-pointer h-full">
                            <div class="w-9 h-9 rounded-full bg-primary-50 text-primary-600 flex items-center justify-center flex-shrink-0">
                                <i class="bi bi-geo-alt-fill text-sm"></i>
                            </div>
                            <select name="city" class="flex-1 min-w-0 bg-transparent border-none text-stone-900 font-medium focus:outline-none text-sm cursor-pointer">
                                <option value="" class="text-stone-400">@Localizer["Where? (All cities)"]</option>
                                @foreach (var city in cities)
                                {
                                    <option value="@city">@city</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Search Button -->
                    <button type="submit"
                            class="px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-md shadow-sm transition-colors duration-150 flex items-center justify-center gap-2 group focus-ring flex-shrink-0"
                            aria-label="@Localizer["Search marketplace"]">
                        <i class="bi bi-search text-lg" aria-hidden="true"></i>
                        <span class="md:hidden lg:inline">@Localizer["Search"]</span>
                    </button>
                </div>
            </form>
        </div>

        <!-- Quick categories - clickable pills -->
        <div class="flex flex-wrap justify-center gap-3 mt-8">
            @foreach (var (cat, icon) in ViewConstants.MarketplaceCategories.Take(5))
            {
                <a href="@Url.Action("Index", "Rentals", new { category = cat })"
                   class="inline-flex items-center gap-2 px-4 py-2 bg-stone-100 hover:bg-primary-50 hover:text-primary-700 rounded-full text-stone-700 text-sm font-medium border border-stone-200 transition-colors duration-150 cursor-pointer focus-ring">
                    <i class="bi @icon" aria-hidden="true"></i>
                    @Localizer[cat]
                </a>
            }
        </div>
    </div>
</section>

<!-- How it works section -->
<section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="text-3xl sm:text-4xl font-bold text-stone-900 mb-4">
                @Localizer["How does RentMate work?"]
            </h2>
            <p class="text-lg text-stone-600 max-w-2xl mx-auto">
                @Localizer["Simple steps to rent what you need"]
            </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
            @{
                var steps = new[] {
                    ("bi-search", "Find", "Browse thousands of items in your immediate vicinity."),
                    ("bi-calendar-check", "Book", "Select dates, contact the owner and confirm the rental."),
                    ("bi-emoji-smile", "Use & Save", "Pick up the item, use it and return it. Simple!")
                };
                var stepNum = 1;
            }
            @foreach (var (icon, title, desc) in steps)
            {
                <div class="relative">
                    <div class="bg-stone-50 rounded-lg p-8 border border-stone-200 h-full">
                        <div class="w-16 h-16 rounded-lg bg-primary-100 text-primary-700 flex items-center justify-center mb-6">
                            <i class="bi @icon text-2xl"></i>
                        </div>
                        <div class="absolute top-6 right-6 w-8 h-8 rounded-full bg-stone-200 flex items-center justify-center text-sm font-bold text-stone-500">
                            @stepNum
                        </div>
                        <h3 class="text-xl font-bold text-stone-900 mb-3">@Localizer[title]</h3>
                        <p class="text-stone-600">@Localizer[desc]</p>
                    </div>
                </div>
                stepNum++;
            }
        </div>
    </div>
</section>

<!-- Popular Items Section -->
@if (popularItems.Any())
{
<section class="py-20 bg-stone-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-10">
            <div>
                <h2 class="text-3xl sm:text-4xl font-bold text-stone-900 mb-2">
                    @Localizer["Popular near you"]
                </h2>
                <p class="text-stone-600">@Localizer["Top rated items loved by renters"]</p>
            </div>
            <a asp-controller="Rentals" asp-action="Index" asp-route-sort="rating"
               class="hidden sm:inline-flex items-center gap-2 text-primary-600 hover:text-primary-700 font-semibold transition-colors">
                @Localizer["View all"] <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            @foreach (var item in popularItems.Take(4))
            {
                <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="group">
                    <div class="bg-white rounded-lg overflow-hidden border border-stone-200 hover:shadow-md transition-shadow duration-150">
                        <!-- Image -->
                        <div class="aspect-[4/3] relative overflow-hidden">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Title" class="w-full h-full object-cover">
                            }
                            else
                            {
                                <div class="w-full h-full bg-gradient-to-br from-stone-100 to-stone-200 flex items-center justify-center">
                                    <i class="bi bi-image text-4xl text-stone-300" aria-hidden="true"></i>
                                </div>
                            }
                            <!-- Favorite button -->
                            <div class="absolute top-3 right-3 z-10">
                                @await Html.PartialAsync("_FavoriteButton", new { ItemId = item.Id, IsFavorited = false })
                            </div>
                            <!-- Rating badge -->
                            @if (item.AverageRating.HasValue)
                            {
                                <div class="absolute bottom-3 left-3 flex items-center gap-1 px-2 py-1 bg-white shadow-sm rounded-lg text-sm font-semibold">
                                    <i class="bi bi-star-fill text-amber-400" aria-hidden="true"></i>
                                    <span>@item.AverageRating.Value.ToString("0.0")</span>
                                </div>
                            }
                        </div>
                        <!-- Content -->
                        <div class="p-4">
                            <div class="flex items-start justify-between gap-2 mb-2">
                                <h3 class="font-semibold text-stone-900 group-hover:text-primary-600 transition-colors line-clamp-1">
                                    @item.Title
                                </h3>
                            </div>
                            @if (!string.IsNullOrEmpty(item.Location))
                            {
                                <p class="text-sm text-stone-500 flex items-center gap-1 mb-3">
                                    <i class="bi bi-geo-alt"></i> @item.Location
                                </p>
                            }
                            <div class="flex items-center justify-between mt-1">
                                <div class="flex items-baseline gap-1">
                                    <span class="text-xl font-bold text-stone-900">@CurrencyService.Format(item.Price)</span>
                                    <span class="text-xs text-stone-500 font-medium lowercase">/ @Localizer["day"]</span>
                                </div>
                                @if (item.DepositAmount > 0)
                                {
                                    <div class="flex items-center gap-1.5 px-2 py-0.5 bg-stone-50 rounded-lg border border-stone-200" title="@Localizer["Security deposit (refundable)"]">
                                        <i class="bi bi-shield-check text-emerald-500 text-[10px]"></i>
                                        <span class="text-[10px] font-bold text-stone-600 uppercase tracking-tight">@CurrencyService.Format(item.DepositAmount.Value)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>

        <div class="mt-8 text-center sm:hidden">
            <a asp-controller="Rentals" asp-action="Index" asp-route-sort="rating"
               class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-md transition-colors">
                @Localizer["View all"] <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</section>
}


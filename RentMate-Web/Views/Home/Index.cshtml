<!-- Testimonials Section -->
<section class="py-20 bg-gradient-to-br from-blue-600 to-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
            <h2 class="font-heading text-3xl sm:text-4xl font-bold mb-4">
                @Localizer["What our users say"]
            </h2>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
            @{
                var testimonials = new[] {
                    ("RentMate saved me so much money! I needed a power drill for one project and found one nearby for just a few euros.", "Sarah M.", "Ljubljana"),
                    ("I've been renting out my camping gear and it basically pays for itself now. Great way to earn passive income!", "Mark T.", "Maribor"),
                    ("The booking process is so smooth. Found a projector for my party in minutes!", "Ana K.", "Celje")
                };
            }
            @foreach (var (quote, name, loc) in testimonials)
            {
                <div class="bg-white/10 rounded-2xl p-6 border border-white/10" style="-webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);">
                    <div class="flex gap-1 mb-4" role="img" aria-label="5 out of 5 stars">
                        @for (int i = 0; i < 5; i++)
                        {
                            <i class="bi bi-star-fill text-amber-400" aria-hidden="true"></i>
                        }
                    </div>
                    <p class="mb-6 leading-relaxed" style="color: var(--text-muted-on-dark, rgba(255,255,255,0.87));">"@Localizer[quote]"</p>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-sky-400 to-blue-500 flex items-center justify-center font-bold text-white" aria-hidden="true">
                            @name[0]
                        </div>
                        <div>
                            <p class="font-semibold" style="color: var(--text-on-dark, rgba(255,255,255,0.92));">@name</p>
                            <p class="text-sm" style="color: var(--text-muted-on-dark, rgba(255,255,255,0.87));">@loc</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-20 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="font-heading text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
            @Localizer["Become part of the RentMate community"]
        </h2>
        <p class="text-lg text-slate-600 mb-8 max-w-2xl mx-auto">
            @Localizer["Earn by renting out your equipment or save by renting."]
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Items" asp-action="Create" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-semibold rounded-full shadow-sm  transition-all duration-300">
                    <i class="bi bi-plus-circle"></i>
                    @Localizer["List your first item"]
                </a>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Register" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-semibold rounded-full shadow-sm  transition-all duration-300">
                    <i class="bi bi-person-plus"></i>
                    @Localizer["Register now"]
                </a>
            }
            <a asp-controller="Rentals" asp-action="Index" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white hover:bg-slate-50 text-slate-900 font-semibold rounded-full border-2 border-slate-200 hover:border-blue-300 transition-all duration-300">
                <i class="bi bi-search"></i>
                @Localizer["Browse marketplace"]
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Helper function to format date as yyyy-MM-dd in local timezone
        function formatLocalDate(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }



        // SmartCalendar is now used instead of Flatpickr for date selection

        // Category pill click handler - populates search and focuses input
        function setSearchCategory(category) {
            const searchInput = document.getElementById('heroSearch');
            if (searchInput) {
                searchInput.value = category;
                searchInput.focus();
                // Select all text so user can easily type to replace
                searchInput.select();
                // Show clear button since we now have a value
                toggleClearButton(searchInput);
            }
        }

        // ============================================================
        // OPUS SEARCH BAR - Clear Button & Loading State Functions
        // ============================================================

        // Toggles the visibility of the clear (×) button based on input value.
        // Uses CSS opacity/visibility for smooth animation.
        function toggleClearButton(inputElement) {
            const clearBtn = document.getElementById('heroSearchClear');
            if (!clearBtn) return;
            
            if (inputElement.value.length > 0) {
                clearBtn.classList.remove('opacity-0', 'invisible');
                clearBtn.classList.add('opacity-100', 'visible');
            } else {
                clearBtn.classList.add('opacity-0', 'invisible');
                clearBtn.classList.remove('opacity-100', 'visible');
            }
        }

        /**
         * Clears the search input, hides the clear button, and refocuses input.
         * Provides immediate feedback for keyboard and mouse users.
         */
        function clearSearchInput() {
            const searchInput = document.getElementById('heroSearch');
            const clearBtn = document.getElementById('heroSearchClear');
            
            if (searchInput) {
                searchInput.value = '';
                searchInput.focus();
            }
            if (clearBtn) {
                clearBtn.classList.add('opacity-0', 'invisible');
                clearBtn.classList.remove('opacity-100', 'visible');
            }
        }

        /**
         * Shows loading spinner on form submit for perceived performance.
         * Called via onsubmit handler on the form element.
         */
        function showSearchLoading() {
            const spinner = document.getElementById('heroSearchSpinner');
            const searchIcon = document.querySelector('#heroSearchForm .bi-search');
            
            if (spinner) {
                spinner.classList.remove('hidden');
            }
            // Optionally hide the search icon in the button during loading
            const submitBtn = document.querySelector('#heroSearchForm button[type="submit"]');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.classList.add('opacity-75', 'cursor-wait');
            }
        }

        // Initialize clear button visibility on page load (for preserved search values)
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('heroSearch');
            if (searchInput && searchInput.value.length > 0) {
                toggleClearButton(searchInput);
            }
        });
    </script>
}


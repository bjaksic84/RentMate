        @* Section 10: Policy Changes *@
        <section>
            <h2 class="text-xl font-semibold text-slate-900 dark:text-white mb-2">@Localizer["PrivacyPolicy.Section10.Title"]</h2>
            <p>@Localizer["PrivacyPolicy.Section10.Body"]</p>
        </section>

        @* Section 11: Contact *@
        <section>
            <h2 class="text-xl font-semibold text-slate-900 dark:text-white mb-2">@Localizer["PrivacyPolicy.Section11.Title"]</h2>

                <li>@Localizer["PrivacyPolicy.Section7.Item3"]</li>
                <li>@Localizer["PrivacyPolicy.Section7.Item4"]</li>
                <li>@Localizer["PrivacyPolicy.Section7.Item5"]</li>
                <li>@Localizer["PrivacyPolicy.Section7.Item6"]</li>
            </ul>
        </section>


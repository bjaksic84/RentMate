@model RentMate.Models.ApplicationUser
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject RentMate.Services.CurrencyService CurrencyService

@{
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName}";
    var profilePic = !string.IsNullOrEmpty(Model.ProfilePictureUrl) ? Model.ProfilePictureUrl : "https://via.placeholder.com/150?text=User";
    
    var allItems = Model.Items?.Where(i => i.IsListed && !i.IsAdminHidden).ToList() ?? new List<RentMate.Models.Item>();
    double avgRating = 0;
    int reviewCount = 0;
    
    if (allItems.Any())
    {
        var allReviews = allItems.SelectMany(i => i.Reviews ?? new List<RentMate.Models.Review>()).Where(r => !r.IsDeleted).ToList();
        if (allReviews.Any())
        {
            avgRating = allReviews.Average(r => r.Rating);
            reviewCount = allReviews.Count;
        }
    }
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid lg:grid-cols-3 gap-8">
        <!-- Profile Sidebar -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-2xl border border-slate-200 p-6 text-center sticky top-24">
                <!-- Profile Picture -->
                <div class="relative inline-block mb-4">
                    <img src="@profilePic" 
                         class="w-32 h-32 rounded-full object-cover ring-4 ring-white shadow-lg mx-auto" 
                         alt="@Model.FirstName">
                    @if(avgRating >= 4.5 && reviewCount >= 5) 
                    {
                        <div class="absolute -bottom-1 -right-1 w-8 h-8 bg-green-500 rounded-full flex items-center justify-center ring-2 ring-white" title="@Localizer["Super Host"]">
                            <i class="bi bi-shield-check text-white text-sm"></i>
                        </div>
                    }
                </div>
                
                <h1 class="font-heading text-2xl font-bold text-slate-900">@Model.FirstName @Model.LastName</h1>
                <p class="text-slate-500 mt-1 flex items-center justify-center gap-1">
                    <i class="bi bi-geo-alt-fill text-red-500"></i>
                    @(Model.City ?? Localizer["Unknown"].Value)
                </p>
                
                <!-- Stats -->
                <div class="flex items-center justify-center gap-6 my-6 py-4 border-y border-slate-200">
                    <div class="text-center">
                        <p class="text-2xl font-bold text-slate-900">@allItems.Count</p>
                        <p class="text-sm text-slate-500">@Localizer["Listings"]</p>
                    </div>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-slate-900 flex items-center justify-center gap-1">
                            @avgRating.ToString("0.0")
                            <i class="bi bi-star-fill text-amber-400 text-sm"></i>
                        </p>
                        <p class="text-sm text-slate-500">@Localizer["Rating"]</p>
                    </div>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-slate-900">@reviewCount</p>
                        <p class="text-sm text-slate-500">@Localizer["Reviews"]</p>
                    </div>
                </div>
                
                <!-- Contact Info -->
                <div class="text-left space-y-3">
                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">@Localizer["Contact"]</p>
                    <div class="flex items-center gap-3 text-slate-600">
                        <i class="bi bi-envelope text-slate-400"></i>
                        <span class="text-sm truncate">@Model.Email</span>
                    </div>
                    @if(!string.IsNullOrEmpty(Model.PhoneNumber))
                    {
                        <div class="flex items-center gap-3 text-slate-600">
                            <i class="bi bi-telephone text-slate-400"></i>
                            <span class="text-sm">@Model.PhoneNumber</span>
                        </div>
                    }
                </div>
                
                @if(avgRating >= 4.5 && reviewCount >= 5) 
                {
                    <div class="mt-6 p-4 bg-green-50 rounded-xl">
                        <div class="flex items-center gap-2 text-green-700">
                            <i class="bi bi-shield-check text-lg"></i>
                            <span class="font-semibold">@Localizer["Super Host"]</span>
                        </div>
                        <p class="text-sm text-green-600 mt-1">@Localizer["Highly rated by renters"]</p>
                    </div>
                }
            </div>
        </div>

        <!-- Listings -->
        <div class="lg:col-span-2">
            <h2 class="font-heading text-2xl font-bold text-slate-900 mb-6">
                @Localizer["Active Listings"] <span class="text-slate-400 font-normal">(@allItems.Count)</span>
            </h2>
            
            @if (!allItems.Any())
            {
                <div class="bg-slate-50 rounded-2xl p-12 text-center">
                    <i class="bi bi-box-seam text-6xl text-slate-300"></i>
                    <p class="mt-4 text-slate-500">@Localizer["This user currently has no active listings."]</p>
                </div>
            }
            else
            {
                <div class="grid sm:grid-cols-2 gap-6">
                    @foreach (var item in allItems)
                    {
                        <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="group">
                            <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
                                <!-- Image -->
                                <div class="relative h-48 overflow-hidden">
                                    @if(!string.IsNullOrEmpty(item.ImageUrl)) {
                                        var thumbUrl = item.ImageUrl.Replace("/upload/", "/upload/c_fill,w_400,h_300,q_auto/");
                                        <img src="@thumbUrl" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                                    } else {
                                        <div class="w-full h-full bg-slate-100 flex items-center justify-center">
                                            <i class="bi bi-image text-4xl text-slate-300"></i>
                                        </div>
                                    }
                                    
                                    <!-- Price Badge -->
                                    <div class="absolute bottom-3 right-3">
                                        <span class="px-3 py-1.5 bg-white/95 backdrop-blur text-slate-900 text-sm font-bold rounded-lg shadow">
                                            @CurrencyService.Format(item.Price)/@Localizer["day"]
                                        </span>
                                    </div>
                                    
                                    <!-- Category Badge -->
                                    <div class="absolute top-3 left-3">
                                        <span class="px-2 py-1 bg-blue-600 text-white text-xs font-medium rounded-full">
                                            @Localizer[item.Category]
                                        </span>
                                    </div>
                                </div>
                                
                                <!-- Content -->
                                <div class="p-4">
                                    <h3 class="font-semibold text-slate-900 group-hover:text-blue-600 transition-colors truncate">
                                        @item.Title
                                    </h3>
                                    <div class="flex items-center gap-2 mt-2 text-sm text-slate-500">
                                        <i class="bi bi-star-fill text-amber-400"></i>
                                        <span>@(item.AverageRating?.ToString("0.0") ?? "-")</span>
                                        <span class="text-slate-300">•</span>
                                        <span>@item.ReviewCount @Localizer["reviews"]</span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
            
            <!-- Recent Reviews -->
            @{
                var recentReviews = allItems
                    .SelectMany(i => (i.Reviews ?? new List<RentMate.Models.Review>()).Select(r => new { Item = i, Review = r }))
                    .Where(x => !x.Review.IsDeleted)
                    .OrderByDescending(x => x.Review.CreatedAt)
                    .Take(5)
                    .ToList();
            }
            
            @if(recentReviews.Any())
            {
                <h2 class="font-heading text-2xl font-bold text-slate-900 mt-12 mb-6">
                    @Localizer["Recent Reviews"]
                </h2>
                
                <div class="space-y-4">
                    @foreach (var entry in recentReviews)
                    {
                        <div class="bg-white rounded-2xl border border-slate-200 p-5">
                            <div class="flex items-start gap-4">
                                <img src="@(entry.Review.Reviewer?.ProfilePictureUrl ?? "https://via.placeholder.com/40")" 
                                     class="w-10 h-10 rounded-full object-cover shrink-0">
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between gap-2">
                                        <div>
                                            <p class="font-semibold text-slate-900">
                                                @(entry.Review.IsAnonymous ? Localizer["Anonymous"] : entry.Review.Reviewer?.FirstName)
                                            </p>
                                            <p class="text-sm text-slate-500">@entry.Review.CreatedAt.ToString("MMMM yyyy")</p>
                                        </div>
                                        <div class="flex items-center gap-0.5">
                                            @for(int i = 0; i < 5; i++) {
                                                <i class="bi bi-star-fill @(i < entry.Review.Rating ? "text-amber-400" : "text-slate-200")"></i>
                                            }
                                        </div>
                                    </div>
                                    <p class="text-sm text-slate-500 mt-1">
                                        @Localizer["For"]: <a asp-controller="Items" asp-action="Details" asp-route-id="@entry.Item.Id" class="text-blue-600 hover:underline">@entry.Item.Title</a>
                                    </p>
                                    <p class="text-slate-600 mt-2">@entry.Review.Body</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>


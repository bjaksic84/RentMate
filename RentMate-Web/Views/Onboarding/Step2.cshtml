@model OnboardingStep2ViewModel
@{
    ViewData["Title"] = "Profile Picture";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-lg w-full">
        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-lg p-8">

            <!-- Progress indicator -->
            <div class="flex items-center justify-center gap-3 mb-8">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-full bg-green-500 text-white flex items-center justify-center text-sm">
                        <i class="bi bi-check-lg"></i>
                    </div>
                    <span class="text-sm font-medium text-green-600">Your Info</span>
                </div>
                <div class="w-12 h-0.5 bg-green-400"></div>
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold">2</div>
                    <span class="text-sm font-medium text-blue-600">Photo</span>
                </div>
            </div>

            <!-- Header -->
            <div class="text-center mb-8">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-600 to-sky-400 flex items-center justify-center mx-auto mb-4">
                    <i class="bi bi-camera text-white text-2xl"></i>
                </div>
                <h2 class="font-heading text-2xl font-bold text-slate-900 dark:text-white">Add a Profile Picture</h2>
                <p class="text-slate-500 dark:text-slate-400 mt-2 text-sm">Profiles with photos get 3× more responses. You can always change it later.</p>
            </div>

            <form asp-action="Step2" method="post" enctype="multipart/form-data" class="space-y-6">
                @Html.AntiForgeryToken()

                <!-- Photo upload area -->
                <div class="flex flex-col items-center gap-4">
                    <div class="relative group">
                        <img id="profilePreview"
                             src="@(string.IsNullOrEmpty(Model?.ExistingProfilePictureUrl) ? "https://via.placeholder.com/160?text=You" : Model.ExistingProfilePictureUrl)"
                             class="w-40 h-40 rounded-2xl object-cover border-2 border-slate-200 dark:border-slate-600 shadow-sm transition-all group-hover:border-blue-400"
                             alt="Profile picture preview" />
                        <label for="fileUpload"
                               class="absolute inset-0 flex flex-col items-center justify-center bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity rounded-2xl cursor-pointer">
                            <i class="bi bi-camera-fill text-white text-2xl"></i>
                            <span class="text-white text-xs mt-1 font-medium">Choose photo</span>
                        </label>
                        <input type="file" id="fileUpload" asp-for="ProfilePicture" class="hidden" accept="image/*" onchange="previewImage(this)" />
                    </div>

                    <label for="fileUpload"
                           class="inline-flex items-center gap-2 px-5 py-2.5 border-2 border-dashed border-slate-300 dark:border-slate-600 hover:border-blue-400 text-slate-600 dark:text-slate-300 text-sm font-medium rounded-xl cursor-pointer transition-colors">
                        <i class="bi bi-upload"></i>
                        Upload from your device
                    </label>
                    <p class="text-xs text-slate-400">JPG, PNG or WEBP. Max 5 MB.</p>
                </div>

                <!-- Tips -->
                <div class="bg-slate-50 dark:bg-slate-700/50 rounded-xl p-4">
                    <p class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Tips for a great photo:</p>
                    <ul class="space-y-1.5 text-xs text-slate-500 dark:text-slate-400">
                        <li class="flex items-center gap-2"><i class="bi bi-check-circle text-green-500"></i> Use a clear, front-facing photo</li>
                        <li class="flex items-center gap-2"><i class="bi bi-check-circle text-green-500"></i> Good lighting makes a big difference</li>
                        <li class="flex items-center gap-2"><i class="bi bi-check-circle text-green-500"></i> Smile — people trust friendly faces</li>
                    </ul>
                </div>

                <!-- Action buttons -->
                <div class="flex flex-col gap-3">
                    <button type="submit"
                            class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-semibold rounded-xl shadow-sm transition-all">
                        <i class="bi bi-check-lg"></i>
                        Complete Setup
                    </button>
                </div>
            </form>

            <!-- Skip button (separate form) -->
            <form asp-action="SkipStep2" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="w-full text-center text-sm text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition-colors py-2">
                    Skip for now — I'll add a photo later
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                // Validate file size (5MB max)
                if (input.files[0].size > 5 * 1024 * 1024) {
                    alert('File is too large. Maximum size is 5 MB.');
                    input.value = '';
                    return;
                }
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('profilePreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}

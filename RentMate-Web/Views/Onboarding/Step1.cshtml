@model OnboardingStep1ViewModel
@{
    ViewData["Title"] = "Welcome to RentMate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-lg w-full">
        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-lg p-8">

            <!-- Progress indicator -->
            <div class="flex items-center justify-center gap-3 mb-8">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold">1</div>
                    <span class="text-sm font-medium text-blue-600">Your Info</span>
                </div>
                <div class="w-12 h-0.5 bg-slate-200 dark:bg-slate-600"></div>
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-full bg-slate-200 dark:bg-slate-600 text-slate-400 flex items-center justify-center text-sm font-bold">2</div>
                    <span class="text-sm text-slate-400">Photo</span>
                </div>
            </div>

            <!-- Header -->
            <div class="text-center mb-8">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-600 to-sky-400 flex items-center justify-center mx-auto mb-4">
                    <i class="bi bi-person-heart text-white text-2xl"></i>
                </div>
                <h2 class="font-heading text-2xl font-bold text-slate-900 dark:text-white">Welcome to RentMate!</h2>
                <p class="text-slate-500 dark:text-slate-400 mt-2 text-sm">Let's set up your profile so others can trust you.</p>
            </div>

            <form asp-action="Step1" method="post" class="space-y-5">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm"></div>

                <!-- Name fields -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="FirstName" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">First Name</label>
                        <input asp-for="FirstName"
                               class="w-full px-4 py-3 border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                               placeholder="John" />
                        <span asp-validation-for="FirstName" class="text-sm text-red-600"></span>
                    </div>
                    <div>
                        <label asp-for="LastName" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Last Name</label>
                        <input asp-for="LastName"
                               class="w-full px-4 py-3 border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                               placeholder="Doe" />
                        <span asp-validation-for="LastName" class="text-sm text-red-600"></span>
                    </div>
                </div>

                <!-- Location -->
                <div>
                    <label asp-for="City" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">
                        <i class="bi bi-geo-alt text-blue-500 mr-1"></i> Location
                    </label>
                    <select asp-for="City" asp-items="@((List<SelectListItem>)ViewBag.CityOptions)"
                            class="w-full px-4 py-3 border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-white transition-colors">
                        <option value="">-- Select your city --</option>
                    </select>
                    <span asp-validation-for="City" class="text-sm text-red-600"></span>
                    <p class="text-xs text-slate-400 mt-1">Your location helps show nearby items and builds trust with renters.</p>
                </div>

                <!-- Info box -->
                <div class="bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800 rounded-xl p-4">
                    <div class="flex items-start gap-3">
                        <i class="bi bi-info-circle text-blue-500 mt-0.5"></i>
                        <div class="text-sm text-blue-700 dark:text-blue-300">
                            <p class="font-medium">Why do we need this?</p>
                            <p class="mt-1 text-blue-600 dark:text-blue-400">Your name and location are shown on your profile and help build trust with other users in the community.</p>
                        </div>
                    </div>
                </div>

                <!-- Submit -->
                <button type="submit"
                        class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-semibold rounded-xl shadow-sm transition-all">
                    Continue
                    <i class="bi bi-arrow-right"></i>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

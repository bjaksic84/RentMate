@model RentMate.Models.Domain.Item
@using System.Text.Json
@using Microsoft.AspNetCore.Mvc.Localization
@using RentMate.Shared.Contracts.Responses
@inject IViewLocalizer Localizer
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService

@{
    var blockedDates = (Model.Rentals ?? Enumerable.Empty<RentMate.Models.Domain.Rental>())
        .Where(r => r.Status == RentalStatus.Active || r.Status == RentalStatus.Pending)
        .Select(r => new { from = r.StartDate.ToString("yyyy-MM-dd"), to = r.EndDate.ToString("yyyy-MM-dd") })
        .ToList();
    var jsonBlocked = blockedDates != null && blockedDates.Any() ? JsonSerializer.Serialize(blockedDates) : "[]";
    var calendarId = $"rentCalendar_{Model.Id}";
}

<!-- Tailwind Modal -->
<div id="rentModal-@Model.Id" class="fixed inset-0 hidden overflow-y-auto" style="z-index: var(--z-modal, 1200);">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="document.getElementById('rentModal-@Model.Id').classList.add('hidden')"></div>
    <div class="flex min-h-full items-start justify-center p-4 pt-16 sm:pt-24">
        <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md">
            <!-- Header -->
            <div class="bg-gradient-to-r from-blue-600 to-blue-500 px-6 py-4 rounded-t-2xl">
                <div class="flex items-center justify-between">
                    <h3 class="text-white font-heading text-lg font-bold">@Localizer["Reservation"]</h3>
                    <button type="button" onclick="document.getElementById('rentModal-@Model.Id').classList.add('hidden')" class="text-white/80 hover:text-white">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <p class="text-white/80 text-sm mt-1">@Model.Title</p>
            </div>
            
            <form asp-controller="Rentals" asp-action="RequestRental" method="post" data-price="@Model.Price?.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="p-6">
                <input type="hidden" name="itemId" value="@Model.Id" />

                <div class="mb-5">
                    <label class="block text-sm font-medium text-slate-700 mb-2">@Localizer["Choose dates"]</label>
                    @await Html.PartialAsync("_SmartCalendar", new RentMate.Models.ViewModels.SmartCalendarModel {
                        Id = calendarId,
                        Mode = RentMate.Models.ViewModels.CalendarMode.Range,
                        StartDateField = "startDate",
                        EndDateField = "endDate",
                        Placeholder = Localizer["Click to select dates..."].Value
                    })
                </div>

                <div id="modalPriceCalculation-@Model.Id" class="hidden mb-5 p-4 bg-slate-50 rounded-xl">
                    <div class="flex justify-between items-center text-sm text-slate-600 mb-2">
                        <span id="modalCalcDays-@Model.Id">0 @Localizer["days"] x @CurrencyService.Format(Model.Price)</span>
                        <span id="modalCalcTotalBase-@Model.Id" class="font-medium">@CurrencyService.GetCurrentCurrency().Symbol 0.00</span>
                    </div>
                    <div class="flex justify-between items-center pt-3 border-t border-slate-200">
                        <span class="font-semibold text-slate-900">@Localizer["Total"]</span>
                        <span id="modalCalcFinalTotal-@Model.Id" class="text-xl font-bold text-green-600">@CurrencyService.GetCurrentCurrency().Symbol 0.00</span>
                    </div>
                </div>

                <div class="flex gap-3">
                    <button type="button" 
                            onclick="document.getElementById('rentModal-@Model.Id').classList.add('hidden')" 
                            class="flex-1 px-4 py-3 border border-slate-200 text-slate-600 font-medium rounded-xl hover:bg-slate-50 transition-colors">
                        @Localizer["Cancel"]
                    </button>
                    <button type="submit" 
                            class="flex-1 px-4 py-3 bg-gradient-to-r from-green-600 to-green-500 text-white font-semibold rounded-xl hover:shadow-md transition-all">
                        <i class="bi bi-check-lg me-1"></i>
                        @Localizer["Confirm"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Price Calculation Script -->
<script>
(function() {
    const calendarId = '@calendarId';
    const itemId = '@Model.Id';
    const pricePerDay = parseFloat('@Model.Price?.ToString(System.Globalization.CultureInfo.InvariantCulture)' || '0');
    
    document.getElementById(calendarId)?.addEventListener('smartcalendar:change', function(e) {
        const { startDate, endDate } = e.detail;
        
        if (startDate && endDate) {
            const start = new Date(startDate);
            const end = new Date(endDate);
            const diffTime = Math.abs(end - start);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
            
            const basePrice = isNaN(pricePerDay) ? 0 : pricePerDay;
            const exchangeRate = window.CurrentCurrency ? window.CurrentCurrency.ExchangeRate : 1.0;
            const symbol = window.CurrentCurrency ? window.CurrentCurrency.Symbol : '€';
            const code = window.CurrentCurrency ? window.CurrentCurrency.Code : 'EUR';
            
            const totalConverted = diffDays * basePrice * exchangeRate;
            const formattedPrice = code === 'CHF' 
                ? `${(basePrice * exchangeRate).toFixed(2)} ${symbol}` 
                : `${symbol}${(basePrice * exchangeRate).toFixed(2)}`;
            const formattedTotal = code === 'CHF' 
                ? `${totalConverted.toFixed(2)} ${symbol}` 
                : `${symbol}${totalConverted.toFixed(2)}`;
            
            const calcWrapper = document.getElementById('modalPriceCalculation-' + itemId);
            const calcDays = document.getElementById('modalCalcDays-' + itemId);
            const calcTotalBase = document.getElementById('modalCalcTotalBase-' + itemId);
            const calcFinalTotal = document.getElementById('modalCalcFinalTotal-' + itemId);
            
            if (calcWrapper) {
                const daysText = window.Translations && window.Translations["days"] ? window.Translations["days"] : "days";
                if (calcDays) calcDays.innerText = `${diffDays} ${daysText} x ${formattedPrice}`;
                if (calcTotalBase) calcTotalBase.innerText = formattedTotal;
                if (calcFinalTotal) calcFinalTotal.innerText = formattedTotal;
                calcWrapper.classList.remove('hidden');
            }
        }
    });
})();
</script>

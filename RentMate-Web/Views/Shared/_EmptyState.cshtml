@*
    Empty State Partial View
    
    Usage: @await Html.PartialAsync("_EmptyState", new { 
        Icon = "bi-box-seam", 
        Message = "No items found",
        ActionLink = "/Items/Create",
        ActionText = "Create Item"
    })
*@

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    var modelType = Model?.GetType();
    var icon = (string)(modelType?.GetProperty("Icon")?.GetValue(Model) ?? ViewData["Icon"] ?? "bi-inbox");
    var message = (string)(modelType?.GetProperty("Message")?.GetValue(Model) ?? ViewData["Message"] ?? "No data found");
    var actionLink = (string?)(modelType?.GetProperty("ActionLink")?.GetValue(Model) ?? ViewData["ActionLink"]);
    var actionText = (string?)(modelType?.GetProperty("ActionText")?.GetValue(Model) ?? ViewData["ActionText"]);
}

<div class="p-12 text-center">
    <div class="w-16 h-16 mx-auto bg-stone-100 rounded-full flex items-center justify-center mb-4">
        <i class="bi @icon text-2xl text-stone-300"></i>
    </div>
    <p class="text-stone-500 mb-4">@Localizer[message]</p>
    @if (!string.IsNullOrEmpty(actionLink) && !string.IsNullOrEmpty(actionText))
    {
        <a href="@actionLink" class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700 transition-colors duration-150">
            <i class="bi bi-plus-lg"></i>
            @Localizer[actionText]
        </a>
    }
</div>

@*
    Back Link Partial View - Consistent back navigation
    
    Usage: @await Html.PartialAsync("_BackLink", new { 
        Controller = "Dashboard", 
        Action = "UserDashboard", 
        Text = "Back to Dashboard",
        RouteId = optionalId  // optional
    })
*@

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    // Use reflection to safely get properties from anonymous types
    var modelType = Model?.GetType();
    var controller = (string?)(modelType?.GetProperty("Controller")?.GetValue(Model) ?? ViewData["Controller"]);
    var action = (string)(modelType?.GetProperty("Action")?.GetValue(Model) ?? ViewData["Action"] ?? "Index");
    var text = (string)(modelType?.GetProperty("Text")?.GetValue(Model) ?? ViewData["Text"] ?? "Back");
    var routeId = modelType?.GetProperty("RouteId")?.GetValue(Model) ?? ViewData["RouteId"];
}

<a asp-controller="@controller" asp-action="@action" asp-route-id="@routeId"
   class="inline-flex items-center gap-2 text-stone-500 hover:text-primary-600 transition-colors duration-150 mb-4">
    <i class="bi bi-arrow-left"></i>
    @Localizer[text]
</a>

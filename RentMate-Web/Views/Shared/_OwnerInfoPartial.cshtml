@model dynamic
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    var fullName = (Model.FirstName ?? Localizer["User"].Value) + " " + (Model.LastName ?? "");
    var profilePic = !string.IsNullOrEmpty(Model.ProfilePictureUrl) 
                     ? Model.ProfilePictureUrl 
                     : "https://via.placeholder.com/100?text=U"; 
}

<div class="p-6">
    <div class="flex items-center justify-between mb-6">
        <h3 class="font-heading text-xl font-bold text-slate-900">@Localizer["Item Owner"]</h3>
        <button type="button" onclick="this.closest('.fixed').classList.add('hidden')" class="p-2 text-slate-400 hover:text-slate-600 rounded-lg">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    
    <div class="text-center">
        <img src="@profilePic" 
             class="w-24 h-24 rounded-full object-cover ring-4 ring-white shadow-lg mx-auto mb-4" 
             alt="@fullName" />
        
        <h4 class="font-heading text-xl font-bold text-slate-900">@fullName</h4>
        <p class="text-slate-500 flex items-center justify-center gap-1 mt-1">
            <i class="bi bi-geo-alt-fill text-red-500"></i>
            @(Model.City ?? Localizer["Unknown"].Value)
        </p>
        
        <!-- Stats -->
        <div class="flex items-center justify-center gap-8 my-6 py-4 border-y border-slate-200">
            <div class="text-center">
                <p class="text-2xl font-bold text-slate-900 flex items-center justify-center gap-1">
                    @Model.AverageRating.ToString("0.0")
                    <i class="bi bi-star-fill text-amber-400 text-sm"></i>
                </p>
                <p class="text-xs text-slate-400 uppercase tracking-wide">@Localizer["Rating"]</p>
            </div>
            <div class="w-px h-10 bg-slate-200"></div>
            <div class="text-center">
                <p class="text-2xl font-bold text-slate-900">@Model.ReviewCount</p>
                <p class="text-xs text-slate-400 uppercase tracking-wide">@Localizer["Reviews"]</p>
            </div>
        </div>
        
        <!-- Verified Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-green-50 text-green-700 rounded-full mb-6">
            <i class="bi bi-shield-check"></i>
            <span class="text-sm font-medium">@Localizer["Verified"]</span>
        </div>
        
        <!-- Actions -->
        <div class="space-y-3">
            <a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.Id" 
               class="block w-full py-3 bg-gradient-to-r from-blue-600 to-blue-500 text-white font-semibold rounded-xl hover:shadow-md transition-all text-center">
                @Localizer["View Full Profile"]
            </a>
            <a href="mailto:@Model.Email" 
               class="block w-full py-3 border border-slate-200 text-slate-700 font-medium rounded-xl hover:bg-slate-50 transition-colors text-center">
                <i class="bi bi-envelope me-2"></i>
                @Localizer["Send Message"]
            </a>
        </div>
    </div>
</div>

@* 
    Favorite Heart Button Partial View
    
    Usage: @await Html.PartialAsync("_FavoriteButton", new FavoriteButtonViewModel { ItemId = item.Id, IsFavorited = item.IsFavorited })
    
    Or with ViewData:
    @await Html.PartialAsync("_FavoriteButton", null, new ViewDataDictionary(ViewData) { { "ItemId", item.Id }, { "IsFavorited", item.IsFavorited } })
*@

@{
    var modelType = Model?.GetType();
    var itemId = modelType?.GetProperty("ItemId")?.GetValue(Model) ?? ViewData["ItemId"];
    var isFavorited = modelType?.GetProperty("IsFavorited")?.GetValue(Model) ?? ViewData["IsFavorited"] ?? false;
    var size = modelType?.GetProperty("Size")?.GetValue(Model) ?? ViewData["Size"] ?? "md"; // sm, md, lg
    
    var sizeClasses = size switch
    {
        "sm" => "w-5 h-5",
        "lg" => "w-8 h-8",
        _ => "w-6 h-6"
    };
    
    var buttonSizeClasses = size switch
    {
        "sm" => "w-8 h-8",
        "lg" => "w-12 h-12",
        _ => "w-10 h-10"
    };
}

<button type="button"
        class="favorite-btn group @buttonSizeClasses rounded-full bg-white/80 hover:bg-white shadow-lg transition-all duration-200 ease-in-out hover:scale-110 focus:outline-none focus:ring-2 focus:ring-red-300 focus:ring-offset-2 flex items-center justify-center"
        style="-webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);"
        data-item-id="@itemId"
        data-favorited="@(((bool)isFavorited).ToString().ToLower())"
        aria-label="@(((bool)isFavorited) ? "Remove from favorites" : "Add to favorites")"
        title="@(((bool)isFavorited) ? "Remove from favorites" : "Add to favorites")">
    
    @* Outline Heart (shown when not favorited) *@
    <svg class="favorite-icon-outline @sizeClasses transition-all duration-200 @(((bool)isFavorited) ? "hidden" : "") text-slate-400 group-hover:text-red-500"
         xmlns="http://www.w3.org/2000/svg"
         fill="none"
         viewBox="0 0 24 24"
         stroke="currentColor"
         stroke-width="2">
        <path stroke-linecap="round"
              stroke-linejoin="round"
              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
    </svg>
    
    @* Filled Heart (shown when favorited) *@
    <svg class="favorite-icon-filled @sizeClasses transition-all duration-200 @(((bool)isFavorited) ? "" : "hidden") text-red-500"
         xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 24 24"
         fill="currentColor">
        <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
    </svg>
    
    @* Loading spinner (shown during API call) *@
    <svg class="favorite-icon-loading @sizeClasses hidden animate-spin text-gray-400"
         xmlns="http://www.w3.org/2000/svg"
         fill="none"
         viewBox="0 0 24 24">
        <circle class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"></circle>
        <path class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
</button>

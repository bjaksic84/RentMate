@*
    Countdown Timer Partial View

    Usage: @await Html.PartialAsync("_CountdownTimer", new {
        EndDate = rental.EndDate,
        DaysRemaining = daysRemaining,
        Urgency = "normal" // normal, warning, urgent, overdue
    })
*@

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    var modelType = Model?.GetType();
    var endDate = (DateTime)(modelType?.GetProperty("EndDate")?.GetValue(Model) ?? DateTime.UtcNow);
    var daysRemaining = (int)(modelType?.GetProperty("DaysRemaining")?.GetValue(Model) ?? 0);
    var urgency = (string)(modelType?.GetProperty("Urgency")?.GetValue(Model) ?? "normal");
    var isOverdue = daysRemaining < 0;

    var (borderColor, bgColor, iconColor, textColor) = urgency switch
    {
        "overdue" => ("border-red-200 dark:border-red-800", "bg-red-50 dark:bg-red-900/10", "text-red-500", "text-red-700 dark:text-red-400"),
        "urgent" => ("border-clay-200 dark:border-clay-800", "bg-clay-50 dark:bg-clay-900/10", "text-clay-500", "text-clay-700 dark:text-clay-400"),
        "warning" => ("border-clay-200 dark:border-clay-800", "bg-clay-50/50 dark:bg-clay-900/10", "text-clay-500", "text-clay-700 dark:text-clay-400"),
        _ => ("border-ledger-200 dark:border-ledger-800", "bg-ledger-50 dark:bg-ledger-800/50", "text-ledger-400", "text-ledger-900 dark:text-ledger-100")
    };
}

<div class="flex items-center gap-3 rounded-md border px-3 py-2 @borderColor @bgColor">
    <svg class="h-4 w-4 @iconColor shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <div class="flex-1">
        <p class="text-[10px] uppercase tracking-wider font-medium text-ledger-400 dark:text-ledger-500">
            @(isOverdue ? Localizer["Overdue by"] : Localizer["Returns in"])
        </p>
        <p class="text-lg font-bold tabular-nums @textColor">
            @Math.Abs(daysRemaining)
            <span class="text-xs font-normal text-ledger-400">@Localizer["days"]</span>
        </p>
    </div>
    <time class="text-[10px] tabular-nums text-ledger-400" datetime="@endDate.ToString("yyyy-MM-dd")">
        @endDate.ToString("dd MMM yyyy")
    </time>
</div>

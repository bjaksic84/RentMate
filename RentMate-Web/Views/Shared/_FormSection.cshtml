@*
    Form Section Partial View - Consistent form card sections
    
    Usage: 
    @await Html.PartialAsync("_FormSection", new { Title = "Item Details" })
    
    Or with ViewData for content:
    <partial name="_FormSection" view-data='@(new ViewDataDictionary(ViewData) { { "Title", "Basic Info" } })'>
        <div>Form content here</div>
    </partial>
*@

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    var modelType = Model?.GetType();
    var title = (string)(modelType?.GetProperty("Title")?.GetValue(Model) ?? ViewData["Title"] ?? "");
    var subtitle = (string?)(modelType?.GetProperty("Subtitle")?.GetValue(Model) ?? ViewData["Subtitle"]);
    var icon = (string?)(modelType?.GetProperty("Icon")?.GetValue(Model) ?? ViewData["Icon"]);
}

<div class="bg-white rounded-lg border border-stone-200 p-6">
    @if (!string.IsNullOrEmpty(title))
    {
        <h2 class="text-lg font-semibold text-stone-900 mb-4 flex items-center gap-2">
            @if (!string.IsNullOrEmpty(icon))
            {
                <i class="bi @icon text-primary-600"></i>
            }
            @Localizer[title]
        </h2>
        @if (!string.IsNullOrEmpty(subtitle))
        {
            <p class="text-sm text-stone-500 -mt-2 mb-4">@Localizer[subtitle]</p>
        }
    }
    @RenderBody()
</div>

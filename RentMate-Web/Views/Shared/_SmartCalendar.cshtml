@model RentMate.Models.ViewModels.SmartCalendarModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    var calId = Model.Id ?? "smartCalendar";
    var mode = Model.Mode == RentMate.Models.ViewModels.CalendarMode.Range ? "range" : "single";
    var minDate = Model.MinDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd");
    var maxDate = Model.MaxDate?.ToString("yyyy-MM-dd") ?? "";
    var maxRangeDays = Model.MaxRangeDays?.ToString() ?? "";
    var initialStart = Model.InitialStart?.ToString("yyyy-MM-dd") ?? "";
    var initialEnd = Model.InitialEnd?.ToString("yyyy-MM-dd") ?? "";
    var disabledItems = new List<object>();
    if (Model.DisabledDates != null)
    {
        disabledItems.AddRange(Model.DisabledDates.Select(d => (object)d.ToString("yyyy-MM-dd")));
    }
    if (Model.DisabledRanges != null)
    {
        disabledItems.AddRange(Model.DisabledRanges.Select(r => (object)new { from = r.From.ToString("yyyy-MM-dd"), to = r.To.ToString("yyyy-MM-dd") }));
    }
    var disabledJson = disabledItems.Any()
        ? System.Text.Json.JsonSerializer.Serialize(disabledItems)
        : "[]";
    var isRangeMode = Model.Mode == RentMate.Models.ViewModels.CalendarMode.Range;
    var weekdaysShort = new[] { "Mo", "Tu", "We", "Th", "Fr", "Sa", "Su" };
}

@* SmartCalendar v3.0 - Consolidated single-file component *@
<div id="@calId" 
     class="smart-calendar relative @Model.CssClass"
     data-mode="@mode"
     data-min-date="@minDate"
     data-max-date="@maxDate"
     data-initial-start="@initialStart"
     data-initial-end="@initialEnd"
     data-disabled="@disabledJson"
     data-max-range-days="@maxRangeDays">
    
    <div class="smart-calendar-input flex items-center gap-3 px-4 py-3 rounded-xl md:rounded-full
                bg-white/60 hover:bg-white/90
                focus-within:bg-white focus-within:ring-2 focus-within:ring-blue-500 focus-within:ring-offset-2 focus-within:shadow-md
                transition-all duration-200 cursor-pointer h-full"
         onclick="SmartCalendar.toggle('@calId')">
        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-blue-600 to-sky-500 flex items-center justify-center flex-shrink-0" aria-hidden="true">
            <i class="bi bi-calendar-event text-white text-sm"></i>
        </div>
        <input type="text" 
               id="@(calId)_display"
               placeholder="@(Model.Placeholder ?? Localizer["When?"].Value)"
               aria-label="@(Model.Placeholder ?? Localizer["Date selection"].Value)"
               aria-haspopup="dialog"
               aria-expanded="false"
               autocomplete="off"
               readonly
               class="flex-1 min-w-0 bg-transparent border-none text-slate-900 font-medium 
                      placeholder-slate-500 focus:outline-none text-sm cursor-pointer">
        <button type="button"
                id="@(calId)_clear"
                onclick="event.stopPropagation(); SmartCalendar.clear('@calId');"
                aria-label="@Localizer["Clear dates"]"
                class="hidden w-6 h-6 rounded-full bg-slate-200 hover:bg-slate-300 
                       flex items-center justify-center text-slate-500 hover:text-slate-700 
                       transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-blue-500">
            <i class="bi bi-x text-sm" aria-hidden="true"></i>
        </button>
    </div>
    
    <input type="hidden" name="@Model.StartDateField" id="@(calId)_start" value="@initialStart">
    @if (isRangeMode)
    {
        <input type="hidden" name="@Model.EndDateField" id="@(calId)_end" value="@initialEnd">
    }
    
    <div id="@(calId)_panel"
         role="dialog"
         aria-modal="true"
         aria-label="@Localizer["Calendar"]"
         class="smart-calendar-panel hidden absolute
                bg-white rounded-2xl shadow-2xl ring-1 ring-slate-900/5
                p-4 sm:p-6 origin-top
                w-[calc(100vw-2rem)] sm:w-auto sm:min-w-[340px] max-w-[95vw]
                @(isRangeMode ? "lg:w-[680px]" : "")">
        
        <div id="@(calId)_announce" aria-live="polite" class="sr-only"></div>
        
        <div class="flex items-center justify-between mb-4 sm:mb-6">
            <button type="button" id="@(calId)_prev" onclick="SmartCalendar.prevMonth('@calId')"
                    class="w-8 h-8 sm:w-10 sm:h-10 rounded-full hover:bg-slate-100 flex items-center justify-center 
                           text-slate-600 transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
                    aria-label="@Localizer["Previous month"]">
                <i class="bi bi-chevron-left text-lg" aria-hidden="true"></i>
            </button>
            <div class="flex-1 flex @(isRangeMode ? "lg:justify-around justify-center" : "justify-center")">
                <h2 id="@(calId)_monthLabel1" class="text-sm sm:text-base font-semibold text-slate-900"></h2>
                @if (isRangeMode)
                {
                    <h2 id="@(calId)_monthLabel2" class="hidden lg:block text-base font-semibold text-slate-900"></h2>
                }
            </div>
            <button type="button" id="@(calId)_next" onclick="SmartCalendar.nextMonth('@calId')"
                    class="w-8 h-8 sm:w-10 sm:h-10 rounded-full hover:bg-slate-100 flex items-center justify-center 
                           text-slate-600 transition-colors"
                    aria-label="@Localizer["Next month"]">
                <i class="bi bi-chevron-right text-lg" aria-hidden="true"></i>
            </button>
        </div>
        
        <div class="flex flex-col lg:flex-row @(isRangeMode ? "lg:gap-10" : "")">
            <div class="flex-1 min-w-0">
                <div class="grid grid-cols-7 mb-2">
                    @foreach (var day in weekdaysShort) { <div class="h-8 sm:h-10 flex items-center justify-center text-xs font-semibold text-slate-400 uppercase tracking-wide">@Localizer[day]</div> }
                </div>
                <div id="@(calId)_grid1" role="grid" aria-label="@Localizer["Calendar days"]" class="grid grid-cols-7"></div>
            </div>
            @if (isRangeMode)
            {
                <div class="hidden lg:block w-px bg-slate-100" aria-hidden="true"></div>
                <div class="hidden lg:block flex-1 min-w-0">
                    <div class="grid grid-cols-7 mb-2">
                        @foreach (var day in weekdaysShort) { <div class="h-8 sm:h-10 flex items-center justify-center text-xs font-semibold text-slate-400 uppercase tracking-wide">@Localizer[day]</div> }
                    </div>
                    <div id="@(calId)_grid2" role="grid" aria-label="@Localizer["Calendar days"]" class="grid grid-cols-7"></div>
                </div>
            }
        </div>
        
        <div id="@(calId)_legend" class="hidden flex flex-wrap items-center gap-x-4 gap-y-1 mt-4 text-xs text-slate-500 dark:text-slate-400">
            <span data-legend="highlight" class="hidden items-center gap-1.5">
                <span class="inline-block w-3.5 h-3.5 rounded" style="background-color: #fef3c7;"></span>
                @Localizer["Your booking"]
            </span>
            <span data-legend="extension" class="hidden items-center gap-1.5">
                <span class="inline-block w-3.5 h-3.5 rounded" style="background-color: #d1fae5;"></span>
                @Localizer["Extension"]
            </span>
            <span data-legend="booked" class="hidden items-center gap-1.5">
                <span class="inline-block w-3.5 h-3.5 rounded" style="background: repeating-linear-gradient(-45deg, rgba(225,29,72,0.15), rgba(225,29,72,0.15) 3px, rgba(225,29,72,0.05) 3px, rgba(225,29,72,0.05) 5px);"></span>
                @Localizer["Booked"]
            </span>
            <span data-legend="unavailable" class="hidden items-center gap-1.5">
                <span class="inline-block w-3.5 h-3.5 rounded bg-slate-200 dark:bg-slate-600 opacity-50"></span>
                @Localizer["Unavailable"]
            </span>
        </div>
        <div class="flex items-center justify-between mt-6 pt-5 border-t border-slate-100">
            <button type="button" id="@(calId)_clearAll" onclick="SmartCalendar.clear('@calId')" 
                    class="text-sm font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-600 transition-colors hidden">
                @Localizer["Clear dates"]
            </button>
            <div class="flex-1"></div>
            <button type="button" onclick="SmartCalendar.close('@calId')" 
                    class="px-5 py-2.5 text-sm font-semibold text-white bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 rounded-full shadow-sm transition-all duration-200">
                @Localizer["Close"]
            </button>
        </div>
    </div>
</div>

<style>
    .sc-day { width: 100%; height: 36px; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 500; color: #1e293b; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); position: relative; cursor: pointer; background: transparent; border: none; outline: none; -webkit-tap-highlight-color: transparent; z-index: 1; }
    @@media (min-width: 640px) { .sc-day { height: 44px; font-size: 14px; } }
    .sc-day.sc-today:not(.sc-selected-start):not(.sc-selected-end)::after { content: ''; position: absolute; bottom: 4px; left: 50%; transform: translateX(-50%); width: 4px; height: 4px; background-color: #2563eb; border-radius: 50%; }
    @@media (min-width: 640px) { .sc-day.sc-today:not(.sc-selected-start):not(.sc-selected-end)::after { bottom: 6px; } }
    .sc-day.sc-today:not(.sc-selected-start):not(.sc-selected-end) { font-weight: 700; color: #2563eb; }
    .sc-day.sc-disabled { color: #cbd5e1; cursor: not-allowed; text-decoration: line-through; opacity: 0.5; }
    .sc-day.sc-booked { color: #e11d48; text-decoration: none; opacity: 1; background: repeating-linear-gradient(-45deg, transparent, transparent 3px, rgba(225, 29, 72, 0.08) 3px, rgba(225, 29, 72, 0.08) 5px); border-radius: 8px; }
    .sc-day::before { content: ''; position: absolute; inset: 2px; border-radius: 50%; background-color: transparent; transition: all 0.2s ease; z-index: -1; }
    .sc-day.sc-booked::before { background-color: rgba(225, 29, 72, 0.1); border-radius: 8px; inset: 1px; }
    /* Highlight: user's own booking (yellow pill) */
    .sc-day.sc-highlight { color: #92400e; font-weight: 600; background-color: #fef3c7; cursor: default; opacity: 1; text-decoration: none; }
    .sc-day.sc-highlight::before { background-color: transparent; }
    .sc-day.sc-highlight.sc-disabled { color: #92400e; opacity: 1; text-decoration: none; }
    .sc-day.sc-highlight-start { border-radius: 50% 0 0 50%; }
    .sc-day.sc-highlight-end { border-radius: 0 50% 50% 0; }
    .sc-day.sc-highlight-start.sc-highlight-end { border-radius: 50%; }
    /* Extension preview (green trail from highlight end to hovered/selected date) */
    .sc-day.sc-ext-preview { color: #065f46; background-color: #d1fae5; opacity: 1; text-decoration: none; cursor: pointer; }
    .sc-day.sc-ext-preview::before { background-color: transparent; }
    /* Last green cell (hover, not yet selected) — right half-pill with green circle */
    .sc-day.sc-ext-preview-end:not(.sc-selected-start) { color: white; font-weight: 600; z-index: 2; background-color: transparent; }
    .sc-day.sc-ext-preview-end:not(.sc-selected-start)::before { background: linear-gradient(135deg, #059669 0%, #10b981 100%); box-shadow: 0 4px 12px rgba(5, 150, 105, 0.35); inset: 0; border-radius: 50%; }
    .sc-day.sc-ext-preview-end:not(.sc-selected-start)::after { content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 50%; background-color: #d1fae5; z-index: -2; }
    /* Single-cell extension preview (immediately after highlight) — full circle, no strip */
    .sc-day.sc-ext-preview-start.sc-ext-preview-end:not(.sc-selected-start)::after { display: none; }
    /* Selected end — blue circle with green connector strip behind */
    .sc-day.sc-ext-preview.sc-selected-start { background-color: #d1fae5; }
    .sc-day.sc-ext-preview-end.sc-selected-start { background-color: transparent; }
    .sc-day.sc-ext-preview-end.sc-selected-start::after { content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 50%; background-color: #d1fae5; z-index: -2; }
    /* Single-cell selected extension (immediately after highlight) — blue circle, no strip */
    .sc-day.sc-ext-preview-start.sc-ext-preview-end.sc-selected-start::after { display: none; }
    @@media (min-width: 640px) { .sc-day::before { inset: 4px; } }
    .sc-day:hover:not(.sc-disabled):not(.sc-selected-start):not(.sc-selected-end):not(.sc-in-range)::before, .sc-day.sc-hover-end:not(.sc-selected-start):not(.sc-selected-end)::before { background-color: #f1f5f9; box-shadow: 0 0 0 1px #e2e8f0; z-index: -1; }
    .sc-day.sc-selected-start, .sc-day.sc-selected-end { color: white; font-weight: 600; z-index: 2; }
    .sc-day.sc-selected-start::before, .sc-day.sc-selected-end::before { background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%); box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35); inset: 0; }
    .sc-day.sc-in-range { color: #1a56db; background-color: #f0f7ff; }
    .sc-day.sc-range-start, .sc-day.sc-range-end { position: relative; }
    .sc-day.sc-range-start::after, .sc-day.sc-range-end::after { content: ''; position: absolute; top: 0; bottom: 0; width: 60%; background-color: #f0f7ff; z-index: -2; }
    .sc-day.sc-range-start::after { right: 0; }
    .sc-day.sc-range-end::after { left: 0; }
    .sc-day:focus-visible::before { box-shadow: 0 0 0 2px white, 0 0 0 4px #2563eb; }
    .sc-empty { width: 36px; height: 36px; }
    @@media (min-width: 640px) { .sc-empty { width: 44px; height: 44px; } }
    .smart-calendar-panel { animation: scFadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1); z-index: var(--z-popover, 1300); left: 50%; transform: translateX(-50%); margin-top: 0.75rem; }
    .smart-calendar-panel.hidden { display: none; }
    @@keyframes scFadeIn { from { opacity: 0; transform: translateX(-50%) translateY(10px) scale(0.98); } to { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); } }
    
    /* Dark mode styles for SmartCalendar */
    .dark .sc-day { color: #e2e8f0; }
    .dark .sc-day.sc-today:not(.sc-selected-start):not(.sc-selected-end) { color: #60a5fa; }
    .dark .sc-day.sc-today:not(.sc-selected-start):not(.sc-selected-end)::after { background-color: #60a5fa; }
    .dark .sc-day.sc-disabled { color: #475569; }
    .dark .sc-day.sc-booked { color: #fb7185; background: repeating-linear-gradient(-45deg, transparent, transparent 3px, rgba(251, 113, 133, 0.1) 3px, rgba(251, 113, 133, 0.1) 5px); }
    .dark .sc-day.sc-booked::before { background-color: rgba(251, 113, 133, 0.12); }
    .dark .sc-day.sc-highlight { color: #fcd34d; background-color: rgba(252, 211, 77, 0.15); }
    .dark .sc-day.sc-highlight.sc-disabled { color: #fcd34d; opacity: 1; }
    .dark .sc-day.sc-ext-preview { color: #6ee7b7; background-color: rgba(16, 185, 129, 0.15); }
    .dark .sc-day.sc-ext-preview-end:not(.sc-selected-start) { color: white; background-color: transparent; }
    .dark .sc-day.sc-ext-preview-end:not(.sc-selected-start)::after { background-color: rgba(16, 185, 129, 0.15); }
    .dark .sc-day.sc-ext-preview.sc-selected-start { background-color: rgba(16, 185, 129, 0.15); }
    .dark .sc-day.sc-ext-preview-end.sc-selected-start { background-color: transparent; }
    .dark .sc-day.sc-ext-preview-end.sc-selected-start::after { background-color: rgba(16, 185, 129, 0.15); }
    .dark .sc-day:hover:not(.sc-disabled):not(.sc-selected-start):not(.sc-selected-end):not(.sc-in-range)::before,
    .dark .sc-day.sc-hover-end:not(.sc-selected-start):not(.sc-selected-end)::before { background-color: #334155; box-shadow: 0 0 0 1px #475569; }
    .dark .sc-day.sc-in-range { color: #93c5fd; background-color: rgba(59, 130, 246, 0.15); }
    .dark .sc-day.sc-range-start::after, .dark .sc-day.sc-range-end::after { background-color: rgba(59, 130, 246, 0.15); }
    .dark .sc-day:focus-visible::before { box-shadow: 0 0 0 2px #1e293b, 0 0 0 4px #60a5fa; }
    .dark .smart-calendar-panel { background-color: #1e293b; border-color: #334155; }
    .dark .smart-calendar-panel .border-slate-100 { border-color: #334155; }

    /* Upward-opening compact variant */
    .sc-open-up .smart-calendar-panel { bottom: 100%; top: auto; margin-top: 0; margin-bottom: 0.75rem; padding: 0.75rem; animation: scFadeInUp 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
    @@keyframes scFadeInUp { from { opacity: 0; transform: translateX(-50%) translateY(10px) scale(0.98); } to { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); } }
    .sc-open-up .sc-day { width: 30px; height: 30px; font-size: 12px; }
    .sc-open-up .sc-empty { width: 30px; height: 30px; }
    @@media (min-width: 640px) {
        .sc-open-up .smart-calendar-panel { padding: 1rem; }
        .sc-open-up .sc-day { width: 34px; height: 34px; font-size: 13px; }
        .sc-open-up .sc-empty { width: 34px; height: 34px; }
    }
    .sc-open-up .smart-calendar-panel .mb-4 { margin-bottom: 0.5rem; }
    .sc-open-up .smart-calendar-panel .sm\:mb-6 { margin-bottom: 0.5rem; }
    .sc-open-up .smart-calendar-panel .mt-6 { margin-top: 0.75rem; }
    .sc-open-up .smart-calendar-panel .pt-5 { padding-top: 0.75rem; }
    .sc-open-up .smart-calendar-panel .mb-2 { margin-bottom: 0.25rem; }
    @@media (min-width: 1024px) {
        .sc-open-up .smart-calendar-panel.lg\:w-\[680px\] { width: 530px; }
        .sc-open-up .smart-calendar-panel .lg\:gap-10 { gap: 1.25rem; }
    }
</style>

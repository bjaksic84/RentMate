            </div>
            <div class="border-t border-stone-800 mt-8 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
                <p class="text-sm">&copy; @DateTime.Now.Year RentMate. @Localizer["All rights reserved."]</p>
                <div class="flex items-center gap-4">
                    <a href="#" class="w-10 h-10 rounded-full bg-stone-800 hover:bg-primary-600 flex items-center justify-center transition-colors touch-target focus-ring" aria-label="@Localizer["Follow us on Facebook"]">
                        <i class="bi bi-facebook" aria-hidden="true"></i>
                    </a>
                    <a href="#" class="w-10 h-10 rounded-full bg-stone-800 hover:bg-primary-600 flex items-center justify-center transition-colors touch-target focus-ring" aria-label="@Localizer["Follow us on X (Twitter)"]">
                        <i class="bi bi-twitter-x" aria-hidden="true"></i>
                    </a>
                    <a href="#" class="w-10 h-10 rounded-full bg-stone-800 hover:bg-primary-600 flex items-center justify-center transition-colors touch-target focus-ring" aria-label="@Localizer["Follow us on Instagram"]">

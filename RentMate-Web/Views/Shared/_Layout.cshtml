@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Localization
@using RentMate.Models
@inject IViewLocalizer Localizer
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var userProfilePic = currentUser?.ProfilePictureUrl;
    var userDisplayName = currentUser?.FirstName ?? currentUser?.UserName ?? "User";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "en";
}
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <script>
        (function() {
            var t = localStorage.getItem('theme') || 'system';
            var dark = t === 'dark' || (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
            if (dark) document.documentElement.classList.add('dark');
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentMate</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        'sans': ['Inter', '-apple-system', 'BlinkMacSystemFont', '"Segoe UI"', 'Roboto', 'sans-serif'],
                        'display': ['"DM Sans"', 'Inter', 'sans-serif'],
                    },
                    colors: {
                        'primary': {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            200: '#99f6e4',
                            300: '#5eead4',
                            400: '#2dd4bf',
                            500: '#14b8a6',
                            600: '#0d9488',
                            700: '#0f766e',
                            800: '#115e59',
                            900: '#134e4a',
                        },
                        'clay': {
                            50: '#fdf5f0',
                            100: '#fae8db',
                            200: '#f3cdb1',
                            300: '#e5a87a',
                            400: '#d4864e',
                            500: '#c2703e',
                            600: '#a85a30',
                            700: '#8a4727',
                            800: '#6e3920',
                            900: '#5a2f1b',
                        },
                        'ledger': {
                            50: '#fafafa',
                            100: '#f5f5f5',
                            200: '#e5e5e5',
                            300: '#d4d4d4',
                            400: '#a3a3a3',
                            500: '#737373',
                            600: '#525252',
                            700: '#404040',
                            800: '#262626',
                            900: '#171717',
                            950: '#0f0f0f',
                        }
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Theme CSS (includes dark mode support) -->
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />

    <!-- Site CSS (dashboard tabs, slide-over panel, animations) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    @inject RentMate.Services.Interfaces.ICurrencyService CurrencyService
    <script>
        window.CurrentCurrency = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(CurrencyService.GetCurrentCurrency()));
    </script>
    
    <style>
        /* Design Tokens */
        :root {
            /* Z-Index Scale */
            --z-base: 1;
            --z-dropdown: 100;
            --z-sticky: 200;
            --z-fixed: 300;
            --z-mobile-drawer: 400;
            --z-modal-backdrop: 1100;
            --z-modal: 1200;
            --z-popover: 1300;
            --z-tooltip: 1400;
            --z-navbar: 900;
            --z-toast: 1500;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f5f5f4;
        }
        ::-webkit-scrollbar-thumb {
            background: #d6d3d1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #a8a29e;
        }

        /* Dark mode scrollbar */
        .dark ::-webkit-scrollbar-track {
            background: #262626;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #525252;
        }
        .dark ::-webkit-scrollbar-thumb:hover {
            background: #737373;
        }

        /* Accessibility: Focus indicators */
        .focus-ring:focus,
        .focus-ring:focus-visible {
            outline: 3px solid #0d9488;
            outline-offset: 2px;
            box-shadow: 0 0 0 4px rgba(13, 148, 136, 0.25);
        }

        /* Accessibility: WCAG compliant touch targets (min 44x44px) */
        .touch-target {
            min-height: 44px;
            min-width: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* Accessibility: Screen reader only */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border-width: 0;
        }
        
        /* ==========================================
           DARK MODE GLOBAL OVERRIDES
           Warm dark palette (#1a1a1a base)
           ========================================== */

        /* Background colors */
        .dark .bg-white { background-color: #262626 !important; }
        .dark .bg-stone-50 { background-color: #1a1a1a !important; }
        .dark .bg-stone-100 { background-color: #262626 !important; }
        .dark .bg-stone-200 { background-color: #3a3a3a !important; }

        /* Text colors */
        .dark .text-stone-900 { color: #fafaf9 !important; }
        .dark .text-stone-800 { color: #e7e5e4 !important; }
        .dark .text-stone-700 { color: #d6d3d1 !important; }
        .dark .text-stone-600 { color: #a8a29e !important; }
        .dark .text-stone-500 { color: #78716c !important; }

        /* Border colors */
        .dark .border-stone-100 { border-color: #3a3a3a !important; }
        .dark .border-stone-200 { border-color: #404040 !important; }
        .dark .border-stone-300 { border-color: #525252 !important; }
        .dark .divide-stone-100 > * + * { border-color: #3a3a3a !important; }
        .dark .divide-stone-200 > * + * { border-color: #404040 !important; }

        /* Ring/outline colors */
        .dark .ring-stone-100 { --tw-ring-color: #3a3a3a !important; }
        .dark .ring-white { --tw-ring-color: #262626 !important; }

        /* Hover states */
        .dark .hover\:bg-stone-50:hover { background-color: #3a3a3a !important; }
        .dark .hover\:bg-stone-100:hover { background-color: #404040 !important; }
        .dark .hover\:bg-primary-50:hover { background-color: rgba(13, 148, 136, 0.15) !important; }
        .dark .hover\:bg-white:hover { background-color: #3a3a3a !important; }

        /* Form inputs and selects */
        .dark input:not([type="range"]), .dark select, .dark textarea {
            background-color: #262626;
            color: #e7e5e4;
            border-color: #404040;
        }
        .dark input::placeholder, .dark textarea::placeholder {
            color: #78716c;
        }
        .dark select option {
            background-color: #262626;
            color: #e7e5e4;
        }

        /* Cards and panels */
        .dark .shadow-sm, .dark .shadow-md, .dark .shadow-lg, .dark .shadow-xl {
            --tw-shadow-color: rgba(0, 0, 0, 0.4);
        }

        /* Navigation hover states */
        .dark .hover\:text-primary-700:hover { color: #2dd4bf !important; }

        /* Logo text in navbar */
        .dark header .text-stone-900 { color: #fafaf9 !important; }

        /* Mobile menu dark mode */
        .dark #mobileMenu { background-color: #262626 !important; }

        /* Dropdown menus dark mode */
        .dark #languageMenu,
        .dark #currencyMenu,
        .dark #themeMenu {
            background-color: #262626 !important;
            border-color: #3a3a3a !important;
        }

        /* User menu dropdown */
        .dark .absolute.right-0.mt-2.bg-white {
            background-color: #262626 !important;
            border-color: #3a3a3a !important;
        }

        /* Primary teal active selection states */
        .dark .bg-primary-50 { background-color: rgba(13, 148, 136, 0.15) !important; }
        .dark .text-primary-700 { color: #2dd4bf !important; }
        .dark .text-primary-600 { color: #14b8a6 !important; }

        /* Red/danger colors */
        .dark .bg-red-50 { background-color: rgba(239, 68, 68, 0.1) !important; }
        .dark .bg-red-100 { background-color: rgba(239, 68, 68, 0.15) !important; }
        .dark .text-red-800 { color: #fecaca !important; }
        .dark .text-red-700 { color: #fca5a5 !important; }
        .dark .text-red-600 { color: #f87171 !important; }
        .dark .text-red-500 { color: #ef4444 !important; }
        .dark .border-red-200 { border-color: rgba(239, 68, 68, 0.3) !important; }
        .dark .hover\:bg-red-50:hover { background-color: rgba(239, 68, 68, 0.15) !important; }

        /* Green/success colors */
        .dark .bg-green-50 { background-color: rgba(34, 197, 94, 0.1) !important; }
        .dark .bg-green-100 { background-color: rgba(34, 197, 94, 0.15) !important; }
        .dark .text-green-800 { color: #bbf7d0 !important; }
        .dark .text-green-700 { color: #86efac !important; }
        .dark .border-green-200 { border-color: rgba(34, 197, 94, 0.3) !important; }

        /* Amber/warning colors */
        .dark .bg-amber-50 { background-color: rgba(245, 158, 11, 0.1) !important; }
        .dark .bg-amber-100 { background-color: rgba(245, 158, 11, 0.15) !important; }
        .dark .text-amber-800 { color: #fde68a !important; }
        .dark .text-amber-700 { color: #fcd34d !important; }
        .dark .border-amber-200 { border-color: rgba(245, 158, 11, 0.3) !important; }

        /* Yellow colors */
        .dark .bg-yellow-100 { background-color: rgba(234, 179, 8, 0.15) !important; }
        .dark .text-yellow-700 { color: #fde047 !important; }

        /* Purple/info colors */
        .dark .bg-purple-100 { background-color: rgba(168, 85, 247, 0.15) !important; }
        .dark .text-purple-700 { color: #d8b4fe !important; }

        /* Filter sidebar specific */
        .dark details summary:hover { background-color: #3a3a3a !important; }

        /* HR elements */
        .dark hr { border-color: #3a3a3a !important; }

        /* Section backgrounds */
        .dark section.bg-white { background-color: #1a1a1a !important; }
        .dark section.bg-stone-50 { background-color: #262626 !important; }
    </style>
</head>
<body class="bg-stone-50 antialiased text-stone-800 transition-colors duration-200">
    <!-- Navbar -->
    <header class="fixed top-0 left-0 right-0" style="z-index: var(--z-navbar);">
        <nav class="bg-white border-b border-stone-200 shadow-sm">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="relative flex items-center justify-between h-16 lg:h-20">
                    <!-- Logo -->
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 group">
                        <div class="w-10 h-10 rounded-md bg-primary-600 flex items-center justify-center">
                            <i class="bi bi-house-heart text-white text-lg"></i>
                        </div>
                        <span class="font-bold text-xl text-stone-900">Rent<span class="text-primary-600">Mate</span></span>
                    </a>
                    
                    <!-- Desktop Navigation -->
                    <div class="hidden sm:flex items-center gap-1 absolute left-1/2 -translate-x-1/2">
                        <a asp-controller="Home" asp-action="Index" class="hidden lg:block px-4 py-2 text-sm font-medium text-stone-600 hover:text-primary-700 rounded-lg hover:bg-primary-50 transition-all duration-200">
                            @Localizer["Home"]
                        </a>
                        <a asp-controller="Rentals" asp-action="Index" class="px-4 py-2 text-sm font-medium text-stone-600 hover:text-primary-700 rounded-lg hover:bg-primary-50 transition-all duration-200">
                            @Localizer["Marketplace"]
                        </a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Dashboard" asp-action="UserDashboard" class="hidden md:block px-4 py-2 text-sm font-medium text-stone-600 hover:text-primary-700 rounded-lg hover:bg-primary-50 transition-all duration-200">
                                @Localizer["Dashboard"]
                            </a>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Dashboard" asp-action="AdminDashboard" class="hidden md:block px-4 py-2 text-sm font-bold text-primary-600 hover:text-primary-700 rounded-lg hover:bg-primary-50 transition-all duration-200">
                                @Localizer["Admin"]
                            </a>
                        }
                    </div>
                    
                    <!-- Right side actions -->
                    <div class="flex items-center gap-2">
                        <!-- Language Selector -->
                        <div class="relative hidden xl:block" id="languageDropdown">
                            @{
                                var langFlag = currentCulture == "sl" ? "🇸🇮" : "🇺🇸";
                                var langName = currentCulture == "sl" ? "SL" : "EN";
                            }
                            <button onclick="document.getElementById('languageMenu').classList.toggle('hidden')" 
                                    class="flex items-center gap-1.5 px-3 py-2 text-stone-600 hover:text-primary-700 hover:bg-primary-50 rounded-lg transition-all duration-200 touch-target focus-ring"
                                    aria-label="@Localizer["Language"]"
                                    aria-haspopup="true">
                                <span>@langFlag</span>
                                <span class="text-sm font-medium">@langName</span>
                                <i class="bi bi-chevron-down text-xs" aria-hidden="true"></i>
                            </button>
                            <div id="languageMenu" class="hidden absolute right-0 mt-2 w-44 bg-white rounded-lg shadow-lg border border-stone-200 overflow-hidden" style="z-index: var(--z-dropdown);">
                                <div class="p-2" id="languageButtons">
                                    <button type="button" onclick="setLanguage('en')" data-culture="en" class="language-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm @(currentCulture == "en" ? "bg-primary-50 text-primary-700 font-medium" : "text-stone-600 hover:bg-stone-50") transition-colors">
                                        <span>🇺🇸</span> English
                                        <i class="bi bi-check ml-auto text-primary-600 @(currentCulture == "en" ? "" : "hidden")"></i>
                                    </button>
                                    <button type="button" onclick="setLanguage('sl')" data-culture="sl" class="language-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm @(currentCulture == "sl" ? "bg-primary-50 text-primary-700 font-medium" : "text-stone-600 hover:bg-stone-50") transition-colors">
                                        <span>🇸🇮</span> Slovenščina
                                        <i class="bi bi-check ml-auto text-primary-600 @(currentCulture == "sl" ? "" : "hidden")"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Currency Selector -->
                        @inject RentMate.Services.Interfaces.ICurrencyService NavCurrencyService
                        @{
                            var navCurrentCurrency = NavCurrencyService.GetCurrentCurrency();
                        }
                        <div class="relative hidden xl:block" id="currencyDropdown">
                            <button onclick="document.getElementById('currencyMenu').classList.toggle('hidden')" 
                                    class="flex items-center gap-1.5 px-3 py-2 text-stone-600 hover:text-primary-700 hover:bg-primary-50 rounded-lg transition-all duration-200 touch-target focus-ring"
                                    aria-label="@Localizer["Currency"]"
                                    aria-haspopup="true">
                                <span>@navCurrentCurrency.Flag</span>
                                <span class="text-sm font-medium">@navCurrentCurrency.Code</span>
                                <i class="bi bi-chevron-down text-xs" aria-hidden="true"></i>
                            </button>
                            <div id="currencyMenu" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-stone-200 overflow-hidden" style="z-index: var(--z-dropdown);">
                                <div class="p-2 max-h-64 overflow-y-auto" id="currencyButtons">
                                    @foreach (var curr in NavCurrencyService.SupportedCurrencies)
                                    {
                                        var isActive = curr.Code == navCurrentCurrency.Code;
                                        <button type="button" onclick="setCurrency('@curr.Code')" data-currency="@curr.Code"
                                                class="currency-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm @(isActive ? "bg-primary-50 text-primary-700 font-medium" : "text-stone-600 hover:bg-stone-50") transition-colors">
                                            <span>@curr.Flag</span>
                                            <span>@curr.Code</span>
                                            <span class="text-stone-400 ml-auto">@curr.Symbol</span>
                                            @if (isActive) { <i class="bi bi-check text-primary-600"></i> }
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Theme Toggle -->
                        <div class="relative hidden xl:block" id="themeDropdown">
                            <button onclick="document.getElementById('themeMenu').classList.toggle('hidden')"
                                    class="flex items-center gap-1.5 px-3 py-2 text-stone-600 hover:text-primary-700 hover:bg-primary-50 rounded-lg transition-all duration-200 touch-target focus-ring"
                                    aria-label="@Localizer["Theme"]"
                                    aria-haspopup="true">
                                <i class="bi bi-sun-fill theme-icon-light" aria-hidden="true"></i>
                                <i class="bi bi-moon-fill theme-icon-dark hidden" aria-hidden="true"></i>
                                <i class="bi bi-display theme-icon-system hidden" aria-hidden="true"></i>
                                <i class="bi bi-chevron-down text-xs" aria-hidden="true"></i>
                            </button>
                            <div id="themeMenu" class="hidden absolute right-0 mt-2 w-44 bg-white rounded-lg shadow-lg border border-stone-200 overflow-hidden" style="z-index: var(--z-dropdown);">
                                <div class="p-2">
                                    <button type="button" onclick="setThemePreference('system')" data-theme-option="system"
                                            class="theme-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-stone-600 hover:bg-stone-50 transition-colors">
                                        <i class="bi bi-display"></i> @Localizer["System"]
                                        <i class="bi bi-check ml-auto text-primary-600 theme-check hidden"></i>
                                    </button>
                                    <button type="button" onclick="setThemePreference('light')" data-theme-option="light"
                                            class="theme-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-stone-600 hover:bg-stone-50 transition-colors">
                                        <i class="bi bi-sun-fill"></i> @Localizer["Light"]
                                        <i class="bi bi-check ml-auto text-primary-600 theme-check hidden"></i>
                                    </button>
                                    <button type="button" onclick="setThemePreference('dark')" data-theme-option="dark"
                                            class="theme-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-stone-600 hover:bg-stone-50 transition-colors">
                                        <i class="bi bi-moon-fill"></i> @Localizer["Dark"]
                                        <i class="bi bi-check ml-auto text-primary-600 theme-check hidden"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Mobile menu button -->
                        <div class="relative xl:hidden">
                            <button onclick="document.getElementById('mobileMenu').classList.toggle('hidden')"
                                    class="p-2 text-stone-600 hover:text-primary-700 hover:bg-primary-50 rounded-lg transition-all duration-200 touch-target focus-ring"
                                    aria-label="@Localizer["Open navigation menu"]"
                                    aria-expanded="false"
                                    aria-controls="mobileMenu">
                                <i class="bi bi-list text-xl" aria-hidden="true"></i>
                                <span class="sr-only">@Localizer["Menu"]</span>
                            </button>
                            <!-- Mobile Menu Dropdown -->
                            <div id="mobileMenu" class="hidden absolute right-0 mt-2 w-72 bg-white rounded-lg shadow-lg border border-stone-200 overflow-hidden" style="z-index: var(--z-dropdown);">
                                <div class="p-2 space-y-0.5">
                                    <a asp-controller="Home" asp-action="Index" class="lg:hidden block px-3 py-2 text-sm font-medium text-stone-600 hover:text-primary-700 rounded-lg hover:bg-primary-50">
                                        @Localizer["Home"]
                                    </a>
                                    <a asp-controller="Rentals" asp-action="Index" class="sm:hidden block px-3 py-2 text-sm font-medium text-stone-600 hover:text-primary-700 rounded-lg hover:bg-primary-50">
                                        @Localizer["Marketplace"]
                                    </a>
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <a asp-controller="Dashboard" asp-action="UserDashboard" class="md:hidden block px-3 py-2 text-sm font-medium text-stone-600 hover:text-primary-700 rounded-lg hover:bg-primary-50">
                                            <i class="bi bi-grid mr-2"></i>@Localizer["Dashboard"]
                                        </a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-controller="Dashboard" asp-action="AdminDashboard" class="block px-3 py-2 text-sm font-medium text-primary-600 rounded-lg hover:bg-primary-50">
                                                <i class="bi bi-shield-lock mr-2"></i>@Localizer["Admin Panel"]
                                            </a>
                                        }
                                    }
                                    <hr class="lg:hidden my-1.5 border-stone-200">
                                    <!-- Language + Theme row -->
                                    <div class="flex items-center justify-between px-1 py-1">
                                        <div class="flex items-center gap-1">
                                            <button type="button" onclick="setLanguage('en')"
                                                    class="px-2.5 py-1 rounded-lg text-sm @(currentCulture == "en" ? "bg-primary-50 text-primary-700 font-medium" : "text-stone-600 hover:bg-primary-50") transition-colors">
                                                🇺🇸 EN
                                            </button>
                                            <button type="button" onclick="setLanguage('sl')"
                                                    class="px-2.5 py-1 rounded-lg text-sm @(currentCulture == "sl" ? "bg-primary-50 text-primary-700 font-medium" : "text-stone-600 hover:bg-primary-50") transition-colors">
                                                🇸🇮 SL
                                            </button>
                                        </div>
                                        <div class="flex items-center gap-0.5">
                                            <button type="button" onclick="setThemePreference('system')" data-theme-mobile="system"
                                                    class="theme-mobile-btn p-1.5 rounded-lg text-sm text-stone-600 hover:bg-primary-50 transition-colors">
                                                <i class="bi bi-display"></i>
                                            </button>
                                            <button type="button" onclick="setThemePreference('light')" data-theme-mobile="light"
                                                    class="theme-mobile-btn p-1.5 rounded-lg text-sm text-stone-600 hover:bg-primary-50 transition-colors">
                                                <i class="bi bi-sun-fill"></i>
                                            </button>
                                            <button type="button" onclick="setThemePreference('dark')" data-theme-mobile="dark"
                                                    class="theme-mobile-btn p-1.5 rounded-lg text-sm text-stone-600 hover:bg-primary-50 transition-colors">
                                                <i class="bi bi-moon-fill"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <!-- Currency row -->
                                    <div class="flex items-center gap-1 px-1 py-1">
                                        @foreach (var curr in NavCurrencyService.SupportedCurrencies)
                                        {
                                            var isActive = curr.Code == navCurrentCurrency.Code;
                                            <button type="button" onclick="setCurrency('@curr.Code')"
                                                    class="px-2.5 py-1 rounded-lg text-sm @(isActive ? "bg-primary-50 text-primary-700 font-medium" : "text-stone-600 hover:bg-primary-50") transition-colors">
                                                @curr.Flag @curr.Code
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- User Menu -->
                            <div class="relative">
                                <button onclick="this.nextElementSibling.classList.toggle('hidden')" class="flex items-center gap-2 p-1.5 pr-3 bg-stone-100 hover:bg-stone-200 rounded-full transition-colors duration-150">
                                    @if (!string.IsNullOrEmpty(userProfilePic))
                                    {
                                        <img src="@userProfilePic" alt="@userDisplayName" class="w-8 h-8 rounded-full object-cover ring-2 ring-white" />
                                    }
                                    else
                                    {
                                        <div class="w-8 h-8 rounded-full bg-primary-600 flex items-center justify-center">
                                            <i class="bi bi-person-fill text-white text-sm"></i>
                                        </div>
                                    }
                                    <i class="bi bi-chevron-down text-xs text-stone-500"></i>
                                </button>
                                <div class="hidden absolute right-0 mt-2 w-48 py-2 bg-white rounded-lg shadow-lg border border-stone-200">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-controller="Dashboard" asp-action="AdminDashboard" class="flex items-center gap-3 px-4 py-2 text-sm text-primary-600 font-bold hover:bg-primary-50 transition-colors">
                                            <i class="bi bi-shield-lock"></i> @Localizer["Admin Panel"]
                                        </a>
                                        <hr class="my-2 border-stone-200">
                                    }
                                    <a asp-controller="Profile" asp-action="Index" class="flex items-center gap-3 px-4 py-2 text-sm text-stone-600 hover:bg-primary-50 hover:text-primary-700 transition-colors">
                                        <i class="bi bi-person"></i> @Localizer["Profile"]
                                    </a>
                                    <a asp-controller="Dashboard" asp-action="UserDashboard" class="flex items-center gap-3 px-4 py-2 text-sm text-stone-600 hover:bg-primary-50 hover:text-primary-700 transition-colors">
                                        <i class="bi bi-grid"></i> @Localizer["Dashboard"]
                                    </a>
                                    <a asp-area="Identity" asp-page="/Account/Manage/Index" class="flex items-center gap-3 px-4 py-2 text-sm text-stone-600 hover:bg-primary-50 hover:text-primary-700 transition-colors">
                                        <i class="bi bi-gear"></i> @Localizer["Settings"]
                                    </a>
                                    <hr class="my-2 border-stone-200">
                                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                                        <button type="submit" class="w-full flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors">
                                            <i class="bi bi-box-arrow-right"></i> @Localizer["Logout"]
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="relative" id="authDropdown">
                                <button onclick="document.getElementById('authMenu').classList.toggle('hidden')"
                                        class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-md shadow-sm transition-colors duration-150">
                                    <i class="bi bi-plus-lg"></i>
                                    <span class="hidden sm:inline">@Localizer["Become a Host"]</span>
                                </button>
                                <div id="authMenu" class="hidden absolute right-0 mt-2 w-44 bg-white rounded-lg shadow-lg border border-stone-200 overflow-hidden" style="z-index: var(--z-dropdown);">
                                    <div class="p-2">
                                        <a asp-area="Identity" asp-page="/Account/Login" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-stone-600 hover:bg-primary-50 hover:text-primary-700 transition-colors">
                                            <i class="bi bi-box-arrow-in-right"></i> @Localizer["Login"]
                                        </a>
                                        <a asp-area="Identity" asp-page="/Account/Register" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-stone-600 hover:bg-primary-50 hover:text-primary-700 transition-colors">
                                            <i class="bi bi-person-plus"></i> @Localizer["Register"]
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            
        </nav>
    </header>
    
    <!-- Main Content with top padding for fixed navbar -->

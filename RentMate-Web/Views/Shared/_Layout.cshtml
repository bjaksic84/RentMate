                <div>
                    <h4 class="font-semibold text-white mb-4">@Localizer["Host"]</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a asp-controller="Items" asp-action="Create" class="hover:text-primary-400 transition-colors">@Localizer["List your item"]</a></li>
                        <li><a href="#" class="hover:text-primary-400 transition-colors">@Localizer["Host resources"]</a></li>
                        <li><a href="#" class="hover:text-primary-400 transition-colors">@Localizer["Community"]</a></li>
                    </ul>

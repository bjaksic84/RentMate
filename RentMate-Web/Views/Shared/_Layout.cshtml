                <div>
                    <h4 class="font-semibold text-white mb-4">@Localizer["Support"]</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a href="#" class="hover:text-primary-400 transition-colors">@Localizer["Help Center"]</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy" class="hover:text-primary-400 transition-colors">@Localizer["Privacy Policy"]</a></li>
                        <li><a href="#" class="hover:text-primary-400 transition-colors">@Localizer["Terms of Service"]</a></li>

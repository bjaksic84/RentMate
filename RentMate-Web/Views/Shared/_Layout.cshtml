@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Localization
@using RentMate.Models
@inject IViewLocalizer Localizer
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var userProfilePic = currentUser?.ProfilePictureUrl;
    var userDisplayName = currentUser?.FirstName ?? currentUser?.UserName ?? "User";
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "en";
}
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <script>
        (function() {
            var t = localStorage.getItem('theme') || 'system';
            var dark = t === 'dark' || (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
            if (dark) document.documentElement.classList.add('dark');
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentMate</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        'heading': ['Outfit', 'sans-serif'],
                        'body': ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        'trust-blue': {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            200: '#bfdbfe',
                            300: '#93c5fd',
                            400: '#60a5fa',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                        }
                    }
                }
            }
        }
    </script>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Theme CSS (includes dark mode support) -->
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    
    @inject RentMate.Services.Interfaces.ICurrencyService CurrencyService
    <script>
        window.CurrentCurrency = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(CurrencyService.GetCurrentCurrency()));
    </script>
    
    <style>
        /* Design Tokens - Trust Blue Theme */
        :root {
            /* Trust Blue Primary Colors */
            --trust-blue-primary: #2563eb;
            --trust-blue-dark: #1d4ed8;
            --trust-blue-darker: #1e40af;
            --trust-blue-light: #3b82f6;
            --trust-blue-lighter: #60a5fa;
            
            /* Z-Index Scale - Logical Hierarchy (prevents collision) */
            --z-base: 1;
            --z-dropdown: 100;
            --z-sticky: 200;
            --z-fixed: 300;
            --z-mobile-drawer: 400;
            --z-modal-backdrop: 1100;
            --z-modal: 1200;
            --z-popover: 1300;
            --z-tooltip: 1400;
            --z-navbar: 900;
            --z-toast: 1500;
            
            /* WCAG Compliant Contrast Colors */
            --text-on-dark: rgba(255, 255, 255, 0.92);
            --text-muted-on-dark: rgba(255, 255, 255, 0.87);
        }
        
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        h1, h2, h3, h4, h5, h6 {
            font-family: 'Outfit', sans-serif;
        }
        
        /* Glassmorphism utilities with Safari compatibility */
        .glass {
            background: rgba(255, 255, 255, 0.8);
            -webkit-backdrop-filter: blur(12px);
            backdrop-filter: blur(12px);
        }
        
        .dark .glass {
            background: rgba(15, 23, 42, 0.8);
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        
        /* Dark mode scrollbar */
        .dark ::-webkit-scrollbar-track {
            background: #1e293b;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #475569;
        }
        .dark ::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }
        
        /* Smooth transitions */
        .hover-lift {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .hover-lift:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px -12px rgba(37, 99, 235, 0.25);
        }
        /* Gradient text */
        .gradient-text {
            background: linear-gradient(135deg, #2563eb 0%, #0ea5e9 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        /* Accessibility: Focus indicators */
        .focus-ring:focus,
        .focus-ring:focus-visible {
            outline: 3px solid var(--trust-blue-primary);
            outline-offset: 2px;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.25);
        }
        
        /* Accessibility: WCAG compliant touch targets (min 44x44px) */
        .touch-target {
            min-height: 44px;
            min-width: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        
        /* Accessibility: Screen reader only */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border-width: 0;
        }
        
        /* ==========================================
           DARK MODE GLOBAL OVERRIDES
           ========================================== */
        
        /* Background colors */
        .dark .bg-white { background-color: #1e293b !important; }
        .dark .bg-slate-50 { background-color: #0f172a !important; }
        .dark .bg-slate-100 { background-color: #1e293b !important; }
        .dark .bg-slate-200 { background-color: #334155 !important; }
        
        /* Text colors */
        .dark .text-slate-900 { color: #f8fafc !important; }
        .dark .text-slate-800 { color: #f1f5f9 !important; }
        .dark .text-slate-700 { color: #e2e8f0 !important; }
        .dark .text-slate-600 { color: #cbd5e1 !important; }
        .dark .text-slate-500 { color: #94a3b8 !important; }
        .dark .text-slate-400 { color: #64748b !important; }
        
        /* Border colors */
        .dark .border-slate-100 { border-color: #334155 !important; }
        .dark .border-slate-200 { border-color: #475569 !important; }
        .dark .border-slate-300 { border-color: #64748b !important; }
        .dark .divide-slate-100 > * + * { border-color: #334155 !important; }
        .dark .divide-slate-200 > * + * { border-color: #475569 !important; }
        
        /* Ring/outline colors */
        .dark .ring-slate-100 { --tw-ring-color: #334155 !important; }
        .dark .ring-white { --tw-ring-color: #1e293b !important; }
        
        /* Hover states */
        .dark .hover\:bg-slate-50:hover { background-color: #334155 !important; }
        .dark .hover\:bg-slate-100:hover { background-color: #475569 !important; }
        .dark .hover\:bg-blue-50:hover { background-color: rgba(59, 130, 246, 0.2) !important; }
        .dark .hover\:bg-white:hover { background-color: #334155 !important; }
        
        /* Form inputs and selects */
        .dark input:not([type="range"]), .dark select, .dark textarea {
            background-color: #1e293b;
            color: #f1f5f9;
            border-color: #475569;
        }
        .dark input::placeholder, .dark textarea::placeholder {
            color: #64748b;
        }
        .dark select option {
            background-color: #1e293b;
            color: #f1f5f9;
        }
        
        /* Specific component overrides */
        .dark .placeholder-slate-500::placeholder { color: #64748b !important; }
        
        /* Cards and panels */
        .dark .shadow-sm, .dark .shadow-md, .dark .shadow-lg, .dark .shadow-xl {
            --tw-shadow-color: rgba(0, 0, 0, 0.4);
        }
        
        /* Navigation hover states */
        .dark .hover\:text-blue-600:hover { color: #60a5fa !important; }
        
        /* Gradient backgrounds in dark mode */
        .dark .from-slate-50 { --tw-gradient-from: #1e293b !important; }
        .dark .to-white { --tw-gradient-to: #0f172a !important; }
        .dark .bg-gradient-to-r.from-slate-50.to-white {
            background: linear-gradient(to right, #1e293b, #0f172a) !important;
        }
        
        /* Logo text in navbar */
        .dark header .text-slate-900 { color: #f8fafc !important; }
        
        /* Mobile menu dark mode */
        .dark #mobileMenu { background-color: #1e293b !important; }
        
        /* Dropdown menus dark mode */
        .dark #languageMenu,
        .dark #currencyMenu,
        .dark #themeMenu {
            background-color: #1e293b !important;
            border-color: #334155 !important;
        }
        
        /* User menu dropdown */
        .dark .absolute.right-0.mt-2.bg-white {
            background-color: #1e293b !important;
            border-color: #334155 !important;
        }
        
        /* Active selection states */
        .dark .bg-blue-50 { background-color: rgba(59, 130, 246, 0.15) !important; }
        .dark .text-blue-700 { color: #93c5fd !important; }
        .dark .text-blue-600 { color: #60a5fa !important; }
        
        /* Red/danger colors */
        .dark .bg-red-50 { background-color: rgba(239, 68, 68, 0.1) !important; }
        .dark .bg-red-100 { background-color: rgba(239, 68, 68, 0.15) !important; }
        .dark .text-red-800 { color: #fecaca !important; }
        .dark .text-red-700 { color: #fca5a5 !important; }
        .dark .text-red-600 { color: #f87171 !important; }
        .dark .text-red-500 { color: #ef4444 !important; }
        .dark .border-red-200 { border-color: rgba(239, 68, 68, 0.3) !important; }
        .dark .hover\:bg-red-50:hover { background-color: rgba(239, 68, 68, 0.15) !important; }
        
        /* Green/success colors */
        .dark .bg-green-50 { background-color: rgba(34, 197, 94, 0.1) !important; }
        .dark .bg-green-100 { background-color: rgba(34, 197, 94, 0.15) !important; }
        .dark .text-green-800 { color: #bbf7d0 !important; }
        .dark .text-green-700 { color: #86efac !important; }
        .dark .border-green-200 { border-color: rgba(34, 197, 94, 0.3) !important; }
        
        /* Amber/warning colors */
        .dark .bg-amber-50 { background-color: rgba(245, 158, 11, 0.1) !important; }
        .dark .bg-amber-100 { background-color: rgba(245, 158, 11, 0.15) !important; }
        .dark .text-amber-800 { color: #fde68a !important; }
        .dark .text-amber-700 { color: #fcd34d !important; }
        .dark .border-amber-200 { border-color: rgba(245, 158, 11, 0.3) !important; }

        /* Yellow colors */
        .dark .bg-yellow-100 { background-color: rgba(234, 179, 8, 0.15) !important; }
        .dark .text-yellow-700 { color: #fde047 !important; }
        
        /* Purple/info colors */
        .dark .bg-purple-100 { background-color: rgba(168, 85, 247, 0.15) !important; }
        .dark .text-purple-700 { color: #d8b4fe !important; }
        
        /* Blue/info refinements */
        .dark .text-blue-800 { color: #bfdbfe !important; }
        .dark .border-blue-200 { border-color: rgba(59, 130, 246, 0.3) !important; }
        
        /* Filter sidebar specific */
        .dark details summary:hover { background-color: #334155 !important; }
        
        /* Category labels and filter items */
        .dark .border-transparent { border-color: transparent !important; }
        
        /* Footer - keep as is since it's already dark */
        
        /* White/light backgrounds that need inversion */
        .dark .bg-white\/60 { background-color: rgba(30, 41, 59, 0.6) !important; }
        .dark .bg-white\/80 { background-color: rgba(30, 41, 59, 0.8) !important; }
        .dark .bg-white\/90 { background-color: rgba(30, 41, 59, 0.9) !important; }
        .dark .hover\:bg-white\/90:hover { background-color: rgba(30, 41, 59, 0.9) !important; }
        
        /* Focus states */
        .dark .focus-within\:bg-white:focus-within { background-color: #1e293b !important; }
        
        /* Border on white */
        .dark .border-white\/20 { border-color: rgba(51, 65, 85, 0.5) !important; }
        .dark .border-white\/30 { border-color: rgba(51, 65, 85, 0.6) !important; }
        
        /* HR elements */
        .dark hr { border-color: #334155 !important; }
        
        /* Section backgrounds */
        .dark section.bg-white { background-color: #0f172a !important; }
        .dark section.bg-slate-50 { background-color: #1e293b !important; }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 font-body antialiased dark:text-slate-100 transition-colors duration-200">
    <!-- Sticky Glassmorphic Navbar -->
    <header class="fixed top-0 left-0 right-0" style="z-index: var(--z-navbar);">
        <nav class="glass border-b border-white/20 shadow-lg shadow-slate-900/5">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="relative flex items-center justify-between h-16 lg:h-20">
                    <!-- Logo -->
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 group">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-sky-400 flex items-center justify-center shadow-sm group- transition-all duration-300">
                            <i class="bi bi-house-heart text-white text-lg"></i>
                        </div>
                        <span class="font-heading font-bold text-xl text-slate-900">Rent<span class="gradient-text">Mate</span></span>
                    </a>
                    
                    <!-- Desktop Navigation -->
                    <div class="hidden sm:flex items-center gap-1 absolute left-1/2 -translate-x-1/2">
                        <a asp-controller="Home" asp-action="Index" class="hidden lg:block px-4 py-2 text-sm font-medium text-slate-600 hover:text-blue-600 rounded-lg hover:bg-blue-50 transition-all duration-200">
                            @Localizer["Home"]
                        </a>
                        <a asp-controller="Rentals" asp-action="Index" class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-blue-600 rounded-lg hover:bg-blue-50 transition-all duration-200">
                            @Localizer["Marketplace"]
                        </a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Dashboard" asp-action="UserDashboard" class="hidden md:block px-4 py-2 text-sm font-medium text-slate-600 hover:text-blue-600 rounded-lg hover:bg-blue-50 transition-all duration-200">
                                @Localizer["Dashboard"]
                            </a>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Dashboard" asp-action="AdminDashboard" class="hidden lg:block px-4 py-2 text-sm font-medium text-slate-600 hover:text-blue-600 rounded-lg hover:bg-blue-50 transition-all duration-200">
                                @Localizer["Admin"]
                            </a>
                        }
                    </div>
                    
                    <!-- Right side actions -->
                    <div class="flex items-center gap-2">
                        <!-- Language Selector -->
                        <div class="relative hidden xl:block" id="languageDropdown">
                            @{
                                var langFlag = currentCulture == "sl" ? "🇸🇮" : "🇺🇸";
                                var langName = currentCulture == "sl" ? "SL" : "EN";
                            }
                            <button onclick="document.getElementById('languageMenu').classList.toggle('hidden')" 
                                    class="flex items-center gap-1.5 px-3 py-2 text-slate-600 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-all duration-200 touch-target focus-ring"
                                    aria-label="@Localizer["Language"]"
                                    aria-haspopup="true">
                                <span>@langFlag</span>
                                <span class="text-sm font-medium">@langName</span>
                                <i class="bi bi-chevron-down text-xs" aria-hidden="true"></i>
                            </button>
                            <div id="languageMenu" class="hidden absolute right-0 mt-2 w-44 bg-white rounded-xl shadow-xl border border-slate-100 overflow-hidden" style="z-index: var(--z-dropdown);">
                                <div class="p-2" id="languageButtons">
                                    <button type="button" onclick="setLanguage('en')" data-culture="en" class="language-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm @(currentCulture == "en" ? "bg-blue-50 text-blue-700 font-medium" : "text-slate-600 hover:bg-slate-50") transition-colors">
                                        <span>🇺🇸</span> English
                                        <i class="bi bi-check ml-auto text-blue-600 @(currentCulture == "en" ? "" : "hidden")"></i>
                                    </button>
                                    <button type="button" onclick="setLanguage('sl')" data-culture="sl" class="language-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm @(currentCulture == "sl" ? "bg-blue-50 text-blue-700 font-medium" : "text-slate-600 hover:bg-slate-50") transition-colors">
                                        <span>🇸🇮</span> Slovenščina
                                        <i class="bi bi-check ml-auto text-blue-600 @(currentCulture == "sl" ? "" : "hidden")"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Currency Selector -->
                        @inject RentMate.Services.Interfaces.ICurrencyService NavCurrencyService
                        @{
                            var navCurrentCurrency = NavCurrencyService.GetCurrentCurrency();
                        }
                        <div class="relative hidden xl:block" id="currencyDropdown">
                            <button onclick="document.getElementById('currencyMenu').classList.toggle('hidden')" 
                                    class="flex items-center gap-1.5 px-3 py-2 text-slate-600 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-all duration-200 touch-target focus-ring"
                                    aria-label="@Localizer["Currency"]"
                                    aria-haspopup="true">
                                <span>@navCurrentCurrency.Flag</span>
                                <span class="text-sm font-medium">@navCurrentCurrency.Code</span>
                                <i class="bi bi-chevron-down text-xs" aria-hidden="true"></i>
                            </button>
                            <div id="currencyMenu" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-xl border border-slate-100 overflow-hidden" style="z-index: var(--z-dropdown);">
                                <div class="p-2 max-h-64 overflow-y-auto" id="currencyButtons">
                                    @foreach (var curr in NavCurrencyService.SupportedCurrencies)
                                    {
                                        var isActive = curr.Code == navCurrentCurrency.Code;
                                        <button type="button" onclick="setCurrency('@curr.Code')" data-currency="@curr.Code"
                                                class="currency-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm @(isActive ? "bg-blue-50 text-blue-700 font-medium" : "text-slate-600 hover:bg-slate-50") transition-colors">
                                            <span>@curr.Flag</span>
                                            <span>@curr.Code</span>
                                            <span class="text-slate-400 ml-auto">@curr.Symbol</span>
                                            @if (isActive) { <i class="bi bi-check text-blue-600"></i> }
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Theme Toggle -->
                        <div class="relative hidden xl:block" id="themeDropdown">
                            <button onclick="document.getElementById('themeMenu').classList.toggle('hidden')"
                                    class="flex items-center gap-1.5 px-3 py-2 text-slate-600 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-all duration-200 touch-target focus-ring"
                                    aria-label="@Localizer["Theme"]"
                                    aria-haspopup="true">
                                <i class="bi bi-sun-fill theme-icon-light" aria-hidden="true"></i>
                                <i class="bi bi-moon-fill theme-icon-dark hidden" aria-hidden="true"></i>
                                <i class="bi bi-display theme-icon-system hidden" aria-hidden="true"></i>
                                <i class="bi bi-chevron-down text-xs" aria-hidden="true"></i>
                            </button>
                            <div id="themeMenu" class="hidden absolute right-0 mt-2 w-44 bg-white rounded-xl shadow-xl border border-slate-100 overflow-hidden" style="z-index: var(--z-dropdown);">
                                <div class="p-2">
                                    <button type="button" onclick="setThemePreference('system')" data-theme-option="system"
                                            class="theme-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-50 transition-colors">
                                        <i class="bi bi-display"></i> @Localizer["System"]
                                        <i class="bi bi-check ml-auto text-blue-600 theme-check hidden"></i>
                                    </button>
                                    <button type="button" onclick="setThemePreference('light')" data-theme-option="light"
                                            class="theme-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-50 transition-colors">
                                        <i class="bi bi-sun-fill"></i> @Localizer["Light"]
                                        <i class="bi bi-check ml-auto text-blue-600 theme-check hidden"></i>
                                    </button>
                                    <button type="button" onclick="setThemePreference('dark')" data-theme-option="dark"
                                            class="theme-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-50 transition-colors">
                                        <i class="bi bi-moon-fill"></i> @Localizer["Dark"]
                                        <i class="bi bi-check ml-auto text-blue-600 theme-check hidden"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Mobile menu button -->
                        <button onclick="document.getElementById('mobileMenu').classList.toggle('hidden')"
                                class="xl:hidden p-2 text-slate-600 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-all duration-200 touch-target focus-ring"
                                aria-label="@Localizer["Open navigation menu"]"
                                aria-expanded="false"
                                aria-controls="mobileMenu">
                            <i class="bi bi-list text-xl" aria-hidden="true"></i>
                            <span class="sr-only">@Localizer["Menu"]</span>
                        </button>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- User Menu -->
                            <div class="relative">
                                <button onclick="this.nextElementSibling.classList.toggle('hidden')" class="flex items-center gap-2 p-1.5 pr-3 bg-slate-100 hover:bg-slate-200 rounded-full transition-all duration-200">
                                    @if (!string.IsNullOrEmpty(userProfilePic))
                                    {
                                        <img src="@userProfilePic" alt="@userDisplayName" class="w-8 h-8 rounded-full object-cover ring-2 ring-white" />
                                    }
                                    else
                                    {
                                        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-600 to-sky-400 flex items-center justify-center">
                                            <i class="bi bi-person-fill text-white text-sm"></i>
                                        </div>
                                    }
                                    <i class="bi bi-chevron-down text-xs text-slate-500"></i>
                                </button>
                                <div class="hidden absolute right-0 mt-2 w-48 py-2 bg-white rounded-xl shadow-md border border-slate-100">
                                    <a asp-controller="Profile" asp-action="Index" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                                        <i class="bi bi-person"></i> @Localizer["Profile"]
                                    </a>
                                    <a asp-controller="Dashboard" asp-action="UserDashboard" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                                        <i class="bi bi-grid"></i> @Localizer["Dashboard"]
                                    </a>
                                    <a asp-area="Identity" asp-page="/Account/Manage/Index" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                                        <i class="bi bi-gear"></i> @Localizer["Settings"]
                                    </a>
                                    <hr class="my-2 border-slate-100">
                                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                                        <button type="submit" class="w-full flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors">
                                            <i class="bi bi-box-arrow-right"></i> @Localizer["Logout"]
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="relative" id="authDropdown">
                                <button onclick="document.getElementById('authMenu').classList.toggle('hidden')"
                                        class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white text-sm font-semibold rounded-full shadow-sm transition-all duration-300">
                                    <i class="bi bi-plus-lg"></i>
                                    <span class="hidden sm:inline">@Localizer["Become a Host"]</span>
                                </button>
                                <div id="authMenu" class="hidden absolute right-0 mt-2 w-44 bg-white rounded-xl shadow-xl border border-slate-100 overflow-hidden" style="z-index: var(--z-dropdown);">
                                    <div class="p-2">
                                        <a asp-area="Identity" asp-page="/Account/Login" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                                            <i class="bi bi-box-arrow-in-right"></i> @Localizer["Login"]
                                        </a>
                                        <a asp-area="Identity" asp-page="/Account/Register" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                                            <i class="bi bi-person-plus"></i> @Localizer["Register"]
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            
            <!-- Mobile Menu -->
            <div id="mobileMenu" class="hidden xl:hidden border-t border-slate-100 bg-white">
                <div class="px-4 py-3 space-y-1">
                    <a asp-controller="Home" asp-action="Index" class="lg:hidden block px-4 py-2 text-sm font-medium text-slate-600 hover:text-blue-600 rounded-lg hover:bg-blue-50">
                        @Localizer["Home"]
                    </a>
                    <a asp-controller="Rentals" asp-action="Index" class="sm:hidden block px-4 py-2 text-sm font-medium text-slate-600 hover:text-blue-600 rounded-lg hover:bg-blue-50">
                        @Localizer["Marketplace"]
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Dashboard" asp-action="UserDashboard" class="md:hidden block px-4 py-2 text-sm font-medium text-slate-600 hover:text-blue-600 rounded-lg hover:bg-blue-50">
                            <i class="bi bi-grid mr-2"></i>@Localizer["Dashboard"]
                        </a>
                    }

                    <hr class="lg:hidden my-2 border-slate-100">

                    <!-- Mobile Language Selector -->
                    <div class="xl:hidden flex items-center gap-2 px-4 py-2">
                        <span class="text-sm font-medium text-slate-600">@Localizer["Language"]:</span>
                        <button type="button" onclick="setLanguage('en')"
                                class="px-3 py-1.5 rounded-lg text-sm @(currentCulture == "en" ? "bg-blue-50 text-blue-700 font-medium" : "text-slate-600 hover:bg-blue-50") transition-colors">
                            🇺🇸 EN
                        </button>
                        <button type="button" onclick="setLanguage('sl')"
                                class="px-3 py-1.5 rounded-lg text-sm @(currentCulture == "sl" ? "bg-blue-50 text-blue-700 font-medium" : "text-slate-600 hover:bg-blue-50") transition-colors">
                            🇸🇮 SL
                        </button>
                    </div>

                    <!-- Mobile Currency Selector -->
                    <div class="xl:hidden flex items-center gap-2 px-4 py-2 flex-wrap">
                        <span class="text-sm font-medium text-slate-600">@Localizer["Currency"]:</span>
                        @foreach (var curr in NavCurrencyService.SupportedCurrencies)
                        {
                            var isActive = curr.Code == navCurrentCurrency.Code;
                            <button type="button" onclick="setCurrency('@curr.Code')"
                                    class="px-3 py-1.5 rounded-lg text-sm @(isActive ? "bg-blue-50 text-blue-700 font-medium" : "text-slate-600 hover:bg-blue-50") transition-colors">
                                @curr.Flag @curr.Code
                            </button>
                        }
                    </div>

                    <!-- Mobile Theme Toggle -->
                    <div class="xl:hidden flex items-center gap-2 px-4 py-2">
                        <span class="text-sm font-medium text-slate-600">@Localizer["Theme"]:</span>
                        <button type="button" onclick="setThemePreference('system')" data-theme-mobile="system"
                                class="theme-mobile-btn p-2 rounded-lg text-sm text-slate-600 hover:bg-blue-50 transition-colors">
                            <i class="bi bi-display"></i>
                        </button>
                        <button type="button" onclick="setThemePreference('light')" data-theme-mobile="light"
                                class="theme-mobile-btn p-2 rounded-lg text-sm text-slate-600 hover:bg-blue-50 transition-colors">
                            <i class="bi bi-sun-fill"></i>
                        </button>
                        <button type="button" onclick="setThemePreference('dark')" data-theme-mobile="dark"
                                class="theme-mobile-btn p-2 rounded-lg text-sm text-slate-600 hover:bg-blue-50 transition-colors">
                            <i class="bi bi-moon-fill"></i>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    
    <!-- Main Content with top padding for fixed navbar -->
    <main class="pt-16 lg:pt-20 min-h-screen">
        @RenderBody()
    </main>
    
    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
                <div class="col-span-2 md:col-span-1">
                    <div class="flex items-center gap-2 mb-4">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-sky-400 flex items-center justify-center">
                            <i class="bi bi-house-heart text-white text-lg"></i>
                        </div>
                        <span class="font-heading font-bold text-xl text-white">RentMate</span>
                    </div>
                    <p class="text-sm text-slate-500">@Localizer["Rent anything, anywhere."]</p>
                </div>
                <div>
                    <h4 class="font-heading font-semibold text-white mb-4">@Localizer["Explore"]</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a asp-controller="Rentals" asp-action="Index" class="hover:text-blue-400 transition-colors">@Localizer["Marketplace"]</a></li>
                        <li><a href="#" class="hover:text-blue-400 transition-colors">@Localizer["Categories"]</a></li>
                        <li><a href="#" class="hover:text-blue-400 transition-colors">@Localizer["How it works"]</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-heading font-semibold text-white mb-4">@Localizer["Host"]</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a asp-controller="Items" asp-action="Create" class="hover:text-blue-400 transition-colors">@Localizer["List your item"]</a></li>
                        <li><a href="#" class="hover:text-blue-400 transition-colors">@Localizer["Host resources"]</a></li>
                        <li><a href="#" class="hover:text-blue-400 transition-colors">@Localizer["Community"]</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-heading font-semibold text-white mb-4">@Localizer["Support"]</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a href="#" class="hover:text-blue-400 transition-colors">@Localizer["Help Center"]</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy" class="hover:text-blue-400 transition-colors">@Localizer["Privacy Policy"]</a></li>
                        <li><a href="#" class="hover:text-blue-400 transition-colors">@Localizer["Terms of Service"]</a></li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-slate-800 mt-8 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
                <p class="text-sm">&copy; @DateTime.Now.Year RentMate. @Localizer["All rights reserved."]</p>
                <div class="flex items-center gap-4">
                    <a href="#" class="w-10 h-10 rounded-full bg-slate-800 hover:bg-blue-600 flex items-center justify-center transition-colors touch-target focus-ring" aria-label="@Localizer["Follow us on Facebook"]">
                        <i class="bi bi-facebook" aria-hidden="true"></i>
                    </a>
                    <a href="#" class="w-10 h-10 rounded-full bg-slate-800 hover:bg-blue-600 flex items-center justify-center transition-colors touch-target focus-ring" aria-label="@Localizer["Follow us on X (Twitter)"]">
                        <i class="bi bi-twitter-x" aria-hidden="true"></i>
                    </a>
                    <a href="#" class="w-10 h-10 rounded-full bg-slate-800 hover:bg-blue-600 flex items-center justify-center transition-colors touch-target focus-ring" aria-label="@Localizer["Follow us on Instagram"]">
                        <i class="bi bi-instagram" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/translations.js" asp-append-version="true"></script>
    <script src="~/js/smartcalendar.js" asp-append-version="true"></script>
    <script src="~/js/favorites.js" asp-append-version="true"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    
    <script>
        // Restore scroll position and form data after language/currency change reload
        (function() {
            const savedScrollPos = sessionStorage.getItem('rentmate_scroll_position');
            if (savedScrollPos) {
                sessionStorage.removeItem('rentmate_scroll_position');
                window.scrollTo(0, parseInt(savedScrollPos, 10));
            }
            
            // Restore form data
            const savedFormData = sessionStorage.getItem('rentmate_form_data');
            if (savedFormData) {
                sessionStorage.removeItem('rentmate_form_data');
                try {
                    const formData = JSON.parse(savedFormData);
                    // Wait for DOM to be ready
                    const restoreForms = () => {
                        formData.forEach(form => {
                            const formEl = document.querySelector(form.selector);
                            if (formEl) {
                                form.fields.forEach(field => {
                                    const input = formEl.querySelector(`[name="${field.name}"]`);
                                    if (input) {
                                        if (input.type === 'checkbox' || input.type === 'radio') {
                                            input.checked = field.checked;
                                        } else if (input.type === 'file') {
                                            // Can't restore file inputs for security reasons
                                        } else {
                                            input.value = field.value;
                                            // Trigger change event for any dependent JS
                                            input.dispatchEvent(new Event('input', { bubbles: true }));
                                        }
                                    }
                                });
                            }
                        });
                    };
                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', restoreForms);
                    } else {
                        restoreForms();
                    }
                } catch (e) {
                    console.error('Failed to restore form data:', e);
                }
            }
        })();

        // Click outside to close dropdown menus
        document.addEventListener('click', function(e) {
            // Close language menu
            const languageDropdown = document.getElementById('languageDropdown');
            const languageMenu = document.getElementById('languageMenu');
            if (languageDropdown && languageMenu && !languageDropdown.contains(e.target)) {
                languageMenu.classList.add('hidden');
            }
            // Close currency menu
            const currencyDropdown = document.getElementById('currencyDropdown');
            const currencyMenu = document.getElementById('currencyMenu');
            if (currencyDropdown && currencyMenu && !currencyDropdown.contains(e.target)) {
                currencyMenu.classList.add('hidden');
            }
            // Close theme menu
            const themeDropdown = document.getElementById('themeDropdown');
            const themeMenu = document.getElementById('themeMenu');
            if (themeDropdown && themeMenu && !themeDropdown.contains(e.target)) {
                themeMenu.classList.add('hidden');
            }
            // Close auth menu
            const authDropdown = document.getElementById('authDropdown');
            const authMenu = document.getElementById('authMenu');
            if (authDropdown && authMenu && !authDropdown.contains(e.target)) {
                authMenu.classList.add('hidden');
            }
        });

        // Set a cookie with 1 year expiry
        function setCookie(name, value) {
            const expires = new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toUTCString();
            document.cookie = `${name}=${value};expires=${expires};path=/`;
        }

        // Save all form data on the page
        function saveFormData() {
            const forms = document.querySelectorAll('form');
            const formData = [];
            forms.forEach((form, index) => {
                const formId = form.id || form.getAttribute('action') || `form-${index}`;
                const selector = form.id ? `#${form.id}` : `form[action="${form.getAttribute('action')}"]`;
                const fields = [];
                form.querySelectorAll('input, textarea, select').forEach(input => {
                    if (input.name && input.type !== 'hidden' && input.type !== 'file') {
                        fields.push({
                            name: input.name,
                            value: input.value,
                            checked: input.checked
                        });
                    }
                });
                if (fields.length > 0) {
                    formData.push({ selector, fields });
                }
            });
            sessionStorage.setItem('rentmate_form_data', JSON.stringify(formData));
        }

        // Seamless language switching - preserves scroll position and form data
        function setLanguage(culture) {
            // Set the ASP.NET Core culture cookie
            setCookie('.AspNetCore.Culture', `c=${culture}|uic=${culture}`);
            
            // Clear cached translations
            sessionStorage.removeItem('rentmate_translations');
            sessionStorage.removeItem('rentmate_translations_version');
            
            // Save scroll position and form data, then reload
            sessionStorage.setItem('rentmate_scroll_position', window.scrollY.toString());
            saveFormData();
            window.location.reload();
        }

        // Seamless currency switching - preserves scroll position and form data
        function setCurrency(currencyCode) {
            setCookie('RentMateCurrency', currencyCode);

            // Save scroll position and form data, then reload
            sessionStorage.setItem('rentmate_scroll_position', window.scrollY.toString());
            saveFormData();
            window.location.reload();
        }

        // ==========================================
        // Theme Management (Light / Dark / System)
        // ==========================================
        function getThemePreference() {
            return localStorage.getItem('theme') || 'system';
        }

        function applyTheme(pref) {
            var isDark = pref === 'dark' || (pref === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.classList.toggle('dark', isDark);
            updateThemeUI(pref);
        }

        function setThemePreference(pref) {
            localStorage.setItem('theme', pref);
            applyTheme(pref);
            // Close the dropdown
            var menu = document.getElementById('themeMenu');
            if (menu) menu.classList.add('hidden');
        }

        function updateThemeUI(pref) {
            // Update desktop dropdown icons
            var icons = { light: '.theme-icon-light', dark: '.theme-icon-dark', system: '.theme-icon-system' };
            Object.keys(icons).forEach(function(key) {
                var el = document.querySelector('#themeDropdown ' + icons[key]);
                if (el) el.classList.toggle('hidden', key !== pref);
            });

            // Update desktop dropdown active states
            document.querySelectorAll('.theme-btn').forEach(function(btn) {
                var opt = btn.getAttribute('data-theme-option');
                var isActive = opt === pref;
                btn.classList.toggle('bg-blue-50', isActive);
                btn.classList.toggle('text-blue-700', isActive);
                btn.classList.toggle('font-medium', isActive);
                var check = btn.querySelector('.theme-check');
                if (check) check.classList.toggle('hidden', !isActive);
            });

            // Update mobile toggle active states
            document.querySelectorAll('.theme-mobile-btn').forEach(function(btn) {
                var opt = btn.getAttribute('data-theme-mobile');
                var isActive = opt === pref;
                btn.classList.toggle('bg-blue-50', isActive);
                btn.classList.toggle('text-blue-700', isActive);
                btn.classList.toggle('ring-2', isActive);
                btn.classList.toggle('ring-blue-300', isActive);
            });
        }

        // Listen for OS theme changes when in "system" mode
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
            if (getThemePreference() === 'system') {
                applyTheme('system');
            }
        });

        // Apply theme on page load (after DOM is available for UI updates)
        (function() {
            function initThemeUI() {
                applyTheme(getThemePreference());
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initThemeUI);
            } else {
                initThemeUI();
            }
        })();
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


@*
    Status Badge Partial View
    
    Usage: @await Html.PartialAsync("_StatusBadge", new { Type = "active", Text = "Active" })
    
    Types: 
      - active: Blue badge for active rentals
      - pending: Amber badge for pending items
      - completed/success/listed: Green badge for completed transactions
      - cancelled/hidden/error/banned: Red badge for cancelled items
      - normal/default: Slate badge
      - warning: Yellow badge
      - info: Purple badge
    
    Optional: ShowIcon = true, SmallPadding = true
*@

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    var badgeType = (string)(Model?.Type ?? ViewData["Type"] ?? "info");
    var text = (string)(Model?.Text ?? ViewData["Text"] ?? "");
    var localizedText = !string.IsNullOrEmpty(text) ? Localizer[text].Value : "";
    var showIcon = (bool?)(Model?.ShowIcon ?? ViewData["ShowIcon"]) ?? false;
    var smallPadding = (bool?)(Model?.SmallPadding ?? ViewData["SmallPadding"]) ?? false;
    
    // Badge color and icon configurations
    var (bgColor, textColor, icon) = badgeType.ToLower() switch
    {
        "active" => ("bg-blue-100", "text-blue-700", "bi-play-circle"),
        "pending" => ("bg-amber-100", "text-amber-700", "bi-clock"),
        "completed" or "success" or "listed" => ("bg-green-100", "text-green-700", "bi-check-circle"),
        "cancelled" or "hidden" or "error" or "banned" => ("bg-red-100", "text-red-700", "bi-x-circle"),
        "moderated" => ("bg-amber-100", "text-amber-700", "bi-shield-exclamation"),
        "normal" or "default" => ("bg-slate-100", "text-slate-600", ""),
        "warning" => ("bg-yellow-100", "text-yellow-700", "bi-exclamation-triangle"),
        "info" => ("bg-purple-100", "text-purple-700", "bi-info-circle"),
        _ => ("bg-slate-100", "text-slate-600", "")
    };
    
    var paddingClass = smallPadding ? "px-2 py-0.5" : "px-2 py-1";
}

<span class="@paddingClass @bgColor @textColor text-xs font-medium rounded-full">@if (showIcon && !string.IsNullOrEmpty(icon)) {<i class="bi @icon"></i><text> </text>}@localizedText</span>

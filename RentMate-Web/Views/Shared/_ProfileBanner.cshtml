@*
    Floating yellow banner shown when the authenticated user has an incomplete profile.
    Injected into _Layout.cshtml — hidden when profile completeness reaches 100 %
    or the user dismisses it (per-session via JS).
*@
@using RentMate.Services.Interfaces
@inject IProfileCompletionService ProfileCompletionService
@inject UserManager<ApplicationUser> UserManager

@if (User.Identity?.IsAuthenticated == true)
{
    var userId = UserManager.GetUserId(User);
    if (userId != null)
    {
        var status = await ProfileCompletionService.GetCompletionStatusAsync(userId);

        @* Only show the banner when the profile is not 100 % complete *@
        if (status.Percentage < 100)
        {
            <div id="profileBanner"
                 class="fixed bottom-4 left-1/2 -translate-x-1/2 w-[95%] max-w-2xl bg-amber-50 dark:bg-amber-900/40 border border-amber-300 dark:border-amber-700 rounded-2xl shadow-xl px-5 py-4 transition-all duration-300"
                 style="z-index: var(--z-toast);">
                <div class="flex items-start gap-4">
                    <!-- Icon -->
                    <div class="flex-shrink-0 mt-0.5">
                        <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-800 flex items-center justify-center">
                            <i class="bi bi-exclamation-triangle-fill text-amber-600 dark:text-amber-300 text-lg"></i>
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-1">
                            <p class="text-sm font-semibold text-amber-800 dark:text-amber-200">
                                Your profile is @status.Percentage% complete
                            </p>
                            <!-- Progress bar -->
                            <div class="flex-1 max-w-[120px] h-2 bg-amber-200 dark:bg-amber-700 rounded-full overflow-hidden">
                                <div class="h-full rounded-full transition-all duration-500
                                     @(status.Percentage >= 80 ? "bg-green-500" : status.Percentage >= 50 ? "bg-amber-500" : "bg-red-400")"
                                     style="width: @(status.Percentage)%"></div>
                            </div>
                        </div>

                        @if (status.Tips.Any())
                        {
                            <div class="flex flex-wrap gap-2 mt-1">
                                @foreach (var tip in status.Tips.Take(3))
                                {
                                    <a href="@tip.Url"
                                       class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium text-amber-700 dark:text-amber-300 bg-amber-100 dark:bg-amber-800/60 hover:bg-amber-200 dark:hover:bg-amber-700 rounded-lg transition-colors">
                                        <i class="@tip.Icon text-[10px]"></i>
                                        @tip.Message
                                    </a>
                                }
                                @if (status.Tips.Count > 3)
                                {
                                    <a href="/Identity/Account/Manage"
                                       class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium text-amber-600 dark:text-amber-400 hover:underline">
                                        +@(status.Tips.Count - 3) more
                                    </a>
                                }
                            </div>
                        }
                    </div>

                    <!-- Close button (session-level dismiss) -->
                    <button onclick="dismissProfileBanner()"
                            class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-lg text-amber-400 hover:text-amber-600 hover:bg-amber-100 dark:hover:bg-amber-800 transition-colors"
                            title="Dismiss">
                        <i class="bi bi-x-lg text-sm"></i>
                    </button>
                </div>
            </div>

            <script>
                // Dismiss for the current browser session only
                (function () {
                    if (sessionStorage.getItem('profileBannerDismissed') === 'true') {
                        var el = document.getElementById('profileBanner');
                        if (el) el.style.display = 'none';
                    }
                })();
                function dismissProfileBanner() {
                    var el = document.getElementById('profileBanner');
                    if (el) {
                        el.style.opacity = '0';
                        el.style.transform = 'translate(-50%, 20px)';
                        setTimeout(function () { el.style.display = 'none'; }, 300);
                    }
                    sessionStorage.setItem('profileBannerDismissed', 'true');
                }
            </script>
        }
    }
}

@*
    Page Header Partial View - Consistent page headers with title, subtitle, and actions
    
    Usage: @await Html.PartialAsync("_PageHeader", new { 
        Title = "Items",
        Subtitle = "Manage all items",
        ActionText = "Create New",
        ActionLink = "/Items/Create",
        ActionIcon = "bi-plus-lg"
    })
*@

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    var modelType = Model?.GetType();
    var title = (string)(modelType?.GetProperty("Title")?.GetValue(Model) ?? ViewData["Title"] ?? "Page Title");
    var subtitle = (string?)(modelType?.GetProperty("Subtitle")?.GetValue(Model) ?? ViewData["Subtitle"]);
    var actionText = (string?)(modelType?.GetProperty("ActionText")?.GetValue(Model) ?? ViewData["ActionText"]);
    var actionLink = (string?)(modelType?.GetProperty("ActionLink")?.GetValue(Model) ?? ViewData["ActionLink"]);
    var actionIcon = (string?)(modelType?.GetProperty("ActionIcon")?.GetValue(Model) ?? ViewData["ActionIcon"]);
    var actionController = (string?)(modelType?.GetProperty("ActionController")?.GetValue(Model) ?? ViewData["ActionController"]);
    var actionAction = (string?)(modelType?.GetProperty("ActionAction")?.GetValue(Model) ?? ViewData["ActionAction"]);
}

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
        <h1 class="text-3xl font-bold text-stone-900">@Localizer[title]</h1>
        @if (!string.IsNullOrEmpty(subtitle))
        {
            <p class="text-stone-500 mt-1">@Localizer[subtitle]</p>
        }
    </div>
    @if (!string.IsNullOrEmpty(actionText))
    {
        @if (!string.IsNullOrEmpty(actionController) && !string.IsNullOrEmpty(actionAction))
        {
            <a asp-controller="@actionController" asp-action="@actionAction"
               class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary-600 text-white rounded-lg font-semibold hover:bg-primary-700 transition-colors duration-150">
                @if (!string.IsNullOrEmpty(actionIcon))
                {
                    <i class="bi @actionIcon"></i>
                }
                @Localizer[actionText]
            </a>
        }
        else if (!string.IsNullOrEmpty(actionLink))
        {
            <a href="@actionLink" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary-600 text-white rounded-lg font-semibold hover:bg-primary-700 transition-colors duration-150">
                @if (!string.IsNullOrEmpty(actionIcon))
                {
                    <i class="bi @actionIcon"></i>
                }
                @Localizer[actionText]
            </a>
        }
    }
</div>

@*
    Page Header Partial View - Consistent page headers with title, subtitle, and actions
    
    Usage: @await Html.PartialAsync("_PageHeader", new { 
        Title = "Items",
        Subtitle = "Manage all items",
        ActionText = "Create New",
        ActionLink = "/Items/Create",
        ActionIcon = "bi-plus-lg"
    })
*@

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    var title = (string)(Model?.Title ?? ViewData["Title"] ?? "Page Title");
    var subtitle = (string?)(Model?.Subtitle ?? ViewData["Subtitle"]);
    var actionText = (string?)(Model?.ActionText ?? ViewData["ActionText"]);
    var actionLink = (string?)(Model?.ActionLink ?? ViewData["ActionLink"]);
    var actionIcon = (string?)(Model?.ActionIcon ?? ViewData["ActionIcon"]);
    var actionController = (string?)(Model?.ActionController ?? ViewData["ActionController"]);
    var actionAction = (string?)(Model?.ActionAction ?? ViewData["ActionAction"]);
}

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
        <h1 class="font-heading text-3xl font-bold text-slate-900">@Localizer[title]</h1>
        @if (!string.IsNullOrEmpty(subtitle))
        {
            <p class="text-slate-500 mt-1">@Localizer[subtitle]</p>
        }
    </div>
    @if (!string.IsNullOrEmpty(actionText))
    {
        @if (!string.IsNullOrEmpty(actionController) && !string.IsNullOrEmpty(actionAction))
        {
            <a asp-controller="@actionController" asp-action="@actionAction" 
               class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-500 text-white rounded-xl font-semibold hover:shadow-md transition-all">
                @if (!string.IsNullOrEmpty(actionIcon))
                {
                    <i class="bi @actionIcon"></i>
                }
                @Localizer[actionText]
            </a>
        }
        else if (!string.IsNullOrEmpty(actionLink))
        {
            <a href="@actionLink" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-500 text-white rounded-xl font-semibold hover:shadow-md transition-all">
                @if (!string.IsNullOrEmpty(actionIcon))
                {
                    <i class="bi @actionIcon"></i>
                }
                @Localizer[actionText]
            </a>
        }
    }
</div>

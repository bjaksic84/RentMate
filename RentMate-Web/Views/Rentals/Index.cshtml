@model IEnumerable<RentMate.Models.Domain.Item>
@using System.Text.Json;
@using System.Globalization;
@using RentMate.Helpers;
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService

@functions {
    /// <summary>
    /// Builds a properly encoded filter URL with array parameters serialized as repeated query keys.
    /// This avoids the System.String[] bug that asp-route-* tag helpers produce for string[] values.
    /// </summary>
    string BuildFilterUrl(
        string[]? categories = null,
        string? search = null,
        string? city = null,
        decimal? minPrice = null,
        decimal? maxPrice = null,
        int? minRating = null,
        string? sort = null,
        int? page = null,
        string? startDate = null,
        string? endDate = null)
    {
        var parts = new List<string>();

        if (!string.IsNullOrEmpty(search))
            parts.Add($"search={Uri.EscapeDataString(search)}");

        if (categories != null)
        {
            foreach (var cat in categories)
            {
                if (!string.IsNullOrEmpty(cat))
                    parts.Add($"category={Uri.EscapeDataString(cat)}");
            }
        }

        if (!string.IsNullOrEmpty(city))
            parts.Add($"city={Uri.EscapeDataString(city)}");

        if (minPrice.HasValue)
            parts.Add($"minPrice={minPrice.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}");

        if (maxPrice.HasValue)
            parts.Add($"maxPrice={maxPrice.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}");

        if (minRating.HasValue && minRating.Value > 0)
            parts.Add($"minRating={minRating.Value}");

        if (!string.IsNullOrEmpty(sort))
            parts.Add($"sort={Uri.EscapeDataString(sort)}");

        if (page.HasValue && page.Value > 1)
            parts.Add($"page={page.Value}");

        if (!string.IsNullOrEmpty(startDate))
            parts.Add($"startDate={Uri.EscapeDataString(startDate)}");

        if (!string.IsNullOrEmpty(endDate))
            parts.Add($"endDate={Uri.EscapeDataString(endDate)}");

        var basePath = Url.Action("Index", "Rentals");
        return parts.Count > 0 ? $"{basePath}?{string.Join("&", parts)}" : basePath!;
    }
}

@{
    ViewData["Title"] = Localizer["Marketplace"];
    
    decimal currentMin = ViewBag.MinPrice ?? 0;
    decimal currentMax = ViewBag.MaxPrice ?? (ViewBag.AbsoluteMaxPrice ?? 500);
    var currency = CurrencyService.GetCurrentCurrency();
    
    var selectedCategories = ViewBag.Category as string[] ?? Array.Empty<string>();
    
    var hasActiveFilters = !string.IsNullOrEmpty(ViewBag.Search as string) || 
                           selectedCategories.Any() || 
                           !string.IsNullOrEmpty(ViewBag.City as string) ||
                           ViewBag.MinPrice != null || 
                           ViewBag.MaxPrice != null ||
                           !string.IsNullOrEmpty(ViewBag.StartDate as string) ||
                           ViewBag.MinRating != null;
    
    var categories = ViewConstants.FilterCategories;
    var cities = CityData.Cities.Select(c => c.Name).ToList();
    
    // Format dates for display (booking.com style: '26 Jan' or '26. jan')
    string FormatShortDate(string dateStr) {
        if (DateTime.TryParse(dateStr, out var date)) {
            var culture = CultureInfo.CurrentUICulture;
            string format = (culture.TwoLetterISOLanguageName == "sl") ? "d. MMM" : "d MMM";
            return date.ToString(format, culture);
        }
        return dateStr ?? "";
    }
    
    var formattedStartDate = FormatShortDate((ViewBag.StartDate as string) ?? "");
    var formattedEndDate = FormatShortDate((ViewBag.EndDate as string) ?? "");
    var displayDateRange = !string.IsNullOrEmpty(ViewBag.StartDate as string) && !string.IsNullOrEmpty(ViewBag.EndDate as string)
        ? $"{formattedStartDate} - {formattedEndDate}"
        : "";
}

@Html.AntiForgeryToken()

<!-- Mini Hero with Search -->
<section class="relative bg-gradient-to-r from-blue-600 to-blue-700 py-12 overflow-visible" style="z-index: var(--z-base, 1);">
    <!-- Decorative background elements -->
    <div class="absolute inset-0 opacity-20 pointer-events-none">
        <div class="absolute top-0 left-1/4 w-64 h-64 bg-sky-400 rounded-full mix-blend-multiply filter blur-3xl animate-pulse"></div>
        <div class="absolute bottom-0 right-1/4 w-64 h-64 bg-indigo-400 rounded-full mix-blend-multiply filter blur-3xl animate-pulse"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 overflow-visible" style="z-index: var(--z-base, 1);">
        <div class="text-center mb-8">
            <h1 class="font-heading text-3xl sm:text-4xl font-bold text-white mb-2">
                @Localizer["Find the perfect item to rent"]
            </h1>
            <p class="text-blue-100 opacity-90">@Model.Count() @Localizer["items available in our community"]</p>
        </div>
        
        <div class="max-w-4xl mx-auto overflow-visible">
            <form asp-action="Index" method="get" id="marketplaceSearchForm"
                  class="glass rounded-2xl sm:rounded-full p-2 shadow-xl border border-white/30 relative overflow-visible" style="z-index: var(--z-dropdown, 100);">
                <div class="flex flex-col sm:flex-row items-stretch gap-2 overflow-visible">
                    <!-- What (Search Input) -->
                    <div class="flex-[1.5] min-w-0 group relative overflow-visible">
                        <div onclick="document.getElementById('mktSearch').focus()" 
                             class="flex items-center gap-3 px-4 py-3 rounded-xl sm:rounded-full 
                                    bg-white/60 hover:bg-white/90 
                                    focus-within:bg-white focus-within:ring-2 focus-within:ring-blue-500 focus-within:ring-offset-2
                                    transition-all duration-200 cursor-text h-full">
                            <div class="w-9 h-9 rounded-full bg-gradient-to-br from-blue-600 to-sky-500 flex items-center justify-center flex-shrink-0">
                                <i class="bi bi-search text-white text-sm"></i>
                            </div>
                            <div class="flex-1 min-w-0 relative">
                                <input type="text" id="mktSearch" name="search" value="@ViewBag.Search" 
                                       placeholder="@Localizer["What are you looking for?"]"
                                       oninput="toggleClearButton(this)"
                                       class="w-full bg-transparent border-none text-slate-900 font-medium placeholder-slate-500 focus:outline-none text-sm pr-8">
                                <button type="button" id="mktSearchClear" onclick="clearSearchInput()"
                                        class="absolute right-0 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full bg-slate-200 hover:bg-slate-300 flex items-center justify-center text-slate-500 transition-all opacity-0 invisible">
                                    <i class="bi bi-x text-sm"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <div class="hidden sm:block w-px bg-slate-300/50 my-2"></div>
                    
                    <!-- Date Range -->
                    <div class="flex-1 min-w-0 relative overflow-visible" style="z-index: var(--z-popover, 1300);">
                        @{
                            DateOnly? marketStartDate = null;
                            DateOnly? marketEndDate = null;
                            if (!string.IsNullOrEmpty(ViewBag.StartDate as string) && DateOnly.TryParse((string)ViewBag.StartDate, out var ps)) marketStartDate = ps;
                            if (!string.IsNullOrEmpty(ViewBag.EndDate as string) && DateOnly.TryParse((string)ViewBag.EndDate, out var pe)) marketEndDate = pe;
                        }
                        @await Html.PartialAsync("_SmartCalendar", new RentMate.Models.ViewModels.SmartCalendarModel {
                            Id = "marketplaceDateRange",
                            StartDateField = "startDate",
                            EndDateField = "endDate",
                            Mode = RentMate.Models.ViewModels.CalendarMode.Range,
                            MinDate = DateOnly.FromDateTime(DateTime.Today),
                            InitialStart = marketStartDate,
                            InitialEnd = marketEndDate,
                            Placeholder = Localizer["When?"].Value
                        })
                    </div>
                    
                    <div class="hidden sm:block w-px bg-slate-300/50 my-2"></div>
                    
                    <!-- Location -->
                    <div class="flex-1 min-w-0 group relative overflow-visible">
                        <div onclick="document.querySelector('[name=city]').focus()" 
                             class="flex items-center gap-3 px-4 py-3 rounded-xl sm:rounded-full bg-white/60 hover:bg-white/90 focus-within:bg-white transition-all cursor-pointer h-full">
                            <div class="w-9 h-9 rounded-full bg-gradient-to-br from-blue-600 to-sky-500 flex items-center justify-center flex-shrink-0">
                                <i class="bi bi-geo-alt-fill text-white text-sm"></i>
                            </div>
                            <select name="city" class="flex-1 min-w-0 bg-transparent border-none text-slate-900 font-medium focus:outline-none text-sm cursor-pointer">
                                <option value="">@Localizer["Where?"]</option>
                                @foreach (var city in cities)
                                {
                                    <option value="@city" selected="@(ViewBag.City == city)">@city</option>
                                }
                            </select>
                        </div>
                    </div>
                    
                    <!-- Search Button -->
                    <button type="submit" class="px-7 py-3 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-semibold rounded-xl sm:rounded-full shadow-md transition-all duration-300 flex items-center justify-center gap-2 group">
                        <i class="bi bi-search text-lg group-hover:scale-110 transition-transform"></i>
                        <span class="sm:hidden lg:inline">@Localizer["Search"]</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- Main Content -->
<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" style="z-index: var(--z-base, 1);">
    <div class="flex flex-col lg:flex-row gap-8">
        
        @await Html.PartialAsync("_FilterSidebar", Model)

        <!-- Main Grid -->
        <div class="flex-1">
            <!-- Active Filters & Sort -->
            <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
                <!-- Active filter tags -->
                <div class="flex flex-wrap items-center gap-2">
                    @foreach (var cat in selectedCategories)
                    {
                        <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-gradient-to-r from-blue-50 to-sky-50 border border-blue-200 text-blue-700 rounded-full text-sm font-medium">
                            <i class="bi bi-tag"></i> @Localizer[cat]
                            @{
                                var remainingCategories = selectedCategories.Where(c => c != cat).ToArray();
                            }
                            <a href="@BuildFilterUrl(categories: remainingCategories, search: ViewBag.Search, city: ViewBag.City, minPrice: ViewBag.MinPrice, maxPrice: ViewBag.MaxPrice, minRating: ViewBag.MinRating, sort: ViewBag.Sort, startDate: ViewBag.StartDate, endDate: ViewBag.EndDate)"
                               class="w-5 h-5 rounded-full bg-blue-200 hover:bg-blue-300 flex items-center justify-center transition-colors">
                                <i class="bi bi-x text-xs"></i>
                            </a>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                    {
                        <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-gradient-to-r from-slate-50 to-white border border-slate-200 text-slate-700 rounded-full text-sm font-medium">
                            <i class="bi bi-search"></i> "@ViewBag.Search"
                            <a href="@BuildFilterUrl(categories: selectedCategories, city: ViewBag.City, minPrice: ViewBag.MinPrice, maxPrice: ViewBag.MaxPrice, minRating: ViewBag.MinRating, sort: ViewBag.Sort, startDate: ViewBag.StartDate, endDate: ViewBag.EndDate)"
                               class="w-5 h-5 rounded-full bg-slate-200 hover:bg-slate-300 flex items-center justify-center transition-colors">
                                <i class="bi bi-x text-xs"></i>
                            </a>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(ViewBag.City as string))
                    {
                        <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-gradient-to-r from-green-50 to-emerald-50 border border-green-200 text-green-700 rounded-full text-sm font-medium">
                            <i class="bi bi-geo-alt-fill"></i> @ViewBag.City
                            <a href="@BuildFilterUrl(categories: selectedCategories, search: ViewBag.Search, minPrice: ViewBag.MinPrice, maxPrice: ViewBag.MaxPrice, minRating: ViewBag.MinRating, sort: ViewBag.Sort, startDate: ViewBag.StartDate, endDate: ViewBag.EndDate)"
                               class="w-5 h-5 rounded-full bg-green-200 hover:bg-green-300 flex items-center justify-center transition-colors">
                                <i class="bi bi-x text-xs"></i>
                            </a>
                        </span>
                    }
                    @if (ViewBag.MinPrice != null || ViewBag.MaxPrice != null)
                    {
                        <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-gradient-to-r from-purple-50 to-violet-50 border border-purple-200 text-purple-700 rounded-full text-sm font-medium">
                            <i class="bi bi-currency-euro"></i> @currency.Symbol@((int)CurrencyService.Convert(ViewBag.MinPrice ?? 0)) - @currency.Symbol@((int)CurrencyService.Convert(ViewBag.MaxPrice ?? ViewBag.AbsoluteMaxPrice))
                            <a href="@BuildFilterUrl(categories: selectedCategories, search: ViewBag.Search, city: ViewBag.City, minRating: ViewBag.MinRating, sort: ViewBag.Sort, startDate: ViewBag.StartDate, endDate: ViewBag.EndDate)"
                               class="w-5 h-5 rounded-full bg-purple-200 hover:bg-purple-300 flex items-center justify-center transition-colors">
                                <i class="bi bi-x text-xs"></i>
                            </a>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(ViewBag.MinRating?.ToString()))
                    {
                        <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-gradient-to-r from-amber-50 to-yellow-50 border border-amber-200 text-amber-700 rounded-full text-sm font-medium">
                            <i class="bi bi-star-fill"></i> @ViewBag.MinRating+ @Localizer["stars"]
                            <a href="@BuildFilterUrl(categories: selectedCategories, search: ViewBag.Search, city: ViewBag.City, minPrice: ViewBag.MinPrice, maxPrice: ViewBag.MaxPrice, sort: ViewBag.Sort, startDate: ViewBag.StartDate, endDate: ViewBag.EndDate)"
                               class="w-5 h-5 rounded-full bg-amber-200 hover:bg-amber-300 flex items-center justify-center transition-colors">
                                <i class="bi bi-x text-xs"></i>
                            </a>
                        </span>
                    }
                </div>
                
                <!-- Sort dropdown -->
                <div class="flex items-center gap-3">
                    <span class="text-sm text-slate-500 hidden sm:inline">@Localizer["Sort by:"]</span>
                    <div class="relative">
                        <select onchange="window.location.href=this.value" 
                                class="appearance-none pl-4 pr-10 py-2.5 border border-slate-200 rounded-xl text-sm font-medium focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-white cursor-pointer hover:border-slate-300 transition-colors">
                            @{
                                var sortNewest = ViewBag.Sort == "newest" || ViewBag.Sort == null;
                                var sortPriceAsc = ViewBag.Sort == "price_asc";
                                var sortPriceDesc = ViewBag.Sort == "price_desc";
                                var sortRating = ViewBag.Sort == "rating";
                            }
                            <option value="@BuildFilterUrl(categories: selectedCategories, search: ViewBag.Search, city: ViewBag.City, minPrice: ViewBag.MinPrice, maxPrice: ViewBag.MaxPrice, minRating: ViewBag.MinRating, sort: "newest", startDate: ViewBag.StartDate, endDate: ViewBag.EndDate)"
                                    selected="@sortNewest">@Localizer["Newest first"]</option>
                            <option value="@BuildFilterUrl(categories: selectedCategories, search: ViewBag.Search, city: ViewBag.City, minPrice: ViewBag.MinPrice, maxPrice: ViewBag.MaxPrice, minRating: ViewBag.MinRating, sort: "price_asc", startDate: ViewBag.StartDate, endDate: ViewBag.EndDate)"
                                    selected="@sortPriceAsc">@Localizer["Price: Low to High"]</option>
                            <option value="@BuildFilterUrl(categories: selectedCategories, search: ViewBag.Search, city: ViewBag.City, minPrice: ViewBag.MinPrice, maxPrice: ViewBag.MaxPrice, minRating: ViewBag.MinRating, sort: "price_desc", startDate: ViewBag.StartDate, endDate: ViewBag.EndDate)"
                                    selected="@sortPriceDesc">@Localizer["Price: High to Low"]</option>
                            <option value="@BuildFilterUrl(categories: selectedCategories, search: ViewBag.Search, city: ViewBag.City, minPrice: ViewBag.MinPrice, maxPrice: ViewBag.MaxPrice, minRating: ViewBag.MinRating, sort: "rating", startDate: ViewBag.StartDate, endDate: ViewBag.EndDate)"
                                    selected="@sortRating">@Localizer["Highest rated"]</option>
                        </select>
                        <i class="bi bi-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none"></i>
                    </div>
                </div>
            </div>
            
            @await Html.PartialAsync("_MobileFilterDrawer", Model)

            <!-- Results Grid -->
            @if (Model.Any())
            {
                <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-6">
                    @foreach (var item in Model)
                    {
                        @await Html.PartialAsync("_ItemCard", item)
                    }
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-20">
                    <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-slate-100 flex items-center justify-center">
                        <i class="bi bi-search text-4xl text-slate-400"></i>
                    </div>
                    <h3 class="font-heading text-xl font-bold text-slate-900 mb-2">@Localizer["No items found"]</h3>
                    <p class="text-slate-500 mb-6">@Localizer["Try adjusting your filters or search terms"]</p>
                    <a asp-action="Index" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-full transition-colors">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        @Localizer["Clear all filters"]
                    </a>
                </div>
            }
            
            <!-- Pagination placeholder -->
            @if (ViewBag.TotalPages > 1)
            {
                <div class="flex justify-center mt-10">
                    <nav class="flex items-center gap-2">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            var isActive = i == (ViewBag.CurrentPage ?? 1);
                            <a href="@BuildFilterUrl(categories: selectedCategories, search: ViewBag.Search, city: ViewBag.City, minPrice: ViewBag.MinPrice, maxPrice: ViewBag.MaxPrice, minRating: ViewBag.MinRating, sort: ViewBag.Sort, page: i, startDate: ViewBag.StartDate, endDate: ViewBag.EndDate)"
                               class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-medium transition-colors @(isActive ? "bg-blue-600 text-white" : "bg-white border border-slate-200 text-slate-700 hover:bg-slate-50")">
                                @i
                            </a>
                        }
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .hover-lift {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .hover-lift:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 40px -12px rgba(37, 99, 235, 0.2);
    }
    .glass {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }
    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .scrollbar-thin::-webkit-scrollbar {
        width: 6px;
    }
    .scrollbar-thin::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 3px;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }
    details summary::-webkit-details-marker {
        display: none;
    }
</style>

@section Scripts {
    <script>window.MarketplaceConfig = { currencySymbol: '@Html.Raw(currency.Symbol)' };</script>
    <script src="~/js/marketplace.js" asp-append-version="true"></script>
}

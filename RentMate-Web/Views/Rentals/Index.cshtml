@model IEnumerable<RentMate.Models.Domain.Item>
@using System.Text.Json;
@using System.Globalization;
@using RentMate.Helpers;
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService

@{
    ViewData["Title"] = Localizer["Marketplace"];
    
    decimal currentMin = ViewBag.MinPrice ?? 0;
    decimal currentMax = ViewBag.MaxPrice ?? (ViewBag.AbsoluteMaxPrice ?? 500);
    var currency = CurrencyService.GetCurrentCurrency();
    
    var selectedCategories = ViewBag.Category as string[] ?? Array.Empty<string>();
    
    var hasActiveFilters = !string.IsNullOrEmpty(ViewBag.Search as string) || 
                           selectedCategories.Any() || 
                           !string.IsNullOrEmpty(ViewBag.City as string) ||
                           ViewBag.MinPrice != null || 
                           ViewBag.MaxPrice != null ||
                           !string.IsNullOrEmpty(ViewBag.StartDate as string) ||
                           !string.IsNullOrEmpty(ViewBag.MinRating as string);
    
    var categories = ViewConstants.FilterCategories;
    var cities = CityData.Cities.Select(c => c.Name).ToList();
    
    // Format dates for display (booking.com style: '26 Jan' or '26. jan')
    string FormatShortDate(string dateStr) {
        if (DateTime.TryParse(dateStr, out var date)) {
            var culture = CultureInfo.CurrentUICulture;
            string format = (culture.TwoLetterISOLanguageName == "sl") ? "d. MMM" : "d MMM";
            return date.ToString(format, culture);
        }
        return dateStr ?? "";
    }
    
    var formattedStartDate = FormatShortDate((ViewBag.StartDate as string) ?? "");
    var formattedEndDate = FormatShortDate((ViewBag.EndDate as string) ?? "");
    var displayDateRange = !string.IsNullOrEmpty(ViewBag.StartDate as string) && !string.IsNullOrEmpty(ViewBag.EndDate as string)
        ? $"{formattedStartDate} - {formattedEndDate}"
        : "";
}

@Html.AntiForgeryToken()

<!-- Mini Hero with Search -->
<section class="relative bg-primary-700 py-12 overflow-visible" style="z-index: 10;">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 overflow-visible" style="z-index: var(--z-base, 1);">
        <div class="text-center mb-8">
            <h1 class="text-3xl sm:text-4xl font-bold text-white mb-2">
                @Localizer["Find the perfect item to rent"]
            </h1>
            <p class="text-primary-100 opacity-90">@Model.Count() @Localizer["items available in our community"]</p>
        </div>

        <div class="max-w-4xl mx-auto overflow-visible">
            <form asp-action="Index" method="get" id="marketplaceSearchForm"
                  class="bg-white shadow-md border border-stone-200 rounded-lg p-2 relative overflow-visible" style="z-index: var(--z-dropdown, 100);">
                <div class="flex flex-col sm:flex-row items-stretch gap-2 overflow-visible">
                    <!-- What (Search Input) -->
                    <div class="flex-[1.5] min-w-0 group relative overflow-visible">
                        <div onclick="document.getElementById('mktSearch').focus()"
                             class="flex items-center gap-3 px-4 py-3 rounded-md
                                    bg-white hover:bg-stone-50
                                    focus-within:bg-white focus-within:ring-2 focus-within:ring-primary-500 focus-within:ring-offset-2
                                    transition-colors duration-150 cursor-text h-full">
                            <div class="w-9 h-9 rounded-full bg-primary-600 flex items-center justify-center flex-shrink-0">
                                <i class="bi bi-search text-white text-sm"></i>
                            </div>
                            <div class="flex-1 min-w-0 relative">
                                <input type="text" id="mktSearch" name="search" value="@ViewBag.Search"
                                       placeholder="@Localizer["What are you looking for?"]"
                                       oninput="toggleClearButton(this)"
                                       class="w-full bg-transparent border-none text-stone-900 font-medium placeholder-stone-500 focus:outline-none text-sm pr-8">
                                <button type="button" id="mktSearchClear" onclick="clearSearchInput()"
                                        class="absolute right-0 top-1/2 -translate-y-1/2 w-6 h-6 rounded-full bg-stone-200 hover:bg-stone-300 flex items-center justify-center text-stone-500 transition-colors duration-150 opacity-0 invisible">
                                    <i class="bi bi-x text-sm"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="hidden sm:block w-px bg-stone-300/50 my-2"></div>

                    <!-- Date Range -->
                    <div class="flex-1 min-w-0 relative overflow-visible" style="z-index: var(--z-popover, 700);">
                        @{
                            DateOnly? marketStartDate = null;
                            DateOnly? marketEndDate = null;
                            if (!string.IsNullOrEmpty(ViewBag.StartDate as string) && DateOnly.TryParse((string)ViewBag.StartDate, out var ps)) marketStartDate = ps;
                            if (!string.IsNullOrEmpty(ViewBag.EndDate as string) && DateOnly.TryParse((string)ViewBag.EndDate, out var pe)) marketEndDate = pe;
                        }
                        @await Html.PartialAsync("_SmartCalendar", new RentMate.Models.ViewModels.SmartCalendarModel {
                            Id = "marketplaceDateRange",
                            StartDateField = "startDate",
                            EndDateField = "endDate",
                            Mode = RentMate.Models.ViewModels.CalendarMode.Range,
                            MinDate = DateOnly.FromDateTime(DateTime.Today),
                            InitialStart = marketStartDate,
                            InitialEnd = marketEndDate,
                            Placeholder = Localizer["When?"].Value
                        })
                    </div>

                    <div class="hidden sm:block w-px bg-stone-300/50 my-2"></div>

                    <!-- Location -->
                    <div class="flex-1 min-w-0 group relative overflow-visible">
                        <div onclick="document.querySelector('[name=city]').focus()"
                             class="flex items-center gap-3 px-4 py-3 rounded-md bg-white hover:bg-stone-50 focus-within:bg-white transition-colors duration-150 cursor-pointer h-full">
                            <div class="w-9 h-9 rounded-full bg-primary-600 flex items-center justify-center flex-shrink-0">
                                <i class="bi bi-geo-alt-fill text-white text-sm"></i>
                            </div>
                            <select name="city" class="flex-1 min-w-0 bg-transparent border-none text-stone-900 font-medium focus:outline-none text-sm cursor-pointer">
                                <option value="">@Localizer["Where?"]</option>
                                @foreach (var city in cities)
                                {
                                    <option value="@city" selected="@(ViewBag.City == city)">@city</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Search Button -->
                    <button type="submit" class="px-7 py-3 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-md shadow-md transition-colors duration-150 flex items-center justify-center gap-2">
                        <i class="bi bi-search text-lg"></i>
                        <span class="sm:hidden lg:inline">@Localizer["Search"]</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- Main Content -->
<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" style="z-index: var(--z-base, 1);">
    <div class="flex flex-col lg:flex-row gap-8">
        
        <!-- Sidebar Filters (Desktop) -->
        <aside class="hidden lg:block w-80 flex-shrink-0">
            <div class="sticky top-24 space-y-4" style="z-index: var(--z-sticky, 200);">
                <div class="bg-white rounded-lg border border-stone-200 shadow-sm overflow-hidden">
                    <!-- Filter Header -->
                    <div class="flex items-center justify-between p-5 border-b border-stone-200 bg-stone-50">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-lg bg-primary-100 flex items-center justify-center">
                                <i class="bi bi-sliders text-primary-600"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-stone-900">@Localizer["Filters"]</h3>
                                @if (hasActiveFilters)
                                {
                                    <p class="text-xs text-stone-500">@Localizer["Active filters applied"]</p>
                                }
                            </div>
                        </div>
                        @if (hasActiveFilters)
                        {
                            <a asp-action="Index" class="text-sm text-red-500 hover:text-red-600 font-medium flex items-center gap-1 transition-colors duration-150">
                                <i class="bi bi-x-circle"></i>
                                @Localizer["Reset"]
                            </a>
                        }
                    </div>
                    
                    <form asp-action="Index" method="get" id="filterForm" class="divide-y divide-stone-200">
                        <input type="hidden" name="search" value="@ViewBag.Search" />
                        
                        <!-- Category Filter -->
                        <details class="group" open>
                            <summary class="flex items-center justify-between p-5 cursor-pointer hover:bg-stone-50 transition-colors list-none">
                                <div class="flex items-center gap-3">
                                    <i class="bi bi-grid-3x3-gap text-stone-400"></i>
                                    <span class="font-semibold text-stone-900">@Localizer["Category"]</span>
                                </div>
                                <i class="bi bi-chevron-down text-stone-400 group-open:rotate-180 transition-transform duration-200"></i>
                            </summary>
                            <div class="px-5 pb-5 space-y-1">
                                @foreach (var cat in categories)
                                {
                                    var isSelected = selectedCategories.Contains(cat);
                                    var iconMap = new Dictionary<string, string> {
                                        {"Tools", "bi-tools"},
                                        {"Electronics", "bi-laptop"},
                                        {"Sports", "bi-bicycle"},
                                        {"Home & Garden", "bi-house"},
                                        {"Fun", "bi-controller"},
                                        {"Other", "bi-three-dots"}
                                    };
                                    <label class="flex items-center gap-3 px-3 py-2.5 rounded-lg cursor-pointer transition-all duration-200 @(isSelected ? "bg-primary-50 border border-primary-200" : "hover:bg-stone-50 border border-transparent")">
                                        <input type="checkbox" name="category" value="@cat" class="hidden" @(isSelected ? "checked" : "") onchange="this.form.submit()">
                                        <i class="bi @iconMap.GetValueOrDefault(cat, "bi-tag") @(isSelected ? "text-primary-600" : "text-stone-400")"></i>
                                        <span class="flex-1 @(isSelected ? "text-primary-700 font-medium" : "text-stone-600")">@Localizer[cat ?? "Other"]</span>
                                        @if (isSelected)
                                        {
                                            <i class="bi bi-check-lg text-primary-600"></i>
                                        }
                                    </label>
                                }
                            </div>
                        </details>
                        
                        <!-- Price Range with Visual Slider -->
                        <details class="group" open>
                            <summary class="flex items-center justify-between p-5 cursor-pointer hover:bg-stone-50 transition-colors list-none">
                                <div class="flex items-center gap-3">
                                    <span class="text-stone-400 font-medium">@currency.Symbol</span>
                                    <span class="font-semibold text-stone-900">@Localizer["Price range"]</span>
                                </div>
                                <i class="bi bi-chevron-down text-stone-400 group-open:rotate-180 transition-transform duration-200"></i>
                            </summary>
                            <div class="px-5 pb-5">
                                <!-- Price display -->
                                <div class="flex items-center justify-between mb-4">
                                    <div class="px-3 py-1.5 bg-stone-100 rounded-lg">
                                        <span id="minPriceDisplay" class="font-semibold text-stone-900">@currency.Symbol@((int)CurrencyService.Convert(currentMin))</span>
                                    </div>
                                    <div class="flex-1 mx-3 flex items-center">
                                        <div class="flex-1 border-t-2 border-dashed border-stone-200"></div>
                                        <i class="bi bi-arrow-left-right text-stone-300 mx-2"></i>
                                        <div class="flex-1 border-t-2 border-dashed border-stone-200"></div>
                                    </div>
                                    <div class="px-3 py-1.5 bg-stone-100 rounded-lg">
                                        <span id="maxPriceDisplay" class="font-semibold text-stone-900">@currency.Symbol@((int)CurrencyService.Convert(currentMax))</span>
                                    </div>
                                </div>
                                
                                <!-- Range slider -->
                                @{
                                    var absMax = (int)(ViewBag.AbsoluteMaxPrice ?? 500);
                                    var minPercent = absMax > 0 ? ((int)currentMin * 100 / absMax) : 0;
                                    var maxPercent = absMax > 0 ? (100 - (int)currentMax * 100 / absMax) : 0;
                                }
                                <div class="relative h-2 bg-stone-200 rounded-full mb-6">
                                    <div id="priceTrack" class="absolute h-full bg-primary-500 rounded-full" style="left: @(minPercent)%; right: @(maxPercent)%;"></div>
                                    <input type="range" id="minPriceSlider" min="0" max="@absMax" value="@((int)currentMin)" step="5"
                                           class="absolute w-full h-2 appearance-none bg-transparent pointer-events-none [&::-webkit-slider-thumb]:pointer-events-auto [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-5 [&::-webkit-slider-thumb]:h-5 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-white [&::-webkit-slider-thumb]:border-2 [&::-webkit-slider-thumb]:border-primary-500 [&::-webkit-slider-thumb]:shadow-lg [&::-webkit-slider-thumb]:cursor-pointer [&::-moz-range-thumb]:pointer-events-auto [&::-moz-range-thumb]:appearance-none [&::-moz-range-thumb]:w-5 [&::-moz-range-thumb]:h-5 [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:bg-white [&::-moz-range-thumb]:border-2 [&::-moz-range-thumb]:border-primary-500 [&::-moz-range-thumb]:shadow-lg [&::-moz-range-thumb]:cursor-pointer">
                                    <input type="range" id="maxPriceSlider" min="0" max="@absMax" value="@((int)currentMax)" step="5"
                                           class="absolute w-full h-2 appearance-none bg-transparent pointer-events-none [&::-webkit-slider-thumb]:pointer-events-auto [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-5 [&::-webkit-slider-thumb]:h-5 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-white [&::-webkit-slider-thumb]:border-2 [&::-webkit-slider-thumb]:border-primary-500 [&::-webkit-slider-thumb]:shadow-lg [&::-webkit-slider-thumb]:cursor-pointer [&::-moz-range-thumb]:pointer-events-auto [&::-moz-range-thumb]:appearance-none [&::-moz-range-thumb]:w-5 [&::-moz-range-thumb]:h-5 [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:bg-white [&::-moz-range-thumb]:border-2 [&::-moz-range-thumb]:border-primary-500 [&::-moz-range-thumb]:shadow-lg [&::-moz-range-thumb]:cursor-pointer">
                                </div>
                                
                                <!-- Quick price buttons -->
                                <div class="flex flex-wrap gap-2 mb-4">
                                    @{
                                        var sym = currency.Symbol;
                                        var priceRanges = new[] { (0, 10, $"< {sym}10"), (10, 25, $"{sym}10-25"), (25, 50, $"{sym}25-50"), (50, 100, $"{sym}50+") };
                                    }
                                    @foreach (var (min, max, label) in priceRanges)
                                    {
                                        <button type="button" onclick="setPriceRange(@min, @max)"
                                                class="px-3 py-1.5 text-xs font-medium rounded-lg border border-stone-200 text-stone-600 hover:bg-primary-50 hover:border-primary-200 hover:text-primary-600 transition-all">
                                            @label
                                        </button>
                                    }
                                </div>
                                
                                <!-- Hidden inputs for form submission -->
                                <input type="hidden" name="minPrice" id="minPriceInput" value="@(ViewBag.MinPrice)" />
                                <input type="hidden" name="maxPrice" id="maxPriceInput" value="@(ViewBag.MaxPrice)" />
                            </div>
                        </details>
                        
                        <!-- Rating Filter with visual stars -->
                        <details class="group" open>
                            <summary class="flex items-center justify-between p-5 cursor-pointer hover:bg-stone-50 transition-colors list-none">
                                <div class="flex items-center gap-3">
                                    <i class="bi bi-star text-stone-400"></i>
                                    <span class="font-semibold text-stone-900">@Localizer["Minimum rating"]</span>
                                </div>
                                <i class="bi bi-chevron-down text-stone-400 group-open:rotate-180 transition-transform duration-200"></i>
                            </summary>
                            <div class="px-5 pb-5">
                                <div class="flex gap-2">
                                    @for (int rating = 1; rating <= 5; rating++)
                                    {
                                        var isRatingSelected = ViewBag.MinRating?.ToString() == rating.ToString();
                                        <a asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-category="@ViewBag.Category" asp-route-city="@ViewBag.City" asp-route-minRating="@(isRatingSelected ? "" : rating.ToString())"
                                           class="flex-1 flex flex-col items-center gap-1.5 p-3 rounded-lg cursor-pointer transition-all duration-200 @(isRatingSelected ? "bg-amber-50 border-2 border-amber-400 shadow-sm" : "bg-stone-50 border-2 border-transparent hover:bg-amber-50/50 hover:border-amber-200")">
                                            <i class="bi bi-star-fill text-lg @(isRatingSelected ? "text-amber-500" : "text-amber-300")"></i>
                                            <span class="text-sm font-semibold @(isRatingSelected ? "text-amber-700" : "text-stone-500")">@rating+</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        </details>
                        
                        <!-- Apply Button -->
                        <div class="p-5">
                            <button type="submit" class="w-full py-3.5 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-lg shadow-sm transition-colors duration-150 flex items-center justify-center gap-2">
                                <i class="bi bi-funnel-fill"></i>
                                @Localizer["Apply Filters"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </aside>
        
        <!-- Main Grid -->
        <div class="flex-1">
            <!-- Active Filters & Sort -->
            <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
                <!-- Active filter tags -->
                <div class="flex flex-wrap items-center gap-2">
                    @foreach (var cat in selectedCategories)
                    {
                        <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-primary-50 border border-primary-200 text-primary-700 rounded-full text-sm font-medium">
                            <i class="bi bi-tag"></i> @Localizer[cat]
                            @{
                                var remainingCategories = selectedCategories.Where(c => c != cat).ToArray();
                            }
                            <a asp-action="Index"
                               asp-all-route-data='new Dictionary<string, string?> {
                                   {"search", ViewBag.Search},
                                   {"city", ViewBag.City},
                                   {"minPrice", ViewBag.MinPrice?.ToString()},
                                   {"maxPrice", ViewBag.MaxPrice?.ToString()},
                                   {"minRating", ViewBag.MinRating?.ToString()},
                                   {"sort", ViewBag.Sort}
                               }'
                               asp-route-category="@remainingCategories"
                               class="w-5 h-5 rounded-full bg-primary-200 hover:bg-primary-300 flex items-center justify-center transition-colors duration-150">
                                <i class="bi bi-x text-xs"></i>
                            </a>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                    {
                        <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-stone-50 border border-stone-200 text-stone-700 rounded-full text-sm font-medium">
                            <i class="bi bi-search"></i> "@ViewBag.Search"
                            <a asp-action="Index" asp-all-route-data='new Dictionary<string, string?> { {"category", string.Join(",", selectedCategories)}, {"city", ViewBag.City}, {"minPrice", ViewBag.MinPrice?.ToString()}, {"maxPrice", ViewBag.MaxPrice?.ToString()}, {"minRating", ViewBag.MinRating?.ToString()}, {"sort", ViewBag.Sort} }'
                               class="w-5 h-5 rounded-full bg-stone-200 hover:bg-stone-300 flex items-center justify-center transition-colors duration-150">
                                <i class="bi bi-x text-xs"></i>
                            </a>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(ViewBag.City as string))
                    {
                        <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-green-50 border border-green-200 text-green-700 rounded-full text-sm font-medium">
                            <i class="bi bi-geo-alt-fill"></i> @ViewBag.City
                            <a asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-category="@selectedCategories"
                               class="w-5 h-5 rounded-full bg-green-200 hover:bg-green-300 flex items-center justify-center transition-colors duration-150">
                                <i class="bi bi-x text-xs"></i>
                            </a>
                        </span>
                    }
                    @if (ViewBag.MinPrice != null || ViewBag.MaxPrice != null)
                    {
                        <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-purple-50 border border-purple-200 text-purple-700 rounded-full text-sm font-medium">
                            <i class="bi bi-currency-euro"></i> @currency.Symbol@((int)CurrencyService.Convert(ViewBag.MinPrice ?? 0)) - @currency.Symbol@((int)CurrencyService.Convert(ViewBag.MaxPrice ?? ViewBag.AbsoluteMaxPrice))
                            <a asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-category="@selectedCategories" asp-route-city="@ViewBag.City"
                               class="w-5 h-5 rounded-full bg-purple-200 hover:bg-purple-300 flex items-center justify-center transition-colors duration-150">
                                <i class="bi bi-x text-xs"></i>
                            </a>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(ViewBag.MinRating?.ToString()))
                    {
                        <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-amber-50 border border-amber-200 text-amber-700 rounded-full text-sm font-medium">
                            <i class="bi bi-star-fill"></i> @ViewBag.MinRating+ @Localizer["stars"]
                            <a asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-category="@selectedCategories" asp-route-city="@ViewBag.City"
                               class="w-5 h-5 rounded-full bg-amber-200 hover:bg-amber-300 flex items-center justify-center transition-colors duration-150">
                                <i class="bi bi-x text-xs"></i>
                            </a>
                        </span>
                    }
                </div>
                
                <!-- Sort dropdown -->
                <div class="flex items-center gap-3">
                    <span class="text-sm text-stone-500 hidden sm:inline">@Localizer["Sort by:"]</span>
                    <div class="relative">
                        <select onchange="window.location.href=this.value" 
                                class="appearance-none pl-4 pr-10 py-2.5 border border-stone-200 rounded-lg text-sm font-medium focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white cursor-pointer hover:border-stone-300 transition-colors">
                            @{
                                var sortNewest = ViewBag.Sort == "newest" || ViewBag.Sort == null;
                                var sortPriceAsc = ViewBag.Sort == "price_asc";
                                var sortPriceDesc = ViewBag.Sort == "price_desc";
                                var sortRating = ViewBag.Sort == "rating";
                            }
                            <option value="@Url.Action("Index", new { search = ViewBag.Search, category = selectedCategories, city = ViewBag.City, sort = "newest" })"
                                    selected="@sortNewest">@Localizer["Newest first"]</option>
                            <option value="@Url.Action("Index", new { search = ViewBag.Search, category = selectedCategories, city = ViewBag.City, sort = "price_asc" })"
                                    selected="@sortPriceAsc">@Localizer["Price: Low to High"]</option>
                            <option value="@Url.Action("Index", new { search = ViewBag.Search, category = selectedCategories, city = ViewBag.City, sort = "price_desc" })"
                                    selected="@sortPriceDesc">@Localizer["Price: High to Low"]</option>
                            <option value="@Url.Action("Index", new { search = ViewBag.Search, category = selectedCategories, city = ViewBag.City, sort = "rating" })"
                                    selected="@sortRating">@Localizer["Highest rated"]</option>
                        </select>
                        <i class="bi bi-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-stone-400 pointer-events-none"></i>
                    </div>
                </div>
            </div>
            
            <!-- Mobile Filter Button -->
            <button onclick="openMobileFilters()" 
                    class="lg:hidden w-full mb-6 py-3.5 bg-white border border-stone-200 rounded-lg text-stone-700 font-medium flex items-center justify-center gap-2 hover:bg-stone-50 hover:border-stone-300 transition-all focus-ring"
                    aria-label="@Localizer["Open filters"]">
                <i class="bi bi-sliders" aria-hidden="true"></i> @Localizer["Filters"]
                @if (hasActiveFilters)
                {
                    <span class="w-6 h-6 bg-primary-600 text-white text-xs rounded-full flex items-center justify-center font-bold">
                        @{
                            var filterCount = 0;
                            if (selectedCategories.Any()) filterCount++;
                            if (!string.IsNullOrEmpty(ViewBag.City as string)) filterCount++;
                            if (ViewBag.MinPrice != null || ViewBag.MaxPrice != null) filterCount++;
                            if (!string.IsNullOrEmpty(ViewBag.MinRating?.ToString())) filterCount++;
                        }
                        @filterCount
                    </span>
                }
            </button>
            
            <!-- Mobile Filters Drawer -->
            <div id="mobileFiltersOverlay" class="fixed inset-0 bg-black/50 hidden lg:hidden" style="z-index: var(--z-modal-backdrop, 1100);" onclick="closeMobileFilters()"></div>
            <div id="mobileFiltersDrawer" class="fixed inset-y-0 right-0 w-full max-w-md bg-white shadow-2xl transform translate-x-full transition-transform duration-300 lg:hidden overflow-hidden flex flex-col rounded-lg" style="z-index: var(--z-modal, 1200);">
                <!-- Drawer Header -->
                <div class="flex items-center justify-between p-5 border-b border-stone-200 bg-stone-50">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-primary-100 flex items-center justify-center">
                            <i class="bi bi-sliders text-primary-600"></i>
                        </div>
                        <h3 class="font-bold text-lg text-stone-900">@Localizer["Filters"]</h3>
                    </div>
                    <button onclick="closeMobileFilters()"
                            class="w-10 h-10 rounded-lg hover:bg-stone-100 flex items-center justify-center transition-colors duration-150 touch-target focus-ring"
                            aria-label="@Localizer["Close filters"]">
                        <i class="bi bi-x-lg text-stone-500" aria-hidden="true"></i>
                    </button>
                </div>
                
                <!-- Drawer Content -->
                <div class="flex-1 overflow-y-auto">
                    <form asp-action="Index" method="get" id="mobileFilterForm" class="divide-y divide-stone-200">
                        <input type="hidden" name="search" value="@ViewBag.Search" />
                        
                        <!-- Category -->
                        <div class="p-5">
                            <h4 class="font-semibold text-stone-900 mb-3 flex items-center gap-2">
                                <i class="bi bi-grid-3x3-gap text-stone-400"></i> @Localizer["Category"]
                            </h4>
                            <div class="grid grid-cols-2 gap-2">
                                @foreach (var cat in categories)
                                {
                                    var isCatSelected = selectedCategories.Contains(cat);
                                    <label class="flex items-center gap-2 p-3 rounded-lg cursor-pointer transition-all @(isCatSelected ? "bg-primary-50 border-2 border-primary-500" : "bg-stone-50 border-2 border-transparent hover:bg-stone-100")">
                                        <input type="checkbox" name="category" value="@cat" class="sr-only" @(isCatSelected ? "checked" : "")>
                                        <span class="text-sm font-medium @(isCatSelected ? "text-primary-700" : "text-stone-600")">@Localizer[cat ?? "Other"]</span>
                                    </label>
                                }
                            </div>
                        </div>
                        
                        <!-- Price Range -->
                        <div class="p-5">
                            <h4 class="font-semibold text-stone-900 mb-3 flex items-center gap-2">
                                <i class="bi bi-currency-euro text-stone-400"></i> @Localizer["Price range"]
                            </h4>
                            <div class="flex items-center gap-3">
                                <div class="flex-1">
                                    <input type="number" name="minPrice" value="@(ViewBag.MinPrice)" placeholder="Min"
                                           class="w-full px-4 py-3 border border-stone-200 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                                </div>
                                <span class="text-stone-300">—</span>
                                <div class="flex-1">
                                    <input type="number" name="maxPrice" value="@(ViewBag.MaxPrice)" placeholder="Max"
                                           class="w-full px-4 py-3 border border-stone-200 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                                </div>
                            </div>
                        </div>
                        
                        <!-- Rating -->
                        <div class="p-5">
                            <h4 class="font-semibold text-stone-900 mb-3 flex items-center gap-2">
                                <i class="bi bi-star text-stone-400"></i> @Localizer["Minimum rating"]
                            </h4>
                            <div class="flex gap-2">
                                @for (int rating = 1; rating <= 5; rating++)
                                {
                                    var isMobileRatingSelected = ViewBag.MinRating?.ToString() == rating.ToString();
                                    <label class="flex-1 flex flex-col items-center gap-1 p-3 rounded-lg cursor-pointer transition-all @(isMobileRatingSelected ? "bg-amber-50 border-2 border-amber-400" : "bg-stone-50 border-2 border-transparent hover:bg-stone-100")">
                                        <input type="radio" name="minRating" value="@rating" class="sr-only" @(isMobileRatingSelected ? "checked" : "")>
                                        <i class="bi bi-star-fill text-amber-400"></i>
                                        <span class="text-xs font-medium @(isMobileRatingSelected ? "text-amber-700" : "text-stone-500")">@rating+</span>
                                    </label>
                                }
                            </div>
                        </div>
                        
                        <!-- City -->
                        <div class="p-5">
                            <h4 class="font-semibold text-stone-900 mb-3 flex items-center gap-2">
                                <i class="bi bi-geo-alt text-stone-400"></i> @Localizer["City"]
                            </h4>
                            <select name="city" class="w-full px-4 py-3 border border-stone-200 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-white">
                                <option value="">@Localizer["All cities"]</option>
                                @foreach (var city in cities)
                                {
                                    var isMobileCitySelected = ViewBag.City == city;
                                    <option value="@city" selected="@isMobileCitySelected">@city</option>
                                }
                            </select>
                        </div>
                    </form>
                </div>
                
                <!-- Drawer Footer -->
                <div class="p-5 border-t border-stone-200 bg-white space-y-3">
                    <button type="submit" form="mobileFilterForm" class="w-full py-3.5 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-lg shadow-sm transition-colors duration-150">
                        @Localizer["Apply Filters"]
                    </button>
                    @if (hasActiveFilters)
                    {
                        <a asp-action="Index" class="block w-full py-3 text-center text-red-500 font-medium hover:bg-red-50 rounded-lg transition-colors duration-150">
                            @Localizer["Clear all filters"]
                        </a>
                    }
                </div>
            </div>
            
            <!-- Results Grid -->
            @if (Model.Any())
            {
                <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-6">
                    @foreach (var item in Model)
                    {
                        <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="group">
                            <div class="bg-white rounded-lg overflow-hidden border border-stone-200 h-full flex flex-col hover:shadow-md transition-shadow duration-150">
                                <!-- Image Container -->
                                <div class="aspect-[4/3] relative overflow-hidden">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Title"
                                             class="w-full h-full object-cover">
                                    }
                                    else
                                    {
                                        <div class="w-full h-full bg-stone-100 flex items-center justify-center">
                                            <i class="bi bi-image text-5xl text-stone-300"></i>
                                        </div>
                                    }

                                    <!-- Favorite Button -->
                                    <div class="absolute top-3 right-3">
                                        @await Html.PartialAsync("_FavoriteButton", new RentMate.Models.ViewModels.FavoriteButtonViewModel {
                                            ItemId = item.Id,
                                            IsFavorited = item.FavoritedBy?.Any(f => f.AccountId == ViewBag.CurrentUserId) ?? false
                                        })
                                    </div>

                                    <!-- Category Badge -->
                                    @if (!string.IsNullOrEmpty(item.Category))
                                    {
                                        <div class="absolute top-3 left-3 px-3 py-1 bg-white rounded-lg text-xs font-bold text-primary-600 shadow-sm">
                                            @Localizer[item.Category ?? "Uncategorized"]
                                        </div>
                                    }

                                    <!-- Rating Badge -->
                                    @if (item.AverageRating.HasValue)
                                    {
                                        <div class="absolute flex items-center gap-1.5 px-2.5 py-1 bg-white rounded-lg text-sm font-semibold shadow-sm" style="bottom: clamp(8px, 2vw, 12px); left: clamp(8px, 2vw, 12px);">
                                            <i class="bi bi-star-fill text-amber-400" aria-hidden="true"></i>
                                            <span class="text-stone-800">@item.AverageRating.Value.ToString("0.0")</span>
                                            <span class="text-stone-400">(@item.ReviewCount)</span>
                                        </div>
                                    }
                                </div>

                                <!-- Content -->
                                <div class="p-5 flex flex-col flex-1">
                                    <h3 class="font-semibold text-lg text-stone-900 group-hover:text-primary-600 transition-colors duration-150 mb-2 line-clamp-1">
                                        @item.Title
                                    </h3>

                                    @if (!string.IsNullOrEmpty(item.Location))
                                    {
                                        <p class="text-sm text-stone-500 flex items-center gap-1.5 mb-3">
                                            <i class="bi bi-geo-alt text-primary-500"></i>
                                            @item.Location
                                        </p>
                                    }

                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <p class="text-sm text-stone-600 line-clamp-2 mb-4 flex-1">
                                            @item.Description
                                        </p>
                                    }

                                    <!-- Price & Owner -->
                                    <div class="flex items-end justify-between mt-auto pt-4 border-t border-stone-200">
                                        <div>
                                            <div class="flex items-baseline gap-1">
                                                <span class="text-2xl font-bold text-stone-900">@CurrencyService.Format(item.Price)</span>
                                                <span class="text-stone-500 text-xs font-medium lowercase">/ @Localizer["day"]</span>
                                            </div>
                                            @if (item.DepositAmount > 0)
                                            {
                                                <div class="flex items-center gap-1.5 mt-1.5 px-2 py-0.5 bg-emerald-50 text-emerald-700 rounded-md border border-emerald-100 w-fit" title="@Localizer["Security deposit (refundable)"]">
                                                    <i class="bi bi-shield-check text-[10px]"></i>
                                                    <span class="text-[9px] font-bold uppercase tracking-wider">@Localizer["Deposit"]: @CurrencyService.Format(item.DepositAmount.Value)</span>
                                                </div>
                                            }
                                        </div>
                                        @if (item.User != null)
                                        {
                                            <div class="flex items-center gap-2">
                                                @if (!string.IsNullOrEmpty(item.User.ProfilePictureUrl))
                                                {
                                                    <img src="@item.User.ProfilePictureUrl"
                                                         alt="@(item.User.FirstName ?? item.User.UserName)"
                                                         class="w-8 h-8 rounded-full object-cover ring-2 ring-white shadow-sm" />
                                                }
                                                else
                                                {
                                                    <div class="w-8 h-8 rounded-full bg-primary-500 flex items-center justify-center text-white text-xs font-bold">
                                                        @(item.User.UserName?.Substring(0, 1).ToUpper() ?? "?")
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-20">
                    <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-stone-100 flex items-center justify-center">
                        <i class="bi bi-search text-4xl text-stone-400"></i>
                    </div>
                    <h3 class="font-sans text-xl font-bold text-stone-900 mb-2">@Localizer["No items found"]</h3>
                    <p class="text-stone-500 mb-6">@Localizer["Try adjusting your filters or search terms"]</p>
                    <a asp-action="Index" class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-full transition-colors">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        @Localizer["Clear all filters"]
                    </a>
                </div>
            }
            
            <!-- Pagination placeholder -->
            @if (ViewBag.TotalPages > 1)
            {
                <div class="flex justify-center mt-10">
                    <nav class="flex items-center gap-2">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            var isActive = i == (ViewBag.CurrentPage ?? 1);
                            <a asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-category="@selectedCategories" asp-route-city="@ViewBag.City"
                               class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-medium transition-colors @(isActive ? "bg-primary-600 text-white" : "bg-white border border-stone-200 text-stone-700 hover:bg-stone-50")">
                                @i
                            </a>
                        }
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .scrollbar-thin::-webkit-scrollbar {
        width: 6px;
    }
    .scrollbar-thin::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 3px;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }
    details summary::-webkit-details-marker {
        display: none;
    }
</style>

@section Scripts {
    <script>
        // Mobile filter drawer
        function openMobileFilters() {
            document.getElementById('mobileFiltersOverlay').classList.remove('hidden');
            document.getElementById('mobileFiltersDrawer').classList.remove('translate-x-full');
            document.body.style.overflow = 'hidden';
        }
        
        function closeMobileFilters() {
            document.getElementById('mobileFiltersOverlay').classList.add('hidden');
            document.getElementById('mobileFiltersDrawer').classList.add('translate-x-full');
            document.body.style.overflow = '';
        }
        
        // City search filter
        const citySearch = document.getElementById('citySearch');
        if (citySearch) {
            citySearch.addEventListener('input', function(e) {
                const query = e.target.value.toLowerCase();
                document.querySelectorAll('.city-option').forEach(function(option) {
                    const city = option.dataset.city;
                    option.style.display = city.includes(query) ? '' : 'none';
                });
            });
        }
        
        // Price range slider
        const minSlider = document.getElementById('minPriceSlider');
        const maxSlider = document.getElementById('maxPriceSlider');
        const minInput = document.getElementById('minPriceInput');
        const maxInput = document.getElementById('maxPriceInput');
        const minDisplay = document.getElementById('minPriceDisplay');
        const maxDisplay = document.getElementById('maxPriceDisplay');
        const priceTrack = document.getElementById('priceTrack');
        const currencySymbol = '@Html.Raw(currency.Symbol)';
        
        if (minSlider && maxSlider) {
            const maxValue = parseInt(maxSlider.max);
            
            function updatePriceRange() {
                let minVal = parseInt(minSlider.value);
                let maxVal = parseInt(maxSlider.value);
                
                if (minVal > maxVal) {
                    [minVal, maxVal] = [maxVal, minVal];
                }
                
                minDisplay.textContent = currencySymbol + minVal;
                maxDisplay.textContent = currencySymbol + maxVal;
                minInput.value = minVal > 0 ? minVal : '';
                maxInput.value = maxVal < maxValue ? maxVal : '';
                
                const minPercent = (minVal / maxValue) * 100;
                const maxPercent = (maxVal / maxValue) * 100;
                priceTrack.style.left = minPercent + '%';
                priceTrack.style.right = (100 - maxPercent) + '%';
            }
            
            minSlider.addEventListener('input', updatePriceRange);
            maxSlider.addEventListener('input', updatePriceRange);
            
            // Initialize
            updatePriceRange();
        }
        
        function setPriceRange(min, max) {
            if (minSlider && maxSlider) {
                minSlider.value = min;
                maxSlider.value = max;
                minSlider.dispatchEvent(new Event('input'));
                maxSlider.dispatchEvent(new Event('input'));
            }
        }
        
        // Close mobile filters on escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeMobileFilters();
            }
        });

        // Initialize Flatpickr date range picker for marketplace
        // Helper function to format date as yyyy-MM-dd in local timezone
        function formatLocalDate(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        // SmartCalendar is now used instead of Flatpickr for marketplace date selection
        
        function toggleClearButton(input) {
            const clearBtn = document.getElementById('mktSearchClear');
            if (input.value.length > 0) {
                clearBtn.classList.remove('opacity-0', 'invisible');
                clearBtn.classList.add('opacity-100', 'visible');
            } else {
                clearBtn.classList.add('opacity-0', 'invisible');
                clearBtn.classList.remove('opacity-100', 'visible');
            }
        }

        function clearSearchInput() {
            const input = document.getElementById('mktSearch');
            input.value = '';
            input.focus();
            toggleClearButton(input);
        }

        // Initialize clear button
        document.addEventListener('DOMContentLoaded', () => {
            const input = document.getElementById('mktSearch');
            if (input) toggleClearButton(input);
        });
    </script>
}


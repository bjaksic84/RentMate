@model RentMate.Models.Rental
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject RentMate.Services.CurrencyService CurrencyService

@{
    ViewData["Title"] = Localizer["Rental Details"];
    var statusColor = Model.Status.ToString() switch
    {
        "Active" => "success",
        "Pending" => "warning",
        "Completed" => "secondary",
        "Cancelled" => "danger",
        _ => "primary"
    };
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-@statusColor text-white text-center py-3">
                    <h5 class="mb-0 text-uppercase ls-1">@Localizer[Model.Status.ToString()]</h5> 
                </div>
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold">@Model.Item.Title</h2> 
                        <p class="text-muted">@Localizer["Rental ID"]: #@Model.Id</p>
                    </div>

                    <div class="row mb-3 border-bottom pb-3">
                        <div class="col-6">
                            <small class="text-muted text-uppercase">@Localizer["Renter"]</small>
                            <p class="fw-bold mb-0">@Model.Renter.Email</p> 
                        </div>
                        <div class="col-6 text-end">
                            <small class="text-muted text-uppercase">@Localizer["Price"]</small>
                            <p class="fw-bold mb-0 text-success">@CurrencyService.Format(Model.TotalPrice)</p>
                        </div>
                    </div>

                    <div class="row text-center mb-4">
                        <div class="col-5">
                            <div class="p-2 bg-light rounded">
                                <small class="d-block text-muted">@Localizer["From"]</small>
                                <strong>@Model.StartDate.ToString("dd. MM. yyyy")</strong> 
                            </div>
                        </div>
                        <div class="col-2 align-self-center">
                            <i class="bi bi-arrow-right text-muted"></i>
                        </div>
                        <div class="col-5">
                            <div class="p-2 bg-light rounded">
                                <small class="d-block text-muted">@Localizer["To"]</small>
                                <strong>@Model.EndDate.ToString("dd. MM. yyyy")</strong>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">@Localizer["Edit data"]</a>
                        <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Back to rentals"]</a> 
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@model RentMate.Models.Domain.Rental
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService

@{
    ViewData["Title"] = Localizer["Rental Details"];
    var statusType = Model.Status.ToString().ToLower();
    var statusBorderClass = Model.Status.ToString() switch
    {
        "Active" => "bg-green-100 border-green-200",
        "Pending" => "bg-amber-100 border-amber-200",
        "Completed" => "bg-stone-100 border-stone-200",
        "Cancelled" => "bg-red-100 border-red-200",
        _ => "bg-primary-100 border-primary-200"
    };
    var days = (Model.EndDate - Model.StartDate).Days + 1;
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        @await Html.PartialAsync("_BackLink", new { Controller = "Rentals", Action = "MyRentals", Text = Localizer["Back to My Rentals"].Value })
    </div>

    <div class="bg-white rounded-lg border border-stone-200 overflow-hidden">
        <!-- Status Header -->
        <div class="@statusBorderClass border-b px-6 py-4 text-center">
            @await Html.PartialAsync("_StatusBadge", new { Type = statusType, Text = Localizer[Model.Status.ToString()].Value })
        </div>

        <div class="p-6">
            <!-- Item Info -->
            <div class="flex gap-4 items-start mb-6">
                @await Html.PartialAsync("_ItemThumbnail", new { ImageUrl = Model.Item?.ImageUrl, Size = "thumb", Alt = Model.Item?.Title, CssClass = "w-20 h-20 rounded-lg shrink-0" })
                <div class="flex-1 min-w-0">
                    <h1 class="text-2xl font-bold text-stone-900">@Model.Item?.Title</h1>
                    <p class="text-stone-400 text-sm mt-1">@Localizer["Rental ID"]: #@Model.Id</p>
                </div>
            </div>

            <!-- Details Grid -->
            <div class="grid sm:grid-cols-2 gap-4 mb-6">
                <div class="bg-stone-50 rounded-lg p-4">
                    <p class="text-xs text-stone-400 uppercase tracking-wide mb-1">@Localizer["Renter"]</p>
                    <p class="font-semibold text-stone-900">@Model.Renter?.Email</p>
                </div>
                <div class="bg-stone-50 rounded-lg p-4">
                    <p class="text-xs text-stone-400 uppercase tracking-wide mb-1">@Localizer["Total Price"]</p>
                    <p class="font-semibold text-green-600 text-lg">@CurrencyService.Format(Model.TotalPrice)</p>
                </div>
            </div>

            <!-- Date Range -->
            <div class="flex items-center justify-between py-4 px-6 bg-stone-50 rounded-lg mb-6">
                <div class="text-center">
                    <p class="text-xs text-stone-400 uppercase tracking-wide">@Localizer["From"]</p>
                    <p class="font-bold text-stone-900 text-lg">@Model.StartDate.ToString("dd MMM yyyy")</p>
                </div>
                <div class="flex flex-col items-center">
                    <div class="w-12 h-0.5 bg-stone-200"></div>
                    <span class="text-xs text-stone-400 mt-1">@days @Localizer["days"]</span>
                </div>
                <div class="text-center">
                    <p class="text-xs text-stone-400 uppercase tracking-wide">@Localizer["To"]</p>
                    <p class="font-bold text-stone-900 text-lg">@Model.EndDate.ToString("dd MMM yyyy")</p>
                </div>
            </div>

            <!-- Owner Contact -->
            @if(Model.Item?.User != null)
            {
                <div class="border border-stone-200 rounded-lg p-4 mb-6">
                    <p class="text-xs text-stone-400 uppercase tracking-wide mb-3">@Localizer["Item Owner"]</p>
                    <div class="flex items-center gap-3">
                        <img src="@(Model.Item.User.ProfilePictureUrl ?? "https://via.placeholder.com/40")" class="w-10 h-10 rounded-full object-cover" />
                        <div>
                            <p class="font-semibold text-stone-900">@Model.Item.User.FirstName @Model.Item.User.LastName</p>
                            <p class="text-sm text-stone-500">@Model.Item.User.Email</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Actions -->
        <div class="px-6 py-4 bg-stone-50 border-t border-stone-200 flex flex-col sm:flex-row gap-3">
            <a asp-controller="Items" asp-action="Details" asp-route-id="@Model.ItemId" class="flex-1 py-3 text-center border border-stone-200 bg-white text-stone-600 rounded-lg font-medium hover:bg-stone-50 transition-colors duration-150">
                @Localizer["View Item"]
            </a>
            <a asp-controller="Rentals" asp-action="MyRentals" class="flex-1 py-3 text-center bg-primary-600 text-white rounded-lg font-semibold hover:bg-primary-700 transition-colors duration-150">
                @Localizer["Back to rentals"]
            </a>
        </div>
    </div>
</div>

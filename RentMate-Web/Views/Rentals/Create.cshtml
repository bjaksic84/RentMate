@model RentMate.Models.Rental
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Create Rental"];
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-slate-500 hover:text-blue-600 transition-colors mb-4">
            <i class="bi bi-arrow-left"></i>
            @Localizer["Back to List"]
        </a>
        <h1 class="font-heading text-3xl font-bold text-slate-900">@Localizer["Create Rental"]</h1>
        <p class="text-slate-500 mt-1">@Localizer["Set up a new rental agreement"]</p>
    </div>

    <form asp-action="Create" class="space-y-6">
        <div asp-validation-summary="ModelOnly" class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-600 text-sm"></div>
        
        <div class="bg-white rounded-2xl border border-slate-200 p-6 space-y-5">
            <div>
                <label asp-for="ItemId" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Item"]</label>
                <select asp-for="ItemId" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors bg-white" asp-items="ViewBag.ItemId">
                    <option value="">-- @Localizer["Select item"] --</option>
                </select>
                <span asp-validation-for="ItemId" class="text-red-500 text-sm mt-1"></span>
            </div>
            
            <div>
                <label asp-for="RenterId" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Renter"]</label>
                <select asp-for="RenterId" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors bg-white" asp-items="ViewBag.RenterId">
                    <option value="">-- @Localizer["Select renter"] --</option>
                </select>
                <span asp-validation-for="RenterId" class="text-red-500 text-sm mt-1"></span>
            </div>
            
            <div class="grid sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="StartDate" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Start Date"]</label>
                    <input asp-for="StartDate" type="date" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
                    <span asp-validation-for="StartDate" class="text-red-500 text-sm mt-1"></span>
                </div>
                <div>
                    <label asp-for="EndDate" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["End Date"]</label>
                    <input asp-for="EndDate" type="date" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
                    <span asp-validation-for="EndDate" class="text-red-500 text-sm mt-1"></span>
                </div>
            </div>
            
            <div>
                <label asp-for="Status" class="block text-sm font-medium text-slate-700 mb-1">@Localizer["Status"]</label>
                <select asp-for="Status" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors bg-white" asp-items="Html.GetEnumSelectList<RentMate.Shared.Contracts.Responses.RentalStatus>()">
                    <option value="">-- @Localizer["Select status"] --</option>
                </select>
                <span asp-validation-for="Status" class="text-red-500 text-sm mt-1"></span>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 justify-end">
            <a asp-action="Index" class="px-6 py-3 border border-slate-200 rounded-xl text-slate-600 hover:bg-slate-50 transition-colors text-center font-medium">
                @Localizer["Cancel"]
            </a>
            <button type="submit" class="px-8 py-3 bg-gradient-to-r from-blue-600 to-blue-500 text-white rounded-xl font-semibold hover:shadow-md transition-all">
                @Localizer["Create"]
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model RentMate.Models.Domain.Rental
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Edit Rental"];
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        @await Html.PartialAsync("_BackLink", new { Controller = "Rentals", Action = "Index", Text = Localizer["Back to List"].Value })
        <h1 class="text-3xl font-bold text-stone-900">@Localizer["Edit Rental"]</h1>
        <p class="text-stone-500 mt-1">@Localizer["Update rental information"]</p>
    </div>

    <form asp-action="Edit" class="space-y-6">
        <div asp-validation-summary="ModelOnly" class="p-4 bg-red-50 border border-red-200 rounded-lg text-red-600 text-sm"></div>
        <input type="hidden" asp-for="Id" />
        
        <div class="bg-white rounded-lg border border-stone-200 p-6 space-y-5">
            <div>
                <label asp-for="ItemId" class="block text-sm font-medium text-stone-700 mb-1">@Localizer["Item"]</label>
                <select asp-for="ItemId" class="w-full px-4 py-3 border border-stone-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors bg-white" asp-items="ViewBag.ItemId"></select>
                <span asp-validation-for="ItemId" class="text-red-500 text-sm mt-1"></span>
            </div>
            
            <div>
                <label asp-for="RenterId" class="block text-sm font-medium text-stone-700 mb-1">@Localizer["Renter"]</label>
                <select asp-for="RenterId" class="w-full px-4 py-3 border border-stone-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors bg-white" asp-items="ViewBag.RenterId"></select>
                <span asp-validation-for="RenterId" class="text-red-500 text-sm mt-1"></span>
            </div>
            
            <div class="grid sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="StartDate" class="block text-sm font-medium text-stone-700 mb-1">@Localizer["Start Date"]</label>
                    <input asp-for="StartDate" type="date" class="w-full px-4 py-3 border border-stone-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors" />
                    <span asp-validation-for="StartDate" class="text-red-500 text-sm mt-1"></span>
                </div>
                <div>
                    <label asp-for="EndDate" class="block text-sm font-medium text-stone-700 mb-1">@Localizer["End Date"]</label>
                    <input asp-for="EndDate" type="date" class="w-full px-4 py-3 border border-stone-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors" />
                    <span asp-validation-for="EndDate" class="text-red-500 text-sm mt-1"></span>
                </div>
            </div>
            
            <div>
                <label asp-for="Status" class="block text-sm font-medium text-stone-700 mb-1">@Localizer["Status"]</label>
                <select asp-for="Status" class="w-full px-4 py-3 border border-stone-200 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors bg-white" asp-items="Html.GetEnumSelectList<RentMate.Shared.Contracts.Responses.RentalStatus>()"></select>
                <span asp-validation-for="Status" class="text-red-500 text-sm mt-1"></span>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 justify-end">
            <a asp-action="Index" class="px-6 py-3 border border-stone-200 rounded-lg text-stone-600 hover:bg-stone-50 transition-colors duration-150 text-center font-medium">
                @Localizer["Cancel"]
            </a>
            <button type="submit" class="px-8 py-3 bg-primary-600 text-white rounded-lg font-semibold hover:bg-primary-700 transition-colors duration-150">
                @Localizer["Save"]
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model RentMate.Models.Domain.Rental
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService

@{
    ViewData["Title"] = Localizer["Cancel Rental"];
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        @await Html.PartialAsync("_BackLink", new { Controller = "Rentals", Action = "MyRentals", Text = Localizer["Back to My Rentals"].Value })
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
        <!-- Warning Header -->
        <div class="bg-red-50 border-b border-red-100 px-6 py-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center">
                    <i class="bi bi-exclamation-triangle text-red-600 text-lg"></i>
                </div>
                <div>
                    <h1 class="font-heading text-xl font-bold text-red-900">@Localizer["Cancel Rental"]</h1>
                    <p class="text-red-600 text-sm">@Localizer["Are you sure you want to cancel this rental?"]</p>
                </div>
            </div>
        </div>

        <div class="p-6">
            <!-- Rental Info -->
            <div class="space-y-4">
                <div class="flex gap-4 items-start">
                    @if(!string.IsNullOrEmpty(Model.Item?.PrimaryImageUrl)) {
                        <img src="@Model.Item.PrimaryImageUrl" class="w-20 h-20 rounded-xl object-cover shrink-0" />
                    } else {
                        <div class="w-20 h-20 rounded-xl bg-slate-100 flex items-center justify-center shrink-0">
                            <i class="bi bi-image text-slate-300 text-xl"></i>
                        </div>
                    }
                    <div>
                        <h2 class="font-heading text-xl font-bold text-slate-900">@Model.Item?.Title</h2>
                        <p class="text-slate-500 text-sm mt-1">@Localizer["Renter"]: @Model.Renter?.Email</p>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-slate-50 rounded-xl p-4">
                        <p class="text-xs text-slate-400 uppercase tracking-wide mb-1">@Localizer["Start Date"]</p>
                        <p class="font-semibold text-slate-900">@Model.StartDate.ToString("dd MMM yyyy")</p>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-4">
                        <p class="text-xs text-slate-400 uppercase tracking-wide mb-1">@Localizer["End Date"]</p>
                        <p class="font-semibold text-slate-900">@Model.EndDate.ToString("dd MMM yyyy")</p>
                    </div>
                </div>

                <div class="bg-slate-50 rounded-xl p-4">
                    <p class="text-xs text-slate-400 uppercase tracking-wide mb-1">@Localizer["Status"]</p>
                    <p class="font-semibold text-slate-900">@Localizer[Model.Status.ToString()]</p>
                </div>
            </div>

            <div class="mt-6 p-4 bg-amber-50 border border-amber-200 rounded-xl">
                <div class="flex items-start gap-3">
                    <i class="bi bi-info-circle text-amber-600 mt-0.5"></i>
                    <p class="text-sm text-amber-700">
                        @Localizer["Cancelling this rental will notify the owner. Depending on the cancellation policy, you may be eligible for a refund."]
                    </p>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row gap-3 justify-end">
            <a asp-controller="Rentals" asp-action="MyRentals" class="px-6 py-3 border border-slate-200 bg-white rounded-xl text-slate-600 hover:bg-slate-50 transition-colors text-center font-medium">
                @Localizer["Keep Rental"]
            </a>
            <form asp-action="Delete" class="inline">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="w-full sm:w-auto px-6 py-3 bg-red-600 text-white rounded-xl font-semibold hover:bg-red-700 transition-colors flex items-center justify-center gap-2">
                    <i class="bi bi-x-circle"></i>
                    @Localizer["Cancel Rental"]
                </button>
            </form>
        </div>
    </div>
</div>

@model IEnumerable<RentMate.Models.Rental>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["My Rentals"];
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>📦 @Localizer["My Rentals"]</h1>
        <a asp-action="Index" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-lg"></i> @Localizer["New Rental"]
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <h3 class="text-muted">@Localizer["You currently have no rentals."]</h3>
            <p>@Localizer["Start by renting an item!"]</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rental-card">
                        <div class="card-header bg-white border-0 pt-3">
                            @{
                                var statusColor = item.Status.ToString() switch
                                {
                                    "Active" => "success",   
                                    "Pending" => "warning",  
                                    "Completed" => "secondary",
                                    "Cancelled" => "danger",
                                    _ => "primary"
                                };
                            }
                            <span class="badge bg-@statusColor rounded-pill float-end">
                                @Localizer[item.Status.ToString()]
                            </span>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-dark">
                                @item.Item?.Title
                            </h5>
                            <p class="card-text text-muted small">
                                <i class="bi bi-person"></i> @item.Renter?.Email
                            </p>
                            
                            <hr class="my-2 opacity-25">

                            <div class="d-flex justify-content-between mt-3">
                                <div>
                                    <small class="text-muted d-block">@Localizer["Start"]</small>
                                    <strong>@item.StartDate.ToString("dd. MMM")</strong>
                                </div>
                                <div class="text-end">
                                    <small class="text-muted d-block">@Localizer["End"]</small>
                                    <strong>@item.EndDate.ToString("dd. MMM")</strong>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0 pb-3">
                            <div class="d-grid gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                    @Localizer["Details"]
                                </a>
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-sm text-muted">@Localizer["Edit"]</a> 
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-light btn-sm text-danger">@Localizer["Cancel"]</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .rental-card {
        transition: transform 0.2s;
    }
    .rental-card:hover {
        transform: translateY(-5px);
    }
</style>
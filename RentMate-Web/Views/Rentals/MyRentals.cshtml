@model IEnumerable<RentMate.Models.Rental>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject RentMate.Services.ICurrencyService CurrencyService

@{
    ViewData["Title"] = Localizer["My Rentals"];
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    @await Html.PartialAsync("_PageHeader", new { 
        Title = Localizer["My Rentals"].Value, 
        Subtitle = Localizer["Track your rental history"].Value, 
        ActionController = "Rentals", 
        ActionAction = "Index", 
        ActionText = Localizer["Browse Items"].Value, 
        ActionIcon = "bi-plus-lg" 
    })

    @if (!Model.Any())
    {
        @await Html.PartialAsync("_EmptyState", new { 
            Icon = "bi-box-seam", 
            Message = Localizer["No rentals yet"].Value, 
            ActionController = "Rentals", 
            ActionAction = "Index", 
            ActionText = Localizer["Explore Items"].Value 
        })
    }
    else
    {
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var rental in Model)
            {
                var statusType = rental.Status.ToString().ToLower();
                
                <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
                    <!-- Item Image -->
                    <div class="relative h-40 overflow-hidden">
                        @await Html.PartialAsync("_ItemThumbnail", new { ImageUrl = rental.Item?.ImageUrl, Size = "sm", Alt = rental.Item?.Title })
                        
                        <!-- Status Badge -->
                        <div class="absolute top-3 right-3">
                            @await Html.PartialAsync("_StatusBadge", new { Type = statusType, Text = Localizer[rental.Status.ToString()].Value })
                        </div>
                    </div>
                    
                    <!-- Content -->
                    <div class="p-5">
                        <h3 class="font-heading text-lg font-bold text-slate-900 truncate">@rental.Item?.Title</h3>
                        
                        <!-- Date Range -->
                        <div class="flex items-center justify-between mt-4 py-3 px-4 bg-slate-50 rounded-xl">
                            <div class="text-center">
                                <p class="text-xs text-slate-400 uppercase tracking-wide">@Localizer["Start"]</p>
                                <p class="font-semibold text-slate-900">@rental.StartDate.ToString("dd MMM")</p>
                            </div>
                            <i class="bi bi-arrow-right text-slate-300"></i>
                            <div class="text-center">
                                <p class="text-xs text-slate-400 uppercase tracking-wide">@Localizer["End"]</p>
                                <p class="font-semibold text-slate-900">@rental.EndDate.ToString("dd MMM")</p>
                            </div>
                        </div>
                        
                        <!-- Price -->
                        <div class="flex items-center justify-between mt-4">
                            <span class="text-slate-500 text-sm">@Localizer["Total"]</span>
                            <span class="text-lg font-bold text-green-600">@CurrencyService.Format(rental.TotalPrice)</span>
                        </div>
                    </div>
                    
                    <!-- Actions -->
                    <div class="px-5 pb-5 pt-0 space-y-2">
                        <a asp-action="Details" asp-route-id="@rental.Id" class="block w-full py-2.5 text-center border border-blue-600 text-blue-600 rounded-xl font-medium hover:bg-blue-50 transition-colors">
                            @Localizer["View Details"]
                        </a>
                        @if(rental.Status.ToString() == "Pending" || rental.Status.ToString() == "Active")
                        {
                            <a asp-action="Delete" asp-route-id="@rental.Id" class="block w-full py-2.5 text-center border border-red-200 text-red-600 rounded-xl font-medium hover:bg-red-50 transition-colors">
                                @Localizer["Cancel Rental"]
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

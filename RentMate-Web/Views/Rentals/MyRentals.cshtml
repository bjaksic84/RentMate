@model IEnumerable<RentMate.Models.Domain.Rental>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService

@{
    ViewData["Title"] = Localizer["My Rentals"];
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    @await Html.PartialAsync("_PageHeader", new { 
        Title = Localizer["My Rentals"].Value, 
        Subtitle = Localizer["Track your rental history"].Value, 
        ActionController = "Rentals", 
        ActionAction = "Index", 
        ActionText = Localizer["Browse Items"].Value, 
        ActionIcon = "bi-plus-lg" 
    })

    @if (!Model.Any())
    {
        @await Html.PartialAsync("_EmptyState", new { 
            Icon = "bi-box-seam", 
            Message = Localizer["No rentals yet"].Value, 
            ActionController = "Rentals", 
            ActionAction = "Index", 
            ActionText = Localizer["Explore Items"].Value 
        })
    }
    else
    {
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var rental in Model)
            {
                var statusType = rental.Status.ToString().ToLower();
                
                <div class="bg-white rounded-lg border border-stone-200 overflow-hidden hover:shadow-md transition-shadow duration-150">
                    <!-- Item Image -->
                    <div class="relative h-40 overflow-hidden">
                        @await Html.PartialAsync("_ItemThumbnail", new { ImageUrl = rental.Item?.ImageUrl, Size = "sm", Alt = rental.Item?.Title })
                        
                        <!-- Status Badge -->
                        <div class="absolute top-3 right-3">
                            @await Html.PartialAsync("_StatusBadge", new { Type = statusType, Text = Localizer[rental.Status.ToString()].Value })
                        </div>
                    </div>
                    
                    <!-- Content -->
                    <div class="p-5">
                        <h3 class="text-lg font-bold text-stone-900 truncate">@rental.Item?.Title</h3>
                        
                        <!-- Date Range -->
                        <div class="flex items-center justify-between mt-4 py-3 px-4 bg-stone-50 rounded-lg">
                            <div class="text-center">
                                <p class="text-xs text-stone-400 uppercase tracking-wide">@Localizer["Start"]</p>
                                <p class="font-semibold text-stone-900">@rental.StartDate.ToString("dd MMM")</p>
                            </div>
                            <i class="bi bi-arrow-right text-stone-300"></i>
                            <div class="text-center">
                                <p class="text-xs text-stone-400 uppercase tracking-wide">@Localizer["End"]</p>
                                <p class="font-semibold text-stone-900">@rental.EndDate.ToString("dd MMM")</p>
                            </div>
                        </div>
                        
                        <!-- Price -->
                        <div class="flex items-center justify-between mt-4">
                            <span class="text-stone-500 text-sm">@Localizer["Total"]</span>
                            <span class="text-lg font-bold text-green-600">@CurrencyService.Format(rental.TotalPrice)</span>
                        </div>
                    </div>
                    
                    <!-- Actions -->
                    <div class="px-5 pb-5 pt-0 space-y-2">
                        <a asp-action="Details" asp-route-id="@rental.Id" class="block w-full py-2.5 text-center border border-primary-600 text-primary-600 rounded-lg font-medium hover:bg-primary-50 transition-colors duration-150">
                            @Localizer["View Details"]
                        </a>
                        @if(rental.Status.ToString() == "Accepted")
                        {
                            <a asp-controller="Payment" asp-action="Checkout" asp-route-rentalId="@rental.Id" class="block w-full py-2.5 text-center bg-primary-600 text-white rounded-lg font-medium hover:bg-primary-700 transition-colors duration-150">
                                @Localizer["Pay Now"]
                            </a>
                        }
                        @if(rental.Status.ToString() == "Pending" || rental.Status.ToString() == "Active")
                        {
                            <form asp-controller="Rentals" asp-action="CancelRental" method="post" class="block w-full">
                                <input type="hidden" name="rentalId" value="@rental.Id" />
                                <button class="block w-full py-2.5 text-center border border-red-200 text-red-600 rounded-lg font-medium hover:bg-red-50 transition-colors duration-150">
                                    @Localizer["Cancel Rental"]
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

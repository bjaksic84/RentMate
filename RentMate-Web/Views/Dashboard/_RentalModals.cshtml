        </div>
    </div>
</div>

<!-- Review Modal -->
<div id="reviewModal" class="fixed inset-0 hidden" style="z-index: var(--z-modal, 1200);">
    <div class="absolute inset-0 bg-black/50 " onclick="closeReviewModal()"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md" style="z-index: var(--z-modal, 1200);">
        <div class="bg-white dark:bg-ledger-800 rounded-lg shadow-lg m-4 overflow-hidden">
            <div class="bg-amber-500 px-6 py-4">
                <div class="flex items-center justify-between">
                    <h3 id="reviewModalTitle" class="text-white text-lg font-bold">@Localizer["Leave a Review"]</h3>
                    <button type="button" onclick="closeReviewModal()" class="text-white/80 hover:text-white"><i class="bi bi-x-lg"></i></button>
                </div>
            </div>
            <form id="reviewForm" class="p-6">
                <input type="hidden" id="reviewRentalId" name="rentalId" />
                <input type="hidden" id="reviewItemId" name="itemId" />
                <input type="hidden" id="reviewId" name="reviewId" />
                <div class="mb-5">
                    <label class="block text-sm font-medium text-ledger-700 dark:text-ledger-300 mb-2">@Localizer["Rating"]</label>
                    <div class="flex gap-2" id="starRating">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <button type="button" class="star-btn text-3xl text-ledger-300 hover:text-amber-400 transition-colors" data-rating="@i"><i class="bi bi-star-fill"></i></button>
                        }
                    </div>
                    <input type="hidden" id="ratingValue" name="rating" value="0" />
                </div>
                <div class="mb-5">
                    <label for="reviewTitle" class="block text-sm font-medium text-ledger-700 dark:text-ledger-300 mb-2">@Localizer["Title"] (@Localizer["optional"])</label>
                    <input type="text" id="reviewTitle" name="title" maxlength="100"
                           class="w-full px-4 py-3 border border-ledger-200 dark:border-neutral-600 dark:bg-neutral-700 dark:text-white rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-colors"
                           placeholder="@Localizer["Summarize your experience"]">
                </div>
                <div class="mb-5">
                    <label for="reviewBody" class="block text-sm font-medium text-ledger-700 dark:text-ledger-300 mb-2">@Localizer["Your Review"]</label>
                    <textarea id="reviewBody" name="body" rows="4" required
                              class="w-full px-4 py-3 border border-ledger-200 dark:border-neutral-600 dark:bg-neutral-700 dark:text-white rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-colors resize-none"
                              placeholder="@Localizer["Share your experience with this item..."]"></textarea>
                </div>
                <div class="mb-5">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="isAnonymous" name="isAnonymous" class="w-4 h-4 text-amber-500 border-ledger-300 rounded focus:ring-amber-500">
                        <span class="text-sm text-ledger-600 dark:text-ledger-400">@Localizer["Post anonymously"]</span>
                    </label>
                </div>
                <div class="flex gap-3">
                    <button type="button" onclick="closeReviewModal()" class="flex-1 px-4 py-3 border border-ledger-200 dark:border-neutral-600 text-ledger-600 dark:text-ledger-300 font-medium rounded-lg hover:bg-ledger-50 dark:hover:bg-neutral-700 transition-colors">@Localizer["Cancel"]</button>
                    <button type="submit" id="reviewSubmitBtn" class="flex-1 px-4 py-3 bg-amber-500 text-white font-semibold rounded-lg hover:shadow-md transition-colors duration-150">
                        <i class="bi bi-check-lg me-1"></i> <span id="reviewSubmitText">@Localizer["Submit Review"]</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

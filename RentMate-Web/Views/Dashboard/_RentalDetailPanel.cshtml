@*
    Rental Detail Slide-Over Panel

    Used by:
    - GET /Dashboard/RentalDetailPartial?rentalId=X (server-rendered partial refresh)

    Model: Rental (domain entity, eager-loaded with Item, Deposit+Evidence, Extensions, Accessories, Owner, Renter, Reviews)
    ViewData["CurrentUserId"] must be set by the controller.
*@
@using Microsoft.AspNetCore.Mvc.Localization
@using RentMate.Models.Domain
@using RentMate.Shared.Contracts.Responses
@inject IViewLocalizer Localizer
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService
@model RentMate.Models.Domain.Rental

@{
    var currentUserId = ViewData["CurrentUserId"] as string ?? "";
    var isRenter = Model.RenterId == currentUserId;
    var isOwner  = Model.OwnerId == currentUserId;
    var counterparty = isRenter ? Model.Owner : Model.Renter;
    var isOverdue = Model.Status == RentalStatus.Active && Model.EndDate.Date < DateTime.UtcNow.Date;
    var daysRemaining = (Model.EndDate.Date - DateTime.UtcNow.Date).Days;

    var activeExt = Model.Extensions
        .FirstOrDefault(e => e.Status == ExtensionStatus.Pending
                          || e.Status == ExtensionStatus.Accepted
                          || e.Status == ExtensionStatus.AutoApproved);

    var hasDeposit = Model.Deposit != null;
    var depositInDispute = hasDeposit &&
        (Model.Deposit!.Status == DepositStatus.Disputed ||
         Model.Deposit!.Status == DepositStatus.CounterOffered ||
         Model.Deposit!.Status == DepositStatus.Escalated);
    var evidenceJson = hasDeposit
        ? System.Text.Json.JsonSerializer.Serialize(
            Model.Deposit!.Evidence.Select(e => new { e.Url, e.Notes }).ToList())
        : "[]";

    var statusBadgeType = Model.Status switch {
        RentalStatus.Active    => isOverdue ? "overdue" : "active",
        RentalStatus.Pending   => "pending",
        RentalStatus.Accepted  => "warning",
        RentalStatus.Completed => "completed",
        RentalStatus.Cancelled => "cancelled",
        _                     => "default"
    };
    var statusText = Model.Status switch {
        RentalStatus.Active    => isOverdue ? "Overdue" : "Active",
        RentalStatus.Pending   => "Pending",
        RentalStatus.Accepted  => "Accepted",
        RentalStatus.Completed => "Completed",
        RentalStatus.Cancelled => "Cancelled",
        _                     => Model.Status.ToString()
    };

    var thumbUrl = !string.IsNullOrEmpty(Model.Item?.ImageUrl)
        ? Model.Item.ImageUrl.Replace("/upload/", "/upload/c_thumb,w_128,h_128,q_auto/")
        : "";

    string FormatDateRange(DateTime a, DateTime b) {
        var first = a <= b ? a : b;
        var second = a <= b ? b : a;
        return $"{first.ToString("dd MMM")} → {second.ToString("dd MMM yyyy")}";
    }
}

<!-- Panel Header -->
<div class="flex items-center gap-3 px-4 py-4 border-b border-ledger-100 dark:border-ledger-800 shrink-0">
    <div class="w-16 h-16 rounded-lg overflow-hidden bg-ledger-100 dark:bg-ledger-700 shrink-0">
        @if (!string.IsNullOrEmpty(thumbUrl))
        {
            <img src="@thumbUrl" alt="@Model.Item?.Title" class="w-full h-full object-cover" />
        }
        else
        {
            <div class="w-full h-full flex items-center justify-center">
                <i class="bi bi-image text-ledger-300 dark:text-ledger-600 text-2xl"></i>
            </div>
        }
    </div>
    <div class="flex-1 min-w-0">
        <p class="font-medium text-sm text-ledger-900 dark:text-white truncate">@Model.Item?.Title</p>
        @await Html.PartialAsync("_StatusBadge", new { Type = statusBadgeType, Text = statusText, SmallPadding = true })
    </div>
    <button type="button" onclick="closeRentalDetail()"
            class="p-2 rounded-lg text-ledger-400 hover:bg-ledger-100 dark:hover:bg-ledger-700 hover:text-ledger-600 dark:hover:text-ledger-300 transition-colors"
            aria-label="@Localizer["Close"]" id="panel-close-btn">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
    </button>
</div>

<!-- Section 1: Rental Info (always visible, always expanded) -->
<div class="px-4 py-4 border-b border-ledger-100 dark:border-ledger-800">
    <h3 class="text-xs font-semibold text-ledger-400 dark:text-ledger-500 uppercase tracking-wider mb-3">@Localizer["Rental Info"]</h3>
    <div class="space-y-2 text-sm">
        <div class="flex justify-between">
            <span class="text-ledger-500 dark:text-ledger-400">@Localizer["Parties"]</span>
            <span class="text-ledger-900 dark:text-white">
                <i class="bi bi-person text-ledger-300 dark:text-ledger-600 mr-1"></i>@(counterparty?.FirstName ?? counterparty?.Email ?? "")
                <span class="text-xs text-ledger-400 ml-1">(@(isRenter ? Localizer["Owner"] : Localizer["Renter"]))</span>
            </span>
        </div>
        <div class="flex justify-between">
            <span class="text-ledger-500 dark:text-ledger-400">@Localizer["Period"]</span>
            <span class="text-ledger-900 dark:text-white tabular-nums">@FormatDateRange(Model.StartDate, Model.EndDate)</span>
        </div>
        <div class="flex justify-between">
            <span class="text-ledger-500 dark:text-ledger-400">@Localizer["Daily Rate"]</span>
            <span class="text-ledger-900 dark:text-white tabular-nums">@CurrencyService.Format(Model.Item?.Price ?? 0)/@Localizer["day"]</span>
        </div>
        @if (Model.Accessories.Any())
        {
            <div class="flex justify-between">
                <span class="text-ledger-500 dark:text-ledger-400">@Localizer["Accessories"]</span>
                <span class="text-ledger-900 dark:text-white tabular-nums">
                    @foreach (var acc in Model.Accessories)
                    {
                        <span class="block text-xs">@acc.Name (+@CurrencyService.Format(acc.DailyPrice)/@Localizer["day"])</span>
                    }
                </span>
            </div>
        }
        @if (hasDeposit)
        {
            <div class="flex justify-between">
                <span class="text-ledger-500 dark:text-ledger-400">@Localizer["Deposit"]</span>
                <span class="text-ledger-900 dark:text-white tabular-nums">@CurrencyService.Format(Model.Deposit!.Amount)</span>
            </div>
        }
        <div class="flex justify-between font-medium border-t border-ledger-100 dark:border-ledger-800 pt-2">
            <span class="text-ledger-700 dark:text-ledger-300">@Localizer["Total"]</span>
            <span class="text-ledger-900 dark:text-white tabular-nums">@CurrencyService.Format(Model.TotalPrice)</span>
        </div>
    </div>
</div>

<!-- Section 2: Countdown (only if active) -->
@if (Model.Status == RentalStatus.Active)
{
    <div class="px-4 py-4 border-b border-ledger-100 dark:border-ledger-800">
        @{
            var urgency = daysRemaining <= 0 ? "overdue"
                        : daysRemaining <= 1 ? "urgent"
                        : daysRemaining <= 3 ? "warning"
                        : "normal";
        }
        @await Html.PartialAsync("_CountdownTimer", new { EndDate = Model.EndDate, DaysRemaining = daysRemaining, Urgency = urgency })
    </div>
}

<!-- Section 3: Deposit Status (only if deposit exists) -->
@if (hasDeposit)
{
    var dep = Model.Deposit!;
    var depIsResolved = dep.Status == DepositStatus.Released || dep.Status == DepositStatus.ChargeUpheld;
    var depAutoExpand = depositInDispute || dep.Status == DepositStatus.Authorized;
    var depCollapsed = depIsResolved && !depAutoExpand;

    <div class="panel-section border-b border-ledger-100 dark:border-ledger-800" data-section="deposit">
        @if (depCollapsed)
        {
            <button type="button" onclick="togglePanelSection(this)" class="w-full flex items-center justify-between px-4 py-3 hover:bg-ledger-50 dark:hover:bg-ledger-800/50 transition-colors">
                <span class="text-sm font-medium text-ledger-600 dark:text-ledger-400">@Localizer["Deposit"]</span>
                <span class="flex items-center gap-2">
                    <span class="text-xs text-ledger-400">@Localizer[dep.Status.ToString()]</span>
                    <i class="bi bi-chevron-right text-ledger-300 dark:text-ledger-600 text-xs transition-transform"></i>
                </span>
            </button>
        }
        <div class="@(depCollapsed ? "hidden px-4 pb-4" : "px-4 py-4")">
            <h3 class="text-xs font-semibold text-ledger-400 dark:text-ledger-500 uppercase tracking-wider mb-3">@Localizer["Deposit Status"]</h3>

            <!-- Timeline -->
            <div class="relative pl-6 space-y-3 text-sm">
                @{
                    var timelineSteps = new List<(string label, string date, bool isCurrent, string icon)>();
                    timelineSteps.Add(("Authorized", dep.AuthorizedAt?.ToString("dd MMM yyyy") ?? "", dep.Status == DepositStatus.Authorized, "bi-shield-check"));

                    if (dep.Status == DepositStatus.Released || dep.ReleasedAt.HasValue)
                        timelineSteps.Add(("Released", dep.ReleasedAt?.ToString("dd MMM yyyy") ?? "", dep.Status == DepositStatus.Released, "bi-check-circle"));
                    if (dep.ChargedAt.HasValue || dep.Status == DepositStatus.Charged || dep.Status == DepositStatus.PartiallyCharged)
                        timelineSteps.Add(("Charged", dep.ChargedAt?.ToString("dd MMM yyyy") ?? "", dep.Status == DepositStatus.Charged || dep.Status == DepositStatus.PartiallyCharged, "bi-exclamation-circle"));
                    if (dep.DisputedAt.HasValue || dep.Status == DepositStatus.Disputed)
                        timelineSteps.Add(("Disputed", dep.DisputedAt?.ToString("dd MMM yyyy") ?? "", dep.Status == DepositStatus.Disputed, "bi-shield-exclamation"));
                    if (dep.CounterOfferAt.HasValue || dep.Status == DepositStatus.CounterOffered)
                        timelineSteps.Add(("Counter-Offered", dep.CounterOfferAt?.ToString("dd MMM yyyy") ?? "", dep.Status == DepositStatus.CounterOffered, "bi-arrow-left-right"));
                    if (dep.EscalatedAt.HasValue || dep.Status == DepositStatus.Escalated)
                        timelineSteps.Add(("Escalated", dep.EscalatedAt?.ToString("dd MMM yyyy") ?? "", dep.Status == DepositStatus.Escalated, "bi-flag"));
                    if (dep.Status == DepositStatus.ChargeUpheld)
                        timelineSteps.Add(("Charge Upheld", dep.AdminResolvedAt?.ToString("dd MMM yyyy") ?? "", true, "bi-gavel"));
                }
                @foreach (var step in timelineSteps)
                {
                    var dotColor = step.isCurrent ? "bg-primary-500" : "bg-ledger-300 dark:bg-ledger-600";
                    var textWeight = step.isCurrent ? "font-medium text-ledger-900 dark:text-white" : "text-ledger-500 dark:text-ledger-400";
                    <div class="relative">
                        <span class="absolute -left-6 top-0.5 w-3 h-3 rounded-full @dotColor"></span>
                        <div class="flex justify-between items-baseline">
                            <span class="@textWeight">@Localizer[step.label]</span>
                            @if (!string.IsNullOrEmpty(step.date))
                            {
                                <span class="text-xs text-ledger-400 tabular-nums">@step.date</span>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Charge/dispute details -->
            @if ((dep.Status == DepositStatus.Charged || dep.Status == DepositStatus.PartiallyCharged ||
                  dep.Status == DepositStatus.Disputed || dep.Status == DepositStatus.CounterOffered ||
                  dep.Status == DepositStatus.Escalated || dep.Status == DepositStatus.ChargeUpheld) &&
                 dep.ChargedAmount.HasValue)
            {
                <div class="mt-3 p-3 bg-ledger-50 dark:bg-ledger-900/50 rounded-lg text-sm space-y-1">
                    <div class="flex justify-between">
                        <span class="text-ledger-500 dark:text-ledger-400">@Localizer["Charged Amount"]</span>
                        <span class="font-medium text-ledger-900 dark:text-white tabular-nums">@CurrencyService.Format(dep.ChargedAmount.Value)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(dep.ChargeReason))
                    {
                        <div>
                            <span class="text-ledger-500 dark:text-ledger-400">@Localizer["Reason"]:</span>
                            <span class="text-ledger-700 dark:text-ledger-300">@dep.ChargeReason</span>
                        </div>
                    }
                </div>
            }
            @if (dep.Status == DepositStatus.Disputed && !string.IsNullOrEmpty(dep.DisputeReason))
            {
                <div class="mt-3 p-3 bg-rose-50 dark:bg-rose-900/10 rounded-lg text-sm">
                    <span class="text-rose-700 dark:text-rose-400 font-medium">@Localizer["Dispute Reason"]:</span>
                    <span class="text-rose-600 dark:text-rose-300">@dep.DisputeReason</span>
                </div>
            }
            @if (dep.Status == DepositStatus.CounterOffered && dep.CounterOfferAmount.HasValue)
            {
                <div class="mt-3 p-3 bg-amber-50 dark:bg-amber-900/10 rounded-lg text-sm space-y-1">
                    <div class="flex justify-between">
                        <span class="text-amber-700 dark:text-amber-400">@Localizer["Counter-Offer"]</span>
                        <span class="font-medium text-amber-900 dark:text-amber-200 tabular-nums">@CurrencyService.Format(dep.CounterOfferAmount.Value)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(dep.OwnerDisputeResponse))
                    {
                        <div class="text-amber-600 dark:text-amber-300">@dep.OwnerDisputeResponse</div>
                    }
                </div>
            }

            @if (dep.AdminNotes != null)
            {
                <div class="mt-3 p-3 bg-purple-50 dark:bg-purple-900/10 rounded-lg text-sm">
                    <span class="text-purple-700 dark:text-purple-400 font-medium">@Localizer["Admin Notes"]:</span>
                    <span class="text-purple-600 dark:text-purple-300">@dep.AdminNotes</span>
                </div>
            }

            <!-- Dispute history link for resolved disputes on completed rentals -->
            @if (Model.Status == RentalStatus.Completed && depIsResolved && dep.DisputedAt.HasValue)
            {
                <div class="mt-3">
                    <a href="/Dashboard/DisputeHistory/@Model.Id" class="text-sm text-primary-600 dark:text-primary-400 hover:underline">
                        @Localizer["View full dispute history"] →
                    </a>
                </div>
            }
        </div>
    </div>
}

<!-- Section 4: Extension Status (if active or extensions exist) -->
@if (Model.Status == RentalStatus.Active || activeExt != null)
{
    var extAutoExpand = activeExt != null;
    var extCollapsed = !extAutoExpand && !Model.Extensions.Any();

    <div class="panel-section border-b border-ledger-100 dark:border-ledger-800" data-section="extension">
        @if (extCollapsed)
        {
            <button type="button" onclick="togglePanelSection(this)" class="w-full flex items-center justify-between px-4 py-3 hover:bg-ledger-50 dark:hover:bg-ledger-800/50 transition-colors">
                <span class="text-sm font-medium text-ledger-600 dark:text-ledger-400">@Localizer["Extensions"]</span>
                <span class="flex items-center gap-2">
                    <span class="text-xs text-ledger-400">@Localizer["None"]</span>
                    <i class="bi bi-chevron-right text-ledger-300 dark:text-ledger-600 text-xs transition-transform"></i>
                </span>
            </button>
        }
        <div class="@(extCollapsed ? "hidden px-4 pb-4" : "px-4 py-4")">
            <h3 class="text-xs font-semibold text-ledger-400 dark:text-ledger-500 uppercase tracking-wider mb-3">@Localizer["Extensions"]</h3>

            @if (activeExt != null)
            {
                var extStatusType = activeExt.Status == ExtensionStatus.Pending ? "pending"
                                  : activeExt.Status == ExtensionStatus.Accepted ? "active"
                                  : "active";
                var extStatusText = activeExt.Status == ExtensionStatus.Pending ? "Pending"
                                  : activeExt.Status == ExtensionStatus.Accepted ? "Approved"
                                  : "Auto-Approved";
                var extDays = (activeExt.NewEndDate.Date - activeExt.OriginalEndDate.Date).Days;

                <div class="p-3 bg-sky-50 dark:bg-sky-900/10 rounded-lg text-sm space-y-2">
                    <div class="flex justify-between items-center">
                        <span class="text-sky-700 dark:text-sky-400 font-medium">@Localizer["Active Extension"]</span>
                        @await Html.PartialAsync("_StatusBadge", new { Type = extStatusType, Text = extStatusText, SmallPadding = true })
                    </div>
                    <div class="flex justify-between text-sky-600 dark:text-sky-300">
                        <span>+@extDays @Localizer["days"] → @activeExt.NewEndDate.ToString("dd MMM yyyy")</span>
                        <span class="tabular-nums">@CurrencyService.Format(activeExt.AdditionalCost)</span>
                    </div>
                    @if (isOwner && activeExt.Status == ExtensionStatus.Pending)
                    {
                        <div class="flex gap-2 mt-2">
                            <button type="button" onclick="approveExtension(@activeExt.Id)"
                                    class="flex-1 px-3 py-1.5 text-xs font-medium bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg transition-colors">
                                @Localizer["Approve"]
                            </button>
                            <button type="button" onclick="declineExtension(@activeExt.Id)"
                                    class="flex-1 px-3 py-1.5 text-xs font-medium border border-ledger-300 dark:border-neutral-600 text-ledger-600 dark:text-ledger-400 rounded-lg hover:bg-ledger-50 dark:hover:bg-neutral-700 transition-colors">
                                @Localizer["Decline"]
                            </button>
                        </div>
                    }
                    @if (isRenter && activeExt.Status == ExtensionStatus.Pending)
                    {
                        <div class="mt-2">
                            <button type="button" onclick="cancelExtension(@activeExt.Id)"
                                    class="px-3 py-1.5 text-xs font-medium border border-rose-300 dark:border-rose-700 text-rose-600 dark:text-rose-400 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-colors">
                                @Localizer["Cancel Extension"]
                            </button>
                        </div>
                    }
                    @if (isRenter && (activeExt.Status == ExtensionStatus.Accepted || activeExt.Status == ExtensionStatus.AutoApproved))
                    {
                        <div class="mt-2">
                            <a href="/Payment/ExtensionCheckout?extensionId=@activeExt.Id"
                               class="inline-block px-3 py-1.5 text-xs font-medium bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg transition-colors">
                                @Localizer["Pay Extension"]
                            </a>
                        </div>
                    }
                </div>
            }
            else if (isRenter && Model.Status == RentalStatus.Active)
            {
                <button type="button"
                        onclick="openExtensionModal(@Model.Id, '@Model.StartDate.ToString("yyyy-MM-dd")', '@Model.EndDate.ToString("yyyy-MM-dd")', @(Model.Item?.Price ?? 0), @Model.ItemId, @(Model.Item?.AutoApproveExtensions.ToString().ToLower()))"
                        class="w-full px-3 py-2 text-sm font-medium bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors">
                    <i class="bi bi-calendar-plus mr-1"></i>@Localizer["Request Extension"]
                </button>
            }
        </div>
    </div>
}

<!-- Section 5: Evidence Galleries (only when evidence exists or deposit disputed) -->
@if (hasDeposit && (Model.Deposit!.Evidence.Any() || depositInDispute))
{
    var ownerEvidence = Model.Deposit!.Evidence.Where(e => e.SubmittedByUserId != Model.RenterId).ToList();
    var renterEvidence = Model.Deposit!.Evidence.Where(e => e.SubmittedByUserId == Model.RenterId).ToList();
    var evidenceAutoExpand = depositInDispute;

    <div class="panel-section border-b border-ledger-100 dark:border-ledger-800" data-section="evidence">
        @if (!evidenceAutoExpand)
        {
            <button type="button" onclick="togglePanelSection(this)" class="w-full flex items-center justify-between px-4 py-3 hover:bg-ledger-50 dark:hover:bg-ledger-800/50 transition-colors">
                <span class="text-sm font-medium text-ledger-600 dark:text-ledger-400">@Localizer["Evidence"]</span>
                <span class="flex items-center gap-2">
                    <span class="text-xs text-ledger-400">@Model.Deposit!.Evidence.Count @Localizer["photos"]</span>
                    <i class="bi bi-chevron-right text-ledger-300 dark:text-ledger-600 text-xs transition-transform"></i>
                </span>
            </button>
        }
        <div class="@(!evidenceAutoExpand ? "hidden px-4 pb-4" : "px-4 py-4")">
            <h3 class="text-xs font-semibold text-ledger-400 dark:text-ledger-500 uppercase tracking-wider mb-3">@Localizer["Evidence"]</h3>

            @if (ownerEvidence.Any())
            {
                <p class="text-xs font-medium text-ledger-500 dark:text-ledger-400 mb-2">@Localizer["Owner's Evidence"]</p>
                <div class="grid grid-cols-3 gap-2 mb-4">
                    @foreach (var ev in ownerEvidence)
                    {
                        <div class="relative group">
                            <img src="@ev.Url" alt="@Localizer["Evidence"]" class="w-full aspect-square object-cover rounded-lg cursor-pointer"
                                 onclick="window.open('@ev.Url', '_blank')" />
                            @if (!string.IsNullOrEmpty(ev.Notes))
                            {
                                <div class="absolute bottom-0 left-0 right-0 bg-black/60 text-white text-[10px] px-1.5 py-1 rounded-b-lg opacity-0 group-hover:opacity-100 transition-opacity truncate">@ev.Notes</div>
                            }
                        </div>
                    }
                </div>
            }

            @if (renterEvidence.Any())
            {
                <p class="text-xs font-medium text-ledger-500 dark:text-ledger-400 mb-2">@Localizer["Renter's Evidence"]</p>
                <div class="grid grid-cols-3 gap-2 mb-4">
                    @foreach (var ev in renterEvidence)
                    {
                        <div class="relative group">
                            <img src="@ev.Url" alt="@Localizer["Evidence"]" class="w-full aspect-square object-cover rounded-lg cursor-pointer"
                                 onclick="window.open('@ev.Url', '_blank')" />
                            @if (!string.IsNullOrEmpty(ev.Notes))
                            {
                                <div class="absolute bottom-0 left-0 right-0 bg-black/60 text-white text-[10px] px-1.5 py-1 rounded-b-lg opacity-0 group-hover:opacity-100 transition-opacity truncate">@ev.Notes</div>
                            }
                        </div>
                    }
                </div>
            }

            @if (depositInDispute)
            {
                <button type="button"
                        onclick="openAddEvidenceModal(@Model.Id)"
                        class="w-full mt-2 px-3 py-2 text-sm font-medium border border-ledger-300 dark:border-neutral-600 text-ledger-600 dark:text-ledger-400 rounded-lg hover:bg-ledger-50 dark:hover:bg-neutral-700 transition-colors">
                    <i class="bi bi-camera mr-1"></i>@Localizer["Add Evidence"]
                </button>
            }
        </div>
    </div>
}

<!-- Section 6: Actions Footer (sticky bottom) -->
<div class="sticky bottom-0 bg-white dark:bg-ledger-900 border-t border-ledger-100 dark:border-ledger-800 px-4 py-3 shrink-0">
    <div class="flex flex-wrap gap-2">
        @* Renter actions *@
        @if (isRenter)
        {
            @if (Model.Status == RentalStatus.Accepted)
            {
                <a href="/Payment/Checkout?rentalId=@Model.Id"
                   class="flex-1 text-center px-4 py-2 text-sm font-medium bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg transition-colors">
                    @Localizer["Pay Now"]
                </a>
            }
            @if (Model.Status == RentalStatus.Pending)
            {
                <form asp-controller="Rentals" asp-action="CancelRental" method="post" class="flex-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="rentalId" value="@Model.Id" />
                    <button type="submit"
                            class="w-full px-4 py-2 text-sm font-medium border border-rose-300 dark:border-rose-700 text-rose-600 dark:text-rose-400 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-colors">
                        @Localizer["Cancel Request"]
                    </button>
                </form>
            }
            @if (Model.Status == RentalStatus.Completed)
            {
                var hasMyReview = Model.Reviews.Any(rv => rv.ReviewerId == currentUserId && !rv.IsDeleted);
                var myReviewId = Model.Reviews.FirstOrDefault(rv => rv.ReviewerId == currentUserId && !rv.IsDeleted)?.Id;
                @if (hasMyReview)
                {
                    <button type="button"
                            onclick="openReviewModal(@Model.Id, @Model.ItemId, @myReviewId)"
                            class="flex-1 px-4 py-2 text-sm font-medium border border-ledger-300 dark:border-neutral-600 text-ledger-500 dark:text-ledger-400 rounded-lg hover:bg-ledger-50 dark:hover:bg-neutral-700 transition-colors">
                        <i class="bi bi-pencil mr-1"></i>@Localizer["Edit Review"]
                    </button>
                }
                else
                {
                    <button type="button"
                            onclick="openReviewModal(@Model.Id, @Model.ItemId, null)"
                            class="flex-1 px-4 py-2 text-sm font-medium bg-amber-500 hover:bg-amber-600 text-white rounded-lg transition-colors">
                        <i class="bi bi-star mr-1"></i>@Localizer["Leave Review"]
                    </button>
                }
            }
            @if (hasDeposit && (Model.Deposit!.Status == DepositStatus.Charged || Model.Deposit!.Status == DepositStatus.PartiallyCharged))
            {
                <button type="button"
                        onclick="openDisputeModal(@Model.Id, @Html.Raw(evidenceJson))"
                        class="flex-1 px-4 py-2 text-sm font-medium border border-rose-300 dark:border-rose-700 text-rose-600 dark:text-rose-400 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-colors">
                    <i class="bi bi-shield-exclamation mr-1"></i>@Localizer["Dispute Charge"]
                </button>
            }
            @if (hasDeposit && Model.Deposit!.Status == DepositStatus.CounterOffered)
            {
                <button type="button"
                        onclick="acceptCounterOffer(@Model.Id)"
                        class="flex-1 px-4 py-2 text-sm font-medium bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg transition-colors">
                    @Localizer["Accept Offer"]
                </button>
                <button type="button"
                        onclick="escalateDispute(@Model.Id)"
                        class="flex-1 px-4 py-2 text-sm font-medium border border-rose-300 dark:border-rose-700 text-rose-600 dark:text-rose-400 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-colors">
                    @Localizer["Escalate"]
                </button>
            }
            @if (hasDeposit && Model.Deposit!.Status == DepositStatus.Disputed)
            {
                <button type="button"
                        onclick="escalateDispute(@Model.Id)"
                        class="flex-1 px-4 py-2 text-sm font-medium border border-rose-300 dark:border-rose-700 text-rose-600 dark:text-rose-400 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-colors">
                    @Localizer["Escalate"]
                </button>
            }
            @if (hasDeposit && (Model.Deposit!.Status == DepositStatus.Charged || Model.Deposit!.Status == DepositStatus.PartiallyCharged || Model.Deposit!.Status == DepositStatus.Disputed))
            {
                <button type="button"
                        onclick="acceptCharge(@Model.Id)"
                        class="px-4 py-2 text-sm font-medium text-ledger-500 dark:text-ledger-400 hover:text-ledger-700 dark:hover:text-ledger-300 transition-colors">
                    @Localizer["Accept Charge"]
                </button>
            }
        }

        @* Owner actions *@
        @if (isOwner)
        {
            @if (Model.Status == RentalStatus.Pending)
            {
                <form asp-controller="Rentals" asp-action="ApproveRental" method="post" class="flex-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="rentalId" value="@Model.Id" />
                    <button type="submit"
                            class="w-full px-4 py-2 text-sm font-medium bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg transition-colors">
                        @Localizer["Approve"]
                    </button>
                </form>
                <form asp-controller="Rentals" asp-action="CancelRental" method="post" class="flex-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="rentalId" value="@Model.Id" />
                    <button type="submit"
                            class="w-full px-4 py-2 text-sm font-medium border border-ledger-300 dark:border-neutral-600 text-ledger-600 dark:text-ledger-400 rounded-lg hover:bg-ledger-50 dark:hover:bg-neutral-700 transition-colors">
                        @Localizer["Reject"]
                    </button>
                </form>
            }
            @if (Model.Status == RentalStatus.Active && hasDeposit && Model.Deposit!.Status == DepositStatus.Authorized)
            {
                <button type="button"
                        onclick="openDepositResolution(@Model.Id, @Model.Deposit!.Amount, '@Model.Deposit!.Status')"
                        class="flex-1 px-4 py-2 text-sm font-medium bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors">
                    @Localizer["Resolve Deposit"]
                </button>
            }
            @if (Model.Status == RentalStatus.Active)
            {
                <button type="button"
                        onclick="openEarlyReturnModal(@Model.Id, @(Model.Deposit?.Amount ?? 0))"
                        class="flex-1 px-4 py-2 text-sm font-medium border border-ledger-300 dark:border-neutral-600 text-ledger-600 dark:text-ledger-400 rounded-lg hover:bg-ledger-50 dark:hover:bg-neutral-700 transition-colors">
                    @Localizer["End Early"]
                </button>
            }
            @if (hasDeposit && Model.Deposit!.Status == DepositStatus.Disputed)
            {
                <button type="button"
                        onclick="openCounterOfferModal(@Model.Id, @Model.Deposit!.Amount, @Html.Raw(evidenceJson))"
                        class="flex-1 px-4 py-2 text-sm font-medium bg-amber-600 hover:bg-amber-700 text-white rounded-lg transition-colors">
                    @Localizer["Counter-Offer"]
                </button>
                <button type="button"
                        onclick="openMaintainChargeModal(@Model.Id, @Html.Raw(evidenceJson))"
                        class="flex-1 px-4 py-2 text-sm font-medium border border-ledger-300 dark:border-neutral-600 text-ledger-600 dark:text-ledger-400 rounded-lg hover:bg-ledger-50 dark:hover:bg-neutral-700 transition-colors">
                    @Localizer["Maintain Charge"]
                </button>
                <button type="button"
                        onclick="releaseDisputedDeposit(@Model.Id)"
                        class="px-4 py-2 text-sm font-medium text-ledger-500 dark:text-ledger-400 hover:text-ledger-700 dark:hover:text-ledger-300 transition-colors">
                    @Localizer["Release Deposit"]
                </button>
            }
        }
    </div>
</div>

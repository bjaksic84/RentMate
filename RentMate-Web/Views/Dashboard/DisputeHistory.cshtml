@model RentMate.Models.Domain.Rental
@using RentMate.Services.Interfaces
@inject ICurrencyService CurrencyService
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Dispute History"];
}

@functions {
    public class TimelineItem {
        public DateTime Date { get; set; }
        public string Type { get; set; } = "";
        public string Title { get; set; } = "";
        public string ActorName { get; set; } = "";
        public string ActorRole { get; set; } = "";
        public string? Description { get; set; }
        public decimal? Amount { get; set; }
        public string Icon { get; set; } = "";
        public string Color { get; set; } = "slate";
        public string? Url { get; set; }
    }
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumbs -->
    <nav class="flex mb-6 text-sm font-medium text-slate-500" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li><a asp-action="UserDashboard" class="hover:text-blue-600 transition-colors">@Localizer["Dashboard"]</a></li>
            <li><i class="bi bi-chevron-right mx-2 text-[10px]"></i></li>
            <li class="text-slate-900 dark:text-white">@Localizer["Dispute History"]</li>
        </ol>
    </nav>

    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="font-heading text-3xl font-bold text-slate-900 dark:text-white">@Localizer["Dispute History"]</h1>
            <p class="text-slate-500 dark:text-slate-400 mt-1">@Localizer["Review the resolution process for rental"] #@Model.Id</p>
        </div>
        <div class="px-3 py-1 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-xs font-bold rounded-full border border-slate-200 dark:border-slate-700 uppercase tracking-widest">
            @Model.Deposit?.Status.ToString()
        </div>
    </div>

    <!-- Rental Context -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 mb-8 shadow-sm">
        <div class="flex items-center gap-4">
            @if (!string.IsNullOrEmpty(Model.Item?.PrimaryImageUrl))
            {
                <img src="@Model.Item.ImageUrl" class="w-16 h-16 rounded-xl object-cover shadow-sm" />
            }
            <div class="flex-1 min-w-0">
                <h3 class="font-bold text-slate-900 dark:text-white text-lg truncate">@Model.Item?.Title</h3>
                <div class="flex flex-wrap gap-x-4 gap-y-1 mt-1 text-sm text-slate-500 dark:text-slate-400">
                    <span><i class="bi bi-calendar-range mr-1"></i> @Model.StartDate.ToString("dd MMM") &rarr; @Model.EndDate.ToString("dd MMM yyyy")</span>
                    <span><i class="bi bi-shop mr-1"></i> @Model.Owner?.UserName</span>
                </div>
            </div>
            <div class="text-right">
                <p class="text-xs text-slate-400 uppercase font-bold tracking-wider">@Localizer["Final Charge"]</p>
                <p class="text-lg font-bold text-slate-900 dark:text-white">@CurrencyService.Format(Model.Deposit?.ChargedAmount ?? 0)</p>
            </div>
        </div>
    </div>

    <!-- Timeline -->
    <div class="relative space-y-8 pl-8 before:absolute before:left-3.5 before:top-2 before:bottom-0 before:w-0.5 before:bg-slate-200 dark:before:bg-slate-700">
        @{
            var updates = new List<TimelineItem>();
            var deposit = Model.Deposit;

            if (deposit != null) {
                // 1. Charge
                if (deposit.ChargedAt.HasValue)
                {
                    updates.Add(new TimelineItem { 
                        Date = deposit.ChargedAt.Value, 
                        Type = "Charge", 
                        Title = Localizer["Deposit Charged"].Value,
                        ActorName = Model.Owner?.FirstName ?? Model.Owner?.Email ?? "Owner",
                        ActorRole = Localizer["Owner"].Value,
                        Description = deposit.ChargeReason,
                        Amount = deposit.ChargedAmount,
                        Icon = "bi-cash-coin",
                        Color = "rose"
                    });
                }

                // 2. Dispute
                if (deposit.DisputedAt.HasValue)
                {
                    updates.Add(new TimelineItem { 
                        Date = deposit.DisputedAt.Value, 
                        Type = "Dispute", 
                        Title = Localizer["Charge Disputed"].Value,
                        ActorName = Model.Renter?.FirstName ?? Model.Renter?.Email ?? "Renter",
                        ActorRole = Localizer["Renter"].Value,
                        Description = deposit.DisputeReason,
                        Icon = "bi-exclamation-triangle",
                        Color = "amber"
                    });
                }

                // 3. Counter-Offer
                if (deposit.CounterOfferAt.HasValue)
                {
                    updates.Add(new TimelineItem { 
                        Date = deposit.CounterOfferAt.Value, 
                        Type = "CounterOffer", 
                        Title = Localizer["Counter-Offer Sent"].Value,
                        ActorName = Model.Owner?.FirstName ?? Model.Owner?.Email ?? "Owner",
                        ActorRole = Localizer["Owner"].Value,
                        Description = deposit.OwnerDisputeResponse,
                        Amount = deposit.CounterOfferAmount,
                        Icon = "bi-arrow-left-right",
                        Color = "indigo"
                    });
                }

                // 4. Escalation
                if (deposit.EscalatedAt.HasValue)
                {
                    updates.Add(new TimelineItem { 
                        Date = deposit.EscalatedAt.Value, 
                        Type = "Escalation", 
                        Title = Localizer["Dispute Escalated"].Value,
                        ActorName = "System",
                        ActorRole = "System",
                        Description = Localizer["Case escalated for admin review."].Value,
                        Icon = "bi-shield-exclamation",
                        Color = "blue"
                    });
                }

                // 5. Resolution
                if (deposit.AdminResolvedAt.HasValue)
                {
                    updates.Add(new TimelineItem { 
                        Date = deposit.AdminResolvedAt.Value, 
                        Type = "Resolution", 
                        Title = Localizer["Case Resolved"].Value,
                        ActorName = "Admin",
                        ActorRole = "Admin",
                        Description = deposit.AdminNotes,
                        Amount = deposit.ChargedAmount,
                        Icon = "bi-check-circle-fill",
                        Color = "emerald"
                    });
                }

                // 6. Evidence
                if (deposit.Evidence != null)
                {
                    foreach (var ev in deposit.Evidence)
                    {
                        var isRenterEv = ev.SubmittedByUserId == Model.RenterId;
                        updates.Add(new TimelineItem { 
                            Date = ev.CreatedAt, 
                            Type = "Evidence", 
                            Title = Localizer["Evidence Uploaded"].Value,
                            ActorName = isRenterEv ? (Model.Renter?.FirstName ?? "Renter") : (Model.Owner?.FirstName ?? "Owner"),
                            ActorRole = isRenterEv ? Localizer["Renter"].Value : Localizer["Owner"].Value,
                            Description = ev.Notes,
                            Url = ev.Url,
                            Icon = "bi-image",
                            Color = "slate"
                        });
                    }
                }
            }

            var sortedUpdates = updates.OrderBy(u => u.Date).ToList();
        }

        @foreach (var update in sortedUpdates)
        {
            <div class="relative group">
                <!-- Node -->
                <div class="absolute -left-[45px] top-1 w-8 h-8 rounded-full border-2 border-white dark:border-slate-800 bg-@(update.Color)-100 dark:bg-@(update.Color)-900/50 flex items-center justify-center text-@(update.Color)-600 dark:text-@(update.Color)-400 z-10 transition-all group-hover:scale-110 shadow-sm">
                    <i class="bi @(update.Icon) text-sm"></i>
                </div>

                <div class="flex flex-col sm:flex-row sm:items-start gap-2 sm:gap-4">
                    <!-- Date Desktop -->
                    <div class="hidden sm:block w-32 pt-2 text-right">
                        <p class="text-xs font-bold text-slate-400">@update.Date.ToString("MMM dd")</p>
                        <p class="text-[10px] text-slate-300">@update.Date.ToString("HH:mm")</p>
                    </div>

                    <!-- Content Card -->
                    <div class="flex-1 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-5 shadow-sm transition-all hover:shadow-md">
                        <div class="flex justify-between items-start mb-3">
                            <div>
                                <h5 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wide">@update.Title</h5>
                                <div class="flex items-center gap-2 mt-1">
                                    <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 uppercase tracking-tighter">
                                        @update.ActorRole
                                    </span>
                                    <span class="text-xs text-slate-400">@update.ActorName</span>
                                </div>
                            </div>
                            <!-- Date Mobile -->
                            <span class="sm:hidden text-[10px] font-bold text-slate-400">
                                @update.Date.ToString("MMM dd, HH:mm")
                            </span>
                        </div>

                        @if (!string.IsNullOrEmpty(update.Description))
                        {
                            <div class="text-sm text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-800/50 p-4 rounded-xl border border-slate-100 dark:border-slate-800 italic">
                                "@update.Description"
                            </div>
                        }

                        @if (update.Amount != null)
                        {
                            <div class="mt-4 flex items-center gap-2">
                                <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">@Localizer["Amount"]:</span>
                                <span class="text-sm font-bold text-slate-900 dark:text-white">@CurrencyService.Format(update.Amount.Value)</span>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(update.Url))
                        {
                            <div class="mt-4">
                                <a href="@update.Url" target="_blank" class="block w-full max-w-sm rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 hover:opacity-95 transition-opacity">
                                    <img src="@update.Url" alt="Evidence" class="w-full h-auto object-cover" />
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Back Button -->
    <div class="mt-12 pt-8 border-t border-slate-100 dark:border-slate-800 flex justify-center">
        <a asp-action="UserDashboard" class="inline-flex items-center gap-2 px-6 py-2.5 bg-slate-900 dark:bg-slate-800 text-white font-bold rounded-xl hover:bg-slate-800 dark:hover:bg-slate-700 transition-all shadow-lg hover:shadow-slate-400/20">
            <i class="bi bi-house-fill"></i>
            @Localizer["Return to Dashboard"]
        </a>
    </div>
</div>

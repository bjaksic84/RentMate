@using Microsoft.AspNetCore.Mvc.Localization
@model RentMate.Models.ViewModels.EvidenceGridViewModel
@inject IViewLocalizer Localizer

@if (Model.Evidence != null && Model.Evidence.Any())
{
    var yourEv  = Model.Evidence.Where(e => e.SubmittedByUserId == Model.CurrentUserId);
    var otherEv = Model.Evidence.Where(e => e.SubmittedByUserId != Model.CurrentUserId);
    var c       = Model.ColorToken;
    var sz      = Model.ThumbnailSize;

    @if (otherEv.Any())
    {
        <div class="mt-4 pt-3 border-t border-@c-200/50 dark:border-@c-800/50">
            <p class="text-[10px] uppercase font-bold text-@c-600 dark:text-@c-500 mb-2 tracking-wider">@Model.OtherPartyLabel</p>
            <div class="flex flex-wrap gap-2">
                @foreach (var ev in otherEv.OrderByDescending(e => e.CreatedAt))
                {
                    <a href="@ev.Url" target="_blank"
                       class="@sz rounded-lg overflow-hidden border border-@c-200 dark:border-@c-800 hover:scale-105 transition-transform"
                       title="@ev.Notes">
                        <img src="@ev.Url" class="w-full h-full object-cover" />
                    </a>
                }
            </div>
        </div>
    }

    @if (yourEv.Any())
    {
        <div class="mt-4 pt-3 border-t border-@c-200/50 dark:border-@c-800/50">
            <p class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 mb-2 tracking-wider">@Localizer["Your Evidence"]</p>
            <div class="flex flex-wrap gap-2">
                @foreach (var ev in yourEv.OrderByDescending(e => e.CreatedAt))
                {
                    <a href="@ev.Url" target="_blank"
                       class="@sz rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700 hover:scale-105 transition-transform"
                       title="@ev.Notes">
                        <img src="@ev.Url" class="w-full h-full object-cover opacity-80" />
                    </a>
                }
                @if (Model.RentalId.HasValue)
                {
                    var btnSz = sz.Contains("w-8") ? "w-8 h-8" : "w-10 h-10";
                    var plusIcon = sz.Contains("w-8") ? "bi-plus" : "bi-plus-lg";
                    <button onclick="openAddEvidenceModal(@Model.RentalId.Value)"
                            class="@btnSz rounded-lg flex items-center justify-center border border-dashed border-slate-300 dark:border-slate-600 text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-900 transition">
                        <i class="bi @plusIcon"></i>
                    </button>
                }
            </div>
        </div>
    }
}

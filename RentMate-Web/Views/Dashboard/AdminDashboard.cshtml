@model RentMate.Models.ViewModels.DashboardViewModel
@using RentMate.Shared.Contracts.Responses
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService

@{
    ViewData["Title"] = Localizer["Admin Dashboard"];
    var currency = CurrencyService.GetCurrentCurrency();
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
        <div>
            <h1 class="font-heading text-3xl font-bold text-slate-900">@Localizer["System Overview"]</h1>
            <p class="text-slate-500 mt-1">@Localizer["Admin Dashboard"]</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="AdminResolvedDisputes" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold rounded-xl shadow-sm transition-all">
                <i class="bi bi-archive"></i>
                @Localizer["Dispute Archive"]
            </a>
            <a href="#" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-semibold rounded-xl shadow-sm transition-all">
                <i class="bi bi-download"></i>
                @Localizer["Export Report"]
            </a>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        @await Html.PartialAsync("_StatCard", new { Icon = "bi-people", IconColor = "blue", Value = Model.TotalUsers, Label = "Users", Link = Url.Action("Index", "Users"), LinkText = "Manage" })
        @await Html.PartialAsync("_StatCard", new { Icon = "bi-currency-euro", IconColor = "green", Value = $"{currency.Symbol}{Model.TotalRevenue:N0}", Label = "Total Revenue" })
        @await Html.PartialAsync("_StatCard", new { Icon = "bi-box-seam", IconColor = "purple", Value = Model.ActiveListings, Label = "Active Listings" })
        @await Html.PartialAsync("_StatCard", new { Icon = "bi-arrow-repeat", IconColor = "amber", Value = Model.ActiveRentals, Label = "In Progress" })
    </div>

    <!-- Escalated Disputes Section -->
    @if (Model.EscalatedDisputes?.Any() ?? false)
    {
        <div class="mb-8 bg-rose-50 dark:bg-rose-900/10 border border-rose-200 dark:border-rose-800 rounded-2xl overflow-hidden shadow-sm">
            <div class="px-6 py-4 border-b border-rose-200 dark:border-rose-800 bg-rose-100/50 dark:bg-rose-900/20 flex items-center justify-between">
                <h2 class="font-heading text-lg font-bold text-rose-900 dark:text-rose-100 flex items-center gap-2">
                    <i class="bi bi-shield-exclamation text-rose-600"></i>
                    @Localizer["Escalated Disputes Awaiting Review"]
                    <span class="ml-2 px-2 py-0.5 bg-rose-600 text-white text-xs font-bold rounded-full">@Model.EscalatedDisputes.Count</span>
                </h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-rose-100/30 dark:bg-rose-900/30 text-rose-800 dark:text-rose-300">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-bold uppercase tracking-wider">@Localizer["Rental"]</th>
                            <th class="px-6 py-3 text-left text-xs font-bold uppercase tracking-wider">@Localizer["Parties"]</th>
                            <th class="px-6 py-3 text-left text-xs font-bold uppercase tracking-wider">@Localizer["Amount"]</th>
                            <th class="px-6 py-3 text-left text-xs font-bold uppercase tracking-wider">@Localizer["Escalated At"]</th>
                            <th class="px-6 py-3 text-right text-xs font-bold uppercase tracking-wider">@Localizer["Action"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-rose-100 dark:divide-rose-800/50">
                        @foreach (var dep in Model.EscalatedDisputes)
                        {
                            <tr class="hover:bg-rose-100/20 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="text-sm font-bold text-slate-900 dark:text-white">#@dep.RentalId</div>
                                    <div class="text-xs text-slate-500 truncate max-w-[150px]">@dep.Rental?.Item?.Title</div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-xs text-slate-700 dark:text-slate-300"><span class="font-medium text-blue-600">R:</span> @dep.Rental?.Renter?.Email</div>
                                    <div class="text-xs text-slate-700 dark:text-slate-300"><span class="font-medium text-emerald-600">O:</span> @dep.Rental?.Owner?.Email</div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-sm font-bold text-rose-700 dark:text-rose-400">@CurrencyService.Format(dep.ChargedAmount ?? 0)</div>
                                    <div class="text-xs text-slate-500 truncate max-w-[200px] break-words overflow-hidden">"@dep.DisputeReason"</div>
                                    @if (dep.Evidence != null && dep.Evidence.Any())
                                    {
                                        <div class="inline-flex items-center gap-1 px-1.5 py-0.5 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 text-[10px] font-bold rounded-md">
                                            <i class="bi bi-paperclip"></i>
                                            <span>@dep.Evidence.Count @Localizer["files"]</span>
                                        </div>
                                    }
                                </td>
                                <td class="px-6 py-4 text-xs text-slate-500">
                                    @dep.EscalatedAt?.ToString("g")
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <a asp-controller="Dashboard" asp-action="AdminReviewDispute" asp-route-id="@dep.RentalId" 
                                       class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold rounded-lg shadow-sm transition-all uppercase tracking-wider">
                                        @Localizer["Review"]
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="mb-8 p-6 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
                    <i class="bi bi-check-circle text-xl"></i>
                </div>
                <div>
                    <h3 class="font-heading font-bold text-slate-900 dark:text-white">@Localizer["No Active Disputes"]</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">@Localizer["All escalated cases have been resolved."] @Localizer["Great job!"]</p>
                </div>
            </div>
            <a asp-action="AdminResolvedDisputes" class="text-sm font-bold text-blue-600 hover:text-blue-700 transition-colors flex items-center gap-1 uppercase tracking-wider">
                <i class="bi bi-archive"></i>
                @Localizer["Dispute Archive"]
            </a>
        </div>
    }

        <!-- Recent Rentals Table -->
        <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
                <h2 class="font-heading text-lg font-bold text-slate-900 flex items-center gap-2">
                    <i class="bi bi-clock-history text-blue-600"></i>
                    @Localizer["Recent Rentals"]
                </h2>
                <a asp-controller="Rentals" asp-action="Index" class="text-sm text-blue-600 hover:text-blue-700 font-medium">
                    @Localizer["All Rentals"] <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-slate-50 border-b border-slate-200">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">@Localizer["Item"]</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">@Localizer["Renter"]</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">@Localizer["Date"]</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">@Localizer["Status"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (RentMate.Models.Domain.Rental rental in Model.Rentals ?? new List<RentMate.Models.Domain.Rental>())
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4 text-sm text-slate-900 font-medium">@rental.Item?.Title</td>
                                <td class="px-6 py-4 text-sm text-slate-500">@rental.Renter?.Email</td>
                                <td class="px-6 py-4 text-sm text-slate-500">@rental.CreatedAt.ToString("dd. MM. yyyy")</td>
                                <td class="px-6 py-4">
                                    @{
                                        var statusType = rental.Status switch
                                        {
                                            RentalStatus.Active => "active",
                                            RentalStatus.Pending => "pending",
                                            RentalStatus.Completed => "completed",
                                            _ => "cancelled"
                                        };
                                        var statusText = rental.Status.ToString();
                                    }
                                    @await Html.PartialAsync("_StatusBadge", new { Type = statusType, Text = statusText })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- New Users List -->
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200">
                <h2 class="font-heading text-lg font-bold text-slate-900 flex items-center gap-2">
                    <i class="bi bi-person-plus text-green-600"></i>
                    @Localizer["New Users"]
                </h2>
            </div>
            <div class="divide-y divide-slate-100">
                @foreach (var user in Model.Users ?? new List<ApplicationUser>())
                {
                    <div class="p-4 hover:bg-slate-50 transition-colors">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                {
                                    <img src="@user.ProfilePictureUrl" class="w-10 h-10 rounded-full object-cover" />
                                }
                                else
                                {
                                    <div class="w-10 h-10 bg-gradient-to-br from-blue-600 to-sky-400 text-white rounded-full flex items-center justify-center">
                                        <i class="bi bi-person"></i>
                                    </div>
                                }
                                <div>
                                    <p class="font-semibold text-slate-900">@user.UserName</p>
                                    <p class="text-sm text-slate-500">@user.Email</p>
                                </div>
                            </div>
                            <a asp-controller="Users" asp-action="Index" class="p-2 text-slate-500 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors">
                                <i class="bi bi-gear"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- All Listings Section -->
    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200">
            <h2 class="font-heading text-lg font-bold text-slate-900 flex items-center gap-2">
                <i class="bi bi-grid text-purple-600"></i>
                @Localizer["All Listings"]
            </h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">@Localizer["Item"]</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">@Localizer["Owner"]</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">@Localizer["Price"]</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">@Localizer["Status"]</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">@Localizer["Moderation"]</th>
                        <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in Model.Listings ?? new List<RentMate.Models.Domain.Item>())
                    {
                        <tr class="hover:bg-slate-50 transition-colors" data-item-id="@item.Id">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" class="w-10 h-10 rounded-lg object-cover" />
                                    }
                                    else
                                    {
                                        <div class="w-10 h-10 bg-slate-100 rounded-lg flex items-center justify-center">
                                            <i class="bi bi-image text-slate-400"></i>
                                        </div>
                                    }
                                    <span class="font-medium text-slate-900">@item.Title</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-500">@item.User?.Email</td>
                            <td class="px-6 py-4 text-sm font-semibold text-slate-900">@CurrencyService.Format(item.Price)</td>
                            <td class="px-6 py-4">
                                @if (item.IsListed)
                                {
                                    <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-medium rounded-full">@Localizer["Listed"]</span>
                                }
                                else
                                {
                                    <span class="px-2 py-1 bg-slate-100 text-slate-600 text-xs font-medium rounded-full">@Localizer["Hidden (User)"]</span>
                                }
                            </td>
                            <td class="px-6 py-4 moderation-status">
                                @if (item.IsAdminHidden)
                                {
                                    <span class="px-2 py-1 bg-red-100 text-red-700 text-xs font-medium rounded-full">@Localizer["Hidden (Admin)"]</span>
                                }
                                else
                                {
                                    <span class="px-2 py-1 bg-slate-50 text-slate-500 text-xs font-medium rounded-full border border-slate-200">@Localizer["Normal"]</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <button class="admin-toggle-btn px-3 py-1.5 text-sm font-medium rounded-lg transition-colors @(item.IsAdminHidden ? "bg-green-600 hover:bg-green-700 text-white" : "border border-red-300 text-red-600 hover:bg-red-50")"
                                            onclick="adminToggleHide(@item.Id, this)">
                                        <i class="bi @(item.IsAdminHidden ? "bi-eye" : "bi-eye-slash")"></i>
                                        @(item.IsAdminHidden ? Localizer["Restore"] : Localizer["Hide"])
                                    </button>
                                    <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" 
                                       class="p-2 text-slate-500 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
async function adminToggleHide(itemId, button) {
    if (!confirm("@Localizer["Are you sure you want to change the visibility of this item?"]")) return;

    try {
        const res = await fetch(`/Items/AdminToggleHide/${itemId}`, {
            method: "POST",
            headers: {
                "X-CSRF-TOKEN": document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""
            }
        });

        if (res.ok) {
            const data = await res.json();
            const row = button.closest("tr");
            const modStatusCell = row.querySelector(".moderation-status");
            
            if (data.isAdminHidden) {
                modStatusCell.innerHTML = '<span class="px-2 py-1 bg-red-100 text-red-700 text-xs font-medium rounded-full">@Localizer["Hidden (Admin)"]</span>';
                button.className = "admin-toggle-btn px-3 py-1.5 text-sm font-medium rounded-lg transition-colors bg-green-600 hover:bg-green-700 text-white";
                button.innerHTML = '<i class="bi bi-eye"></i> @Localizer["Restore"]';
            } else {
                modStatusCell.innerHTML = '<span class="px-2 py-1 bg-slate-50 text-slate-500 text-xs font-medium rounded-full border border-slate-200">@Localizer["Normal"]</span>';
                button.className = "admin-toggle-btn px-3 py-1.5 text-sm font-medium rounded-lg transition-colors border border-red-300 text-red-600 hover:bg-red-50";
                button.innerHTML = '<i class="bi bi-eye-slash"></i> @Localizer["Hide"]';
            }
        } else {
            alert("@Localizer["Error toggling visibility"]");
        }
    } catch (err) {
        console.error(err);
        alert("@Localizer["Network error"]");
    }
}
</script>
}

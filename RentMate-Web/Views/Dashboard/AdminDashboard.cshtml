@model RentMate.Models.DashboardViewModel
@using RentMate.Shared.Contracts.Responses
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Admin Dashboard"];
}

<div class="container-fluid px-4 mt-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">@Localizer["System Overview"]</h1>
        <a href="#" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-download fa-sm text-white-50"></i> @Localizer["Export Report"]
        </a>
    </div>

    @* Statistics Cards *@
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">@Localizer["Users"]</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalUsers</div>
                    <a asp-controller="Users" asp-action="Index" class="btn btn-link btn-sm p-0 mt-2">@Localizer["Manage"]</a>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">@Localizer["Total Revenue"]</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalRevenue.ToString("C")</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">@Localizer["Active Listings"]</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.ActiveListings</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">@Localizer["In Progress"]</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.ActiveRentals</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        @* Recent Rentals Table *@
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">@Localizer["Recent Rentals"]</h6>
                    <a href="/Rentals" class="btn btn-sm btn-outline-primary">@Localizer["All Rentals"]</a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>@Localizer["Item"]</th>
                                    <th>@Localizer["Renter"]</th>
                                    <th>@Localizer["Date"]</th>
                                    <th>@Localizer["Status"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (RentMate.Models.Rental rental in Model.Rentals ?? new List<RentMate.Models.Rental>())
                                {
                                    <tr>
                                        <td>@rental.Item?.Title</td>
                                        <td>@rental.Renter?.Email</td>
                                        <td>@rental.CreatedAt.ToString("dd. MM. yyyy")</td>
                                        <td>
                                            <span class="badge @(rental.Status == RentalStatus.Active ? "bg-success" : "bg-secondary")">
                                                @rental.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        @* New Users List *@
        <div class="col-lg-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">@Localizer["New Users"]</h6>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var user in Model.Users ?? new List<ApplicationUser>())
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-bold">@user.UserName</span><br />
                                    <small class="text-muted">@user.Email</small>
                                </div>
                                <a asp-controller="Users" asp-action="Index" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-user-cog"></i> @Localizer["Manage"]
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">@Localizer["All Listings"]</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>@Localizer["Item"]</th>
                                    <th>@Localizer["Owner"]</th>
                                    <th>@Localizer["Price"]</th>
                                    <th>@Localizer["Status"]</th>
                                    <th>@Localizer["Moderation"]</th>
                                    <th class="text-end">@Localizer["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Listings ?? new List<RentMate.Models.Item>())
                                {
                                    <tr data-item-id="@item.Id">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                {
                                                    <img src="@item.ImageUrl" class="rounded me-2" style="width: 40px; height: 40px; object-fit: cover;" />
                                                }
                                                <span>@item.Title</span>
                                            </div>
                                        </td>
                                        <td>@item.User?.Email</td>
                                        <td>@item.Price.ToString()</td>
                                        <td>
                                            @if (item.IsListed)
                                            {
                                                <span class="badge bg-success">@Localizer["Listed"]</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@Localizer["Hidden (User)"]</span>
                                            }
                                        </td>
                                        <td class="moderation-status">
                                            @if (item.IsAdminHidden)
                                            {
                                                <span class="badge bg-danger">@Localizer["Hidden (Admin)"]</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark">@Localizer["Normal"]</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-sm @(item.IsAdminHidden ? "btn-success" : "btn-outline-danger") admin-toggle-btn" 
                                                    onclick="adminToggleHide(@item.Id, this)">
                                                <i class="fas @(item.IsAdminHidden ? "fa-eye" : "fa-eye-slash")"></i>
                                                @(item.IsAdminHidden ? Localizer["Restore"] : Localizer["Hide"])
                                            </button>
                                            <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-external-link-alt"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
async function adminToggleHide(itemId, button) {
    if (!confirm("@Localizer["Are you sure you want to change the visibility of this item?"]")) return;

    try {
        const res = await fetch(`/Items/AdminToggleHide/${itemId}`, {
            method: "POST",
            headers: {
                "X-CSRF-TOKEN": document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""
            }
        });

        if (res.ok) {
            const data = await res.json();
            const row = button.closest("tr");
            const modStatusCell = row.querySelector(".moderation-status");
            
            if (data.isAdminHidden) {
                modStatusCell.innerHTML = '<span class="badge bg-danger">@Localizer["Hidden (Admin)"]</span>';
                button.className = "btn btn-sm btn-success admin-toggle-btn";
                button.innerHTML = '<i class="fas fa-eye"></i> @Localizer["Restore"]';
            } else {
                modStatusCell.innerHTML = '<span class="badge bg-light text-dark">@Localizer["Normal"]</span>';
                button.className = "btn btn-sm btn-outline-danger admin-toggle-btn";
                button.innerHTML = '<i class="fas fa-eye-slash"></i> @Localizer["Hide"]';
            }
        } else {
            alert("@Localizer["Error toggling visibility"]");
        }
    } catch (err) {
        console.error(err);
        alert("@Localizer["Network error"]");
    }
}
</script>
}

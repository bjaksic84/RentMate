                <div id="er-charge-preview" class="mt-2 hidden">
                    <div class="flex items-center gap-2 p-2 bg-rose-50 dark:bg-rose-900/20 border border-rose-100 dark:border-rose-800 rounded-xl">
                        <i class="bi bi-file-earmark-check text-rose-600"></i>
                        <span class="text-xs text-rose-700 dark:text-rose-400 font-medium truncate" id="er-charge-filename"></span>
                        <button onclick="clearErChargeEvidence()" class="ml-auto p-1 hover:bg-rose-100 dark:hover:bg-rose-800 rounded-lg">
                            <i class="bi bi-x text-rose-600"></i>
                        </button>
                    </div>
                </div>
            </div>
            <button onclick="completeWithDeposit('charge')" id="er-charge-btn"
                    class="w-full rounded-xl border border-rose-300 dark:border-rose-700 text-rose-600 dark:text-rose-400 px-4 py-2.5 text-sm font-medium transition hover:bg-rose-50 dark:hover:bg-rose-900/20">
                <i class="bi bi-shield-x mr-1"></i> @Localizer["Charge Deposit"]
            </button>
        </div>
    </div>
</div>

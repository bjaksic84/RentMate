@using Microsoft.AspNetCore.Mvc.Localization
@using RentMate.Shared.Contracts.Responses
@model RentMate.Models.ViewModels.DashboardViewModel
@inject IViewLocalizer Localizer
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService

@{
    ViewData["Title"] = Localizer["Dashboard"];
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
        <div>
            <h1 class="font-heading text-3xl font-bold text-slate-900">@Localizer["👋 Hello, {0}", User.Identity?.Name ?? ""]</h1>
            <p class="text-slate-500 mt-1">@Localizer["Manage your items, rentals, and borrowings in one place."]</p>
        </div>
        <div class="flex items-center gap-3">
            <span id="connectionIndicator" class="px-3 py-1.5 bg-slate-200 text-slate-600 text-sm font-medium rounded-full">
                @Localizer["Offline"]
            </span>
            <a asp-controller="Items" asp-action="Create" 
               class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white font-semibold rounded-xl shadow-sm  transition-all">
                <i class="bi bi-plus-lg"></i>
                @Localizer["Add Item"]
            </a>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <!-- Toast Container -->
    <div id="toastContainer" class="fixed top-20 right-4 z-50 space-y-2"></div>

    <!-- Alerts -->
    @await Html.PartialAsync("_Alert")

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-8">
        @await Html.PartialAsync("_StatCard", new { Icon = "bi-box-seam", IconColor = "blue", Value = Model.ListingsOwned?.Count() ?? 0, Label = "My Items", Link = (string?)null, LinkText = (string?)null })
        @await Html.PartialAsync("_StatCard", new { Icon = "bi-graph-up-arrow", IconColor = "green", Value = Model.OwnerRentals?.Count() ?? 0, Label = "Renting Out", Link = (string?)null, LinkText = (string?)null })
        @await Html.PartialAsync("_StatCard", new { Icon = "bi-bag", IconColor = "purple", Value = Model.MyRentals?.Count() ?? 0, Label = "My Rentals", Link = (string?)null, LinkText = (string?)null })
        @await Html.PartialAsync("_StatCard", new { Icon = "bi-star", IconColor = "amber", Value = Model.ListingsOwned?.Sum(i => i.ReviewCount) ?? 0, Label = "Reviews", Link = (string?)null, LinkText = (string?)null })
        <div class="bg-white rounded-2xl border border-slate-200 p-5">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center">
                    <i class="bi bi-heart-fill text-red-500 text-xl"></i>
                </div>
                <div>
                    <p class="text-2xl font-bold text-slate-900" data-favorites-count>@(Model.FavoriteItems?.Count ?? 0)</p>
                    <p class="text-sm text-slate-500">@Localizer["Favorites"]</p>
                </div>
            </div>
        </div>
    </div>

    <div class="space-y-8">
        <!-- My Items Section -->
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
                <h2 class="font-heading text-lg font-bold text-slate-900 flex items-center gap-2">
                    <i class="bi bi-box-seam text-blue-600"></i>
                    @Localizer["My Items"]
                </h2>
            </div>

            @if (Model.ListingsOwned?.Any() ?? false)
            {
                <div class="divide-y divide-slate-100">
                    @foreach (var item in Model.ListingsOwned)
                    {
                        <div class="p-4 hover:bg-slate-50 transition-colors">
                            <div class="flex items-center gap-4">
                                <!-- Image -->
                                <div class="w-16 h-16 shrink-0">
                                    @if(!string.IsNullOrEmpty(item.ImageUrl)) {
                                        var thumbUrl = item.ImageUrl.Replace("/upload/", "/upload/c_thumb,w_100,h_100,g_face,q_auto/");
                                        <img src="@thumbUrl" class="w-full h-full rounded-xl object-cover" />
                                    } else {
                                        <div class="w-full h-full bg-slate-100 rounded-xl flex items-center justify-center">
                                            <i class="bi bi-image text-slate-400"></i>
                                        </div>
                                    }
                                </div>
                                
                                <!-- Info -->
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2">
                                        <h3 class="font-semibold text-slate-900 truncate">@item.Title</h3>
                                        @if (item.IsListed)
                                        {
                                            <span class="px-2 py-0.5 bg-green-100 text-green-700 text-xs font-medium rounded-full">@Localizer["Listed"]</span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 bg-red-100 text-red-700 text-xs font-medium rounded-full">@Localizer["Hidden"]</span>
                                        }
                                        @if (item.IsAdminHidden)
                                        {
                                            <span class="px-2 py-0.5 bg-amber-100 text-amber-700 text-xs font-medium rounded-full" title="@Localizer["Hidden by moderator"]">
                                                <i class="bi bi-shield-exclamation"></i> @Localizer["Moderated"]
                                            </span>
                                        }
                                    </div>
                                    <p class="text-sm text-slate-500">@Localizer[item.Category ?? "Uncategorized"]</p>
                                    <div class="flex items-center gap-4 mt-1 text-sm">
                                        <span class="font-semibold text-blue-600">@CurrencyService.Format(item.Price)/@Localizer["day"]</span>
                                        <span class="text-slate-400">•</span>
                                        <span class="text-slate-500"><i class="bi bi-star-fill text-amber-400"></i> @(item.AverageRating?.ToString("0.0") ?? "-")</span>
                                        <span class="text-slate-400">•</span>
                                        <span class="text-slate-500">@item.ReviewCount @Localizer["reviews"]</span>
                                    </div>
                                </div>
                                
                                <!-- Actions -->
                                <div class="flex items-center gap-2">
                                    <button onclick="toggleListing(@item.Id, this)" 
                                            class="p-2 text-slate-500 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors" 
                                            title="@(item.IsListed ? Localizer["Hide from marketplace"] : Localizer["List on marketplace"])">
                                        @if(item.IsListed) { <i class="bi bi-eye-slash"></i> } else { <i class="bi bi-eye"></i> }
                                    </button>
                                    <a asp-controller="Items" asp-action="Edit" asp-route-id="@item.Id" 
                                       class="p-2 text-slate-500 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors"
                                       title="@Localizer["Edit"]">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-controller="Items" asp-action="Delete" asp-route-id="@item.Id" 
                                       class="p-2 text-slate-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors"
                                       title="@Localizer["Delete"]">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="py-12 text-center">
                    <i class="bi bi-box-seam text-6xl text-slate-200"></i>
                    <h3 class="mt-4 text-lg font-semibold text-slate-900">@Localizer["You have no listed items yet."]</h3>
                    <p class="text-slate-500 mt-1">@Localizer["Start earning by listing your first item"]</p>
                    <a asp-controller="Items" asp-action="Create" class="inline-flex items-center gap-2 mt-4 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors">
                        <i class="bi bi-plus-lg"></i>
                        @Localizer["Add First Item"]
                    </a>
                </div>
            }
        </div>

        <!-- Renting Out (Owner) Section -->
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200">
                <h2 class="font-heading text-lg font-bold text-slate-900 flex items-center gap-2">
                    <i class="bi bi-graph-up-arrow text-green-600"></i>
                    @Localizer["Renting Out (Owner)"]
                </h2>
            </div>

            @if (Model.OwnerRentals?.Any() ?? false)
            {
                <div class="divide-y divide-slate-100">
                    @foreach (var rental in Model.OwnerRentals)
                    {
                        <div class="p-4 hover:bg-slate-50 transition-colors">
                            <div class="flex flex-col sm:flex-row sm:items-center gap-4">
                                <div class="flex-1">
                                    <h3 class="font-semibold text-slate-900">@rental.Item?.Title</h3>
                                    <div class="flex items-center gap-2 mt-1">
                                        @if (!string.IsNullOrEmpty(rental.Renter?.ProfilePictureUrl))
                                        {
                                            <img src="@rental.Renter.ProfilePictureUrl" class="w-6 h-6 rounded-full object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center text-xs">
                                                <i class="bi bi-person"></i>
                                            </div>
                                        }
                                        <span class="text-sm text-slate-500">@rental.Renter?.Email</span>
                                    </div>
                                </div>
                                
                                <div class="flex flex-wrap items-center gap-4 text-sm">
                                    <div class="text-slate-500">
                                        @rental.StartDate.ToString("dd.MM") <i class="bi bi-arrow-right mx-1"></i> @rental.EndDate.ToString("dd.MM.yyyy")
                                    </div>
                                    <div class="font-bold text-green-600">@CurrencyService.Format(rental.TotalPrice)</div>
                                    
                                    @if (rental.Status == RentalStatus.Pending)
                                    {
                                        <span class="px-2 py-1 bg-amber-100 text-amber-700 text-xs font-medium rounded-full">@Localizer["Pending"]</span>
                                    }
                                    else if (rental.Status == RentalStatus.Active)
                                    {
                                        <span class="px-2 py-1 bg-blue-100 text-blue-700 text-xs font-medium rounded-full">@Localizer["Active"]</span>
                                    }
                                    else if (rental.Status == RentalStatus.Completed)
                                    {
                                        <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-medium rounded-full">@Localizer["Completed"]</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 bg-red-100 text-red-700 text-xs font-medium rounded-full">@Localizer["Cancelled"]</span>
                                    }
                                </div>
                                
                                <div class="flex items-center gap-2">
                                    @if (rental.Status == RentalStatus.Pending)
                                    {
                                        <form asp-controller="Rentals" asp-action="ApproveRental" method="post" class="inline">
                                            <input type="hidden" name="rentalId" value="@rental.Id" />
                                            <button class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg transition-colors">
                                                <i class="bi bi-check-lg"></i> @Localizer["Approve"]
                                            </button>
                                        </form>
                                        <form asp-controller="Rentals" asp-action="CancelRental" method="post" class="inline">
                                            <input type="hidden" name="rentalId" value="@rental.Id" />
                                            <button class="px-4 py-2 border border-red-300 text-red-600 hover:bg-red-50 text-sm font-medium rounded-lg transition-colors">
                                                <i class="bi bi-x-lg"></i> @Localizer["Reject"]
                                            </button>
                                        </form>
                                    }
                                    else if (rental.Status == RentalStatus.Active)
                                    {
                                        <form asp-controller="Rentals" asp-action="CompleteRental" method="post" class="inline">
                                            <input type="hidden" name="rentalId" value="@rental.Id" />
                                            <button class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
                                                @Localizer["Mark Returned"]
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="py-12 text-center">
                    <i class="bi bi-calendar-x text-6xl text-slate-200"></i>
                    <h3 class="mt-4 text-lg font-semibold text-slate-900">@Localizer["No rental requests at the moment."]</h3>
                    <p class="text-slate-500 mt-1">@Localizer["When someone wants to rent your items, you'll see them here"]</p>
                </div>
            }
        </div>

        <!-- My Rentals (From Others) Section -->
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
                <h2 class="font-heading text-lg font-bold text-slate-900 flex items-center gap-2">
                    <i class="bi bi-bag text-purple-600"></i>
                    @Localizer["My Rentals (From Others)"]
                </h2>
                <a asp-controller="Rentals" asp-action="Index" class="text-sm text-blue-600 hover:text-blue-700 font-medium">
                    <i class="bi bi-search me-1"></i> @Localizer["Browse Marketplace"]
                </a>
            </div>

            @if (Model.MyRentals?.Any() ?? false)
            {
                <div class="divide-y divide-slate-100">
                    @foreach (var rental in Model.MyRentals)
                    {
                        <div class="p-4 hover:bg-slate-50 transition-colors">
                            <div class="flex flex-col sm:flex-row sm:items-center gap-4">
                                <div class="flex-1">
                                    <h3 class="font-semibold text-slate-900">@rental.Item?.Title</h3>
                                    <div class="flex items-center gap-2 mt-1">
                                        @if (!string.IsNullOrEmpty(rental.Item?.User?.ProfilePictureUrl))
                                        {
                                            <img src="@rental.Item.User.ProfilePictureUrl" class="w-6 h-6 rounded-full object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-6 h-6 bg-slate-600 text-white rounded-full flex items-center justify-center text-xs">
                                                <i class="bi bi-person"></i>
                                            </div>
                                        }
                                        <span class="text-sm text-slate-500">@Localizer["From"] @rental.Item?.User?.FirstName</span>
                                    </div>
                                </div>
                                
                                <div class="flex flex-wrap items-center gap-4 text-sm">
                                    <div class="text-slate-500">
                                        @rental.StartDate.ToString("dd.MM") <i class="bi bi-arrow-right mx-1"></i> @rental.EndDate.ToString("dd.MM.yyyy")
                                    </div>
                                    <div class="font-bold text-slate-900">@CurrencyService.Format(rental.TotalPrice)</div>
                                    
                                    @if (rental.Status == RentalStatus.Pending)
                                    {
                                        <span class="px-2 py-1 bg-amber-100 text-amber-700 text-xs font-medium rounded-full">@Localizer["Pending"]</span>
                                    }
                                    else if (rental.Status == RentalStatus.Active)
                                    {
                                        <span class="px-2 py-1 bg-blue-100 text-blue-700 text-xs font-medium rounded-full">@Localizer["Active"]</span>
                                    }
                                    else if (rental.Status == RentalStatus.Completed)
                                    {
                                        <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-medium rounded-full">@Localizer["Completed"]</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 bg-red-100 text-red-700 text-xs font-medium rounded-full">@Localizer["Cancelled"]</span>
                                    }
                                </div>
                                
                                <div class="flex items-center gap-2">
                                    @{
                                        // Check if this rental already has a review from the current user
                                        var hasReview = rental.Item?.Reviews?.Any(r => r.RentalId == rental.Id && !r.IsDeleted) ?? false;
                                    }
                                    @if (rental.Status == RentalStatus.Completed && !hasReview)
                                    {
                                        <button class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white text-sm font-medium rounded-lg transition-colors"
                                                data-bs-toggle="modal" data-bs-target="#reviewModal" data-rentalid="@rental.Id">
                                            <i class="bi bi-star"></i> @Localizer["Leave Review"]
                                        </button>
                                    }
                                    else if (rental.Status == RentalStatus.Pending)
                                    {
                                        <form asp-controller="Rentals" asp-action="CancelRental" method="post" class="inline">
                                            <input type="hidden" name="rentalId" value="@rental.Id" />
                                            <button class="px-4 py-2 border border-slate-300 text-slate-600 hover:bg-slate-50 text-sm font-medium rounded-lg transition-colors">
                                                @Localizer["Cancel Request"]
                                            </button>
                                        </form>
                                    }
                                    <a asp-controller="Items" asp-action="Details" asp-route-id="@rental.ItemId" 
                                       class="p-2 text-slate-500 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="py-12 text-center">
                    <i class="bi bi-bag text-6xl text-slate-200"></i>
                    <h3 class="mt-4 text-lg font-semibold text-slate-900">@Localizer["You haven't rented anything yet."]</h3>
                    <p class="text-slate-500 mt-1">@Localizer["Explore the marketplace to find items to rent"]</p>
                    <a asp-controller="Rentals" asp-action="Index" class="inline-flex items-center gap-2 mt-4 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors">
                        <i class="bi bi-search"></i>
                        @Localizer["Browse Marketplace"]
                    </a>
                </div>
            }
        </div>

        <!-- Saved Favorites Section -->
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
                <h2 class="font-heading text-lg font-bold text-slate-900 flex items-center gap-2">
                    <i class="bi bi-heart-fill text-red-500"></i>
                    @Localizer["Saved Favorites"]
                </h2>
                <a asp-controller="Rentals" asp-action="Index" class="text-sm text-blue-600 hover:text-blue-700 font-medium">
                    <i class="bi bi-plus-lg me-1"></i> @Localizer["Find More"]
                </a>
            </div>

            @if (Model.FavoriteItems?.Any() ?? false)
            {
                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 p-4">
                    @foreach (var item in Model.FavoriteItems)
                    {
                        <div class="group relative bg-slate-50 rounded-xl overflow-hidden hover:shadow-md transition-all" data-favorite-card>
                            <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="block">
                                <!-- Image -->
                                <div class="aspect-[4/3] relative overflow-hidden">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        var thumbUrl = item.ImageUrl.Replace("/upload/", "/upload/c_fill,w_400,h_300,q_auto/");
                                        <img src="@thumbUrl" alt="@item.Title" 
                                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                    }
                                    else
                                    {
                                        <div class="w-full h-full bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center">
                                            <i class="bi bi-image text-4xl text-slate-300"></i>
                                        </div>
                                    }
                                    
                                    <!-- Rating Badge -->
                                    @if (item.AverageRating.HasValue)
                                    {
                                        <div class="absolute bottom-2 left-2 flex items-center gap-1 px-2 py-1 bg-white/90 rounded-lg text-xs font-semibold shadow-sm" style="-webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);">
                                            <i class="bi bi-star-fill text-amber-400"></i>
                                            <span class="text-slate-800">@item.AverageRating.Value.ToString("0.0")</span>
                                        </div>
                                    }
                                </div>
                                
                                <!-- Content -->
                                <div class="p-3">
                                    <h3 class="font-semibold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-1">
                                        @item.Title
                                    </h3>
                                    @if (!string.IsNullOrEmpty(item.Location) || !string.IsNullOrEmpty(item.User?.City))
                                    {
                                        <p class="text-xs text-slate-500 flex items-center gap-1 mt-1">
                                            <i class="bi bi-geo-alt text-blue-500"></i> 
                                            @(item.Location ?? item.User?.City)
                                        </p>
                                    }
                                    <div class="flex items-center justify-between mt-2">
                                        <span class="font-bold text-slate-900">@CurrencyService.Format(item.Price)<span class="text-slate-500 font-normal text-xs">/@Localizer["day"]</span></span>
                                    </div>
                                </div>
                            </a>
                            
                            <!-- Favorite Button (positioned absolutely) -->
                            <div class="absolute top-2 right-2">
                                @await Html.PartialAsync("_FavoriteButton", new RentMate.Models.ViewModels.FavoriteButtonViewModel {
                                    ItemId = item.Id,
                                    IsFavorited = true,
                                    Size = "sm"
                                })
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="py-12 text-center">
                    <i class="bi bi-heart text-6xl text-slate-200"></i>
                    <h3 class="mt-4 text-lg font-semibold text-slate-900">@Localizer["No favorites yet"]</h3>
                    <p class="text-slate-500 mt-1">@Localizer["Items you favorite will appear here for quick access"]</p>
                    <a asp-controller="Rentals" asp-action="Index" class="inline-flex items-center gap-2 mt-4 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors">
                        <i class="bi bi-search"></i>
                        @Localizer["Browse Marketplace"]
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        // Toggle listing visibility
        async function toggleListing(itemId, btn) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const response = await fetch(`/Items/ToggleListing/${itemId}`, { 
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': token
                    }
                });
                if (response.ok) {
                    location.reload();
                } else {
                    console.error('Failed to toggle listing:', response.statusText);
                }
            } catch (error) {
                console.error('Error toggling listing:', error);
            }
        }

        // SignalR connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/rentMateHub")
            .withAutomaticReconnect()
            .build();

        connection.on("RentalRequested", () => location.reload());
        connection.on("RentalApproved", () => location.reload());
        connection.on("RentalCompleted", () => location.reload());
        connection.on("RentalCancelled", () => location.reload());

        connection.start()
            .then(() => {
                document.getElementById('connectionIndicator').className = 'px-3 py-1.5 bg-green-100 text-green-700 text-sm font-medium rounded-full';
                document.getElementById('connectionIndicator').textContent = '@Localizer["Live"]';
            })
            .catch(err => console.error('SignalR Error:', err));
    </script>
}


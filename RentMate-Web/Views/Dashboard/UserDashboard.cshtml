                                    <i class="bi bi-cloud-upload text-3xl text-slate-400 mb-2"></i>
                                    <p class="text-xs text-slate-500 font-medium">@Localizer["Click to upload evidence"]</p>
                                </div>
                                <input type="file" id="dispute-evidence-file" class="hidden" accept="image/*" />
                            </label>
                        </div>
                        <div id="dispute-evidence-preview" class="mt-3 hidden">
                            <div class="flex items-center gap-2 p-2 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-100 dark:border-emerald-800 rounded-xl">
                                <i class="bi bi-file-earmark-check text-emerald-600"></i>
                                <span class="text-xs text-emerald-700 dark:text-emerald-400 font-medium truncate" id="dispute-filename"></span>
                                <button onclick="clearDisputeEvidence()" class="ml-auto p-1 hover:bg-emerald-100 dark:hover:bg-emerald-800 rounded-lg">
                                    <i class="bi bi-x text-emerald-600"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-8 flex gap-3">
                    <button data-action="close-dispute" class="flex-1 px-6 py-3 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 font-bold rounded-2xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-all">
                        @Localizer["Cancel"]
                    </button>
                    <button id="dispute-submit-btn" onclick="submitDispute()" class="flex-1 px-6 py-3 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-2xl shadow-lg shadow-rose-600/20 transition-all">
                        @Localizer["Submit Dispute"]
                    </button>
                </div>
            </div>
        </div>
    </div>


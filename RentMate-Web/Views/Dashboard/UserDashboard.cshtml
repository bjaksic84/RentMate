@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Identity
@using RentMate.Shared.Contracts.Responses
@using RentMate.Models.Domain
@model RentMate.Models.ViewModels.DashboardViewModel
@inject IViewLocalizer Localizer
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = Localizer["Dashboard"];
    var activeMyRentals = Model.MyRentals?.Where(r => r.Status == RentalStatus.Active).ToList() ?? new();
    var activeOwnerRentals = Model.OwnerRentals?.Where(r => r.Status == RentalStatus.Active).ToList() ?? new();
    var currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var rawName = currentUser?.UserName ?? User.Identity?.Name;
    var atIndex = rawName?.IndexOf('@') ?? -1;
    var displayName = atIndex > 0 ? rawName![..atIndex] : (rawName ?? string.Empty);
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
        <div>
            <h1 class="font-outfit text-3xl font-bold text-slate-900 dark:text-white">
                @Localizer["Hello, {0}", displayName]
            </h1>
            <p class="text-slate-500 dark:text-slate-400 mt-1">
                @Localizer["Manage your items, rentals, and borrowings in one place."]
            </p>
        </div>
        <div class="flex items-center gap-3">
            <span id="connectionIndicator" class="px-3 py-1.5 bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-400 text-sm font-medium rounded-full">
                @Localizer["Offline"]
            </span>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="AdminDashboard"
                   class="inline-flex items-center gap-2 px-5 py-2.5 border border-trust-blue-200 dark:border-trust-blue-800 text-trust-blue-600 dark:text-trust-blue-400 font-medium rounded-xl hover:bg-trust-blue-50 dark:hover:bg-trust-blue-900/20 transition-all">
                    <i class="bi bi-shield-lock"></i>
                    @Localizer["Admin Panel"]
                </a>
            }
            <a asp-controller="Items" asp-action="Create"
               class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-trust-blue-600 to-trust-blue-700 hover:brightness-110 text-white font-medium rounded-xl shadow-sm transition-all">
                <i class="bi bi-plus-lg"></i>
                @Localizer["Add Item"]
            </a>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <!-- Toast Container -->
    <div id="toastContainer" class="fixed top-20 right-4 space-y-2" style="z-index: var(--z-toast, 1500);"></div>

    <!-- Alerts -->
    @await Html.PartialAsync("_Alert")

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
        @await Html.PartialAsync("_StatCard", new { Icon = "bi-bag", IconColor = "purple", Value = activeMyRentals.Count, Label = "Active Rentals", Link = (string?)null, LinkText = (string?)null })
        @await Html.PartialAsync("_StatCard", new { Icon = "bi-graph-up-arrow", IconColor = "green", Value = activeOwnerRentals.Count, Label = "Renting Out", Link = (string?)null, LinkText = (string?)null })
        @await Html.PartialAsync("_StatCard", new { Icon = "bi-calendar-plus", IconColor = "blue", Value = Model.PendingExtensionCount, Label = "Pending Extensions", Link = (string?)null, LinkText = (string?)null })
        @await Html.PartialAsync("_StatCard", new { Icon = "bi-shield-check", IconColor = "amber", Value = CurrencyService.Format(Model.DepositSummary?.TotalHeld ?? 0), Label = "Deposits Held", Link = (string?)null, LinkText = (string?)null })
    </div>

    <!-- Attention Required Banner -->
    @await Html.PartialAsync("_AttentionBanner", Model)

    <!-- Two-Column Layout -->
    <div class="flex flex-col lg:flex-row gap-8">
        <!-- Left Column (Main Content) -->
        <div class="flex-1 lg:w-2/3 space-y-8">
            @await Html.PartialAsync("_MyRentals", Model)
            @await Html.PartialAsync("_RentingOut", Model)
            @await Html.PartialAsync("_RentalHistory", Model)
        </div>

        <!-- Right Column (Sidebar) -->
        @await Html.PartialAsync("_DashboardSidebar", Model)
    </div>
</div>

<!-- Modals -->
@await Html.PartialAsync("_RentalModals", Model)
@await Html.PartialAsync("_DepositModals", Model)
@await Html.PartialAsync("_DisputeModals", Model)

@section Scripts {
    <script>
        window.DashboardConfig = {
            urls: {
                toggleListing: '/Items/ToggleListing/',
                getBookedDates: '/Items/GetBookedDates',
                requestExtension: '/Dashboard/RequestExtension',
                approveExtension: '/Dashboard/ApproveExtension',
                declineExtension: '/Dashboard/DeclineExtension',
                cancelExtension: '/Dashboard/CancelExtension',
                releaseDeposit: '/Dispute/ReleaseDeposit',
                chargeDeposit: '/Dispute/ChargeDeposit',
                completeWithDeposit: '/Dispute/CompleteWithDeposit',
                disputeDeposit: '/Dispute/DisputeDeposit',
                counterOfferDeposit: '/Dispute/CounterOfferDeposit',
                maintainCharge: '/Dispute/MaintainCharge',
                acceptCharge: '/Dispute/AcceptCharge',
                acceptCounterOffer: '/Dispute/AcceptCounterOffer',
                rejectCounterOffer: '/Dispute/RejectCounterOffer',
                releaseDisputedDeposit: '/Dispute/ReleaseDisputedDeposit',
                escalateDispute: '/Dispute/EscalateDispute',
                uploadEvidence: '/Dispute/UploadDisputeEvidence',
                reviewsMineItem: '/api/Reviews/mine/item/',
                reviewSubmit: '/api/Reviews/',
                signalRHub: '/rentmateHub'
            },
            strings: {
                day: '@Localizer["day"]',
                days: '@Localizer["days"]',
                submitting: '@Localizer["Submitting..."]',
                requestExtension: '@Localizer["Request Extension"]',
                somethingWentWrong: '@Localizer["Something went wrong"]',
                editReview: '@Localizer["Edit Review"]',
                leaveReview: '@Localizer["Leave a Review"]',
                updateReview: '@Localizer["Update Review"]',
                submitReview: '@Localizer["Submit Review"]',
                pleaseSelectRating: '@Localizer["Please select a rating"]',
                failedToSubmitReview: '@Localizer["Failed to submit review"]',
                anErrorOccurred: '@Localizer["An error occurred. Please try again."]',
                live: '@Localizer["Live"]',
                newRentalRequest: '@Localizer["New rental request for"]',
                rentalStatusUpdated: '@Localizer["Rental status updated for"]',
                newExtensionRequest: '@Localizer["New extension request for"]',
                extensionStatusUpdated: '@Localizer["Extension status updated for"]',
                rentalFor: '@Localizer["Rental for"]',
                isOverdueBy: '@Localizer["is overdue by"]',
                depositStatusUpdated: '@Localizer["Deposit status updated for"]',
                disputeEscalated: '@Localizer["Dispute escalated for"]',
                depositReleased: '@Localizer["Deposit released for"]',
                disputeResolved: '@Localizer["Dispute resolved for"]',
                settlementReached: '@Localizer["Settlement reached for"]',
                newCounterOffer: '@Localizer["New counter-offer for"]',
                counterOfferRejected: '@Localizer["Counter-offer rejected for"]',
                depositDisputed: '@Localizer["Deposit disputed for"]',
                depositCharged: '@Localizer["Deposit charged for"]',
                enterValidAmount: '@Localizer["Enter a valid amount"]',
                amountExceedsDeposit: '@Localizer["Amount exceeds deposit"]',
                pleaseProvideReason: '@Localizer["Please provide a reason"]',
                pleaseProvideProof: '@Localizer["Please provide a picture for proof"]',
                counterOfferMustBeLess: '@Localizer["Counter-offer must be less than current charge"]',
                maximum: '@Localizer["Maximum"]',
                pleaseSelectFile: '@Localizer["Please select a file."]',
                uploading: '@Localizer["Uploading..."]',
                evidenceAddedSuccess: '@Localizer["Evidence added successfully."]',
                uploadFailed: '@Localizer["Upload failed."]',
                unexpectedError: '@Localizer["An unexpected error occurred."]',
                upload: '@Localizer["Upload"]',
                processing: '@Localizer["Processing..."]',
                confirmSendAdmin: '@Localizer["Confirm & Send to Admin"]',
                releaseDisputedConfirm: '@Localizer["Release this disputed deposit back to the renter?"]',
                maintainChargeConfirm: '@Localizer["Maintain current charge and send to admin review?"]',
                acceptChargeConfirm: '@Localizer["Accept this charge and close the dispute?"]',
                acceptCounterOfferConfirm: '@Localizer["Accept counter-offer and pay the settled amount?"]',
                rejectCounterOfferConfirm: '@Localizer["Reject counter-offer? The original charge will stand and you can dispute again."]',
                disputeSubmittedEvidenceFailed: '@Localizer["Dispute submitted, but evidence upload failed."]'
            }
        };
    </script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/dashboard.js"></script>
    <script src="~/js/dashboard-disputes.js"></script>
}

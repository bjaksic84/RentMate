@using Microsoft.AspNetCore.Mvc.Localization
@using RentMate.Shared.Contracts.Responses
@using RentMate.Models.Domain
@model RentMate.Models.ViewModels.DashboardViewModel
@inject IViewLocalizer Localizer
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService

@{
    ViewData["Title"] = Localizer["Dashboard"];
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    // Compute attention items
    var pendingOwnerRentals = Model.OwnerRentals?.Where(r => r.Status == RentalStatus.Pending).ToList() ?? new();
    var overdueRentals = Model.MyRentals?.Where(r => r.Status == RentalStatus.Active && r.EndDate.Date < DateTime.UtcNow.Date).ToList() ?? new();
    var activeMyRentals = Model.MyRentals?.Where(r => r.Status == RentalStatus.Active).ToList() ?? new();
    var activeOwnerRentals = Model.OwnerRentals?.Where(r => r.Status == RentalStatus.Active).ToList() ?? new();
    var pendingMyRentals = Model.MyRentals?.Where(r => r.Status == RentalStatus.Pending || r.Status == RentalStatus.Accepted).ToList() ?? new();
    var pendingOwnerRentalCount = pendingOwnerRentals.Count;
    var overdueCount = overdueRentals.Count;

    // Dispute chips: rentals with deposit in disputed/counter-offered/escalated state
    var disputedAsRenter = Model.MyRentals?.Where(r =>
        r.Deposit != null &&
        (r.Deposit.Status == DepositStatus.Disputed ||
         r.Deposit.Status == DepositStatus.CounterOffered ||
         r.Deposit.Status == DepositStatus.Escalated)).ToList() ?? new();
    var disputedAsOwner = Model.OwnerRentals?.Where(r =>
        r.Deposit != null &&
        (r.Deposit.Status == DepositStatus.Disputed ||
         r.Deposit.Status == DepositStatus.CounterOffered ||
         r.Deposit.Status == DepositStatus.Escalated)).ToList() ?? new();
    var totalDisputes = disputedAsRenter.Count + disputedAsOwner.Count;

    // Deposit charged: rentals where the renter's deposit was charged (needs attention to dispute or accept)
    var chargedDepositsAsRenter = Model.MyRentals?.Where(r =>
        r.Deposit != null &&
        (r.Deposit.Status == DepositStatus.Charged ||
         r.Deposit.Status == DepositStatus.PartiallyCharged)).ToList() ?? new();
    var chargedDepositCount = chargedDepositsAsRenter.Count;

    var hasAttentionItems = pendingOwnerRentalCount > 0 || overdueCount > 0 || totalDisputes > 0 || chargedDepositCount > 0;

    // Completed rentals with unresolved deposits (need to stay visible in active tabs)
    var completedRenterWithDeposit = Model.MyRentals?.Count(r =>
        r.Status == RentalStatus.Completed && r.Deposit != null &&
        (r.Deposit.Status == DepositStatus.Charged ||
         r.Deposit.Status == DepositStatus.PartiallyCharged ||
         r.Deposit.Status == DepositStatus.Disputed ||
         r.Deposit.Status == DepositStatus.CounterOffered ||
         r.Deposit.Status == DepositStatus.Escalated)) ?? 0;
    var completedOwnerWithDeposit = Model.OwnerRentals?.Count(r =>
        r.Status == RentalStatus.Completed && r.Deposit != null &&
        (r.Deposit.Status == DepositStatus.Charged ||
         r.Deposit.Status == DepositStatus.PartiallyCharged ||
         r.Deposit.Status == DepositStatus.Disputed ||
         r.Deposit.Status == DepositStatus.CounterOffered ||
         r.Deposit.Status == DepositStatus.Escalated)) ?? 0;

    // Tab counts
    var myRentalsCount = (activeMyRentals.Count + pendingMyRentals.Count + completedRenterWithDeposit);
    var rentingOutCount = activeOwnerRentals.Count + pendingOwnerRentalCount + completedOwnerWithDeposit;
    var myItemsCount = Model.ListingsOwned?.Count ?? 0;
    var favoritesCount = Model.FavoriteItems?.Count ?? 0;

    // Defensive date range formatter — ensures earlier date is always shown first
    string FormatDateRange(DateTime a, DateTime b) {
        var first = a <= b ? a : b;
        var second = a <= b ? b : a;
        return $"{first.ToString("dd MMM")} → {second.ToString("dd MMM yyyy")}";
    }
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    @Html.AntiForgeryToken()
    <div id="toastContainer" class="fixed top-20 right-4 z-50 space-y-2"></div>
    @await Html.PartialAsync("_Alert")

    <!-- ═══════════════════════════════════════════════
         HEADER
         ═══════════════════════════════════════════════ -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
            <h1 class="font-display font-bold text-2xl text-ledger-900 dark:text-white">
                @Localizer["Hello, {0}", User.Identity?.Name ?? ""]
            </h1>
            <p class="text-ledger-400 dark:text-ledger-500 mt-0.5 text-sm">
                @Localizer["Manage your items, rentals, and borrowings in one place."]
            </p>
        </div>
        <div class="flex items-center gap-3">
            <!-- Connection indicator: dot + label -->
            <span id="connectionIndicator" class="inline-flex items-center gap-1.5 text-xs text-ledger-400 dark:text-ledger-500">
                <span id="connectionDot" class="w-2 h-2 rounded-full bg-ledger-300 dark:bg-ledger-600"></span>
                <span id="connectionLabel">@Localizer["Offline"]</span>
            </span>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="AdminDashboard"
                   class="text-sm font-medium text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 transition-colors">
                    <i class="bi bi-shield-lock mr-1"></i>@Localizer["Admin Panel"]
                </a>
            }
            <a asp-controller="Items" asp-action="Create"
               class="inline-flex items-center gap-1.5 px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium rounded-full shadow-sm transition-colors duration-150">
                <i class="bi bi-plus-lg"></i>@Localizer["Add Item"]
            </a>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════
         ATTENTION BAR (chips — filled by Step 6)
         ═══════════════════════════════════════════════ -->
    <div id="attention-bar"
         class="@(hasAttentionItems ? "flex" : "hidden") flex-wrap items-center gap-2 mb-6"
         data-overdue="@overdueCount"
         data-pending-approvals="@pendingOwnerRentalCount"
         data-disputes="@totalDisputes"
         data-disputes-renter="@disputedAsRenter.Count"
         data-disputes-owner="@disputedAsOwner.Count">
        @if (overdueCount > 0)
        {
            <button type="button"
                    class="attention-chip inline-flex items-center gap-1.5 px-3 h-8 rounded-full text-xs font-medium bg-rose-50 text-rose-700 dark:bg-rose-900/20 dark:text-rose-400 cursor-pointer transition-colors duration-150 hover:bg-rose-100 dark:hover:bg-rose-900/40"
                    data-attention-tab="my-rentals"
                    data-attention-type="overdue"
                    aria-label="@Localizer["{0} overdue rentals — click to view", overdueCount]">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@overdueCount @Localizer["Overdue"]</span>
            </button>
        }
        @if (pendingOwnerRentalCount > 0)
        {
            <button type="button"
                    class="attention-chip inline-flex items-center gap-1.5 px-3 h-8 rounded-full text-xs font-medium bg-amber-50 text-amber-700 dark:bg-amber-900/20 dark:text-amber-400 cursor-pointer transition-colors duration-150 hover:bg-amber-100 dark:hover:bg-amber-900/40"
                    data-attention-tab="renting-out"
                    data-attention-type="pending-approval"
                    aria-label="@Localizer["{0} pending approvals — click to view", pendingOwnerRentalCount]">
                <i class="bi bi-clock-fill"></i>
                <span>@pendingOwnerRentalCount @Localizer["Pending Approvals"]</span>
            </button>
        }
        @if (totalDisputes > 0)
        {
            // Disputes: if more disputes are renter-side → my-rentals; else renting-out
            var disputeTab = disputedAsRenter.Count >= disputedAsOwner.Count ? "my-rentals" : "renting-out";
            <button type="button"
                    class="attention-chip inline-flex items-center gap-1.5 px-3 h-8 rounded-full text-xs font-medium bg-purple-50 text-purple-700 dark:bg-purple-900/20 dark:text-purple-400 cursor-pointer transition-colors duration-150 hover:bg-purple-100 dark:hover:bg-purple-900/40"
                    data-attention-tab="@disputeTab"
                    data-attention-type="dispute"
                    aria-label="@Localizer["{0} active disputes — click to view", totalDisputes]">
                <i class="bi bi-shield-exclamation"></i>
                <span>@totalDisputes @Localizer["Disputes"]</span>
            </button>
        }
        @if (chargedDepositCount > 0)
        {
            <button type="button"
                    class="attention-chip inline-flex items-center gap-1.5 px-3 h-8 rounded-full text-xs font-medium bg-rose-50 text-rose-700 dark:bg-rose-900/20 dark:text-rose-400 cursor-pointer transition-colors duration-150 hover:bg-rose-100 dark:hover:bg-rose-900/40"
                    data-attention-tab="my-rentals"
                    data-attention-type="deposit-charged"
                    aria-label="@Localizer["{0} deposits charged — click to review", chargedDepositCount]">
                <i class="bi bi-cash-coin"></i>
                <span>@chargedDepositCount @Localizer["Deposit Charged"]</span>
            </button>
        }
    </div>

    <!-- ═══════════════════════════════════════════════
         STATS ROW
         ═══════════════════════════════════════════════ -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
        @await Html.PartialAsync("_StatCard", new { Icon = "bi-bag", IconColor = "purple", Value = activeMyRentals.Count, Label = "Active Rentals", Link = (string?)null, LinkText = (string?)null })
        @await Html.PartialAsync("_StatCard", new { Icon = "bi-graph-up-arrow", IconColor = "green", Value = activeOwnerRentals.Count, Label = "Renting Out", Link = (string?)null, LinkText = (string?)null })
        @await Html.PartialAsync("_StatCard", new { Icon = "bi-calendar-plus", IconColor = "primary", Value = Model.PendingExtensionCount, Label = "Pending Extensions", Link = (string?)null, LinkText = (string?)null })
        @await Html.PartialAsync("_StatCard", new { Icon = "bi-shield-check", IconColor = "amber", Value = CurrencyService.Format(Model.DepositSummary?.TotalHeld ?? 0), Label = "Deposits Held", Link = (string?)null, LinkText = (string?)null })
    </div>

    <!-- ═══════════════════════════════════════════════
         TAB BAR
         ═══════════════════════════════════════════════ -->
    <div class="dash-tabs" role="tablist" aria-label="@Localizer["Dashboard sections"]" id="dashboard-tablist">

        <button id="tab-my-rentals"
                role="tab"
                aria-selected="true"
                aria-controls="tabpanel-my-rentals"
                tabindex="0"
                class="dash-tab active"
                onclick="switchTab('my-rentals')">
            @Localizer["My Rentals"]
            @if (myRentalsCount > 0)
            {
                <sup class="text-[10px] text-ledger-400 ml-0.5">@myRentalsCount</sup>
            }
        </button>

        <button id="tab-renting-out"
                role="tab"
                aria-selected="false"
                aria-controls="tabpanel-renting-out"
                tabindex="-1"
                class="dash-tab"
                onclick="switchTab('renting-out')">
            @Localizer["Renting Out"]
            @if (rentingOutCount > 0)
            {
                <sup class="text-[10px] text-ledger-400 ml-0.5">@rentingOutCount</sup>
            }
        </button>

        <button id="tab-my-items"
                role="tab"
                aria-selected="false"
                aria-controls="tabpanel-my-items"
                tabindex="-1"
                class="dash-tab"
                onclick="switchTab('my-items')">
            @Localizer["My Items"]
            @if (myItemsCount > 0)
            {
                <sup class="text-[10px] text-ledger-400 ml-0.5">@myItemsCount</sup>
            }
        </button>

        <button id="tab-history"
                role="tab"
                aria-selected="false"
                aria-controls="tabpanel-history"
                tabindex="-1"
                class="dash-tab"
                onclick="switchTab('history')">
            @Localizer["History"]
        </button>

        <button id="tab-favorites"
                role="tab"
                aria-selected="false"
                aria-controls="tabpanel-favorites"
                tabindex="-1"
                class="dash-tab"
                onclick="switchTab('favorites')">
            @Localizer["Favorites"]
            <sup class="text-[10px] text-ledger-400 ml-0.5">@favoritesCount</sup>
        </button>

    </div>

    <!-- ═══════════════════════════════════════════════
         TAB CONTENT PANELS
         ═══════════════════════════════════════════════ -->

    <!-- MY RENTALS (pre-rendered) -->
    <div id="tabpanel-my-rentals"
         role="tabpanel"
         aria-labelledby="tab-my-rentals"
         class="tab-content mt-6">
        @{
            var myRentalsDisplay = Model.MyRentals?
                .Where(r => r.Status == RentalStatus.Active
                         || r.Status == RentalStatus.Pending
                         || r.Status == RentalStatus.Accepted
                         || (r.Status == RentalStatus.Completed && r.Deposit != null &&
                             (r.Deposit.Status == DepositStatus.Charged ||
                              r.Deposit.Status == DepositStatus.PartiallyCharged ||
                              r.Deposit.Status == DepositStatus.Disputed ||
                              r.Deposit.Status == DepositStatus.CounterOffered ||
                              r.Deposit.Status == DepositStatus.Escalated)))
                .OrderBy(r => r.Status == RentalStatus.Active ? 0
                           : r.Status == RentalStatus.Accepted ? 1
                           : r.Status == RentalStatus.Pending ? 2
                           : 3)
                .ThenBy(r => r.EndDate)
                .ToList() ?? new();
        }
        @if (myRentalsDisplay.Any())
        {
            <div class="space-y-2">
                @foreach (var rental in myRentalsDisplay)
                {
                    var isOverdue = rental.Status == RentalStatus.Active && rental.EndDate.Date < DateTime.UtcNow.Date;
                    var hasDisputedDeposit = rental.Deposit != null &&
                        (rental.Deposit.Status == DepositStatus.Disputed ||
                         rental.Deposit.Status == DepositStatus.CounterOffered ||
                         rental.Deposit.Status == DepositStatus.Escalated);
                    var activeExt = rental.Extensions.FirstOrDefault(e =>
                        e.Status == ExtensionStatus.Pending ||
                        e.Status == ExtensionStatus.Accepted ||
                        e.Status == ExtensionStatus.AutoApproved);

                    var hasChargedDeposit = rental.Deposit != null &&
                        (rental.Deposit.Status == DepositStatus.Charged ||
                         rental.Deposit.Status == DepositStatus.PartiallyCharged);
                    var attType = isOverdue ? "overdue" : hasDisputedDeposit ? "dispute" : hasChargedDeposit ? "deposit-charged" : "";
                    var cardBase = "rental-row flex items-center gap-4 p-4 bg-white dark:bg-ledger-800 rounded-lg border transition-colors duration-150";
                    var cardExtra = isOverdue
                        ? " border-rose-200 dark:border-rose-800 bg-rose-50/30 dark:bg-rose-900/10"
                        : hasChargedDeposit
                        ? " border-rose-200 dark:border-rose-800 bg-rose-50/30 dark:bg-rose-900/10"
                        : " border-ledger-200 dark:border-ledger-700 hover:border-ledger-300 dark:hover:border-ledger-600";

                    var thumbUrl = !string.IsNullOrEmpty(rental.Item?.ImageUrl)
                        ? rental.Item.ImageUrl.Replace("/upload/", "/upload/c_thumb,w_112,h_112,q_auto/")
                        : "";

                    // Status badge type
                    var statusBadgeType = rental.Status switch {
                        RentalStatus.Active    => isOverdue ? "overdue" : "active",
                        RentalStatus.Pending   => "pending",
                        RentalStatus.Accepted  => "warning",
                        RentalStatus.Completed => "completed",
                        _                     => "default"
                    };
                    var statusText = rental.Status switch {
                        RentalStatus.Active    => isOverdue ? "Overdue" : "Active",
                        RentalStatus.Pending   => "Pending",
                        RentalStatus.Accepted  => "Accepted",
                        RentalStatus.Completed => "Completed",
                        _                     => rental.Status.ToString()
                    };

                    // Deposit badge type
                    var depBadgeType = rental.Deposit?.Status switch {
                        DepositStatus.Authorized       => "deposit-authorized",
                        DepositStatus.Released         => "deposit-released",
                        DepositStatus.Charged or
                        DepositStatus.PartiallyCharged => "deposit-charged",
                        DepositStatus.Disputed or
                        DepositStatus.CounterOffered or
                        DepositStatus.Escalated        => "warning",
                        _                              => "deposit-held"
                    };
                    var depText = rental.Deposit?.Status switch {
                        DepositStatus.Authorized   => "Deposit: Held",
                        DepositStatus.Released     => "Deposit: Released",
                        DepositStatus.Charged      => "Deposit: Charged",
                        DepositStatus.PartiallyCharged => "Deposit: Partial",
                        DepositStatus.Disputed     => "Deposit: Disputed",
                        DepositStatus.CounterOffered => "Counter-Offer",
                        DepositStatus.Escalated    => "Escalated",
                        _                          => "Deposit"
                    };

                    <div class="@cardBase@cardExtra"
                         data-rental-id="@rental.Id"
                         @(attType != "" ? $"data-attention-type=\"{attType}\"" : "")>

                        <!-- Thumbnail -->
                        <div class="w-14 h-14 shrink-0 rounded-lg overflow-hidden bg-ledger-100 dark:bg-ledger-700">
                            @if (!string.IsNullOrEmpty(thumbUrl))
                            {
                                <img src="@thumbUrl" alt="@rental.Item?.Title" class="w-full h-full object-cover" loading="lazy" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center">
                                    <i class="bi bi-image text-ledger-300 dark:text-ledger-600 text-xl"></i>
                                </div>
                            }
                        </div>

                        <!-- Info -->
                        <div class="flex-1 min-w-0">
                            <p class="font-medium text-sm text-ledger-900 dark:text-white truncate">@rental.Item?.Title</p>
                            <p class="text-xs text-ledger-400 dark:text-ledger-500 mt-0.5 truncate">
                                <i class="bi bi-person text-ledger-300 dark:text-ledger-600 mr-1"></i>@(rental.Owner?.FirstName ?? rental.Owner?.Email ?? "")
                                &nbsp;·&nbsp;
                                <span class="tabular-nums">@FormatDateRange(rental.StartDate, rental.EndDate)</span>
                            </p>
                            <p class="text-xs text-ledger-500 dark:text-ledger-400 mt-0.5 tabular-nums">
                                @CurrencyService.Format(rental.Item?.Price ?? 0)/@Localizer["day"]
                                &nbsp;·&nbsp;
                                @Localizer["Total"]: @CurrencyService.Format(rental.TotalPrice)
                            </p>
                            @if (rental.Deposit != null || activeExt != null || rental.Accessories.Any())
                            {
                                <div class="flex flex-wrap items-center gap-1 mt-1">
                                    @if (rental.Deposit != null && rental.Deposit.Status != DepositStatus.Released)
                                    {
                                        <span class="relative inline-flex items-center">
                                            @await Html.PartialAsync("_StatusBadge", new { Type = depBadgeType, Text = depText, SmallPadding = true })
                                            @if (hasDisputedDeposit)
                                            {
                                                <span class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-rose-500 animate-pulse" title="@Localizer["Action needed"]"></span>
                                            }
                                        </span>
                                    }
                                    @if (activeExt != null)
                                    {
                                        var extText = activeExt.Status == ExtensionStatus.Pending ? "Extension Pending"
                                                    : activeExt.Status == ExtensionStatus.Accepted ? "Extension Approved"
                                                    : "Extension Auto-Approved";
                                        @await Html.PartialAsync("_StatusBadge", new { Type = "extension-pending", Text = extText, SmallPadding = true })
                                    }
                                    @if (rental.Accessories.Any())
                                    {
                                        <span class="px-2 py-0.5 bg-ledger-100 dark:bg-ledger-700 text-ledger-500 dark:text-ledger-400 text-xs font-medium rounded-full">
                                            @rental.Accessories.Count @Localizer["accessories"]
                                        </span>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Right: Status + Action + Details -->
                        <div class="shrink-0 flex flex-col items-end gap-1.5">
                            @await Html.PartialAsync("_StatusBadge", new { Type = statusBadgeType, Text = statusText, SmallPadding = true })

                            @* Per-state primary action (renter) *@
                            @if (rental.Status == RentalStatus.Active && activeExt == null)
                            {
                                <button type="button"
                                        onclick="openExtensionModal(@rental.Id, '@rental.StartDate.ToString("yyyy-MM-dd")', '@rental.EndDate.ToString("yyyy-MM-dd")', @(rental.Item?.Price ?? 0), @rental.ItemId, @(rental.Item?.AutoApproveExtensions.ToString().ToLower()))"
                                        class="px-2.5 py-1 text-xs font-medium bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors duration-150">
                                    @Localizer["Extend"]
                                </button>
                            }
                            else if (rental.Status == RentalStatus.Active && activeExt?.Status == ExtensionStatus.Pending)
                            {
                                <span class="px-2.5 py-1 text-xs font-medium bg-ledger-100 dark:bg-ledger-700 text-ledger-400 dark:text-ledger-500 rounded-lg cursor-not-allowed">
                                    @Localizer["Ext. Pending"]
                                </span>
                            }
                            else if (rental.Status == RentalStatus.Active &&
                                     (activeExt?.Status == ExtensionStatus.Accepted || activeExt?.Status == ExtensionStatus.AutoApproved))
                            {
                                <a href="/Payment/ExtensionCheckout?extensionId=@activeExt.Id"
                                   class="px-2.5 py-1 text-xs font-medium bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg transition-colors duration-150">
                                    @Localizer["Pay Extension"]
                                </a>
                            }
                            else if (rental.Status == RentalStatus.Accepted)
                            {
                                <a href="/Payment/Checkout?rentalId=@rental.Id"
                                   class="px-2.5 py-1 text-xs font-medium bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg transition-colors duration-150">
                                    @Localizer["Pay Now"]
                                </a>
                            }
                            else if (rental.Status == RentalStatus.Pending)
                            {
                                <form asp-controller="Rentals" asp-action="CancelRental" method="post" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="rentalId" value="@rental.Id" />
                                    <button type="submit"
                                            class="px-2.5 py-1 text-xs font-medium border border-rose-300 dark:border-rose-700 text-rose-600 dark:text-rose-400 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-colors duration-150">
                                        @Localizer["Cancel"]
                                    </button>
                                </form>
                            }
                            else if (rental.Status == RentalStatus.Completed && hasChargedDeposit)
                            {
                                <button type="button"
                                        onclick="lastClickedRentalDetailsLink=this; openRentalDetail(@rental.Id, null)"
                                        class="px-2.5 py-1 text-xs font-medium bg-rose-600 hover:bg-rose-700 text-white rounded-lg transition-colors duration-150">
                                    @Localizer["Review Charge"]
                                </button>
                            }
                            else if (rental.Status == RentalStatus.Completed && hasDisputedDeposit)
                            {
                                <button type="button"
                                        onclick="lastClickedRentalDetailsLink=this; openRentalDetail(@rental.Id, null)"
                                        class="px-2.5 py-1 text-xs font-medium bg-amber-600 hover:bg-amber-700 text-white rounded-lg transition-colors duration-150">
                                    @Localizer["View Dispute"]
                                </button>
                            }
                            else if (rental.Status == RentalStatus.Completed)
                            {
                                var hasMyReview = rental.Reviews.Any(rv => rv.ReviewerId == currentUserId && !rv.IsDeleted);
                                var myReviewId = rental.Reviews.FirstOrDefault(rv => rv.ReviewerId == currentUserId && !rv.IsDeleted)?.Id;
                                @if (hasMyReview)
                                {
                                    <button type="button"
                                            onclick="openReviewModal(@rental.Id, @rental.ItemId, @myReviewId)"
                                            class="px-2.5 py-1 text-xs font-medium border border-ledger-300 dark:border-ledger-600 text-ledger-500 dark:text-ledger-400 rounded-lg hover:bg-ledger-50 dark:hover:bg-ledger-700 transition-colors duration-150">
                                        <i class="bi bi-pencil mr-0.5"></i>@Localizer["Edit Review"]
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            onclick="openReviewModal(@rental.Id, @rental.ItemId, null)"
                                            class="px-2.5 py-1 text-xs font-medium bg-amber-500 hover:bg-amber-600 text-white rounded-lg transition-colors duration-150">
                                        <i class="bi bi-star mr-0.5"></i>@Localizer["Review"]
                                    </button>
                                }
                            }

                            <button type="button"
                                    onclick="lastClickedRentalDetailsLink=this; openRentalDetail(@rental.Id, null)"
                                    class="text-primary-600 dark:text-primary-400 text-xs hover:underline">
                                @Localizer["Details"] →
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            @await Html.PartialAsync("_EmptyState", new {
                Icon = "bi-box-seam",
                Message = "You haven't rented anything yet",
                ActionLink = Url.Action("Index", "Items"),
                ActionText = "Browse Marketplace"
            })
        }
    </div>

    <!-- RENTING OUT (pre-rendered) -->
    <div id="tabpanel-renting-out"
         role="tabpanel"
         aria-labelledby="tab-renting-out"
         class="tab-content hidden mt-6">
        @{
            var ownerRentalsDisplay = Model.OwnerRentals?
                .Where(r => r.Status == RentalStatus.Active
                         || r.Status == RentalStatus.Pending
                         || r.Status == RentalStatus.Accepted
                         || (r.Status == RentalStatus.Completed && r.Deposit != null &&
                             (r.Deposit.Status == DepositStatus.Charged ||
                              r.Deposit.Status == DepositStatus.PartiallyCharged ||
                              r.Deposit.Status == DepositStatus.Disputed ||
                              r.Deposit.Status == DepositStatus.CounterOffered ||
                              r.Deposit.Status == DepositStatus.Escalated)))
                .OrderBy(r => r.Status == RentalStatus.Pending ? 0 : r.Status == RentalStatus.Active ? 1 : 2)
                .ThenBy(r => r.EndDate)
                .ToList() ?? new();
        }
        @if (ownerRentalsDisplay.Any())
        {
            <div class="space-y-2">
                @foreach (var rental in ownerRentalsDisplay)
                {
                    var isPendingApproval = rental.Status == RentalStatus.Pending;
                    var attTypeOwner = isPendingApproval ? "pending-approval" : "";
                    // Check for disputed deposit owned by this user
                    var hasDisputedOwner = rental.Deposit != null &&
                        (rental.Deposit.Status == DepositStatus.Disputed ||
                         rental.Deposit.Status == DepositStatus.CounterOffered ||
                         rental.Deposit.Status == DepositStatus.Escalated);
                    if (hasDisputedOwner && attTypeOwner == "") attTypeOwner = "dispute";

                    var cardBaseOwner = "rental-row flex items-center gap-4 p-4 bg-white dark:bg-ledger-800 rounded-lg border transition-colors duration-150";
                    var cardExtraOwner = isPendingApproval
                        ? " border-amber-200 dark:border-amber-800 bg-amber-50/20 dark:bg-amber-900/10"
                        : " border-ledger-200 dark:border-ledger-700 hover:border-ledger-300 dark:hover:border-ledger-600";

                    var thumbUrlO = !string.IsNullOrEmpty(rental.Item?.ImageUrl)
                        ? rental.Item.ImageUrl.Replace("/upload/", "/upload/c_thumb,w_112,h_112,q_auto/")
                        : "";

                    var statusBadgeTypeO = rental.Status switch {
                        RentalStatus.Active    => "active",
                        RentalStatus.Pending   => "pending",
                        RentalStatus.Accepted  => "warning",
                        RentalStatus.Completed => "completed",
                        _                      => "default"
                    };
                    var statusTextO = rental.Status switch {
                        RentalStatus.Active    => "Active",
                        RentalStatus.Pending   => "Pending",
                        RentalStatus.Accepted  => "Accepted",
                        RentalStatus.Completed => "Completed",
                        _                      => rental.Status.ToString()
                    };

                    var activeExtO = rental.Extensions.FirstOrDefault(e => e.Status == ExtensionStatus.Pending);
                    var depBadgeTypeO = rental.Deposit?.Status switch {
                        DepositStatus.Authorized       => "deposit-authorized",
                        DepositStatus.Charged or
                        DepositStatus.PartiallyCharged => "deposit-charged",
                        DepositStatus.Disputed or
                        DepositStatus.CounterOffered or
                        DepositStatus.Escalated        => "warning",
                        _                              => "deposit-held"
                    };
                    var depTextO = rental.Deposit?.Status switch {
                        DepositStatus.Authorized   => "Deposit: Held",
                        DepositStatus.Charged      => "Deposit: Charged",
                        DepositStatus.PartiallyCharged => "Deposit: Partial",
                        DepositStatus.Disputed     => "Deposit: Disputed",
                        DepositStatus.CounterOffered => "Counter-Offer",
                        DepositStatus.Escalated    => "Escalated",
                        _                          => "Deposit"
                    };

                    <div class="@cardBaseOwner@cardExtraOwner"
                         data-rental-id="@rental.Id"
                         @(attTypeOwner != "" ? $"data-attention-type=\"{attTypeOwner}\"" : "")>

                        <!-- Thumbnail -->
                        <div class="w-14 h-14 shrink-0 rounded-lg overflow-hidden bg-ledger-100 dark:bg-ledger-700">
                            @if (!string.IsNullOrEmpty(thumbUrlO))
                            {
                                <img src="@thumbUrlO" alt="@rental.Item?.Title" class="w-full h-full object-cover" loading="lazy" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center">
                                    <i class="bi bi-image text-ledger-300 dark:text-ledger-600 text-xl"></i>
                                </div>
                            }
                        </div>

                        <!-- Info -->
                        <div class="flex-1 min-w-0">
                            <p class="font-medium text-sm text-ledger-900 dark:text-white truncate">@rental.Item?.Title</p>
                            <p class="text-xs text-ledger-400 dark:text-ledger-500 mt-0.5 truncate">
                                <i class="bi bi-person text-ledger-300 dark:text-ledger-600 mr-1"></i>@(rental.Renter?.FirstName ?? rental.Renter?.Email ?? "")
                                &nbsp;·&nbsp;
                                <span class="tabular-nums">@FormatDateRange(rental.StartDate, rental.EndDate)</span>
                            </p>
                            <p class="text-xs text-ledger-500 dark:text-ledger-400 mt-0.5 tabular-nums">
                                @CurrencyService.Format(rental.Item?.Price ?? 0)/@Localizer["day"]
                                &nbsp;·&nbsp;
                                @Localizer["Total"]: @CurrencyService.Format(rental.TotalPrice)
                            </p>
                            @if (rental.Deposit != null || activeExtO != null)
                            {
                                <div class="flex flex-wrap items-center gap-1 mt-1">
                                    @if (rental.Deposit != null)
                                    {
                                        <span class="relative inline-flex items-center">
                                            @await Html.PartialAsync("_StatusBadge", new { Type = depBadgeTypeO, Text = depTextO, SmallPadding = true })
                                            @if (hasDisputedOwner)
                                            {
                                                <span class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-rose-500 animate-pulse" title="@Localizer["Action needed"]"></span>
                                            }
                                        </span>
                                    }
                                    @if (activeExtO != null)
                                    {
                                        @await Html.PartialAsync("_StatusBadge", new { Type = "extension-pending", Text = "Extension Request", SmallPadding = true })
                                    }
                                </div>
                            }
                        </div>

                        <!-- Right: Status + Action + Details -->
                        <div class="shrink-0 flex flex-col items-end gap-1.5">
                            @await Html.PartialAsync("_StatusBadge", new { Type = statusBadgeTypeO, Text = statusTextO, SmallPadding = true })

                            @* Per-state primary action (owner) *@
                            @if (rental.Status == RentalStatus.Pending)
                            {
                                <div class="flex gap-1.5">
                                    <form asp-controller="Rentals" asp-action="ApproveRental" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="rentalId" value="@rental.Id" />
                                        <button type="submit"
                                                class="px-2.5 py-1 text-xs font-medium bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg transition-colors duration-150">
                                            @Localizer["Approve"]
                                        </button>
                                    </form>
                                    <form asp-controller="Rentals" asp-action="CancelRental" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="rentalId" value="@rental.Id" />
                                        <button type="submit"
                                                class="px-2.5 py-1 text-xs font-medium border border-ledger-300 dark:border-neutral-600 text-ledger-600 dark:text-ledger-400 rounded-lg hover:bg-ledger-50 dark:hover:bg-neutral-700 transition-colors duration-150">
                                            @Localizer["Reject"]
                                        </button>
                                    </form>
                                </div>
                            }
                            else if ((rental.Status == RentalStatus.Active || rental.Status == RentalStatus.Completed) && hasDisputedOwner)
                            {
                                <button type="button"
                                        onclick="lastClickedRentalDetailsLink=this; openRentalDetail(@rental.Id, null)"
                                        class="px-2.5 py-1 text-xs font-medium bg-amber-600 hover:bg-amber-700 text-white rounded-lg transition-colors duration-150">
                                    @Localizer["Resolve Dispute"]
                                </button>
                            }
                            else if (rental.Status == RentalStatus.Active)
                            {
                                <button type="button"
                                        onclick="openEarlyReturnModal(@rental.Id, @(rental.Deposit?.Amount ?? 0))"
                                        class="px-2.5 py-1 text-xs font-medium border border-ledger-300 dark:border-neutral-600 text-ledger-600 dark:text-ledger-400 rounded-lg hover:bg-ledger-50 dark:hover:bg-neutral-700 transition-colors duration-150">
                                    @Localizer["End Early"]
                                </button>
                            }
                            else if (rental.Status == RentalStatus.Accepted)
                            {
                                <span class="px-2.5 py-1 text-xs font-medium bg-ledger-100 dark:bg-ledger-700 text-ledger-400 dark:text-ledger-500 rounded-lg cursor-default">
                                    @Localizer["Awaiting Payment"]
                                </span>
                            }

                            <button type="button"
                                    onclick="lastClickedRentalDetailsLink=this; openRentalDetail(@rental.Id, null)"
                                    class="text-primary-600 dark:text-primary-400 text-xs hover:underline">
                                @Localizer["Details"] →
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            @await Html.PartialAsync("_EmptyState", new {
                Icon = "bi-shop",
                Message = "No rental requests yet",
                ActionLink = Url.Action("Create", "Items"),
                ActionText = "List Your First Item"
            })
        }
    </div>

    <!-- MY ITEMS (pre-rendered) -->
    <div id="tabpanel-my-items"
         role="tabpanel"
         aria-labelledby="tab-my-items"
         class="tab-content hidden mt-6">
        @{
            var listings = Model.ListingsOwned ?? new();

            // Earnings summary computed from OwnerRentals in DashboardViewModel
            var allOwnerRentals = Model.OwnerRentals ?? new();
            var totalEarned = allOwnerRentals
                .Where(r => r.Status == RentalStatus.Completed || r.Status == RentalStatus.Active)
                .Sum(r => r.TotalPrice);
            var activeIncome = allOwnerRentals
                .Where(r => r.Status == RentalStatus.Active)
                .Sum(r => r.TotalPrice);
            var depositsHeld = Model.DepositSummary?.TotalHeld ?? 0m;
        }

        @if (listings.Any())
        {
            <!-- Earnings Summary Bar -->
            <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mb-6 px-4 py-3 rounded-xl bg-ledger-50 dark:bg-ledger-800/50 border border-ledger-100 dark:border-ledger-800 text-sm">
                <span class="text-ledger-500 dark:text-ledger-400">
                    <span class="font-medium text-ledger-900 dark:text-white">@CurrencyService.Format(totalEarned)</span>
                    <span class="ml-1">@Localizer["total earned"]</span>
                </span>
                <span class="hidden sm:block w-px h-4 bg-ledger-200 dark:bg-ledger-700"></span>
                <span class="text-ledger-500 dark:text-ledger-400">
                    <span class="font-medium text-emerald-600 dark:text-emerald-400">@CurrencyService.Format(activeIncome)</span>
                    <span class="ml-1">@Localizer["active income"]</span>
                </span>
                @if (depositsHeld > 0)
                {
                    <span class="hidden sm:block w-px h-4 bg-ledger-200 dark:bg-ledger-700"></span>
                    <span class="text-ledger-500 dark:text-ledger-400">
                        <span class="font-medium text-sky-600 dark:text-sky-400">@CurrencyService.Format(depositsHeld)</span>
                        <span class="ml-1">@Localizer["deposits held"]</span>
                    </span>
                }
            </div>

            <!-- Items Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var item in listings)
                {
                    var itemStatus = item.IsAdminHidden ? "banned"
                        : !item.IsListed ? "hidden"
                        : item.IsRented ? "active"
                        : "listed";
                    var thumbUrl = !string.IsNullOrEmpty(item.ImageUrl)
                        ? item.ImageUrl.Replace("/upload/", "/upload/c_thumb,w_300,h_200,q_auto/")
                        : "";
                    <div class="group rounded-xl border border-ledger-100 dark:border-ledger-800 bg-white dark:bg-ledger-900 overflow-hidden hover:shadow-sm transition-shadow duration-150">
                        <!-- Thumbnail -->
                        <div class="relative aspect-[3/2] bg-ledger-100 dark:bg-ledger-800 overflow-hidden">
                            @if (!string.IsNullOrEmpty(thumbUrl))
                            {
                                <img src="@thumbUrl"
                                     alt="@item.Title"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center">
                                    <i class="bi bi-image text-ledger-300 dark:text-ledger-600 text-3xl"></i>
                                </div>
                            }
                            <!-- Status dot overlay -->
                            <div class="absolute top-2 left-2">
                                @await Html.PartialAsync("_StatusBadge", new { Type = itemStatus, Text = itemStatus == "active" ? "Rented" : itemStatus == "listed" ? "Listed" : itemStatus == "hidden" ? "Hidden" : "Moderated", ShowIcon = false, SmallPadding = true })
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="p-3">
                            <p class="font-medium text-sm text-ledger-900 dark:text-white truncate mb-0.5">@item.Title</p>
                            <p class="text-xs text-ledger-500 dark:text-ledger-400">
                                @CurrencyService.Format(item.Price ?? 0)/@Localizer["day"]
                                @if (item.DepositAmount.HasValue && item.DepositAmount.Value > 0)
                                {
                                    <span class="ml-2 text-sky-600 dark:text-sky-400">+ @CurrencyService.Format(item.DepositAmount.Value) @Localizer["deposit"]</span>
                                }
                            </p>
                        </div>

                        <!-- Quick Actions -->
                        <div class="flex items-center gap-1 px-3 pb-3 border-t border-ledger-50 dark:border-ledger-800 pt-2 mt-1">
                            @if (!item.IsAdminHidden)
                            {
                                <!-- Toggle listed/unlisted -->
                                <form method="post" asp-controller="Items" asp-action="ToggleListing" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit"
                                            class="inline-flex items-center gap-1 px-2.5 py-1 text-xs rounded-lg border transition-colors @(item.IsListed ? "border-ledger-200 dark:border-ledger-700 text-ledger-500 dark:text-ledger-400 hover:bg-ledger-50 dark:hover:bg-ledger-800" : "border-emerald-200 dark:border-emerald-800 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/20")"
                                            title="@(item.IsListed ? Localizer["Unlist"] : Localizer["List"])">
                                        <i class="bi @(item.IsListed ? "bi-eye-slash" : "bi-eye")"></i>
                                        <span>@(item.IsListed ? Localizer["Unlist"] : Localizer["List"])</span>
                                    </button>
                                </form>
                            }

                            <a asp-controller="Items" asp-action="Edit" asp-route-id="@item.Id"
                               class="inline-flex items-center gap-1 px-2.5 py-1 text-xs rounded-lg border border-ledger-200 dark:border-ledger-700 text-ledger-500 dark:text-ledger-400 hover:bg-ledger-50 dark:hover:bg-ledger-800 transition-colors">
                                <i class="bi bi-pencil"></i>
                                <span>@Localizer["Edit"]</span>
                            </a>

                            <a asp-controller="Items" asp-action="Delete" asp-route-id="@item.Id"
                               class="ml-auto inline-flex items-center gap-1 px-2.5 py-1 text-xs rounded-lg border border-rose-100 dark:border-rose-900/50 text-rose-500 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-colors">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                }

                <!-- Add New Item CTA card -->
                <a asp-controller="Items" asp-action="Create"
                   class="flex flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-ledger-200 dark:border-ledger-700 bg-white dark:bg-ledger-900 hover:border-primary-300 dark:hover:border-primary-600 hover:bg-primary-50/30 dark:hover:bg-primary-900/10 transition-colors duration-150 aspect-[3/2] sm:aspect-auto sm:min-h-[160px]">
                    <div class="w-10 h-10 rounded-full bg-primary-50 dark:bg-primary-900/20 flex items-center justify-center">
                        <i class="bi bi-plus-lg text-primary-600 dark:text-primary-400 text-lg"></i>
                    </div>
                    <span class="text-sm font-medium text-primary-600 dark:text-primary-400">@Localizer["Add New Item"]</span>
                </a>
            </div>
        }
        else
        {
            @await Html.PartialAsync("_EmptyState", new {
                Icon = "bi-plus-circle",
                Message = "You haven't listed any items",
                ActionLink = Url.Action("Create", "Items"),
                ActionText = "List Your First Item"
            })
        }
    </div>

    <!-- HISTORY (lazy-loaded) -->
    <div id="tabpanel-history"
         role="tabpanel"
         aria-labelledby="tab-history"
         class="tab-content hidden mt-6">
        <!-- Skeleton loader: 5 table-row skeletons -->
        <div id="history-skeleton" class="space-y-2">
            @for (int i = 0; i < 5; i++)
            {
                <div class="flex items-center gap-4 px-4 py-3 rounded-lg border border-ledger-100 dark:border-ledger-800 animate-pulse">
                    <div class="w-10 h-10 rounded bg-ledger-100 dark:bg-ledger-800 shrink-0"></div>
                    <div class="flex-1 space-y-2">
                        <div class="h-3 bg-ledger-100 dark:bg-ledger-800 rounded w-2/5"></div>
                        <div class="h-2.5 bg-ledger-100 dark:bg-ledger-800 rounded w-1/3"></div>
                    </div>
                    <div class="h-5 w-16 bg-ledger-100 dark:bg-ledger-800 rounded-full shrink-0"></div>
                </div>
            }
        </div>
    </div>

    <!-- FAVORITES (lazy-loaded) -->
    <div id="tabpanel-favorites"
         role="tabpanel"
         aria-labelledby="tab-favorites"
         class="tab-content hidden mt-6">
        <!-- Skeleton loader: 3-column card grid -->
        <div id="favorites-skeleton" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 animate-pulse">
            @for (int i = 0; i < 6; i++)
            {
                <div class="rounded-lg border border-ledger-100 dark:border-ledger-800 overflow-hidden">
                    <div class="aspect-[3/2] bg-ledger-100 dark:bg-ledger-800"></div>
                    <div class="p-4 space-y-2">
                        <div class="h-3 bg-ledger-100 dark:bg-ledger-800 rounded w-3/4"></div>
                        <div class="h-2.5 bg-ledger-100 dark:bg-ledger-800 rounded w-1/3"></div>
                    </div>
                </div>
            }
        </div>
    </div>

</div>

<!-- ═══════════════════════════════════════════════
     RENTAL DETAIL SLIDE-OVER PANEL
     ═══════════════════════════════════════════════ -->
<div id="rental-detail-backdrop" class="slide-over-backdrop hidden" onclick="closeRentalDetail()"></div>
<aside id="rental-detail-panel" class="slide-over-panel" role="dialog" aria-modal="true" aria-label="@Localizer["Rental Details"]">
    <div class="slide-over-panel__body" id="rental-panel-body">
        <!-- Content populated client-side by openRentalDetail() or fetched from RentalDetailPartial -->
    </div>
</aside>

@await Html.PartialAsync("~/Views/Dashboard/_RentalModals.cshtml")
@await Html.PartialAsync("~/Views/Dashboard/_DisputeModals.cshtml")

@* ── Serialize active rental data for instant panel open ── *@
@{
    // Cap at 50 total: My Rentals + Renting Out
    // Helper to serialize a rental for the panel JS data map
    object serializeRental(Rental r, string role) {
        var cp = role == "renter" ? r.Owner : r.Renter;
        return new {
            id        = r.Id,
            role      = role,
            status    = r.Status.ToString(),
            itemTitle = r.Item?.Title ?? "",
            itemImage = r.Item?.ImageUrl ?? "",
            itemId    = r.ItemId,
            itemPrice = r.Item?.Price ?? 0m,
            startDate = r.StartDate.ToString("yyyy-MM-dd"),
            endDate   = r.EndDate.ToString("yyyy-MM-dd"),
            totalPrice = r.TotalPrice,
            counterpartyName  = cp?.FirstName ?? cp?.Email ?? "",
            counterpartyAvatar = (string?)null,
            depositStatus = r.Deposit?.Status.ToString(),
            depositAmount = r.Deposit?.Amount ?? 0m,
            depositId     = r.Deposit?.Id,
            depositChargedAmount = r.Deposit?.ChargedAmount,
            depositChargeReason = r.Deposit?.ChargeReason ?? "",
            depositDisputeReason = r.Deposit?.DisputeReason ?? "",
            depositCounterOfferAmount = r.Deposit?.CounterOfferAmount,
            depositOwnerResponse = r.Deposit?.OwnerDisputeResponse ?? "",
            hasReview     = role == "renter" && r.Reviews.Any(rv => rv.ReviewerId == currentUserId && !rv.IsDeleted),
            reviewId      = role == "renter" ? r.Reviews.FirstOrDefault(rv => rv.ReviewerId == currentUserId && !rv.IsDeleted)?.Id : null,
            autoApproveExtensions = r.Item?.AutoApproveExtensions ?? false,
            extensions = r.Extensions
                .Where(e => e.Status == ExtensionStatus.Pending || e.Status == ExtensionStatus.Accepted || e.Status == ExtensionStatus.AutoApproved)
                .Select(e => new {
                    id = e.Id,
                    status = e.Status.ToString(),
                    newEndDate = e.NewEndDate.ToString("yyyy-MM-dd"),
                    originalEndDate = e.OriginalEndDate.ToString("yyyy-MM-dd"),
                    additionalCost = e.AdditionalCost
                }).ToList(),
            accessories = r.Accessories.Select(a => new {
                name = a.Name,
                dailyPrice = a.DailyPrice
            }).ToList(),
            evidence = (r.Deposit?.Evidence ?? new List<DisputeEvidence>())
                .Select(ev => new {
                    id = ev.Id,
                    imageUrl = ev.Url,
                    notes = ev.Notes ?? "",
                    submittedByName = ev.SubmittedBy?.FirstName ?? ev.SubmittedBy?.Email ?? "",
                    isOwner = ev.SubmittedByUserId != r.RenterId
                }).ToList()
        };
    }

    var serializableRentals = (Model.MyRentals ?? new())
        .Take(25)
        .Select(r => serializeRental(r, "renter"))
        .Concat(
            (Model.OwnerRentals ?? new())
                .Take(25)
                .Select(r => serializeRental(r, "owner"))
        )
        .ToList();

    // Build dictionary keyed by rental ID using dynamic
    var rentalDataDict = new Dictionary<string, object>();
    foreach (dynamic item in serializableRentals)
    {
        rentalDataDict[item.id.ToString()] = item;
    }
}
<script>
window.rentalData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    rentalDataDict,
    new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }
));
</script>


@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Identity
@using RentMate.Shared.Contracts.Responses
@using RentMate.Models.Domain
@model RentMate.Models.ViewModels.DashboardViewModel
@inject IViewLocalizer Localizer
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = Localizer["Dashboard"];
    var currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var rawName = currentUser?.UserName ?? User.Identity?.Name;
    var atIndex = rawName?.IndexOf('@') ?? -1;
    var displayName = atIndex > 0 ? rawName![..atIndex] : (rawName ?? string.Empty);

    // Badge counts for tabs
    var overdueRentals = Model.MyRentals?.Where(r => r.Status == RentalStatus.Active && r.EndDate.Date < DateTime.UtcNow.Date).ToList() ?? new();
    var acceptedRentals = Model.MyRentals?.Where(r => r.Status == RentalStatus.Accepted).ToList() ?? new();
    var pendingRequests = Model.OwnerRentals?.Where(r => r.Status == RentalStatus.Pending).ToList() ?? new();
    var renterDepositAttention = Model.MyRentals?.Where(r => r.Deposit != null
        && (r.Deposit.Status == DepositStatus.Charged
            || r.Deposit.Status == DepositStatus.PartiallyCharged
            || r.Deposit.Status == DepositStatus.CounterOffered)).ToList() ?? new();
    var rentalsWithExtPayment = Model.MyRentals?.Where(r =>
        r.Extensions != null && r.Extensions.Any(e => e.Status == ExtensionStatus.Accepted || e.Status == ExtensionStatus.AutoApproved)).ToList() ?? new();
    var ownerDisputedDeposits = Model.OwnerRentals?.Where(r => r.Deposit != null
        && r.Deposit.Status == DepositStatus.Disputed).ToList() ?? new();
    var renterCompletedReady = Model.MyRentals?.Where(r => r.Status == RentalStatus.Completed && r.ArchivedAt == null
        && (r.Deposit == null || (r.Deposit.Status != DepositStatus.Disputed && r.Deposit.Status != DepositStatus.CounterOffered && r.Deposit.Status != DepositStatus.Escalated))).ToList() ?? new();
    var ownerCompletedReady = Model.OwnerRentals?.Where(r => r.Status == RentalStatus.Completed && r.ArchivedAt == null
        && (r.Deposit == null || (r.Deposit.Status != DepositStatus.Disputed && r.Deposit.Status != DepositStatus.CounterOffered && r.Deposit.Status != DepositStatus.Escalated))).ToList() ?? new();
    var rentingAttentionCount = overdueRentals.Count + acceptedRentals.Count
        + renterDepositAttention.Count + rentalsWithExtPayment.Count + renterCompletedReady.Count;
    var lendingAttentionCount = pendingRequests.Count + (Model.PendingExtensionCount)
        + ownerDisputedDeposits.Count + ownerCompletedReady.Count;
    var archivedRentals = (Model.MyRentals?.Where(r => (r.Status == RentalStatus.Completed || r.Status == RentalStatus.Cancelled) && r.ArchivedAt != null).ToList() ?? new())
        .Concat(Model.OwnerRentals?.Where(r => (r.Status == RentalStatus.Completed || r.Status == RentalStatus.Cancelled) && r.ArchivedAt != null).ToList() ?? new())
        .ToList();
    var currentUserId = currentUser?.Id;
    var unreviewedCount = archivedRentals.Count(r => r.OwnerId != currentUserId
        && r.Status == RentalStatus.Completed
        && !(r.Item?.Reviews?.Any(rev => rev.ReviewerId == currentUserId && !rev.IsDeleted) ?? false));
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
        <div>
            <h1 class="font-outfit text-3xl font-bold text-slate-900 dark:text-white">
                @Localizer["Hello, {0}", displayName]
            </h1>
            <p class="text-slate-500 dark:text-slate-400 mt-1">
                @Localizer["Manage your items, rentals, and borrowings in one place."]
            </p>
        </div>
        <div class="flex items-center gap-3">
            <span id="connectionIndicator" class="px-3 py-1.5 bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-400 text-sm font-medium rounded-full">
                @Localizer["Offline"]
            </span>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="AdminDashboard"
                   class="inline-flex items-center gap-2 px-5 py-2.5 border border-trust-blue-200 dark:border-trust-blue-800 text-trust-blue-600 dark:text-trust-blue-400 font-medium rounded-xl hover:bg-trust-blue-50 dark:hover:bg-trust-blue-900/20 transition-all">
                    <i class="bi bi-shield-lock"></i>
                    @Localizer["Admin Panel"]
                </a>
            }
            <a asp-controller="Items" asp-action="Create"
               class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-trust-blue-600 to-trust-blue-700 hover:brightness-110 text-white font-medium rounded-xl shadow-sm transition-all">
                <i class="bi bi-plus-lg"></i>
                @Localizer["Add Item"]
            </a>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <!-- Toast Container -->
    <div id="toastContainer" class="fixed top-20 right-4 space-y-2" style="z-index: var(--z-toast, 1500);"></div>

    <!-- Alerts -->
    @await Html.PartialAsync("_Alert")

    <!-- Tab Navigation -->
    <nav class="flex gap-1 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-1 mb-8" role="tablist">
        <button data-tab="home" role="tab" aria-selected="true"
                class="tab-btn flex-1 flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all">
            <i class="bi bi-house-heart"></i>
            <span class="hidden sm:inline">@Localizer["DashboardTabHome"]</span>
        </button>
        <button data-tab="renting" role="tab" aria-selected="false"
                class="tab-btn flex-1 flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all relative">
            <i class="bi bi-bag"></i>
            <span class="hidden sm:inline">@Localizer["DashboardTabRenting"]</span>
            @if (rentingAttentionCount > 0)
            {
                <span class="tab-badge absolute -top-1 -right-1 w-5 h-5 bg-rose-500 text-white text-xs font-bold rounded-full flex items-center justify-center">@rentingAttentionCount</span>
            }
        </button>
        <button data-tab="lending" role="tab" aria-selected="false"
                class="tab-btn flex-1 flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all relative">
            <i class="bi bi-box-seam"></i>
            <span class="hidden sm:inline">@Localizer["DashboardTabLending"]</span>
            @if (lendingAttentionCount > 0)
            {
                <span class="tab-badge absolute -top-1 -right-1 w-5 h-5 bg-amber-500 text-white text-xs font-bold rounded-full flex items-center justify-center">@lendingAttentionCount</span>
            }
        </button>
        <button data-tab="history" role="tab" aria-selected="false"
                class="tab-btn flex-1 flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all relative">
            <i class="bi bi-clock-history"></i>
            <span class="hidden sm:inline">@Localizer["DashboardTabHistory"]</span>
            @if (unreviewedCount > 0)
            {
                <span class="tab-badge absolute -top-1 -right-1 w-5 h-5 bg-sky-500 text-white text-xs font-bold rounded-full flex items-center justify-center">@unreviewedCount</span>
            }
        </button>
    </nav>

    <!-- Tab: Home -->
    <div data-tab-panel="home" class="tab-panel">
        @await Html.PartialAsync("_DashboardHome", Model)
    </div>

    <!-- Tab: Renting -->
    <div data-tab-panel="renting" class="tab-panel hidden">
        @await Html.PartialAsync("_DashboardRenting", Model)
    </div>

    <!-- Tab: Lending -->
    <div data-tab-panel="lending" class="tab-panel hidden">
        @await Html.PartialAsync("_DashboardLending", Model)
    </div>

    <!-- Tab: History -->
    <div data-tab-panel="history" class="tab-panel hidden">
        @await Html.PartialAsync("_DashboardHistory", Model)
    </div>
</div>

<!-- Modals (outside tabs, always available) -->
@await Html.PartialAsync("_RentalModals", Model)
@await Html.PartialAsync("_DepositModals", Model)
@await Html.PartialAsync("_DisputeModals", Model)


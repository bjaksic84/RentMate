                                                                "@dep.OwnerDisputeResponse"
                                                            </div>
                                                        }
                                                        <div class="mt-3 flex gap-2">
                                                            <button onclick="acceptCounterOffer(@rental.Id)"
                                                                    class="px-3 py-1.5 text-xs font-medium bg-amber-600 text-white rounded-lg hover:brightness-110 transition">
                                                                @Localizer["Accept & Pay"] @CurrencyService.Format(dep.CounterOfferAmount ?? 0)
                                                            </button>
                                                            <button onclick="escalateDispute(@rental.Id)"
                                                                    id="escalate-btn-co-@rental.Id"
                                                                    class="px-3 py-1.5 text-xs font-medium border border-amber-300 dark:border-amber-700 text-amber-700 dark:text-amber-400 rounded-lg hover:bg-amber-100 dark:hover:bg-amber-900/30 transition disabled:opacity-50 disabled:cursor-not-allowed">
                                                                @Localizer["Reject & Escalate"]
                                                            </button>
                                                        </div>


                                                         @if (dep.Evidence != null && dep.Evidence.Any())
                                                         {
                                                             var yourEv = dep.Evidence.Where(e => e.SubmittedByUserId == currentUserId);
                                                             var otherEv = dep.Evidence.Where(e => e.SubmittedByUserId != currentUserId);

                                                             @if (otherEv.Any())
                                                             {
                                                                 <div class="mt-4 pt-3 border-t border-amber-200/50 dark:border-amber-800/50">
                                                                     <p class="text-[10px] uppercase font-bold text-amber-600 dark:text-amber-500 mb-2 tracking-wider">@Localizer["Owner's Evidence"]</p>
                                                                     <div class="flex flex-wrap gap-2">
                                                                         @foreach (var ev in otherEv.OrderByDescending(e => e.CreatedAt))
                                                                         {
                                                                             <a href="@ev.Url" target="_blank" class="w-10 h-10 rounded-lg overflow-hidden border border-amber-200 dark:border-amber-800 hover:scale-105 transition-transform" title="@ev.Notes">
                                                                                 <img src="@ev.Url" class="w-full h-full object-cover" />
                                                                             </a>
                                                                         }
                                                                     </div>
                                                                 </div>
                                                             }

                                                             @if (yourEv.Any())
                                                             {
                                                                 <div class="mt-4 pt-3 border-t border-amber-200/50 dark:border-amber-800/50">
                                                                     <p class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 mb-2 tracking-wider">@Localizer["Your Evidence"]</p>
                                                                     <div class="flex flex-wrap gap-2">
                                                                         @foreach (var ev in yourEv.OrderByDescending(e => e.CreatedAt))
                                                                         {
                                                                             <a href="@ev.Url" target="_blank" class="w-10 h-10 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700 hover:scale-105 transition-transform" title="@ev.Notes">
                                                                                 <img src="@ev.Url" class="w-full h-full object-cover opacity-80" />
                                                                             </a>
                                                                         }
                                                                         <button onclick="openAddEvidenceModal(@rental.Id)" class="w-10 h-10 rounded-lg flex items-center justify-center border border-dashed border-slate-300 dark:border-slate-600 text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-900 transition">
                                                                             <i class="bi bi-plus-lg"></i>
                                                                         </button>
                                                                     </div>
                                                                 </div>
                                                             }
                                                         }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else if (dep.Status == DepositStatus.Escalated)
                                        {
                                            <div class="mb-3 rounded-xl border border-blue-200 dark:border-blue-800 bg-blue-50 dark:bg-blue-900/20 p-3">
                                                <div class="flex items-start gap-2">
                                                    <i class="bi bi-shield-shaded text-blue-500 mt-0.5 shrink-0"></i>
                                                    <div>
                                                        <p class="text-xs font-medium text-blue-700 dark:text-blue-300">@Localizer["Under Internal Review"]</p>
                                                        <p class="text-xs text-blue-600 dark:text-blue-400 mt-0.5">@Localizer["Our team is reviewing this dispute. We'll contact you shortly."]</p>
                                                        
                                                         @if (dep.Evidence != null && dep.Evidence.Any())
                                                         {
                                                             var yourEv = dep.Evidence.Where(e => e.SubmittedByUserId == currentUserId);
                                                             var otherEv = dep.Evidence.Where(e => e.SubmittedByUserId != currentUserId);

                                                             @if (otherEv.Any())
                                                             {
                                                                 <div class="mt-4 pt-3 border-t border-blue-200/50 dark:border-blue-800/50">
                                                                     <p class="text-[10px] uppercase font-bold text-blue-600 dark:text-blue-500 mb-2 tracking-wider">@Localizer["Owner's Evidence"]</p>
                                                                     <div class="flex flex-wrap gap-2">
                                                                         @foreach (var ev in otherEv.OrderByDescending(e => e.CreatedAt))
                                                                         {
                                                                             <a href="@ev.Url" target="_blank" class="w-8 h-8 rounded-lg overflow-hidden border border-blue-200 dark:border-blue-800 hover:scale-105 transition-transform" title="@ev.Notes">
                                                                                 <img src="@ev.Url" class="w-full h-full object-cover" />
                                                                             </a>
                                                                         }
                                                                     </div>
                                                                 </div>
                                                             }

                                                             @if (yourEv.Any())
                                                             {
                                                                 <div class="mt-4 pt-3 border-t border-blue-200/50 dark:border-blue-800/50">
                                                                     <p class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 mb-2 tracking-wider">@Localizer["Your Evidence"]</p>
                                                                     <div class="flex flex-wrap gap-2">
                                                                         @foreach (var ev in yourEv.OrderByDescending(e => e.CreatedAt))
                                                                         {
                                                                             <a href="@ev.Url" target="_blank" class="w-8 h-8 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700 hover:scale-105 transition-transform" title="@ev.Notes">
                                                                                 <img src="@ev.Url" class="w-full h-full object-cover opacity-80" />
                                                                             </a>
                                                                         }
                                                                         <button onclick="openAddEvidenceModal(@rental.Id)" class="w-8 h-8 rounded-lg flex items-center justify-center border border-dashed border-slate-300 dark:border-slate-600 text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-900 transition">
                                                                             <i class="bi bi-plus"></i>
                                                                         </button>
                                                                     </div>
                                                                 </div>
                                                             }
                                                         }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else if (dep.Status == DepositStatus.ChargeUpheld)
                                        {
                                            <div class="mb-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 p-3">
                                                <div class="flex items-start gap-2">
                                                    <i class="bi bi-shield-check text-slate-400 mt-0.5 shrink-0"></i>
                                                    <div>
                                                        <p class="text-xs font-medium text-slate-700 dark:text-slate-300">@Localizer["Dispute Resolved"]</p>
                                                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">@Localizer["The original charge was upheld by support review."]</p>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else if (dep.Status == DepositStatus.Released && dep.DisputedAt.HasValue)
                                        {
                                            <div class="mb-3 rounded-xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-900/20 p-3">
                                                <div class="flex items-center gap-2">
                                                    <i class="bi bi-shield-check text-emerald-500 shrink-0"></i>
                                                    <p class="text-xs font-medium text-emerald-700 dark:text-emerald-300">@Localizer["Dispute Won - Deposit released"]</p>
                                                </div>
                                            </div>
                                        }
                                    }

                                    <!-- Accessories -->
                                    @if (rental.Accessories?.Any() ?? false)
                                    {
                                        <div class="mb-3 flex flex-wrap gap-1.5">
                                            @foreach (var acc in rental.Accessories)
                                            {
                                                <span class="inline-flex items-center rounded-lg bg-slate-100 dark:bg-slate-700 px-2 py-0.5 text-xs text-slate-600 dark:text-slate-300">
                                                    @acc.Name &middot; @CurrencyService.Format(acc.DailyPrice)/@Localizer["day"]
                                                </span>
                                            }
                                        </div>
                                    }

                                    <!-- Total -->
                                    <div class="flex items-center justify-between border-t border-slate-100 dark:border-slate-700 pt-3 mb-3">
                                        <span class="text-sm text-slate-500 dark:text-slate-400">@Localizer["Total"]</span>
                                        <span class="text-base font-semibold text-slate-900 dark:text-white">@CurrencyService.Format(rental.TotalPrice)</span>
                                    </div>

                                    <!-- Actions -->
                                    <div class="flex gap-2">
                                        @if (acceptedExt != null)
                                        {
                                            <a asp-controller="Payment" asp-action="ExtensionCheckout" asp-route-extensionId="@acceptedExt.Id"
                                               class="flex-1 rounded-xl bg-gradient-to-r from-trust-blue-600 to-trust-blue-700 px-3 py-2 text-sm font-medium text-white shadow-sm transition hover:brightness-110 text-center flex items-center justify-center">
                                                <i class="bi bi-credit-card mr-1"></i> @Localizer["Pay for Extension"] (@CurrencyService.Format(acceptedExt.AdditionalCost))
                                            </a>
                                            <button onclick="cancelExtension(@acceptedExt.Id)"
                                                    class="rounded-xl border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700 transition"
                                                    title="@Localizer["Cancel Extension"]">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        }
                                        else if (rental.Status == RentalStatus.Active && !hasPendingExt)
                                        {
                                            <button onclick="openExtensionModal(@rental.Id, '@rental.StartDate.ToString("yyyy-MM-dd")', '@rental.EndDate.ToString("yyyy-MM-dd")', @(rental.Item?.Price ?? 0), @(rental.ItemId), @(rental.Item?.AutoApproveExtensions.ToString().ToLower()))"
                                                    class="flex-1 rounded-xl bg-gradient-to-r from-trust-blue-600 to-trust-blue-700 px-3 py-2 text-sm font-medium text-white shadow-sm transition hover:brightness-110 focus:ring-2 focus:ring-trust-blue-500 focus:ring-offset-2">
                                                @Localizer["Extend Rental"]
                                            </button>
                                        }
                                        else if (hasPendingExt)
                                        {
                                            <span class="flex-1 rounded-xl border border-sky-200 dark:border-sky-800 bg-sky-50 dark:bg-sky-900/20 px-3 py-2 text-center text-sm font-medium text-sky-700 dark:text-sky-400">
                                                <i class="bi bi-clock"></i> @Localizer["Extension Pending"]
                                            </span>
                                        }
                                        else if (rental.Status == RentalStatus.Completed && existingReview == null)
                                        {
                                            <button onclick="openReviewModal(@rental.Id, @rental.ItemId, null)"
                                                    class="flex-1 rounded-xl bg-amber-500 hover:bg-amber-600 px-3 py-2 text-sm font-medium text-white transition">
                                                <i class="bi bi-star"></i> @Localizer["Leave Review"]
                                            </button>
                                        }
                                        else if (rental.Status == RentalStatus.Completed && existingReview != null)
                                        {
                                            <button onclick="openReviewModal(@rental.Id, @rental.ItemId, @existingReview.Id)"
                                                    class="flex-1 rounded-xl bg-trust-blue-500 hover:bg-trust-blue-600 px-3 py-2 text-sm font-medium text-white transition">
                                                <i class="bi bi-pencil"></i> @Localizer["Edit Review"]
                                            </button>
                                        }
                                        else if (rental.Status == RentalStatus.Accepted)
                                        {
                                            <a asp-controller="Payment" asp-action="Checkout" asp-route-rentalId="@rental.Id" 
                                               class="flex-1 rounded-xl bg-trust-blue-600 hover:bg-trust-blue-700 px-3 py-2 text-sm font-medium text-white transition text-center flex items-center justify-center">
                                                <i class="bi bi-credit-card mr-2"></i> @Localizer["Pay Now"]
                                            </a>
                                            <form asp-controller="Rentals" asp-action="CancelRental" method="post" class="flex-1">
                                                <input type="hidden" name="rentalId" value="@rental.Id" />
                                                <button class="w-full rounded-xl border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700 transition">
                                                    @Localizer["Cancel Request"]
                                                </button>
                                            </form>
                                        }
                                        else if (rental.Status == RentalStatus.Pending)
                                        {
                                            <form asp-controller="Rentals" asp-action="CancelRental" method="post" class="flex-1">
                                                <input type="hidden" name="rentalId" value="@rental.Id" />
                                                <button class="w-full rounded-xl border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700 transition">
                                                    @Localizer["Cancel Request"]
                                                </button>
                                            </form>
                                        }
                                        else if (rental.Status == RentalStatus.Pending)
                                        {
                                            <form asp-controller="Rentals" asp-action="CancelRental" method="post" class="flex-1">
                                                <input type="hidden" name="rentalId" value="@rental.Id" />
                                                <button class="w-full rounded-xl border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700 transition">
                                                    @Localizer["Cancel Request"]
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    @await Html.PartialAsync("_EmptyState", new { Icon = "bi-bag", Message = "You haven't rented anything yet.", ActionLink = Url.Action("Index", "Rentals"), ActionText = "Browse Marketplace" })
                }
            </section>

            <!-- Renting Out (Owner) -->
            <section class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700">
                    <h2 class="text-lg font-semibold font-outfit text-slate-900 dark:text-white flex items-center gap-2">
                        <i class="bi bi-graph-up-arrow text-emerald-600"></i>
                        @Localizer["Renting Out (Owner)"]
                    </h2>
                </div>

                @{
                    var activeOwnerRentalsList = Model.OwnerRentals?.Where(r =>
                        r.Status == RentalStatus.Active || r.Status == RentalStatus.Pending || r.Status == RentalStatus.Accepted
                        || (r.Status == RentalStatus.Completed && r.Deposit != null
                            && (r.Deposit.Status == DepositStatus.Disputed || r.Deposit.Status == DepositStatus.CounterOffered
                                || r.Deposit.Status == DepositStatus.Escalated
                                || ((r.Deposit.Status == DepositStatus.Charged || r.Deposit.Status == DepositStatus.PartiallyCharged) 
                                    && r.Deposit.DisputeDeadline.HasValue && r.Deposit.DisputeDeadline > DateTime.UtcNow)))
                    ).ToList() ?? new();
                }
                @if (activeOwnerRentalsList.Any())
                {
                    <div class="p-4 grid gap-4 sm:grid-cols-2">
                        @foreach (var rental in activeOwnerRentalsList)
                        {
                            var daysRemaining = (rental.EndDate.Date - DateTime.UtcNow.Date).Days;
                            var isRentalOverdue = rental.Status == RentalStatus.Active && daysRemaining < 0;
                            var ownerUrgency = daysRemaining < 0 ? "overdue" : daysRemaining <= 1 ? "urgent" : daysRemaining <= 3 ? "warning" : "normal";

                            <article class="group relative overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-sm transition-shadow hover:shadow-md">
                                <div class="relative h-40 overflow-hidden">
                                    @if (!string.IsNullOrEmpty(rental.Item?.ImageUrl))
                                    {
                                        var thumbUrl = rental.Item.ImageUrl.Replace("/upload/", "/upload/c_fill,w_400,h_200,q_auto/");
                                        <img src="@thumbUrl" alt="@rental.Item?.Title" class="h-full w-full object-cover transition-transform group-hover:scale-105" />
                                    }
                                    else
                                    {
                                        <div class="h-full w-full bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-700 dark:to-slate-800 flex items-center justify-center">
                                            <i class="bi bi-image text-4xl text-slate-300 dark:text-slate-600"></i>
                                        </div>
                                    }
                                    <div class="absolute top-3 left-3">
                                        @await Html.PartialAsync("_StatusBadge", new { Type = isRentalOverdue ? "overdue" : rental.Status.ToString().ToLower(), Text = isRentalOverdue ? "Overdue" : rental.Status.ToString(), ShowIcon = true })
                                    </div>
                                    @if (rental.Deposit != null)
                                    {
                                        var depositBadgeType = rental.Deposit.Status switch {
                                            DepositStatus.Authorized => "deposit-held",
                                            DepositStatus.Released => "deposit-released",
                                            DepositStatus.Charged or DepositStatus.PartiallyCharged => "deposit-charged",
                                            DepositStatus.Disputed => "overdue",
                                            _ => "pending"
                                        };
                                        <div class="absolute top-3 right-3">
                                            @await Html.PartialAsync("_StatusBadge", new { Type = depositBadgeType, Text = CurrencyService.Format(rental.Deposit.Amount), ShowIcon = true, SmallPadding = true })
                                        </div>
                                    }
                                </div>

                                <div class="p-4">
                                    <h3 class="text-base font-medium text-slate-900 dark:text-white mb-2 line-clamp-1">@rental.Item?.Title</h3>

                                    <!-- Renter Info -->
                                    <div class="flex items-center gap-2 mb-3">
                                        @if (!string.IsNullOrEmpty(rental.Renter?.ProfilePictureUrl))
                                        {
                                            <img src="@rental.Renter.ProfilePictureUrl" class="w-5 h-5 rounded-full object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-5 h-5 bg-trust-blue-600 text-white rounded-full flex items-center justify-center text-xs"><i class="bi bi-person"></i></div>
                                        }
                                        <span class="text-xs text-slate-500 dark:text-slate-400">@Localizer["Rented by"] @(rental.Renter?.FirstName ?? rental.Renter?.Email)</span>
                                    </div>

                                    <!-- Countdown / Dates -->
                                    @if (rental.Status == RentalStatus.Active)
                                    {
                                        <div class="mb-3">
                                            <div class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 mb-1.5">
                                                <i class="bi bi-calendar-event"></i>
                                                <span>@Localizer["Return by"] <strong class="text-slate-700 dark:text-slate-200">@rental.EndDate.ToString("dd MMM yyyy")</strong></span>
                                            </div>
                                            @await Html.PartialAsync("_CountdownTimer", new { EndDate = rental.EndDate, DaysRemaining = daysRemaining, Urgency = ownerUrgency })
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mb-3 flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
                                            <i class="bi bi-calendar-range"></i>
                                            <span>@FormatDateRange(rental.StartDate, rental.EndDate)</span>
                                        </div>
                                    }

                                    <!-- Deposit -->
                                    @if (rental.Item?.DepositAmount.HasValue == true && rental.Item.DepositAmount.Value > 0)
                                    {
                                        <div class="mb-3 flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
                                            <i class="bi bi-shield-check text-sky-500"></i>
                                            <span>@Localizer["Deposit"]: <strong class="text-slate-700 dark:text-slate-200">@CurrencyService.Format(rental.Item.DepositAmount.Value)</strong></span>
                                        </div>
                                    }

                                    <!-- Extension Status -->
                                    @{
                                        var ownerAcceptedExt = rental.Extensions?.FirstOrDefault(e => e.Status == ExtensionStatus.Accepted || e.Status == ExtensionStatus.AutoApproved);
                                    }
                                    @if (ownerAcceptedExt != null)
                                    {
                                        <div class="mb-3 flex items-center gap-1.5 text-xs rounded-lg bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 p-2">
                                            <i class="bi bi-hourglass-split text-amber-500"></i>
                                            <span class="text-amber-700 dark:text-amber-300">@Localizer["Extension accepted — awaiting payment"] (+@CurrencyService.Format(ownerAcceptedExt.AdditionalCost))</span>
                                        </div>
                                    }

                                    <!-- Deposit Dispute Banner (owner sees when renter disputed) -->
                                    @if (rental.Deposit != null)
                                    {
                                        var dep = rental.Deposit;
                                        @if (dep.Status == DepositStatus.Disputed)
                                        {
                                            <div class="mb-3 rounded-xl border border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-900/20 p-3">
                                                <div class="flex items-start gap-2">
                                                    <i class="bi bi-exclamation-triangle text-rose-500 mt-0.5 shrink-0"></i>
                                                    <div class="flex-1">
                                                        <p class="text-xs font-bold text-rose-700 dark:text-rose-300">@Localizer["Renter disputed the deposit charge"]</p>
                                                        @if (!string.IsNullOrEmpty(dep.DisputeReason))
                                                        {
                                                            <p class="text-xs text-rose-600 dark:text-rose-400 mt-0.5 italic">"@dep.DisputeReason"</p>
                                                        }
                                                        
                                                        @if (dep.DisputeDeadline.HasValue && dep.DisputeDeadline > DateTime.UtcNow)
                                                        {
                                                            <div class="mt-2 flex items-center gap-1.5 text-[10px] font-medium text-rose-600 dark:text-rose-400 uppercase tracking-wider">
                                                                <i class="bi bi-clock"></i>
                                                                <span>@Localizer["Your response deadline"]: @dep.DisputeDeadline.Value.ToString("dd MMM HH:mm")</span>
                                                            </div>
                                                        }

                                                        <div class="mt-3 flex flex-wrap gap-2">
                                                             <button onclick='openCounterOfferModal(@rental.Id, @(dep.ChargedAmount ?? 0), @Html.Raw(System.Text.Json.JsonSerializer.Serialize((dep.Evidence ?? new List<DisputeEvidence>()).Where(e => e.SubmittedByUserId != currentUserId).Select(e => new { e.Url, e.Notes }))))'
                                                                    class="px-3 py-1.5 text-xs font-medium bg-white dark:bg-slate-800 text-trust-blue-600 border border-trust-blue-200 dark:border-trust-blue-800 rounded-lg hover:bg-trust-blue-50 dark:hover:bg-trust-blue-900/10 transition">
                                                                <i class="bi bi-pencil-square mr-1"></i>@Localizer["Counter-Offer"]
                                                            </button>
                                                             <button onclick='openMaintainChargeModal(@rental.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize((dep.Evidence ?? new List<DisputeEvidence>()).Where(e => e.SubmittedByUserId != currentUserId).Select(e => new { e.Url, e.Notes }))))'
                                                                    class="px-3 py-1.5 text-xs font-medium bg-trust-blue-600 text-white rounded-lg hover:brightness-110 transition">
                                                                @Localizer["Maintain Charge"]
                                                            </button>
                                                            <button onclick="releaseDisputedDeposit(@rental.Id)"
                                                                    class="px-3 py-1.5 text-xs font-medium text-emerald-600 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-700 rounded-lg hover:bg-emerald-100 dark:hover:bg-emerald-900/30 transition">
                                                                <i class="bi bi-shield-check mr-1"></i>@Localizer["Release & Close"]
                                                            </button>
                                                        </div>

                                                         @if (dep.Evidence != null && dep.Evidence.Any())
                                                         {
                                                             var yourEv = dep.Evidence.Where(e => e.SubmittedByUserId == currentUserId);
                                                             var otherEv = dep.Evidence.Where(e => e.SubmittedByUserId != currentUserId);

                                                             @if (otherEv.Any())
                                                             {
                                                                 <div class="mt-4 pt-3 border-t border-rose-100 dark:border-rose-900/50">
                                                                     <p class="text-[10px] uppercase font-bold text-rose-500 dark:text-rose-400 mb-2 tracking-wider">@Localizer["Renter's Evidence"]</p>
                                                                     <div class="flex flex-wrap gap-2">
                                                                         @foreach (var ev in otherEv.OrderByDescending(e => e.CreatedAt))
                                                                         {
                                                                             <a href="@ev.Url" target="_blank" class="w-10 h-10 rounded-lg overflow-hidden border border-rose-200 dark:border-rose-800 hover:scale-105 transition-transform" title="@ev.Notes">
                                                                                 <img src="@ev.Url" class="w-full h-full object-cover" />
                                                                             </a>
                                                                         }
                                                                     </div>
                                                                 </div>
                                                             }

                                                             @if (yourEv.Any())
                                                             {
                                                                 <div class="mt-4 pt-3 border-t border-rose-100 dark:border-rose-900/50">
                                                                     <p class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 mb-2 tracking-wider">@Localizer["Your Evidence"]</p>
                                                                     <div class="flex flex-wrap gap-2">
                                                                         @foreach (var ev in yourEv.OrderByDescending(e => e.CreatedAt))
                                                                         {
                                                                             <a href="@ev.Url" target="_blank" class="w-10 h-10 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700 hover:scale-105 transition-transform" title="@ev.Notes">
                                                                                 <img src="@ev.Url" class="w-full h-full object-cover opacity-80" />
                                                                             </a>
                                                                         }
                                                                         <button onclick="openAddEvidenceModal(@rental.Id)" class="w-10 h-10 rounded-lg flex items-center justify-center border border-dashed border-slate-300 dark:border-slate-600 text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-900 transition">
                                                                             <i class="bi bi-plus-lg"></i>
                                                                         </button>
                                                                     </div>
                                                                 </div>
                                                             }
                                                         }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else if (dep.Status == DepositStatus.CounterOffered)
                                        {
                                            <div class="mb-3 rounded-xl border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-900/20 p-3">
                                                <div class="flex items-start gap-2">
                                                    <i class="bi bi-hourglass-split text-amber-500 mt-0.5 shrink-0"></i>
                                                    <div>
                                                        <p class="text-xs font-medium text-amber-700 dark:text-amber-300">@Localizer["Counter-offer sent"]</p>
                                                        <p class="text-xs text-amber-600 dark:text-amber-400 mt-0.5">@Localizer["Waiting for renter to accept or escalate..."]</p>
                                                        <p class="text-[11px] font-semibold mt-1">@Localizer["Amount"]: @CurrencyService.Format(dep.CounterOfferAmount ?? 0)</p>

                                                         @if (dep.Evidence != null && dep.Evidence.Any())
                                                         {
                                                             var yourEv = dep.Evidence.Where(e => e.SubmittedByUserId == currentUserId);
                                                             var otherEv = dep.Evidence.Where(e => e.SubmittedByUserId != currentUserId);

                                                             @if (otherEv.Any())
                                                             {
                                                                 <div class="mt-4 pt-3 border-t border-amber-200/50 dark:border-amber-800/50">
                                                                     <p class="text-[10px] uppercase font-bold text-amber-600 dark:text-amber-500 mb-2 tracking-wider">@Localizer["Renter's Evidence"]</p>
                                                                     <div class="flex flex-wrap gap-2">
                                                                         @foreach (var ev in otherEv.OrderByDescending(e => e.CreatedAt))
                                                                         {
                                                                             <a href="@ev.Url" target="_blank" class="w-8 h-8 rounded-lg overflow-hidden border border-amber-200 dark:border-amber-800 hover:scale-105 transition-transform" title="@ev.Notes">
                                                                                 <img src="@ev.Url" class="w-full h-full object-cover" />
                                                                             </a>
                                                                         }
                                                                     </div>
                                                                 </div>
                                                             }

                                                             @if (yourEv.Any())
                                                             {
                                                                 <div class="mt-4 pt-3 border-t border-amber-200/50 dark:border-amber-800/50">
                                                                     <p class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 mb-2 tracking-wider">@Localizer["Your Evidence"]</p>
                                                                     <div class="flex flex-wrap gap-2">
                                                                         @foreach (var ev in yourEv.OrderByDescending(e => e.CreatedAt))
                                                                         {
                                                                             <a href="@ev.Url" target="_blank" class="w-8 h-8 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700 hover:scale-105 transition-transform" title="@ev.Notes">
                                                                                 <img src="@ev.Url" class="w-full h-full object-cover opacity-80" />
                                                                             </a>
                                                                         }
                                                                         <button onclick="openAddEvidenceModal(@rental.Id)" class="w-8 h-8 rounded-lg flex items-center justify-center border border-dashed border-slate-300 dark:border-slate-600 text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-900 transition">
                                                                             <i class="bi bi-plus"></i>
                                                                         </button>
                                                                     </div>
                                                                 </div>
                                                             }
                                                         }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else if (dep.Status == DepositStatus.Escalated)
                                        {
                                            <div class="mb-3 rounded-xl border border-blue-200 dark:border-blue-800 bg-blue-50 dark:bg-blue-900/20 p-3">
                                                <div class="flex items-start gap-2">
                                                    <i class="bi bi-info-circle text-blue-500 mt-0.5 shrink-0"></i>
                                                    <div>
                                                        <p class="text-xs font-medium text-blue-700 dark:text-blue-300">@Localizer["Dispute Escalated"]</p>
                                                        <p class="text-xs text-blue-600 dark:text-blue-400 mt-0.5">@Localizer["Admin review in progress. No further action needed."]</p>

                                                         @if (dep.Evidence != null && dep.Evidence.Any())
                                                         {
                                                             var yourEv = dep.Evidence.Where(e => e.SubmittedByUserId == currentUserId);
                                                             var otherEv = dep.Evidence.Where(e => e.SubmittedByUserId != currentUserId);

                                                             @if (otherEv.Any())
                                                             {
                                                                 <div class="mt-4 pt-3 border-t border-blue-200/50 dark:border-blue-800/50">
                                                                     <p class="text-[10px] uppercase font-bold text-blue-600 dark:text-blue-500 mb-2 tracking-wider">@Localizer["Renter's Evidence"]</p>
                                                                     <div class="flex flex-wrap gap-2">
                                                                         @foreach (var ev in otherEv.OrderByDescending(e => e.CreatedAt))
                                                                         {
                                                                             <a href="@ev.Url" target="_blank" class="w-8 h-8 rounded-lg overflow-hidden border border-blue-200 dark:border-blue-800 hover:scale-105 transition-transform" title="@ev.Notes">
                                                                                 <img src="@ev.Url" class="w-full h-full object-cover" />
                                                                             </a>
                                                                         }
                                                                     </div>
                                                                 </div>
                                                             }

                                                             @if (yourEv.Any())
                                                             {
                                                                 <div class="mt-4 pt-3 border-t border-blue-200/50 dark:border-blue-800/50">
                                                                     <p class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 mb-2 tracking-wider">@Localizer["Your Evidence"]</p>
                                                                     <div class="flex flex-wrap gap-2">
                                                                         @foreach (var ev in yourEv.OrderByDescending(e => e.CreatedAt))
                                                                         {
                                                                             <a href="@ev.Url" target="_blank" class="w-8 h-8 rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700 hover:scale-105 transition-transform" title="@ev.Notes">
                                                                                 <img src="@ev.Url" class="w-full h-full object-cover opacity-80" />
                                                                             </a>
                                                                         }
                                                                         <button onclick="openAddEvidenceModal(@rental.Id)" class="w-8 h-8 rounded-lg flex items-center justify-center border border-dashed border-slate-300 dark:border-slate-600 text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-900 transition">
                                                                             <i class="bi bi-plus"></i>
                                                                         </button>
                                                                     </div>
                                                                 </div>
                                                             }
                                                         }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }

                                    <!-- Price -->
                                    <div class="flex items-center justify-between text-sm mb-3">
                                        <span class="text-slate-500 dark:text-slate-400">@Localizer["Total"]</span>
                                        <span class="font-semibold text-emerald-600">@CurrencyService.Format(rental.TotalPrice)</span>
                                    </div>

                                    <!-- Actions -->
                                    <div class="flex gap-2">
                                        @if (rental.Status == RentalStatus.Pending)
                                        {
                                            <form asp-controller="Rentals" asp-action="ApproveRental" method="post" class="flex-1">
                                                <input type="hidden" name="rentalId" value="@rental.Id" />
                                                <button class="w-full rounded-xl bg-emerald-600 hover:bg-emerald-700 px-3 py-2 text-sm font-medium text-white transition">
                                                    <i class="bi bi-check-lg"></i> @Localizer["Approve"]
                                                </button>
                                            </form>
                                            <form asp-controller="Rentals" asp-action="CancelRental" method="post" class="flex-1">
                                                <input type="hidden" name="rentalId" value="@rental.Id" />
                                                <button class="w-full rounded-xl border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700 transition">
                                                    <i class="bi bi-x-lg"></i> @Localizer["Reject"]
                                                </button>
                                            </form>
                                        }
                                        else if (rental.Status == RentalStatus.Active)
                                        {
                                            @if (rental.Deposit != null && rental.Deposit.Status == DepositStatus.Authorized)
                                            {
                                                <button type="button"
                                                        onclick="openEarlyReturnModal(@rental.Id, @(rental.Deposit.Amount))"
                                                        class="flex-1 rounded-xl border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700 transition">
                                                    <i class="bi bi-flag"></i> @Localizer["End rental early"]
                                                </button>
                                            }
                                            else
                                            {
                                                <form asp-controller="Rentals" asp-action="CompleteRental" method="post" class="flex-1">
                                                    <input type="hidden" name="rentalId" value="@rental.Id" />
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="w-full rounded-xl border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700 transition">
                                                        <i class="bi bi-flag"></i> @Localizer["End rental early"]
                                                    </button>
                                                </form>
                                            }
                                        }
                                        else if (rental.Status == RentalStatus.Accepted)
                                        {
                                            <span class="flex-1 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-2 text-center text-sm font-medium text-slate-500 dark:text-slate-400">
                                                <i class="bi bi-hourglass-split"></i> @Localizer["Waiting for Payment"]
                                            </span>
                                            <form asp-controller="Rentals" asp-action="CancelRental" method="post" class="">
                                                <input type="hidden" name="rentalId" value="@rental.Id" />
                                                <button class="rounded-xl border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-700 transition" title="@Localizer["Cancel"]">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    @await Html.PartialAsync("_EmptyState", new { Icon = "bi-calendar-x", Message = "No rental requests at the moment." })
                }
            </section>

            @{
                var completedRentals = (Model.MyRentals?.Where(r =>
                        (r.Status == RentalStatus.Completed || r.Status == RentalStatus.Cancelled)
                        && !(r.Deposit != null && (r.Deposit.Status == DepositStatus.Disputed
                            || r.Deposit.Status == DepositStatus.Escalated
                            || r.Deposit.Status == DepositStatus.CounterOffered
                            || ((r.Deposit.Status == DepositStatus.Charged || r.Deposit.Status == DepositStatus.PartiallyCharged) 
                                && r.Deposit.DisputeDeadline.HasValue && r.Deposit.DisputeDeadline > DateTime.UtcNow)))
                    ).ToList() ?? new())
                    .Concat(Model.OwnerRentals?.Where(r =>
                        (r.Status == RentalStatus.Completed || r.Status == RentalStatus.Cancelled)
                        && !(r.Deposit != null && (r.Deposit.Status == DepositStatus.Disputed
                            || r.Deposit.Status == DepositStatus.Escalated
                            || r.Deposit.Status == DepositStatus.CounterOffered
                            || ((r.Deposit.Status == DepositStatus.Charged || r.Deposit.Status == DepositStatus.PartiallyCharged) 
                                && r.Deposit.DisputeDeadline.HasValue && r.Deposit.DisputeDeadline > DateTime.UtcNow)))
                    ) ?? Enumerable.Empty<Rental>())
                    .OrderByDescending(r => r.EndDate)
                    .Take(12)
                    .ToList();
            }
            @if (completedRentals.Any())
            {
                <section class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden">
                    <details open>
                        <summary class="px-6 py-4 cursor-pointer select-none border-b border-slate-200 dark:border-slate-700">
                            <h2 class="inline text-lg font-semibold font-outfit text-slate-900 dark:text-white">
                                <i class="bi bi-clock-history text-slate-400 mr-2"></i>
                                @Localizer["Rental History"]
                                <span class="ml-2 text-sm font-normal text-slate-500">(@completedRentals.Count)</span>
                            </h2>
                            @{
                                var unreviewedCount = completedRentals.Count(r => r.OwnerId != currentUserId && r.Status == RentalStatus.Completed && !(r.Item?.Reviews?.Any(rev => rev.ReviewerId == currentUserId && !rev.IsDeleted) ?? false));
                            }
                            @if (unreviewedCount > 0)
                            {
                                <p class="mt-1 ml-8 text-sm text-amber-600 dark:text-amber-400">
                                    <i class="bi bi-star mr-1"></i>
                                    @string.Format(Localizer["You have {0} completed rentals awaiting your review"].Value, unreviewedCount)
                                </p>
                            }
                        </summary>
                        <div class="divide-y divide-slate-100 dark:divide-slate-700">
                            @foreach (var rental in completedRentals)
                            {
                                var isOwner = rental.OwnerId == currentUserId;
                                <div class="px-6 py-3 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-lg overflow-hidden shrink-0">
                                            @if (!string.IsNullOrEmpty(rental.Item?.ImageUrl))
                                            {
                                                var thumbUrl = rental.Item.ImageUrl.Replace("/upload/", "/upload/c_thumb,w_80,h_80,q_auto/");
                                                <img src="@thumbUrl" class="w-full h-full object-cover" />
                                            }
                                            else
                                            {
                                                <div class="w-full h-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center"><i class="bi bi-image text-slate-300"></i></div>
                                            }
                                        </div>
                                        <div>
                                            <p class="text-sm font-medium text-slate-900 dark:text-white">@rental.Item?.Title</p>
                                            <p class="text-xs text-slate-500 dark:text-slate-400">
                                                @FormatDateRange(rental.StartDate, rental.EndDate)
                                                &middot; @(isOwner ? Localizer["As owner"] : Localizer["As renter"])
                                            </p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="text-sm font-medium text-slate-900 dark:text-white">@CurrencyService.Format(rental.TotalPrice)</span>
                                        @await Html.PartialAsync("_StatusBadge", new { Type = rental.Status.ToString().ToLower(), Text = rental.Status.ToString(), SmallPadding = true })
                                        @if (!isOwner && rental.Status == RentalStatus.Completed)
                                        {
                                            var existingReview = rental.Item?.Reviews?.FirstOrDefault(r => r.ReviewerId == currentUserId && !r.IsDeleted);
                                            @if (existingReview == null)
                                            {
                                                <button type="button" onclick="openReviewModal(@rental.Id, @rental.ItemId, null)"
                                                        class="px-2.5 py-1 text-xs font-medium text-amber-600 hover:text-amber-700 border border-amber-200 dark:border-amber-700 rounded-lg hover:bg-amber-50 dark:hover:bg-amber-900/20 transition">
                                                    <i class="bi bi-star mr-1"></i>@Localizer["Leave Review"]
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" onclick="openReviewModal(@rental.Id, @rental.ItemId, @existingReview.Id)"
                                                        class="px-2.5 py-1 text-xs font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 border border-slate-200 dark:border-slate-600 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700/50 transition">
                                                    <i class="bi bi-pencil mr-1"></i>@Localizer["Edit Review"]
                                                </button>
                                            }
                                            <a asp-controller="Items" asp-action="Details" asp-route-id="@rental.ItemId"
                                               class="px-2.5 py-1 text-xs font-medium text-trust-blue-600 hover:text-trust-blue-700 border border-trust-blue-200 dark:border-trust-blue-800 rounded-lg hover:bg-trust-blue-50 dark:hover:bg-trust-blue-900/20 transition">
                                                @Localizer["Rent Again"]
                                            </a>
                                        }

                                        @if (rental.Deposit != null && rental.Deposit.ChargedAt.HasValue)
                                        {
                                            <a asp-action="DisputeHistory" asp-route-id="@rental.Id"
                                               class="px-2.5 py-1 text-xs font-medium text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 border border-slate-200 dark:border-slate-600 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700/50 transition"
                                               title="@Localizer["View dispute process details"]">
                                                <i class="bi bi-shield-check mr-1"></i>@Localizer["Dispute History"]
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </details>
                </section>
            }
        </div>

        <!-- Right Column (Sidebar) -->
        <div class="lg:w-1/3 space-y-6">
            <!-- My Items Summary -->
            <section class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="px-5 py-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
                    <h2 class="text-base font-semibold font-outfit text-slate-900 dark:text-white flex items-center gap-2">
                        <i class="bi bi-box-seam text-trust-blue-600"></i>
                        @Localizer["My Items"]
                    </h2>
                    <a asp-controller="Items" asp-action="Create" class="text-xs text-trust-blue-600 hover:text-trust-blue-700 font-medium">
                        <i class="bi bi-plus-lg"></i> @Localizer["Add"]
                    </a>
                </div>

                @if (Model.ListingsOwned?.Any() ?? false)
                {
                    <div class="divide-y divide-slate-100 dark:divide-slate-700 max-h-96 overflow-y-auto">
                        @foreach (var item in Model.ListingsOwned)
                        {
                            <div class="px-5 py-3 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 shrink-0 rounded-lg overflow-hidden">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            var thumbUrl = item.ImageUrl.Replace("/upload/", "/upload/c_thumb,w_80,h_80,q_auto/");
                                            <img src="@thumbUrl" class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center"><i class="bi bi-image text-slate-300"></i></div>
                                        }
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-1.5">
                                            <h3 class="text-sm font-medium text-slate-900 dark:text-white truncate">@item.Title</h3>
                                            @if (item.IsListed)
                                            {
                                                <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0" title="@Localizer["Listed"]"></span>
                                            }
                                            else
                                            {
                                                <span class="w-2 h-2 rounded-full bg-slate-300 dark:bg-slate-600 shrink-0" title="@Localizer["Hidden"]"></span>
                                            }
                                        </div>
                                        <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
                                            <span class="font-medium text-trust-blue-600">@CurrencyService.Format(item.Price)/@Localizer["day"]</span>
                                            @if (item.DepositAmount.HasValue)
                                            {
                                                <span>&middot; <i class="bi bi-shield-check"></i> @CurrencyService.Format(item.DepositAmount)</span>
                                            }
                                            @if (item.Accessories?.Any() ?? false)
                                            {
                                                <span>&middot; @item.Accessories.Count @Localizer["add-ons"]</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <button onclick="toggleListing(@item.Id, this)"
                                                class="p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors"
                                                title="@(item.IsListed ? Localizer["Hide"] : Localizer["List"])">
                                            <i class="bi @(item.IsListed ? "bi-eye-slash" : "bi-eye") text-sm"></i>
                                        </button>
                                        <a asp-controller="Items" asp-action="Edit" asp-route-id="@item.Id"
                                           class="p-1.5 text-slate-400 hover:text-trust-blue-600 hover:bg-trust-blue-50 dark:hover:bg-trust-blue-900/20 rounded-lg transition-colors"
                                           title="@Localizer["Edit"]">
                                            <i class="bi bi-pencil text-sm"></i>
                                        </a>
                                        <a asp-controller="Items" asp-action="Delete" asp-route-id="@item.Id"
                                           class="p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors"
                                           title="@Localizer["Delete"]">
                                            <i class="bi bi-trash text-sm"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    @await Html.PartialAsync("_EmptyState", new { Icon = "bi-box-seam", Message = "You have no listed items yet.", ActionLink = Url.Action("Create", "Items"), ActionText = "Add First Item" })
                }
            </section>

            <!-- Saved Favorites -->
            <section class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="px-5 py-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
                    <h2 class="text-base font-semibold font-outfit text-slate-900 dark:text-white flex items-center gap-2">
                        <i class="bi bi-heart-fill text-red-500"></i>
                        @Localizer["Favorites"]
                        @if (Model.FavoriteItems?.Any() ?? false)
                        {
                            <span class="text-xs font-normal text-slate-500">(@(Model.FavoriteItems?.Count ?? 0))</span>
                        }
                    </h2>
                    <a asp-controller="Rentals" asp-action="Index" class="text-xs text-trust-blue-600 hover:text-trust-blue-700 font-medium">
                        @Localizer["Find More"]
                    </a>
                </div>

                @if (Model.FavoriteItems?.Any() ?? false)
                {
                    <div class="divide-y divide-slate-100 dark:divide-slate-700 max-h-80 overflow-y-auto">
                        @foreach (var item in Model.FavoriteItems)
                        {
                            <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id"
                               class="px-5 py-3 flex items-center gap-3 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors">
                                <div class="w-10 h-10 shrink-0 rounded-lg overflow-hidden">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        var thumbUrl = item.ImageUrl.Replace("/upload/", "/upload/c_thumb,w_80,h_80,q_auto/");
                                        <img src="@thumbUrl" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <div class="w-full h-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center"><i class="bi bi-image text-slate-300"></i></div>
                                    }
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h3 class="text-sm font-medium text-slate-900 dark:text-white truncate">@item.Title</h3>
                                    <span class="text-xs font-semibold text-trust-blue-600">@CurrencyService.Format(item.Price)/@Localizer["day"]</span>
                                </div>
                                @if (item.AverageRating.HasValue)
                                {
                                    <span class="text-xs text-amber-500"><i class="bi bi-star-fill"></i> @item.AverageRating.Value.ToString("0.0")</span>
                                }
                            </a>
                        }
                    </div>
                }
                else
                {
                    @await Html.PartialAsync("_EmptyState", new { Icon = "bi-heart", Message = "No favorites yet" })
                }
            </section>

            <!-- Earnings Overview (Placeholder) -->
            <section class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-5">
                <h2 class="text-base font-semibold font-outfit text-slate-900 dark:text-white flex items-center gap-2 mb-4">
                    <i class="bi bi-currency-euro text-emerald-600"></i>
                    @Localizer["Earnings Overview"]
                </h2>
                <div class="space-y-3">
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500 dark:text-slate-400">@Localizer["Total Earned"]</span>
                        <span class="font-medium text-slate-900 dark:text-white">
                            @CurrencyService.Format(Model.OwnerRentals?.Where(r => r.Status == RentalStatus.Completed).Sum(r => r.TotalPrice) ?? 0)
                        </span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500 dark:text-slate-400">@Localizer["Active Income"]</span>
                        <span class="font-medium text-emerald-600">
                            @CurrencyService.Format(Model.OwnerRentals?.Where(r => r.Status == RentalStatus.Active).Sum(r => r.TotalPrice) ?? 0)
                        </span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500 dark:text-slate-400">@Localizer["Deposits Held"]</span>
                        <span class="font-medium text-sky-600">
                            @CurrencyService.Format(Model.DepositSummary?.TotalHeld ?? 0)
                        </span>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

<!-- Extension Modal -->
<div id="extension-modal" class="fixed inset-0 z-50 hidden items-center justify-center" role="dialog" aria-modal="true" aria-labelledby="extension-modal-title">
    <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" data-action="close-extension"></div>
    <div class="relative mx-4 w-full max-w-md rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-6 shadow-xl">
        <button type="button" data-action="close-extension" class="absolute top-4 right-4 rounded-lg p-1 text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-slate-600 dark:hover:text-slate-300 transition" aria-label="@Localizer["Close"]">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
        <div class="mb-5">
            <h2 id="extension-modal-title" class="text-lg font-semibold font-outfit text-slate-900 dark:text-white">@Localizer["Extend Rental"]</h2>
        </div>
        <div id="ext-current-info" class="mb-5 rounded-xl bg-slate-50 dark:bg-slate-900/50 p-4">
            <div class="flex justify-between text-sm">
                <span class="text-slate-500 dark:text-slate-400">@Localizer["Your rental period"]</span>
                <span id="ext-rental-period" class="font-medium text-slate-900 dark:text-white"></span>
            </div>
            <div class="mt-2 flex justify-between text-sm">
                <span class="text-slate-500 dark:text-slate-400">@Localizer["Daily rate"]</span>
                <span id="ext-daily-rate" class="font-medium text-slate-900 dark:text-white"></span>
            </div>
        </div>
        <form id="extension-form" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="RentalId" id="ext-rental-id" />
            <div class="mb-4">
                <label class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-300">@Localizer["New return date"]</label>
                @await Html.PartialAsync("_SmartCalendar", new RentMate.Models.ViewModels.SmartCalendarModel {
                    Id = "extCalendar",
                    Mode = RentMate.Models.ViewModels.CalendarMode.Single,
                    StartDateField = "NewEndDate",
                    MinDate = DateOnly.FromDateTime(DateTime.Today.AddDays(1)),
                    Placeholder = Localizer["Pick new return date..."].Value
                })
            </div>
            <div id="ext-blocked-notice" class="mb-4 hidden rounded-xl border border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-900/20 p-3">
                <div class="flex items-start gap-2">
                    <i class="bi bi-calendar-x text-rose-500 mt-0.5 shrink-0"></i>
                    <div>
                        <p class="text-xs font-medium text-rose-700 dark:text-rose-300">@Localizer["Extension limited"]</p>
                        <p class="text-xs text-rose-600 dark:text-rose-400 mt-0.5">@Localizer["Another booking starts on"] <strong id="ext-blocked-date"></strong>. @Localizer["You can extend up to the day before. To rent beyond that, create a new booking after their rental ends."]</p>
                    </div>
                </div>
            </div>
            <div id="ext-cost-preview" class="mb-5 hidden rounded-xl border border-trust-blue-200 dark:border-trust-blue-800 bg-trust-blue-50 dark:bg-trust-blue-900/20 p-4">
                <div class="space-y-2 text-sm">
                    <div class="flex justify-between text-slate-600 dark:text-slate-400">
                        <span>@Localizer["Additional days"]</span>
                        <span id="ext-extra-days">0</span>
                    </div>
                    <div class="flex justify-between border-t border-trust-blue-200 dark:border-trust-blue-700 pt-2">
                        <span class="font-medium text-slate-900 dark:text-white">@Localizer["Additional cost"]</span>
                        <span id="ext-additional-cost" class="text-base font-semibold text-trust-blue-700 dark:text-trust-blue-300"></span>
                    </div>
                </div>
            </div>
            <div id="ext-approval-notice" class="mb-5 flex items-start gap-2 rounded-xl border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-900/20 p-3">
                <i class="bi bi-info-circle text-amber-500 mt-0.5 shrink-0"></i>
                <p class="text-xs text-amber-700 dark:text-amber-300">@Localizer["This extension request will be sent to the owner for approval."]</p>
            </div>
            <div class="flex gap-3">
                <button type="button" data-action="close-extension"
                        class="flex-1 rounded-xl border border-slate-200 dark:border-slate-600 px-4 py-2.5 text-sm font-medium text-slate-700 dark:text-slate-300 transition hover:bg-slate-50 dark:hover:bg-slate-700">
                    @Localizer["Cancel"]
                </button>
                <button type="submit" id="ext-submit-btn" disabled
                        class="flex-1 rounded-xl bg-gradient-to-r from-trust-blue-600 to-trust-blue-700 px-4 py-2.5 text-sm font-medium text-white shadow-sm transition hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-50">
                    @Localizer["Request Extension"]
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Deposit Resolution Modal -->

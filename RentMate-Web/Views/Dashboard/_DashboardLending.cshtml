@using Microsoft.AspNetCore.Mvc.Localization
@using RentMate.Shared.Contracts.Responses
@using RentMate.Models.Domain
@using System.Text.Json
@model RentMate.Models.ViewModels.DashboardViewModel
@inject IViewLocalizer Localizer
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService

@{
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    var activeOwnerRentals = Model.OwnerRentals?.Where(r =>
        r.Status == RentalStatus.Active || r.Status == RentalStatus.Pending || r.Status == RentalStatus.Accepted
        || (r.Status == RentalStatus.Completed && r.ArchivedAt == null)
    ).ToList() ?? new();

    var pendingRequests = activeOwnerRentals.Where(r => r.Status == RentalStatus.Pending).ToList();
    var activeRentals = activeOwnerRentals.Where(r => r.Status == RentalStatus.Active).ToList();
    var acceptedRentals = activeOwnerRentals.Where(r => r.Status == RentalStatus.Accepted).ToList();
    var depositIssueRentals = activeOwnerRentals.Where(r => r.Status == RentalStatus.Completed).ToList();

    var dailyIncome = activeRentals.Sum(r => r.Item?.Price ?? 0);
    var totalEarned = Model.OwnerRentals?.Where(r => r.Status == RentalStatus.Completed).Sum(r => r.TotalPrice) ?? 0;
    var monthlyEarned = Model.OwnerRentals?
        .Where(r => r.Status == RentalStatus.Completed && r.EndDate.Month == DateTime.UtcNow.Month && r.EndDate.Year == DateTime.UtcNow.Year)
        .Sum(r => r.TotalPrice) ?? 0;
}

<!-- Summary Strip -->
<div class="flex flex-wrap items-center gap-4 mb-6 px-1">
    <div class="flex items-center gap-2 text-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span class="text-slate-500 dark:text-slate-400">@Localizer["RentedOut"]</span>
        <span class="font-semibold text-slate-900 dark:text-white">@activeRentals.Count</span>
    </div>
    <div class="flex items-center gap-2 text-sm">
        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
        <span class="text-slate-500 dark:text-slate-400">@Localizer["PendingRequests"]</span>
        <span class="font-semibold text-slate-900 dark:text-white">@pendingRequests.Count</span>
    </div>
    <div class="flex items-center gap-2 text-sm">
        <i class="bi bi-cash-stack text-emerald-600"></i>
        <span class="text-slate-500 dark:text-slate-400">@Localizer["DailyIncome"]</span>
        <span class="font-semibold text-emerald-600">@CurrencyService.Format(dailyIncome)/@Localizer["day"]</span>
    </div>
</div>

@* === Pending Rental Requests — inline rich cards (Airbnb-style host inbox) === *@
@if (pendingRequests.Any())
{
    <div class="mb-6 rounded-2xl border border-amber-200 dark:border-amber-800 bg-amber-50/60 dark:bg-amber-900/10 overflow-hidden">
        <div class="px-5 py-3 border-b border-amber-200 dark:border-amber-800 flex items-center gap-2">
            <i class="bi bi-clock text-amber-500"></i>
            <h3 class="text-sm font-semibold text-amber-700 dark:text-amber-300">@Localizer["PendingRequests"] (@pendingRequests.Count)</h3>
        </div>
        <div class="p-3 space-y-3">
            @foreach (var rental in pendingRequests)
            {
                var detail = Model.PendingRequestDetails?.GetValueOrDefault(rental.Id);
                var thumbUrl = !string.IsNullOrEmpty(rental.Item?.PrimaryImageUrl)
                    ? rental.Item.PrimaryImageUrl.Replace("/upload/", "/upload/c_thumb,w_80,h_80,q_auto/")
                    : "";
                var avatarUrl = !string.IsNullOrEmpty(rental.Renter?.ProfilePictureUrl)
                    ? rental.Renter.ProfilePictureUrl.Replace("/upload/", "/upload/c_thumb,w_128,h_128,q_auto/")
                    : "";
                var days = Math.Max(1, (rental.EndDate - rental.StartDate).Days);
                var trustScore = rental.Renter?.ProfileTrustScore ?? 0;
                var trustLabel = trustScore >= 80 ? Localizer["TrustHighlyTrusted"].Value
                               : trustScore >= 60 ? Localizer["TrustTrusted"].Value
                               : Localizer["TrustNewUser"].Value;
                var trustColor = trustScore >= 80 ? "emerald" : trustScore >= 60 ? "amber" : "slate";
                var renterDisplayName = rental.Renter?.FirstName != null
                    ? $"{rental.Renter.FirstName} {rental.Renter.LastName}".Trim()
                    : (rental.Renter?.UserName ?? Localizer["DeletedUser"].Value);

                var verifications = new List<(string Label, string Icon)>();
                if (rental.Renter?.EmailConfirmed == true) verifications.Add(("Email", "bi-envelope-check-fill"));
                if (rental.Renter?.IsPhoneVerified == true) verifications.Add(("Phone", "bi-phone-fill"));
                if (rental.Renter?.IsGovernmentIdVerified == true) verifications.Add(("ID", "bi-person-badge-fill"));
                if (!string.IsNullOrEmpty(rental.Renter?.ProfilePictureUrl)) verifications.Add(("Photo", "bi-image-fill"));

                var hasAccessories = (rental.Accessories?.Count ?? 0) > 0;
                var basePriceFmt = CurrencyService.Format(detail?.BasePrice ?? (rental.Item?.Price ?? 0m) * days);
                var pricePerDayFmt = CurrencyService.Format(rental.Item?.Price ?? 0m);
                var accessoriesTotalFmt = CurrencyService.Format(detail?.AccessoriesTotal ?? 0m);
                var totalPayoutFmt = CurrencyService.Format(detail?.NetPayout ?? (rental.Item?.Price ?? 0m) * days);
                var depositAmount = detail?.DepositAmount ?? 0m;
                var depositAmountFmt = CurrencyService.Format(depositAmount);
                var hasConflict = detail?.HasConflict ?? false;

                <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden">
                    <!-- Header: item thumb + title -->
                    <div class="flex items-center gap-3 px-5 py-3 border-b border-slate-200 dark:border-slate-700">
                        <div class="w-10 h-10 shrink-0 rounded-lg overflow-hidden bg-slate-100 dark:bg-slate-700">
                            @if (!string.IsNullOrEmpty(thumbUrl))
                            {
                                <img src="@thumbUrl" class="w-full h-full object-cover" alt="@rental.Item?.Title" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center"><i class="bi bi-image text-slate-300"></i></div>
                            }
                        </div>
                        <a asp-controller="Items" asp-action="Details" asp-route-id="@rental.ItemId"
                           class="flex-1 min-w-0 text-base font-semibold text-slate-900 dark:text-white truncate hover:text-trust-blue-600 dark:hover:text-trust-blue-400 transition-colors">
                            @rental.Item?.Title
                        </a>
                    </div>

                    <!-- Body: two-column on md+, booking-first on mobile -->
                    <div class="p-5">
                        <div class="flex flex-col-reverse md:flex-row gap-5">

                            <!-- Renter panel (left on desktop, second on mobile) -->
                            <div class="md:w-72 shrink-0 rounded-xl bg-blue-50/50 dark:bg-slate-900/40 border border-blue-100 dark:border-slate-700 p-4 flex flex-col gap-3">
                                <div class="flex items-start gap-3">
                                    <div class="w-12 h-12 rounded-full overflow-hidden bg-slate-200 dark:bg-slate-700 shrink-0">
                                        @if (!string.IsNullOrEmpty(avatarUrl))
                                        {
                                            <img src="@avatarUrl" class="w-full h-full object-cover" alt="@renterDisplayName" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center text-xl text-slate-400"><i class="bi bi-person-circle"></i></div>
                                        }
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="font-semibold text-slate-900 dark:text-white text-sm truncate">@renterDisplayName</p>
                                        @if (!string.IsNullOrEmpty(rental.Renter?.City))
                                        {
                                            <p class="text-xs text-slate-500 dark:text-slate-400 truncate">@rental.Renter.City</p>
                                        }
                                        @if (!string.IsNullOrEmpty(rental.Renter?.Id))
                                        {
                                            <a asp-controller="Profile" asp-action="Details" asp-route-id="@rental.Renter.Id"
                                               class="text-xs text-trust-blue-600 hover:text-trust-blue-700 dark:text-trust-blue-400 font-medium inline-flex items-center gap-1 mt-0.5">
                                                @Localizer["ViewFullProfile"] <i class="bi bi-arrow-right"></i>
                                            </a>
                                        }
                                    </div>
                                </div>

                                <div>
                                    <span class="text-sm font-semibold text-@(trustColor)-600 dark:text-@(trustColor)-400">@trustLabel</span>
                                </div>

                                @if (verifications.Any())
                                {
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var v in verifications)
                                        {
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300">
                                                <i class="bi @v.Icon"></i>@v.Label
                                            </span>
                                        }
                                    </div>
                                }

                                @{
                                    var avgRating = detail?.RenterAvgRating ?? 0;
                                    var reviewCount = detail?.RenterReviewCount ?? 0;
                                    var completedRentals = detail?.RenterCompletedRentalsCount ?? 0;
                                }
                                @if (avgRating > 0 || completedRentals > 0)
                                {
                                    <div class="flex items-center gap-3 text-xs">
                                        @if (avgRating > 0)
                                        {
                                            <span class="font-medium text-amber-500">★ @avgRating.ToString("0.0") (@reviewCount)</span>
                                        }
                                        @if (completedRentals > 0)
                                        {
                                            <span class="text-slate-500 dark:text-slate-400">@Localizer["RentalsCompletedCount", completedRentals]</span>
                                        }
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(rental.Renter?.Bio))
                                {
                                    <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-3 italic">"@rental.Renter.Bio"</p>
                                }
                            </div>

                            <!-- Booking panel (right on desktop, first on mobile) -->
                            <div class="flex-1 flex flex-col gap-4 min-w-0">

                                <!-- Date strip -->
                                <div class="rounded-xl bg-emerald-50/50 dark:bg-slate-900/40 border border-emerald-100 dark:border-slate-700 p-4">
                                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-2">@Localizer["BookingDetails"]</p>
                                    <div class="flex items-center gap-3 flex-wrap">
                                        <span class="text-base font-semibold text-slate-900 dark:text-white">@rental.StartDate.ToString("dd MMM")</span>
                                        <i class="bi bi-arrow-right text-slate-400"></i>
                                        <span class="text-base font-semibold text-slate-900 dark:text-white">@rental.EndDate.ToString("dd MMM yyyy")</span>
                                        <span class="ml-auto text-sm font-medium text-emerald-600 dark:text-emerald-400">@days @Localizer["days"]</span>
                                    </div>
                                </div>

                                @if (hasConflict)
                                {
                                    <div class="flex items-start gap-2 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 p-3">
                                        <i class="bi bi-exclamation-triangle-fill text-red-500 shrink-0 mt-0.5"></i>
                                        <div class="min-w-0">
                                            <p class="text-sm font-medium text-red-700 dark:text-red-300">
                                                @Localizer["CalendarConflictCount", detail!.ConflictingRentals.Count]
                                            </p>
                                            <ul class="mt-1 space-y-0.5 text-xs text-red-600 dark:text-red-400">
                                                @foreach (var c in detail.ConflictingRentals)
                                                {
                                                    var cName = c.Renter?.FirstName ?? c.Renter?.UserName ?? "";
                                                    <li>@c.StartDate.ToString("dd MMM") – @c.EndDate.ToString("dd MMM yyyy")@(string.IsNullOrEmpty(cName) ? "" : $" ({cName})")</li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                }

                                <!-- Payout breakdown -->
                                <div class="rounded-xl bg-emerald-50/50 dark:bg-slate-900/40 border border-emerald-100 dark:border-slate-700 p-4">
                                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-3">@Localizer["Payout"]</p>
                                    <div class="space-y-1.5 text-sm">
                                        <div class="flex justify-between">
                                            <span class="text-slate-500 dark:text-slate-400">@days @Localizer["days"] × @pricePerDayFmt</span>
                                            <span class="font-medium text-slate-900 dark:text-white">@basePriceFmt</span>
                                        </div>
                                        @if (hasAccessories)
                                        {
                                            <div class="space-y-1">
                                                @foreach (var a in rental.Accessories!)
                                                {
                                                    <div class="flex justify-between text-xs">
                                                        <span class="text-slate-500 dark:text-slate-400">@a.Name</span>
                                                        <span>@CurrencyService.Format(a.DailyPrice * days)</span>
                                                    </div>
                                                }
                                            </div>
                                            <div class="flex justify-between border-t border-slate-200 dark:border-slate-600 mt-1.5 pt-1.5">
                                                <span class="text-slate-500 dark:text-slate-400">@Localizer["AccessoriesTotal"]</span>
                                                <span class="font-medium text-slate-900 dark:text-white">@accessoriesTotalFmt</span>
                                            </div>
                                            <div class="flex justify-between border-t border-emerald-200 dark:border-emerald-800 pt-2 mt-1">
                                                <span class="font-semibold text-slate-900 dark:text-white">@Localizer["TotalPayout"]</span>
                                                <span class="font-bold text-emerald-600 dark:text-emerald-400 text-base">@totalPayoutFmt</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (depositAmount > 0)
                                {
                                    <p class="text-xs text-slate-400 italic px-1">@string.Format(Localizer["DepositNote"].Value, depositAmountFmt)</p>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Footer: Reject + Approve -->
                    <div class="flex items-center justify-end gap-2 px-5 py-3 border-t border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50">
                        <form method="post" asp-controller="Rentals" asp-action="CancelRental" class="inline">
                            <input type="hidden" name="rentalId" value="@rental.Id" />
                            <button type="submit"
                                    class="px-4 py-2 text-sm font-medium border border-slate-300 dark:border-slate-600 text-slate-600 dark:text-slate-300 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 transition-all focus-ring">
                                @Localizer["Reject"]
                            </button>
                        </form>
                        <form method="post" asp-controller="Rentals" asp-action="ApproveRental" class="inline">
                            <input type="hidden" name="rentalId" value="@rental.Id" />
                            <button type="submit"
                                    class="inline-flex items-center gap-1.5 px-5 py-2 text-sm font-semibold bg-gradient-to-r from-emerald-600 to-emerald-500 hover:from-emerald-700 hover:to-emerald-600 text-white rounded-lg shadow-sm transition-all focus-ring">
                                <i class="bi bi-check-lg"></i>@Localizer["Approve"]
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
}

@* === Attention: Pending Extension Requests === *@
@* JSON data blocks rendered here, outside any styled container *@
@if (Model.PendingExtensions?.Any() ?? false)
{
    @foreach (var ext in Model.PendingExtensions!)
    {
        var extConflicts = Model.ExtensionConflicts?.GetValueOrDefault(ext.Id);
        var extDays = Math.Max(1, (ext.NewEndDate - ext.OriginalEndDate).Days);
        var totalRentalDays = Math.Max(1, (ext.Rental?.EndDate - ext.Rental?.StartDate)?.Days ?? 1);
        var currentDay = Math.Max(1, (DateTime.UtcNow - (ext.Rental?.StartDate ?? DateTime.UtcNow)).Days + 1);

        var extPayload = new {
            extensionId = ext.Id,
            rentalId = ext.RentalId,
            item = new {
                title = ext.Rental?.Item?.Title ?? "",
                thumbUrl = !string.IsNullOrEmpty(ext.Rental?.Item?.PrimaryImageUrl)
                    ? ext.Rental.Item.PrimaryImageUrl.Replace("/upload/", "/upload/c_thumb,w_80,h_80,q_auto/")
                    : ""
            },
            renterFirstName = ext.RequestedBy?.FirstName ?? ext.RequestedBy?.UserName ?? "",
            originalEndDate = ext.OriginalEndDate.ToString("dd MMM yyyy"),
            newEndDate = ext.NewEndDate.ToString("dd MMM yyyy"),
            extraDays = extDays,
            additionalCost = ext.AdditionalCost,
            additionalCostFmt = CurrencyService.Format(ext.AdditionalCost),
            progress = $"Day {Math.Min(currentDay, totalRentalDays)} of {totalRentalDays}",
            conflicts = extConflicts?.Select(c => new {
                renterName = c.Renter?.FirstName ?? c.Renter?.UserName ?? "",
                start = c.StartDate.ToString("dd MMM"),
                end = c.EndDate.ToString("dd MMM yyyy")
            }).ToList(),
            hasConflict = extConflicts?.Any() ?? false
        };

        <script type="application/json" class="extension-request-data" data-extension-id="@ext.Id">@Html.Raw(JsonSerializer.Serialize(extPayload, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }))</script>
    }

    <div class="mb-6 rounded-2xl border border-sky-200 dark:border-sky-800 bg-sky-50 dark:bg-sky-900/20 overflow-hidden">
        <div class="px-5 py-3 border-b border-sky-200 dark:border-sky-800 flex items-center gap-2">
            <i class="bi bi-calendar-plus text-sky-500"></i>
            <h3 class="text-sm font-semibold text-sky-700 dark:text-sky-300">@Localizer["Pending Extensions"] (@(Model.PendingExtensions?.Count ?? 0))</h3>
        </div>
        <div class="divide-y divide-sky-200 dark:divide-sky-800">
            @foreach (var ext in Model.PendingExtensions!)
            {
                <div class="px-5 py-3 flex items-center gap-3 cursor-pointer hover:bg-sky-100/50 dark:hover:bg-sky-900/30 transition-colors extension-request-row"
                     data-extension-id="@ext.Id"
                     role="button"
                     tabindex="0"
                     aria-label="@Localizer["ExtensionDetails"]: @ext.Rental?.Item?.Title">
                    <span class="w-8 h-8 rounded-full bg-sky-100 dark:bg-sky-900/30 flex items-center justify-center shrink-0">
                        <i class="bi bi-calendar-plus text-sky-600 dark:text-sky-400 text-sm"></i>
                    </span>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-slate-900 dark:text-white truncate">@ext.Rental?.Item?.Title</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400">
                            @Localizer["From"] @(ext.RequestedBy?.FirstName ?? ext.RequestedBy?.UserName ?? Localizer["DeletedUser"].Value) &mdash;
                            @ext.OriginalEndDate.ToString("dd MMM") &rarr; @ext.NewEndDate.ToString("dd MMM yyyy")
                            (+@CurrencyService.Format(ext.AdditionalCost))
                        </p>
                    </div>
                    <i class="bi bi-chevron-right text-slate-400 shrink-0"></i>
                </div>
            }
        </div>
    </div>
}

@* === Active Owner Rentals (expandable rows) === *@
@{
    var nonPendingRentals = activeRentals.Concat(acceptedRentals).Concat(depositIssueRentals).ToList();
}
@if (nonPendingRentals.Any())
{
    <div class="mb-6">
        <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-3 flex items-center gap-2">
            <i class="bi bi-graph-up-arrow text-emerald-500"></i>
            @Localizer["RentedOut"] (@nonPendingRentals.Count)
        </h3>
        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden divide-y divide-slate-100 dark:divide-slate-700">
            @foreach (var rental in nonPendingRentals)
            {
                @await Html.PartialAsync("_OwnerRentalRow", new RentMate.Models.ViewModels.RentalRowViewModel { Rental = rental, CurrentUserId = currentUserId ?? "", CurrencyService = CurrencyService })
            }
        </div>
    </div>
}

@* === Earnings Bar === *@
<div class="mb-6 grid grid-cols-3 gap-4">
    @await Html.PartialAsync("_StatCard", new { Icon = "bi-currency-euro", IconColor = "green", Value = CurrencyService.Format(totalEarned), Label = "Total Earned", Link = (string?)null, LinkText = (string?)null })
    @await Html.PartialAsync("_StatCard", new { Icon = "bi-calendar-check", IconColor = "blue", Value = CurrencyService.Format(monthlyEarned), Label = "MonthlyEarnings", Link = (string?)null, LinkText = (string?)null })
    @await Html.PartialAsync("_StatCard", new { Icon = "bi-shield-check", IconColor = "amber", Value = CurrencyService.Format(Model.DepositSummary?.TotalHeld ?? 0), Label = "DepositsHeld", Link = (string?)null, LinkText = (string?)null })
</div>

@* === My Items Mini-Grid === *@
<div>
    <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-semibold text-slate-900 dark:text-white flex items-center gap-2">
            <i class="bi bi-box-seam text-trust-blue-600"></i>
            @Localizer["MyItems"] (@(Model.ListingsOwned?.Count ?? 0))
        </h3>
        <a asp-controller="Items" asp-action="Create" class="text-xs text-trust-blue-600 hover:text-trust-blue-700 font-medium">
            <i class="bi bi-plus-lg"></i> @Localizer["Add"]
        </a>
    </div>

    @if (Model.ListingsOwned?.Any() ?? false)
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var item in Model.ListingsOwned)
            {
                <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden hover:shadow-sm transition-shadow">
                    <div class="h-28 overflow-hidden relative">
                        @if (!string.IsNullOrEmpty(item.PrimaryImageUrl))
                        {
                            var thumbUrl = item.PrimaryImageUrl.Replace("/upload/", "/upload/c_fill,w_300,h_150,q_auto/");
                            <img src="@thumbUrl" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <div class="w-full h-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center"><i class="bi bi-image text-2xl text-slate-300"></i></div>
                        }
                        <div class="absolute top-2 right-2">
                            @if (item.IsListed)
                            {
                                <span class="px-1.5 py-0.5 bg-emerald-500/90 text-white text-[10px] font-bold rounded-full">@Localizer["Listed"]</span>
                            }
                            else
                            {
                                <span class="px-1.5 py-0.5 bg-slate-500/90 text-white text-[10px] font-bold rounded-full">@Localizer["Hidden"]</span>
                            }
                        </div>
                        @if (pendingRequests.Any(r => r.ItemId == item.Id))
                        {
                            <span class="absolute top-2 left-2 w-3 h-3 bg-amber-500 rounded-full animate-pulse ring-2 ring-white dark:ring-slate-800"
                                  title="@Localizer["PendingRequests"]"></span>
                        }
                    </div>
                    <div class="p-3">
                        <h4 class="text-sm font-medium text-slate-900 dark:text-white truncate">@item.Title</h4>
                        <p class="text-xs font-semibold text-trust-blue-600 mt-0.5">@CurrencyService.Format(item.Price)/@Localizer["day"]</p>
                        <div class="flex items-center gap-1 mt-2">
                            <button onclick="toggleListing(@item.Id, this)"
                                    class="p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors"
                                    title="@(item.IsListed ? Localizer["Hide"] : Localizer["List"])">
                                <i class="bi @(item.IsListed ? "bi-eye-slash" : "bi-eye") text-sm"></i>
                            </button>
                            <a asp-controller="Items" asp-action="Edit" asp-route-id="@item.Id"
                               class="p-1.5 text-slate-400 hover:text-trust-blue-600 hover:bg-trust-blue-50 dark:hover:bg-trust-blue-900/20 rounded-lg transition-colors"
                               title="@Localizer["Edit"]">
                                <i class="bi bi-pencil text-sm"></i>
                            </a>
                            <a asp-controller="Items" asp-action="Delete" asp-route-id="@item.Id"
                               class="p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors"
                               title="@Localizer["Delete"]">
                                <i class="bi bi-trash text-sm"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
            <!-- Add Item Card -->
            <a asp-controller="Items" asp-action="Create"
               class="bg-white dark:bg-slate-800 rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-600 flex flex-col items-center justify-center min-h-[180px] hover:border-trust-blue-400 dark:hover:border-trust-blue-600 hover:bg-trust-blue-50/50 dark:hover:bg-trust-blue-900/10 transition-all group">
                <div class="w-10 h-10 bg-trust-blue-100 dark:bg-trust-blue-900/30 rounded-xl flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
                    <i class="bi bi-plus-lg text-trust-blue-600 dark:text-trust-blue-400"></i>
                </div>
                <p class="text-sm font-medium text-slate-500 dark:text-slate-400 group-hover:text-trust-blue-600 dark:group-hover:text-trust-blue-400 transition-colors">@Localizer["Add Item"]</p>
            </a>
        </div>
    }
    else
    {
        @await Html.PartialAsync("_EmptyState", new { Icon = "bi-box-seam", Message = "You have no listed items yet.", ActionLink = Url.Action("Create", "Items"), ActionText = "Add First Item" })
    }
</div>

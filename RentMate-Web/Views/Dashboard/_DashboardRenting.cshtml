@using Microsoft.AspNetCore.Mvc.Localization
@using RentMate.Shared.Contracts.Responses
@using RentMate.Models.Domain
@model RentMate.Models.ViewModels.DashboardViewModel
@inject IViewLocalizer Localizer
@inject RentMate.Services.Interfaces.ICurrencyService CurrencyService

@{
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    // Active rentals: includes active, pending, accepted, completed-not-archived, and completed-with-active-deposit-issues
    var activeMyRentals = Model.MyRentals?.Where(r =>
        r.Status == RentalStatus.Active || r.Status == RentalStatus.Pending || r.Status == RentalStatus.Accepted
        || (r.Status == RentalStatus.Completed && r.ArchivedAt == null)
    ).ToList() ?? new();

    var overdueRentals = activeMyRentals.Where(r => r.Status == RentalStatus.Active && r.EndDate.Date < DateTime.UtcNow.Date).ToList();
    var activeNonOverdue = activeMyRentals.Where(r => r.Status == RentalStatus.Active && r.EndDate.Date >= DateTime.UtcNow.Date).ToList();
    var pendingRentals = activeMyRentals.Where(r => r.Status == RentalStatus.Pending || r.Status == RentalStatus.Accepted).ToList();
    var depositIssueRentals = activeMyRentals.Where(r => r.Status == RentalStatus.Completed).ToList();

    var dailyCost = activeMyRentals.Where(r => r.Status == RentalStatus.Active).Sum(r => r.Item?.Price ?? 0);
}

@if (activeMyRentals.Any())
{
    <!-- Summary Strip -->
    <div class="flex flex-wrap items-center gap-4 mb-6 px-1">
        <div class="flex items-center gap-2 text-sm">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="text-slate-500 dark:text-slate-400">@Localizer["ActiveRentals"]</span>
            <span class="font-semibold text-slate-900 dark:text-white">@(overdueRentals.Count + activeNonOverdue.Count)</span>
        </div>
        <div class="flex items-center gap-2 text-sm">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            <span class="text-slate-500 dark:text-slate-400">@Localizer["PendingRentals"]</span>
            <span class="font-semibold text-slate-900 dark:text-white">@pendingRentals.Count</span>
        </div>
        <div class="flex items-center gap-2 text-sm">
            <i class="bi bi-cash-stack text-trust-blue-600"></i>
            <span class="text-slate-500 dark:text-slate-400">@Localizer["DailyCost"]</span>
            <span class="font-semibold text-trust-blue-600">@CurrencyService.Format(dailyCost)/@Localizer["day"]</span>
        </div>
    </div>

    @* === Overdue Attention Section === *@
    @if (overdueRentals.Any())
    {
        <div class="mb-6 rounded-2xl border border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-900/20 overflow-hidden">
            <div class="px-5 py-3 border-b border-rose-200 dark:border-rose-800 flex items-center gap-2">
                <i class="bi bi-exclamation-triangle text-rose-500"></i>
                <h3 class="text-sm font-semibold text-rose-700 dark:text-rose-300">@Localizer["Overdue"] (@overdueRentals.Count)</h3>
            </div>
            <div class="divide-y divide-rose-200 dark:divide-rose-800">
                @foreach (var rental in overdueRentals)
                {
                    var overdueDays = (DateTime.UtcNow.Date - rental.EndDate.Date).Days;
                    <div class="px-5 py-3 flex items-center gap-3">
                        <div class="w-10 h-10 shrink-0 rounded-lg overflow-hidden">
                            @if (!string.IsNullOrEmpty(rental.Item?.PrimaryImageUrl))
                            {
                                var thumbUrl = rental.Item.PrimaryImageUrl.Replace("/upload/", "/upload/c_thumb,w_80,h_80,q_auto/");
                                <img src="@thumbUrl" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <div class="w-full h-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center"><i class="bi bi-image text-slate-300"></i></div>
                            }
                        </div>
                        <div class="flex-1 min-w-0">
                            <a asp-controller="Items" asp-action="Details" asp-route-id="@rental.ItemId" class="text-sm font-medium text-slate-900 dark:text-white hover:text-trust-blue-600 truncate block">@rental.Item?.Title</a>
                            <p class="text-xs text-rose-600 dark:text-rose-400">@overdueDays @Localizer["days overdue"] &mdash; @Localizer["Return or extend to avoid deposit charge"]</p>
                        </div>
                        <button onclick="openExtensionModal(@rental.Id, '@rental.StartDate.ToString("yyyy-MM-dd")', '@rental.EndDate.ToString("yyyy-MM-dd")', @(rental.Item?.Price ?? 0), @(rental.ItemId), @(rental.Item?.AutoApproveExtensions.ToString().ToLower()))"
                                class="px-3 py-1.5 text-xs font-medium bg-trust-blue-600 text-white rounded-lg hover:brightness-110 transition shrink-0">
                            @Localizer["Extend"]
                        </button>
                    </div>
                }
            </div>
        </div>
    }

    @* === Active Rentals Section === *@
    @if (activeNonOverdue.Any() || depositIssueRentals.Any())
    {
        <div class="mb-6">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-3 flex items-center gap-2">
                <i class="bi bi-play-circle text-emerald-500"></i>
                @Localizer["ActiveRentals"] (@(activeNonOverdue.Count + depositIssueRentals.Count))
            </h3>
            <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden divide-y divide-slate-100 dark:divide-slate-700">
                @foreach (var rental in activeNonOverdue.Concat(depositIssueRentals))
                {
                    @await Html.PartialAsync("_RenterRentalRow", new { Rental = rental, CurrentUserId = currentUserId, CurrencyService = CurrencyService })
                }
            </div>
        </div>
    }

    @* === Pending Rentals Section === *@
    @if (pendingRentals.Any())
    {
        <div class="mb-6">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-3 flex items-center gap-2">
                <i class="bi bi-clock text-amber-500"></i>
                @Localizer["PendingRentals"] (@pendingRentals.Count)
            </h3>
            <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden divide-y divide-slate-100 dark:divide-slate-700">
                @foreach (var rental in pendingRentals)
                {
                    @await Html.PartialAsync("_RenterRentalRow", new { Rental = rental, CurrentUserId = currentUserId, CurrencyService = CurrencyService })
                }
            </div>
        </div>
    }
}
else
{
    @await Html.PartialAsync("_EmptyState", new { Icon = "bi-bag", Message = "You haven't rented anything yet.", ActionLink = Url.Action("Index", "Rentals"), ActionText = "Browse Marketplace" })
}

@* === Favorites Strip === *@
@if (Model.FavoriteItems?.Any() ?? false)
{
    <div class="mt-6">
        <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-3 flex items-center gap-2">
            <i class="bi bi-heart-fill text-red-500"></i>
            @Localizer["SavedFavorites"] (@(Model.FavoriteItems?.Count ?? 0))
        </h3>
        <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-thin">
            @foreach (var item in Model.FavoriteItems!)
            {
                <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id"
                   class="shrink-0 w-40 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden hover:border-trust-blue-300 dark:hover:border-trust-blue-700 hover:shadow-sm transition-all">
                    <div class="h-24 overflow-hidden">
                        @if (!string.IsNullOrEmpty(item.PrimaryImageUrl))
                        {
                            var thumbUrl = item.PrimaryImageUrl.Replace("/upload/", "/upload/c_fill,w_200,h_120,q_auto/");
                            <img src="@thumbUrl" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <div class="w-full h-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center"><i class="bi bi-image text-slate-300"></i></div>
                        }
                    </div>
                    <div class="p-2.5">
                        <p class="text-xs font-medium text-slate-900 dark:text-white truncate">@item.Title</p>
                        <p class="text-xs font-semibold text-trust-blue-600 mt-0.5">@CurrencyService.Format(item.Price)/@Localizer["day"]</p>
                    </div>
                </a>
            }
        </div>
    </div>
}

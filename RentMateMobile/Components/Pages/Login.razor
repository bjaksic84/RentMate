@page "/login"
@layout RentMateMobile.Components.Layout.EmptyLayout
@using System.Net.Http.Json
@inject HttpClient Http
@inject RentMateMobile.Services.AuthService Auth
@inject NavigationManager Nav

<div class="container mt-5">
    <div class="card shadow p-4 border-0">
        <h2 class="text-center fw-bold mb-4">Dobrodošli nazaj!</h2>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input @bind="loginModel.Email" class="form-control form-control-lg" type="email" />
        </div>
        <div class="mb-3">
            <label class="form-label">Geslo</label>
            <input @bind="loginModel.Password" type="password" class="form-control form-control-lg" />
        </div>
        @if (errorMessage != null) { <div class="alert alert-danger">@errorMessage</div> }
        <button class="btn btn-primary btn-lg w-100 mt-3" @onclick="HandleLogin" disabled="@isLoggingIn">
            @if (isLoggingIn) { <span class="spinner-border spinner-border-sm"></span> } else { <span>Prijava</span> }
        </button>
    </div>
</div>

@code {
    private LoginDto loginModel = new LoginDto();
    private string? errorMessage;
    private bool isLoggingIn;

    private async Task HandleLogin()
    {
        isLoggingIn = true;
        errorMessage = null;
        try 
        {
            // Pozor: Preveri, če je pot do tvojega API-ja res "api/auth/login" ali morda "api/accountapi/login"
            var response = await Http.PostAsJsonAsync("api/accountapi/login", loginModel);
            
            if (response.IsSuccessStatusCode) 
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
                if (result != null) 
                {
                    // SHRANIMO VSE PODATKE V AUTH SERVICE
                    await Auth.LoginUser(
                        result.Token, 
                        result.UserId, 
                        result.Email, 
                        result.UserName, 
                        result.City, 
                        result.ProfilePictureUrl
                    );
                    Nav.NavigateTo("marketplace");
                }
            } 
            else 
            { 
                errorMessage = "Napačni podatki za prijavo."; 
            }
        } 
        catch (Exception ex) 
        { 
            errorMessage = "Napaka pri povezavi: " + ex.Message; 
        }
        finally 
        { 
            isLoggingIn = false; 
        }
    }

    public class LoginDto { public string? Email { get; set; } public string? Password { get; set; } }
    public class LoginResponse { 
        public string Token { get; set; } = ""; 
        public string UserId { get; set; } = ""; 
        public string Email { get; set; } = "";
        public string UserName { get; set; } = "";
        public string City { get; set; } = "";
        public string? ProfilePictureUrl { get; set; }
    }
}
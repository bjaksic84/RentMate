@page "/rentals"
@using System.Net.Http.Json
@using RentMate.Shared
@inject HttpClient Http

<div class="container pb-5">
    <h3 class="my-4 fw-bold">Moji najemi</h3>

    <div class="rental-tabs mb-4">
        <button class="btn @(activeTab == 1 ? "btn-primary" : "btn-light")" @onclick="() => activeTab = 1">Moje rezervacije</button>
        <button class="btn @(activeTab == 2 ? "btn-primary" : "btn-light")" @onclick="() => activeTab = 2">Oddano drugim</button>
    </div>

    @if (isFetching)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        @if (activeTab == 1)
        {
            <div class="rental-list">
                @if (myRentals.Any())
                {
                    @foreach (var r in myRentals)
                    {
                        @* V Rentals.razor zamenjaj Rental-Card del s tem *@
                        <div class="rental-card shadow-sm border-0 mb-3 p-3 bg-white rounded-4">
                            <div class="row align-items-center">
                                <div class="col-3">
                                    <div class="rounded-3 bg-light d-flex align-items-center justify-content-center" style="height: 60px; width: 60px;">
                                        <i class="oi oi-box text-primary"></i>
                                    </div>
                                </div>
                                <div class="col-9">
                                    <div class="d-flex justify-content-between">
                                        <h6 class="fw-bold m-0">@r.Item</h6>
                                        <span class="status-dot @(r.Status.Equals(1))? "active" : "")"></span>
                                    </div>
                                    <p class="text-muted small mb-1">@r.StartDate.ToString("dd. MMM") - @r.EndDate.ToString("dd. MMM")</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-dark">@r.TotalPrice €</span>
                                        <button class="btn btn-link btn-sm p-0 text-decoration-none">Podrobnosti</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-center text-muted">Nimate aktivnih najemov.</p>
                }
            </div>
        }
        else
        {
            <div class="rental-list">
                @* Podobna logika za OwnerRentals *@
                <p class="text-center text-muted">Nihče si še ni izposodil vaše opreme.</p>
            </div>
        }
    }
</div>

@code {
    private int activeTab = 1;
    private bool isFetching = false;
    private List<RentalDto> myRentals = new();

    protected override async Task OnInitializedAsync()
    {
        isFetching = true;
        try
        {
            // To kliče MyRentals iz tvojega DashboardViewModel-a preko API-ja
            // Če še nimaš tega endpointa, ga bo treba dodati v DashboardController
            var result = await Http.GetFromJsonAsync<List<RentalDto>>("api/dashboard/myrentals");
            if (result != null) myRentals = result;
        }
        catch { /* Tiho spodleti za demo */ }
        finally { isFetching = false; }
    }

}
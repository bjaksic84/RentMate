@page "/rentals"
@using RentMate.Shared
@inject HttpClient Http

<div class="container pb-5">
    <h3 class="my-4 fw-bold">Najemi in rezervacije</h3>

    <div class="btn-group w-100 mb-4 shadow-sm" role="group">
        <button class="btn @(activeTab == 1 ? "btn-primary" : "btn-outline-primary")" @onclick="() => SwitchTab(1)">
            Moje rezervacije
        </button>
        <button class="btn @(activeTab == 2 ? "btn-primary" : "btn-outline-primary")" @onclick="() => SwitchTab(2)">
            Oddano drugim
        </button>
    </div>

    @if (isFetching)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        var currentList = activeTab == 1 ? myRentals : ownerRentals;

        @if (currentList.Any())
        {
            @foreach (var r in currentList)
            {
                <div class="card shadow-sm border-0 mb-3 p-3 rounded-4 bg-white">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="fw-bold mb-1">@r.Item?.Title</h6>
                            <p class="small text-muted mb-0">
                                <i class="oi oi-calendar me-1"></i> @r.StartDate.ToShortDateString() - @r.EndDate.ToShortDateString()
                            </p>
                        </div>
                        <span class="badge @GetStatusClass(r.Status)">@r.Status</span>
                    </div>
                    <hr class="my-2 opacity-25" />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">@r.TotalPrice €</span>
                        <button class="btn btn-sm btn-light">Podrobnosti</button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="oi oi-inbox text-muted mb-3" style="font-size: 3rem;"></i>
                <p class="text-muted">Tukaj še ni ničesar.</p>
            </div>
        }
    }
</div>

@code {
    private int activeTab = 1;
    private bool isFetching = false;
    private List<RentalDto> myRentals = new();
    private List<RentalDto> ownerRentals = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isFetching = true;
        try
        {
            // Popravljeni poti (niso več 404)
            myRentals = await Http.GetFromJsonAsync<List<RentalDto>>("api/dashboard/my-rentals") ?? new();
            ownerRentals = await Http.GetFromJsonAsync<List<RentalDto>>("api/dashboard/owner-rentals") ?? new();
        }
        catch (Exception ex) { Console.WriteLine("Napaka: " + ex.Message); }
        finally { isFetching = false; }
    }

    private async Task SwitchTab(int tab)
    {
        activeTab = tab;
        await LoadData();
    }

    private string GetStatusClass(RentalStatus status) => status switch
    {
        RentalStatus.Active => "bg-success text-white",
        RentalStatus.Pending => "bg-warning text-dark",
        _ => "bg-secondary text-white"
    };
}
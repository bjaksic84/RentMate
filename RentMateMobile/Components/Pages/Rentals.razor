@page "/rentals"
@using RentMate.Shared
@inject HttpClient Http
@inject NavigationManager Nav

<div class="container pb-5">
    <h3 class="my-4 fw-bold">Moje aktivnosti</h3>

    @* Tab preklopnik *@
    <div class="nav-pills-container mb-4 shadow-sm p-1 bg-light rounded-pill d-flex">
        <button class="btn flex-grow-1 rounded-pill @(activeTab == 1 ? "btn-primary shadow" : "text-muted")" 
                @onclick="() => activeTab = 1">
            <i class="oi oi-cart me-2"></i>Moja naročila
        </button>
        <button class="btn flex-grow-1 rounded-pill @(activeTab == 2 ? "btn-primary shadow" : "text-muted")" 
                @onclick="() => activeTab = 2">
            <i class="oi oi-share me-2"></i>Moje oddaje
        </button>
    </div>

    @if (isFetching) {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    } else {
        var currentList = activeTab == 1 ? myRentals : ownerRentals;

        @if (currentList.Any()) {
            @foreach (var r in currentList) {
                <div class="card shadow-sm border-0 mb-3 rounded-4 overflow-hidden @(r.Status.ToString().Equals("Rejected") ? "opacity-75" : "")">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="fw-bold m-0 text-truncate" style="max-width: 60%;">@r.Item.Title</h6>
                            <span class="badge rounded-pill @GetStatusClass(r.Status.ToString())">@TranslateStatus(r.Status.ToString())</span>
                        </div>

                        <div class="d-flex align-items-center text-muted small mb-3">
                            <i class="oi oi-calendar me-2 text-primary"></i>
                            @r.StartDate.ToShortDateString() - @r.EndDate.ToShortDateString()
                            <span class="mx-2">•</span>
                            <span class="fw-bold text-dark">@r.TotalPrice €</span>
                        </div>

                        <div class="d-flex align-items-center gap-2 border-top pt-3">
                            <div class="avatar-sm bg-light rounded-circle text-center" style="width: 32px; height: 32px; line-height: 32px;">
                                <i class="oi oi-person small"></i>
                            </div>
                            <div class="small flex-grow-1">
                                <div class="text-muted" style="font-size: 0.75rem;">@(activeTab == 1 ? "Lastnik" : "Najemnik")</div>
                                <div class="fw-bold">@(activeTab == 1 ? r.Owner?.UserName : r.Renter?.UserName)</div>
                            </div>

                            @* Dinamični gumbi glede na status in vlogo *@
                            <div class="d-flex gap-2">
                                @if (activeTab == 2 && r.Status.ToString().Equals("Pending")) {
                                    <button class="btn btn-success btn-sm rounded-pill px-3" @onclick='() => UpdateStatus(r.Id, "Accepted")'>Sprejmi</button>
                                    <button class="btn btn-outline-danger btn-sm rounded-pill px-3" @onclick='() => UpdateStatus(r.Id, "Rejected")'>Zavrni</button>
                                }

                                @if (activeTab == 2 && r.Status.ToString().Equals("Accepted")) {
                                    <button class="btn btn-primary btn-sm rounded-pill px-3" @onclick='() => UpdateStatus(r.Id, "Completed")'>Zaključi (Vrnjeno)</button>
                                }

                                @if (activeTab == 1 && r.Status.ToString().Equals("Pending")) {
                                    <button class="btn btn-light btn-sm rounded-pill text-danger" @onclick='() => UpdateStatus(r.Id, "Cancelled")'>Prekliči</button>
                                }

                                @if (activeTab == 1 && r.Status.ToString().Equals("Completed")) {
                                    if (r.ExistingReview == null) {
                                        <button class="btn btn-warning btn-sm rounded-pill shadow-sm" @onclick="() => OpenReview(r)">
                                            <i class="oi oi-star"></i> Oceni
                                        </button>
                                    } else {
                                        <button class="btn btn-outline-secondary btn-sm rounded-pill shadow-sm" @onclick="() => OpenReview(r)">
                                            <i class="oi oi-pencil"></i> Uredi oceno
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        } else {
            <div class="text-center py-5 opacity-50">
                <i class="oi oi-inbox d-block mb-3" style="font-size: 3rem;"></i>
                <p>Nimate aktivnih najemov v tej sekciji.</p>
            </div>
        }
    }
</div>

@* MODAL ZA OCENJEVANJE *@
@if (selectedForReview != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="fw-bold">Oceni najem</h5>
                    <button type="button" class="btn-close" @onclick="() => selectedForReview = null"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center mb-4">
                        <div class="d-flex justify-content-center gap-2 mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                int starIndex = i;
                                <span style="font-size: 2.5rem; cursor: pointer; color: @(newReview.Rating >= starIndex ? "#FFD700" : "#E0E0E0"); transition: color 0.2s;" 
                                    @onclick="() => SetRating(starIndex)"
                                    @onclick:stopPropagation="true">
                                    ★
                                </span>
                            }
                        </div>
                        <p class="text-muted small">Vaša ocena: <strong>@newReview.Rating</strong> / 5</p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Naslov</label>
                        <input type="text" class="form-control rounded-3" placeholder="Npr. Odlična izkušnja!" @bind="newReview.Title" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Vaše mnenje</label>
                        <textarea class="form-control rounded-3" rows="4" placeholder="Opišite svojo izkušnjo..." @bind="newReview.Body"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-light rounded-pill px-4" @onclick="() => selectedForReview = null">Prekliči</button>
                    <button class="btn btn-primary rounded-pill px-4 shadow" 
                            disabled="@(newReview.Rating == 0 || isSavingReview)" 
                            @onclick="SubmitReview">
                        @if (isSavingReview) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        Oddaj oceno
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private int activeTab = 1;
    private bool isFetching = true;
    private List<RentalDto> myRentals = new();
    private List<RentalDto> ownerRentals = new();
    
    // Review logic
    private RentalDto? selectedForReview;
    private int currentRating = 5;
    private string reviewComment = "";

    
    private Review newReview = new();
    private bool isSavingReview = false;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData() {
        isFetching = true;
        try {
            // Predpostavljamo, da RentalsApiController vrača te podatke
            myRentals = await Http.GetFromJsonAsync<List<RentalDto>>("api/rentalsapi/my-rentals") ?? new();
            ownerRentals = await Http.GetFromJsonAsync<List<RentalDto>>("api/rentalsapi/owner-rentals") ?? new();
        } catch (Exception ex) { Console.WriteLine(ex.Message); }
        finally { isFetching = false; }
    }

    private async Task UpdateStatus(int id, string newStatus) {
        var response = await Http.PatchAsJsonAsync($"api/rentalsapi/{id}/status", newStatus);
        if (response.IsSuccessStatusCode) {
            await LoadData();
            await App.Current.MainPage.DisplayAlert("Posodobljeno", $"Status najema je zdaj: {TranslateStatus(newStatus)}", "V redu");
        }
    }

    private void OpenReview(RentalDto rental)
    {
        selectedForReview = rental;
        // If there is an existing review by this user for this rental, prefill for editing
        if (rental.ExistingReview != null)
        {
            newReview = new Review
            {
                RentalId = rental.Id,
                ItemId = rental.ItemId,
                Rating = rental.ExistingReview.Rating,
                Title = rental.ExistingReview.Title,
                Body = rental.ExistingReview.Body
            };
        }
        else
        {
            newReview = new Review
            {
                RentalId = rental.Id,
                ItemId = rental.ItemId,
                Rating = 5, // Privzeto 5 zvezdic
                Title = "",
                Body = ""
            };
        }
        StateHasChanged();
    }
    private void SetRating(int rating)
    {
        newReview.Rating = rating;
        Console.WriteLine($"Ocena nastavljena na: {newReview.Rating}");
        StateHasChanged(); // Prisili UI v osvežitev
    }

    private async Task SubmitReview()
    {
        if (selectedForReview == null) return;
        Console.WriteLine($"POŠILJAM: ItemId={newReview.ItemId}, RentalId={newReview.RentalId}, Rating={newReview.Rating}, Title={newReview.Title}");

        if (newReview.Rating < 1 || newReview.Rating > 5)
        {
            await App.Current.MainPage.DisplayAlert("Pozor", "Ocena mora biti med 1 in 5!", "V redu");
            return;
        }
        isSavingReview = true;
        try
        {
            var payload = new {
            ItemId = newReview.ItemId,
            RentalId = newReview.RentalId,
            Rating = (int)newReview.Rating, // Eksplicitno pretvori v int
            Title = newReview.Title,
            Body = newReview.Body,
            ReviewerId = "placeholder"
        };

        var response = await Http.PostAsJsonAsync("api/reviewapi", payload);
        
        if (!response.IsSuccessStatusCode)
        {
            var content = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"SERVER ERROR: {content}");
            await App.Current.MainPage.DisplayAlert("Napaka", "Napaka pri oddaji ocene.", "V redu");
        }
        else
        {
            // On success, refresh list, close modal and notify user
            await LoadData();
            selectedForReview = null;
            await App.Current.MainPage.DisplayAlert("Hvala", "Ocena je bila shranjena.", "V redu");
        }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Review error: {ex.Message}");
        }
        finally
        {
            isSavingReview = false;
        }
    }

    private string TranslateStatus(string s) => s switch {
        "Pending" => "V čakanju",
        "Accepted" => "Potrjeno",
        "Rejected" => "Zavrnjeno",
        "Completed" => "Zaključeno",
        "Cancelled" => "Preklicano",
        _ => s
    };

    private string GetStatusClass(string s) => s switch {
        "Pending" => "bg-warning-subtle text-warning",
        "Accepted" => "bg-success-subtle text-success",
        "Rejected" => "bg-danger-subtle text-danger",
        "Completed" => "bg-info-subtle text-info",
        _ => "bg-secondary-subtle text-secondary"
    };
}
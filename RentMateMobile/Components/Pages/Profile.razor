@page "/profile"
@using RentMateMobile.Services
@inject AuthService Auth
@inject NavigationManager Nav

<div class="container pt-5">
    @if (Auth.CurrentUser == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2 text-muted">Nalaganje profila...</p>
        </div>
    }
    else
    {
        <div class="text-center mb-4">
            <div class="bg-primary text-white d-inline-block rounded-circle p-4 mb-3 shadow">
                <i class="oi oi-person" style="font-size: 3rem;"></i>
            </div>
            <h3 class="fw-bold">@Auth.CurrentUser.Name</h3>
            <p class="text-muted">@Auth.CurrentUser.Email</p>
        </div>

        <div class="card border-0 shadow-sm mx-2 rounded-4 overflow-hidden">
            <div class="list-group list-group-flush">
                <div class="list-group-item py-3 border-0">
                    <small class="text-muted d-block">ID Uporabnika</small>
                    <span class="fw-medium text-break" style="font-size: 0.8rem;">@Auth.CurrentUser.Id</span>
                </div>
                <div class="list-group-item py-1 border-0"><hr class="m-0 opacity-25" /></div>
                <button class="list-group-item list-group-item-action py-3 text-danger border-0" @onclick="HandleLogout">
                    <i class="oi oi-account-logout me-2"></i> <strong>Odjava</strong>
                </button>
            </div>
        </div>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // 1. Zagotovimo, da so podatki naloženi iz SecureStorage v CurrentUser
        await Auth.LoadCurrentUserAsync();
        
        // 2. Preverimo avtentikacijo
        if (!await Auth.IsAuthenticated())
        {
            Nav.NavigateTo("login");
        }
    }

    private void HandleLogout()
    {
        Auth.Logout();
        Nav.NavigateTo("login");
    }
}
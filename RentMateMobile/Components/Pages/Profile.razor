@page "/profile"
@using RentMateMobile.Services
@using RentMate.Shared
@using RentMate.Helpers
@inject HttpClient Http
@inject IImageService ImageService
@inject AuthService Auth
@inject NavigationManager Nav

<div class="container pt-4 pb-5">
    @if (Auth.CurrentUser == null) {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    } else {
        <div class="text-center mb-4">
            <div class="position-relative d-inline-block">
                @if (!string.IsNullOrEmpty(profileUrl)) {
                    <img src="@profileUrl" class="rounded-circle shadow" style="width: 120px; height: 120px; object-fit: cover;" />
                } else {
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 120px; height: 120px;">
                        <i class="oi oi-person" style="font-size: 3.5rem;"></i>
                    </div>
                }
                <button class="btn btn-sm btn-dark position-absolute bottom-0 end-0 rounded-circle p-2 shadow" @onclick="ChangeProfilePicture">
                    <i class="oi oi-camera-slr text-white"></i>
                </button>
            </div>
            <h3 class="fw-bold mt-3 mb-0">@Auth.CurrentUser.Name</h3>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-4 text-uppercase small text-primary tracking-wider">Osnovne nastavitve</h6>
                
                <div class="mb-3">
                    <label class="form-label small fw-bold">E-poštni naslov</label>
                    <input type="email" class="form-control rounded-3" @bind="editEmail" />
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold">Moja lokacija (Kraj)</label>
                    <select class="form-select rounded-3" @bind="selectedCity">
                        @if (string.IsNullOrEmpty(selectedCity))
                        {
                            <option value="" disabled selected>Izberite mesto...</option>
                        }
                        @foreach (var city in CityData.Cities.OrderBy(c => c.Name))
                        {
                            <option value="@city.Name">@city.Name</option>
                        }
                    </select>
                    @if (!string.IsNullOrEmpty(selectedCity))
                    {
                        <div class="form-text text-primary small">
                            <i class="oi oi-check me-1"></i> Trenutno nastavljeno: <strong>@selectedCity</strong>
                        </div>
                    }
                </div>

                <button class="btn btn-primary w-100 rounded-pill py-2 fw-bold" @onclick="UpdateProfile" disabled="@isSaving">
                    @if(isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    Shrani spremembe
                </button>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3 text-uppercase small text-primary">Varnost</h6>
                <div class="mb-2">
                    <input type="password" class="form-control rounded-3 mb-2" placeholder="Trenutno geslo" @bind="oldPass" />
                    <input type="password" class="form-control rounded-3" placeholder="Novo geslo" @bind="newPass" />
                </div>
                <button class="btn btn-outline-primary btn-sm rounded-pill w-100" @onclick="ChangePassword">
                    Posodobi geslo
                </button>
            </div>
        </div>

        <button class="btn btn-light text-danger w-100 rounded-pill py-3 fw-bold border-0 shadow-sm" @onclick="HandleLogout">
            <i class="oi oi-account-logout me-2"></i>Odjava iz računa
        </button>
    }
</div>

@code {
    public class UpdateProfileModel { 
        public string Email { get; set; } = "";
        public string City { get; set; } = "";
        public string? ProfilePictureUrl { get; set; }
    }
    private string editEmail = "";
    private string selectedCity = "";
    private string profileUrl = "";
    private string oldPass = "";
    private string newPass = "";
    private bool isSaving = false;

    protected override async Task OnInitializedAsync() {
        await Auth.LoadCurrentUserAsync();
        if (!await Auth.IsAuthenticated()) Nav.NavigateTo("login");

        editEmail = Auth.CurrentUser?.Email ?? "";
        selectedCity = Auth.CurrentUser?.City?.Trim() ?? "";
        profileUrl = Auth.CurrentUser?.ProfilePictureUrl ?? "";
        StateHasChanged();
    }

    private async Task ChangeProfilePicture() {
        var url = await ImageService.PickAndUploadImageAsync();
        if (!string.IsNullOrEmpty(url)) {
            profileUrl = url;
            await UpdateProfile(); // Samodejno shrani po nalaganju
        }
    }

    private async Task UpdateProfile() {
        isSaving = true;
        var model = new UpdateProfileModel { Email = editEmail, City = selectedCity, ProfilePictureUrl = profileUrl };
        var res = await Http.PutAsJsonAsync("api/accountapi/update-profile", model);
        
        if (res.IsSuccessStatusCode) {
            await Auth.LoginUser(
                Auth.CurrentUser.Token, 
                Auth.CurrentUser.Id, 
                editEmail, 
                Auth.CurrentUser.Name, 
                selectedCity, // NOVO MESTO
                profileUrl    // NOVA SLIKA
            );
            await App.Current.MainPage.DisplayAlertAsync("Uspeh", "Profil je posodobljen!", "OK");
            
        }
        isSaving = false;
    }

    private async Task ChangePassword() {
        if (string.IsNullOrEmpty(newPass)) return;
        var res = await Http.PostAsJsonAsync("api/accountapi/change-password", new { OldPassword = oldPass, NewPassword = newPass });
        
        if (res.IsSuccessStatusCode) {
            await App.Current.MainPage.DisplayAlertAsync("Varnost", "Geslo uspešno spremenjeno.", "OK");
            oldPass = newPass = "";
        } else {
            var msg = await res.Content.ReadAsStringAsync();
            await App.Current.MainPage.DisplayAlertAsync("Napaka", msg, "Zapri");
        }
    }

    private void HandleLogout() {
        Auth.Logout();
        Nav.NavigateTo("login");
    }
}
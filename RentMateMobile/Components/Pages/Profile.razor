@page "/profile"
@inject RentMateMobile.Services.AuthService Auth
@inject NavigationManager Nav

<div class="container text-center pt-5">
    <div class="profile-avatar mb-3">
        <i class="oi oi-person" style="font-size: 4rem; color: #ccc;"></i>
    </div>
    <h4 class="fw-bold">Uporabnik RentMate</h4>
    <p class="text-muted">Prijavljeni ste v svojo varno sejo.</p>

    <div class="mt-5 px-3">
        <button class="btn btn-outline-danger w-100 py-3" @onclick="HandleLogout">
            <i class="oi oi-account-logout me-2"></i> Odjava
        </button>
    </div>
</div>

@code {
    void HandleLogout()
    {
        Auth.Logout();
        Nav.NavigateTo("login");
    }
}
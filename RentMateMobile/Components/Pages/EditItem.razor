@page "/edit-item/{Id:int}"
@using RentMate.Shared
@using RentMateMobile.Services
@inject HttpClient Http
@inject NavigationManager Nav
@inject IImageService ImageService

<div class="container pb-5">
    <h3 class="my-4 fw-bold">Uredi oglas</h3>

    @if (item == null) {
        <div class="text-center"><div class="spinner-border"></div></div>
    } else {
        <div class="card border-0 shadow-sm p-4">
            <div class="mb-3">
                <label class="form-label fw-bold">Trenutna slika</label>
                @if (!string.IsNullOrEmpty(item.ImageUrl)) {
                    <div class="position-relative mb-2">
                        <img src="@item.ImageUrl" class="rounded w-100" style="max-height:200px; object-fit:cover;" />
                    </div>
                }
                <button type="button" class="btn btn-outline-primary w-100" @onclick="HandleImageUpload">
                    Zamenjaj sliko
                </button>
            </div>

            <div class="mb-3">
                <label class="form-label">Naziv</label>
                <input @bind="item.Title" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Cena (€/dan)</label>
                <input @bind="item.Price" type="number" class="form-control" />
            </div>

            <button class="btn btn-primary w-100" @onclick="UpdateItem">Shrani spremembe</button>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private RentMate.Shared.Item? item;

    protected override async Task OnInitializedAsync() {
        item = await Http.GetFromJsonAsync<RentMate.Shared.Item>($"api/itemsapi/{Id}");
    }

    private async Task HandleImageUpload() {
        var url = await ImageService.PickAndUploadImageAsync();
        if (!string.IsNullOrEmpty(url)) item.ImageUrl = url;
    }

    private async Task UpdateItem() {
        var response = await Http.PutAsJsonAsync($"api/itemsapi/{Id}", item);
        if (response.IsSuccessStatusCode) Nav.NavigateTo("/dashboard");
    }
}
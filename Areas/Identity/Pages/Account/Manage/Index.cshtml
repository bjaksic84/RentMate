@page
@model IndexModel
@{
    ViewData["Title"] = "Profil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3 class="mb-4">@ViewData["Title"]</h3>
<partial name="_StatusMessage" model="Model.StatusMessage" />

<div class="row">
    <div class="col-md-9">
        <form id="profile-form" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-4 text-center border-end">
                            <div class="position-relative d-inline-block">
                                <img id="profilePreview" 
                                     src="@(string.IsNullOrEmpty(Model.Input.ProfilePictureUrl) ? "https://via.placeholder.com/150?text=No+Image" : Model.Input.ProfilePictureUrl)" 
                                     class="rounded-circle img-thumbnail shadow-sm object-fit-cover" 
                                     style="width: 160px; height: 160px;" 
                                     alt="Profile Picture" />
                                
                                <label for="fileUpload" class="btn btn-sm btn-primary position-absolute bottom-0 end-0 rounded-circle shadow" style="width: 40px; height: 40px; line-height: 28px;">
                                    <i class="bi bi-camera-fill"></i>
                                </label>
                                <input type="file" id="fileUpload" asp-for="Input.NewProfilePicture" class="d-none" accept="image/*" onchange="previewImage(this)" />
                            </div>
                            <p class="text-muted small mt-3">Kliknite ikono kamere za zamenjavo slike.</p>
                        </div>

                        <div class="col-md-8 ps-md-4">
                            <div class="form-floating mb-3">
                                <input asp-for="Username" class="form-control" disabled />
                                <label asp-for="Username" class="form-label"></label>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Input.FirstName" class="form-control" placeholder="Ime" />
                                        <label asp-for="Input.FirstName">Ime</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Input.LastName" class="form-control" placeholder="Priimek" />
                                        <label asp-for="Input.LastName">Priimek</label>
                                    </div>
                                </div>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.City" class="form-control" placeholder="Mesto" />
                                <label asp-for="Input.City">Mesto (za lažje iskanje)</label>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Telefon" />
                                <label asp-for="Input.PhoneNumber">Telefonska številka</label>
                                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <button id="update-profile-button" type="submit" class="btn btn-lg btn-success px-5">Shrani spremembe</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('profilePreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}